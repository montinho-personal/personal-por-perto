---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import Lightbox from '../components/Lightbox.astro';
import { site } from '../data/site';
import { organizationSchema, websiteSchema, graph } from '../lib/schema';

export interface Props {
  title: string;
  description: string;
  /** Caminho da página (ex.: "/personal-trainer/sao-paulo-sp"). */
  path: string;
  /** Nós JSON-LD adicionais específicos da página. */
  schema?: object[];
  ogType?: string;
  /** Imagem OG absoluta ou relativa ao domínio. */
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  schema = [],
  ogType = 'website',
  image = '/og-default.png',
  noindex = false,
} = Astro.props;

// Canonical espelha exatamente a URL servida/sitemap: formato 'directory'
// serve /caminho/ (com barra). Canonical sem barra apontaria para um 301.
const pathCanonico = path.endsWith('/') ? path : `${path}/`;
const canonical = new URL(pathCanonico, site.dominio).href;
const ogImage = image.startsWith('http') ? image : new URL(image, site.dominio).href;

// Toda página carrega Organization + WebSite e mescla os nós específicos.
const jsonLd = graph(organizationSchema(), websiteSchema(), ...schema);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="EGZvPU34aJS29O2EKxEcdiasLIzAd8QWv-9twsNyPfQ" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta name="theme-color" content="#16181d" />
    <meta name="author" content={site.nome} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#conteudo" class="skip-link">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
    <Lightbox />

    <div id="cookie-aviso" class="cookie-aviso" hidden role="dialog" aria-live="polite" aria-label="Aviso de cookies">
      <p class="cookie-texto">
        Usamos cookies essenciais para o funcionamento do site e, com a sua
        autorização, cookies analíticos para entender como o conteúdo é usado.
        Saiba mais na <a href="/privacidade/">Política de Privacidade e Cookies</a>.
      </p>
      <div class="cookie-acoes">
        <button type="button" id="cookie-recusar" class="cookie-btn cookie-btn--ghost">Recusar</button>
        <button type="button" id="cookie-aceitar" class="cookie-btn">Aceitar</button>
      </div>
    </div>

    <script is:inline define:vars={{ gaId: site.analyticsId }}>
      (function () {
        var CHAVE = 'ppp-consentimento-cookies';

        // Carrega o Google Analytics 4 apenas após consentimento (LGPD).
        function carregarAnalytics() {
          if (!gaId || window.__pppGAOn) return;
          window.__pppGAOn = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { window.dataLayer.push(arguments); };
          window.gtag('js', new Date());
          window.gtag('config', gaId, { anonymize_ip: true });
        }

        var consentido = null;
        try { consentido = localStorage.getItem(CHAVE); } catch (e) {}

        if (consentido === 'aceito') carregarAnalytics();

        var aviso = document.getElementById('cookie-aviso');
        if (consentido || !aviso) return; // já decidiu antes, ou sem banner
        aviso.hidden = false;

        function decidir(valor) {
          try { localStorage.setItem(CHAVE, valor); } catch (e) {}
          aviso.hidden = true;
          if (valor === 'aceito') carregarAnalytics();
        }
        var aceitar = document.getElementById('cookie-aceitar');
        var recusar = document.getElementById('cookie-recusar');
        if (aceitar) aceitar.addEventListener('click', function () { decidir('aceito'); });
        if (recusar) recusar.addEventListener('click', function () { decidir('recusado'); });
      })();
    </script>

    <script is:inline>
      // Conta no GA do portal cliques de saída (Montinho e Instagram).
      // Só dispara se o GA estiver carregado (ou seja, se os cookies foram aceitos).
      (function () {
        document.addEventListener('click', function (e) {
          var t = e.target;
          if (!t || !t.closest || typeof window.gtag !== 'function') return;

          var wpp = t.closest('a[data-wpp], a[href*="wa.me"], a[href*="api.whatsapp.com"]');
          if (wpp) {
            window.gtag('event', 'clique_whatsapp', {
              link_url: wpp.getAttribute('href') || '',
            });
            return;
          }

          var ig = t.closest('a[data-ig], a[href*="instagram.com"]');
          if (ig) {
            window.gtag('event', 'clique_instagram', {
              link_url: ig.getAttribute('href') || '',
            });
            return;
          }

          var mont = t.closest('a[href*="montinhopersonal.com.br"]');
          if (mont) {
            var href = mont.getAttribute('href') || '';
            var conteudo = '';
            try { conteudo = new URL(href).searchParams.get('utm_content') || ''; } catch (err) {}
            window.gtag('event', 'clique_montinho', {
              link_url: href,
              link_content: conteudo,
            });
          }
        }, true);
      })();
    </script>
  </body>
</html>

<style is:global>
  .cookie-aviso {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 100;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--sp-3, 0.75rem) var(--sp-5, 1.5rem);
    padding: var(--sp-4, 1rem) var(--sp-5, 1.5rem);
    background: #16181d;
    color: #d8dce3;
    border-top: 2px solid var(--accent, #f0641e);
    box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.35);
    font-size: var(--step--1, 0.9rem);
  }
  .cookie-aviso[hidden] {
    display: none;
  }
  .cookie-texto {
    margin: 0;
    max-width: 60ch;
    line-height: 1.55;
  }
  .cookie-aviso a {
    color: #fff;
    text-decoration: underline;
  }
  .cookie-acoes {
    display: flex;
    gap: var(--sp-3, 0.75rem);
    flex-shrink: 0;
  }
  .cookie-btn {
    cursor: pointer;
    border: 1px solid var(--accent, #f0641e);
    background: var(--accent, #f0641e);
    color: #fff;
    font-weight: 600;
    padding: 0.55rem 1.2rem;
    border-radius: 999px;
    font-size: inherit;
    line-height: 1;
  }
  .cookie-btn:hover {
    filter: brightness(1.08);
  }
  .cookie-btn--ghost {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.35);
    color: #d8dce3;
  }
  .cookie-btn--ghost:hover {
    border-color: #fff;
    color: #fff;
    filter: none;
  }
  @media (max-width: 520px) {
    .cookie-aviso {
      flex-direction: column;
      align-items: stretch;
    }
    .cookie-acoes {
      justify-content: flex-end;
    }
  }
</style>
