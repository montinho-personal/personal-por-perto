---
/**
 * Hub de ferramentas do portal.
 *
 * Não é uma página de índice com dois links: é a página que responde
 * "que ferramenta resolve o meu problema?" e explica o critério por trás
 * delas. Os cards são montados a partir do registro central em
 * src/data/ferramentas.ts — publicar ferramenta nova é acrescentar a
 * entrada lá, e o hub, o rodapé e o schema acompanham sozinhos.
 */
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaMontinho from '../../components/CtaMontinho.astro';
import { breadcrumbSchema, itemListSchema } from '../../lib/schema';
import { site } from '../../data/site';
import { ferramentas, ferramentasDisponiveis, urlFerramenta } from '../../data/ferramentas';
import { rotas } from '../../lib/links';
import { ETAPAS, FERRAMENTAS, SITUACOES } from '../../lib/jornada';
import { formatDateLong } from '../../lib/slug';

const path = '/ferramentas';
const atualizadoEm = '2026-08-30';

const crumbs = [
  { nome: 'Início', url: '/' },
  { nome: 'Meu Mapa do Treino', url: path },
];

const title = 'Meu Mapa do Treino: descubra seu próximo passo | Personal por Perto';
const description =
  'Sete ferramentas gratuitas e sem cadastro que mostram qual é o seu próximo passo: constância, rotina, estrutura do treino, formato de acompanhamento e preço na sua cidade.';

const urlCanonica = new URL(path + '/', site.dominio).href;

const schema = [
  breadcrumbSchema(crumbs),
  {
    '@type': 'CollectionPage',
    '@id': `${urlCanonica}#webpage`,
    url: urlCanonica,
    name: 'Meu Mapa do Treino',
    description,
    inLanguage: site.idioma,
    dateModified: atualizadoEm,
    isPartOf: { '@id': `${site.dominio}/#website` },
  },
  itemListSchema(
    'Meu Mapa do Treino: as sete etapas',
    ferramentasDisponiveis.map((f) => f.nome),
    site.dominio,
    ferramentasDisponiveis.map((f) => new URL(urlFerramenta(f.slug), site.dominio).href),
  ),
];
---

<Base title={title} description={description} path={path} schema={schema}>
  <Breadcrumbs crumbs={crumbs} />

  <!-- ============================= HERO ============================= -->
  <header class="section-sm">
    <div class="container fer-intro">
      <p class="eyebrow">Meu Mapa do Treino · gratuito, sem cadastro</p>
      <h1>Você não precisa de mais uma dica. Precisa descobrir o seu próximo passo.</h1>
      <p class="fer-lead">
        Treino, rotina, constância, acompanhamento e investimento não são
        assuntos separados — são etapas da mesma decisão. Estas ferramentas
        existem para você descobrir <strong>em qual delas você está</strong>
        e o que resolve o seu caso agora. Não é preciso usar todas.
      </p>
      <ul class="fer-selos">
        <li><span aria-hidden="true">✓</span> Gratuitas, sem cadastro</li>
        <li><span aria-hidden="true">✓</span> Resultado na hora</li>
        <li><span aria-hidden="true">✓</span> Método aberto e explicado</li>
      </ul>
    </div>
  </header>

  <!-- ===================== ONDE VOCÊ ESTÁ HOJE ====================== -->
  <section class="section-sm" id="onde-voce-esta">
    <div class="container">
      <div class="fer-intro">
        <h2>Onde você está hoje?</h2>
        <p class="hj-sub">
          Escolha a frase que mais parece com a sua situação. Cada uma leva
          direto à ferramenta que resolve aquele problema — e explica por quê.
        </p>
      </div>

      <ul class="hj-situacoes">
        {
          SITUACOES.map((sit) => (
            <li>
              <a
                class="hj-sit"
                href={FERRAMENTAS[sit.destino].url}
                data-situacao={sit.id}
              >
                <span class="hj-sit-frase">“{sit.frase}”</span>
                <span class="hj-sit-detalhe">{sit.detalhe}</span>
                <span class="hj-sit-destino">
                  Começar por: <strong>{FERRAMENTAS[sit.destino].nome}</strong>
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="hj-rot-wrap">
        <p class="hj-rot-chamada">Nenhuma dessas descreve o seu caso?</p>
        <button type="button" class="btn btn-secondary" id="hj-abrir-roteador">
          Descobrir meu próximo passo
        </button>
        <p class="hj-rot-micro">Quatro perguntas. Serve só para indicar por onde começar.</p>
        <div id="hj-roteador" class="hj-rot" hidden></div>
      </div>
    </div>
  </section>

  <!-- ======================= MEU MAPA DO TREINO ===================== -->
  <section class="section-sm tint" id="hj-mapa-secao">
    <div class="container">
      <div id="hj-mapa" hidden></div>
      <noscript>
        <p class="hj-sub">
          O mapa da jornada precisa de JavaScript. Todas as ferramentas e todo o
          conteúdo desta página funcionam normalmente sem ele.
        </p>
      </noscript>
    </div>
  </section>

  <!-- =========================== A JORNADA ========================== -->
  <section class="section-sm" id="jornada">
    <div class="container">
      <div class="fer-intro">
        <h2>As sete etapas de uma decisão sobre treino</h2>
        <p class="hj-sub">
          Muita gente procura solução antes de entender qual é o problema:
          troca de treino, tenta aumentar a frequência, muda de academia,
          contrata alguém — e para de novo. Quase sempre o que falta não é
          motivação, e sim identificar qual é a próxima decisão correta.
          Cada etapa abaixo responde uma pergunta, e cada resposta indica a
          seguinte.
        </p>
      </div>

      <ol class="hj-etapas-lista">
        {
          ETAPAS.map((e) => (
            <li class="hj-etapa-card">
              <span class="hj-etapa-num">{e.ordem}</span>
              <div>
                <h3>
                  {e.nome} — <a href={FERRAMENTAS[e.ferramenta].url}>{FERRAMENTAS[e.ferramenta].nome}</a>
                </h3>
                <p class="hj-etapa-pergunta">Responde: “{e.pergunta}”</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============================ CARDS ============================= -->
  <section class="section-sm" id="todas">
    <div class="container">
      <div class="fer-intro">
        <h2>Todas as ferramentas, em detalhe</h2>
        <p class="hj-sub">
          O que cada uma pergunta, o que ela entrega ao terminar e — com a
          mesma clareza — o que ela não faz.
        </p>
      </div>
      <div class="fer-lista">
        {
          ferramentas.map((f) =>
            f.disponivel ? (
              <article class="card fer-card">
                <div class="fer-card-topo">
                  {f.selo && <span class="pill pill-accent">{f.selo}</span>}
                  <h2 class="fer-nome">
                    <a href={urlFerramenta(f.slug)}>{f.nome}</a>
                  </h2>
                  {f.perguntaCentral && <p class="fer-pergunta">Responde: “{f.perguntaCentral}”</p>}
                </div>

                <p class="fer-desc">{f.descricao}</p>

                {f.paraQuem && (
                  <p class="fer-paraquem">
                    <strong>Para quem é:</strong> {f.paraQuem}
                  </p>
                )}

                {f.entrega && (
                  <div class="fer-entrega">
                    <h3>O que você leva ao terminar</h3>
                    <ul class="check-list">
                      {f.entrega.map((e) => (
                        <li>{e}</li>
                      ))}
                    </ul>
                  </div>
                )}

                {f.naoFaz && (
                  <p class="fer-naofaz">
                    <strong>O que ela não faz:</strong> {f.naoFaz}
                  </p>
                )}

                <a class="btn btn-primary fer-btn" href={urlFerramenta(f.slug)}>
                  Abrir {f.nomeCurto.toLowerCase()}
                </a>
              </article>
            ) : (
              <article class="card fer-card fer-card--breve">
                <div class="fer-card-topo">
                  <span class="pill pill-neutral">Em breve</span>
                  <h2 class="fer-nome">{f.nome}</h2>
                </div>
                <p class="fer-desc">{f.descricao}</p>
              </article>
            ),
          )
        }
      </div>
    </div>
  </section>

  <!-- ====================== CONTEÚDO EDITORIAL ====================== -->
  <section class="section-sm tint">
    <div class="container">
      <article class="prose fer-artigo">
        <p class="fer-atualizado">Atualizado em {formatDateLong(atualizadoEm)}</p>

        <h2 id="qual-usar">Qual ferramenta usar primeiro</h2>
        <p>
          Depende de onde você travou. Se a dúvida ainda é <em>que tipo</em> de
          acompanhamento contratar — se vale um personal do seu lado na academia
          ou se um acompanhamento a distância resolveria melhor —, comece pelo
          <a href={urlFerramenta('encontre-seu-personal-ideal')}>diagnóstico do
          personal ideal</a>. Ele é a porta de entrada natural, porque a
          resposta dele muda tudo o que vem depois, inclusive o preço.
        </p>
        <p>
          Se você já decidiu que vai treinar e o nó é <em>como organizar a
          semana</em> — quantos dias, como dividir, o que fazer quando não dá
          para cumprir tudo —, o
          <a href={urlFerramenta('treino-para-minha-rotina')}>treino para minha
          rotina</a> é o caminho. Ele parte da sua disponibilidade real, não da
          semana ideal, e entrega também a semana mínima viável: o número de
          sessões que segura a rotina quando o mês aperta.
        </p>
        <p>
          Se o formato você já decidiu e a dúvida é <em>quanto custa</em>, vá
          direto para a
          <a href={urlFerramenta('calculadora-preco-personal')}>calculadora de
          preço</a>. Ela mostra a faixa de referência por sessão e por mês na
          sua cidade, com a conta aberta — porque o preço muda muito conforme o
          formato, a frequência e a região, e chegar à conversa sem parâmetro
          nenhum é o que faz muita gente aceitar o primeiro número que ouve.
        </p>
        <p>
          As três conversam entre si: ao terminar uma, o resultado sugere a
          próxima já com o seu contexto, sem perguntar de novo o que você
          acabou de responder.
        </p>

        <h2 id="por-que-gratuitas">Por que elas são gratuitas e não pedem cadastro</h2>
        <p>
          Porque bloquear resultado atrás de formulário transforma uma ajuda em
          isca. As duas ferramentas mostram o resultado completo na hora, sem
          e-mail, sem telefone e sem cadastro. A única informação opcional é a
          cidade, usada para dizer se o atendimento presencial é viável no seu
          caso — e dá para pular.
        </p>
        <p>
          O portal é mantido por um profissional que atende presencialmente na
          região de Alphaville e online no Brasil inteiro. Quando o seu perfil
          combina com esse trabalho, isso aparece no resultado; quando não
          combina, a ferramenta diz isso com todas as letras e indica o caminho
          honesto. Essa é a troca: a ferramenta precisa ser útil mesmo para
          quem nunca vai contratar nada.
        </p>

        <h2 id="como-funcionam">Como elas chegam ao resultado</h2>
        <p>
          Nenhuma das duas sorteia resposta nem usa inteligência artificial para
          inventar texto. As duas são determinísticas: as mesmas respostas
          produzem sempre o mesmo resultado, calculado por regras que estão
          descritas na própria página de cada ferramenta.
        </p>
        <p>
          Isso vale também para o que elas <em>não</em> afirmam. O diagnóstico
          não diz que você é de um "tipo" nem promete resultado; a calculadora
          declara que trabalha com faixa de referência editorial e nunca alega
          preço médio de mercado, porque não existe coleta de preços praticados
          por trás. Preferimos entregar um número mais humilde e verdadeiro do
          que um número redondo e inventado.
        </p>

        <h2 id="limites">O que as ferramentas não fazem</h2>
        <p>
          Elas ajudam a decidir <strong>formato e faixa de investimento</strong>.
          Não prescrevem treino, não fazem avaliação física, não diagnosticam
          nada e não substituem a orientação individual de um profissional. Se
          você tem dor, lesão ou alguma condição de saúde, converse com um
          médico ou fisioterapeuta antes de começar a treinar — e leve essa
          orientação para quem for te acompanhar.
        </p>

        <h2 id="mais">Prefere ler antes de usar</h2>
        <p>
          As ferramentas nasceram do conteúdo do portal, e o conteúdo continua
          lá para quem quiser se aprofundar. Os
          <a href={rotas.guias}>guias de contratação</a> destrincham critérios,
          formatos e preços em texto; o diretório de
          <a href={rotas.cidades}>personal trainer por cidade</a> traz o
          panorama local de cada região, com academias e espaços de treino
          verificados.
        </p>
      </article>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <CtaMontinho variante="destaque" />
    </div>
  </section>
  <script>
    import { iniciarHub } from '../../scripts/hubJornada.client';
    iniciarHub();
  </script>
</Base>

<style>
  .fer-intro {
    max-width: 760px;
  }
  .fer-lead {
    margin-top: var(--sp-4);
    font-size: var(--step-1);
    color: var(--ink-soft);
    line-height: 1.55;
  }
  .fer-selos {
    list-style: none;
    padding: 0;
    margin: var(--sp-5) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3) var(--sp-5);
    font-size: var(--step--1);
    color: var(--muted);
  }
  .fer-selos li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .fer-selos span {
    color: var(--accent);
    font-weight: 800;
  }

  /* Cards em coluna única até 900px: o conteúdo de cada um é denso e
     duas colunas estreitas empilhariam texto demais lado a lado. Acima
     disso, auto-fit acomoda qualquer quantidade de ferramentas sem deixar
     linha órfã quando o número é ímpar. */
  .fer-lista {
    display: grid;
    gap: var(--sp-5);
  }
  @media (min-width: 900px) {
    .fer-lista {
      grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
      align-items: start;
    }
  }
  .fer-card {
    display: flex;
    flex-direction: column;
  }
  .fer-nome {
    margin-top: var(--sp-3);
    font-size: var(--step-2);
    line-height: 1.2;
  }
  .fer-nome a {
    color: inherit;
    text-decoration: none;
  }
  .fer-nome a:hover {
    color: var(--brand-600);
  }
  .fer-pergunta {
    margin-top: var(--sp-2);
    font-weight: 600;
    color: var(--ink-soft);
  }
  .fer-desc {
    margin-top: var(--sp-3);
    color: var(--muted);
    line-height: 1.6;
  }
  .fer-paraquem {
    margin-top: var(--sp-4);
    line-height: 1.6;
    color: var(--ink-soft);
  }
  .fer-entrega {
    margin-top: var(--sp-4);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--line-soft);
  }
  .fer-entrega h3 {
    font-size: var(--step-0);
    margin-bottom: var(--sp-3);
  }
  .fer-naofaz {
    margin-top: var(--sp-4);
    font-size: var(--step--1);
    color: var(--muted);
    line-height: 1.55;
  }
  /* Empurra o botão para a base: com cards de alturas diferentes, as
     chamadas de ação ficam alinhadas entre si. */
  .fer-btn {
    margin-top: auto;
    align-self: flex-start;
    margin-block-start: var(--sp-5);
  }
  .fer-card--breve {
    opacity: 0.75;
  }

  .fer-artigo {
    max-width: var(--container-narrow);
    margin-inline: auto;
  }
  .fer-atualizado {
    color: var(--muted);
    font-size: var(--step--1);
    margin-bottom: var(--sp-5);
  }
  .fer-artigo h2 {
    margin-top: var(--sp-7);
    font-size: var(--step-2);
  }
  .fer-artigo h2:first-of-type {
    margin-top: 0;
  }
  .fer-artigo p {
    margin-top: var(--sp-4);
    line-height: 1.7;
  }
</style>

<!-- is:global obrigatório: mapa, plano e roteador nascem via JS. Prefixo `hj-`. -->
<style is:global>
  .hj-sub {
    margin-top: var(--sp-3);
    color: var(--muted);
    line-height: 1.65;
    max-width: 68ch;
  }

  /* ------------------------ Onde você está hoje ------------------------ */
  .hj-situacoes {
    list-style: none;
    padding: 0;
    margin: var(--sp-5) 0 0;
    display: grid;
    gap: var(--sp-3);
  }
  @media (min-width: 700px) {
    .hj-situacoes { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1080px) {
    .hj-situacoes { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .hj-sit {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    height: 100%;
    padding: var(--sp-4) var(--sp-5);
    border: 2px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.12s ease, transform 0.12s ease;
  }
  .hj-sit:hover { border-color: var(--accent); transform: translateY(-2px); }
  .hj-sit:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
  .hj-sit-frase { font-size: var(--step-0); font-weight: 700; line-height: 1.35; }
  .hj-sit-detalhe { font-size: var(--step--1); color: var(--muted); line-height: 1.5; }
  .hj-sit-destino {
    margin-top: auto;
    padding-top: var(--sp-3);
    font-size: var(--step--1);
    color: var(--brand-600);
  }

  /* ----------------------------- Roteador ------------------------------ */
  .hj-rot-wrap {
    margin-top: var(--sp-6);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--line-soft);
    text-align: center;
  }
  .hj-rot-chamada { font-weight: 700; margin-bottom: var(--sp-3); }
  .hj-rot-micro { margin-top: var(--sp-2); font-size: var(--step--1); color: var(--muted); }
  .hj-rot { margin-top: var(--sp-5); }
  .hj-rot-box {
    max-width: 620px;
    margin-inline: auto;
    text-align: left;
    background: #fff;
    border: 2px solid var(--brand-600);
    border-radius: var(--radius-lg);
    padding: var(--sp-5);
    box-shadow: var(--shadow-lg);
  }
  .hj-rot-passo {
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .hj-rot-pergunta { margin-top: var(--sp-2); font-size: var(--step-1); line-height: 1.25; }
  .hj-rot-opcoes { display: grid; gap: var(--sp-2); margin-top: var(--sp-4); }
  .hj-rot-opcao {
    text-align: left;
    padding: 0.85rem 1rem;
    border: 2px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
    font: inherit;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
    min-height: 52px;
  }
  .hj-rot-opcao:hover { border-color: var(--accent); background: var(--accent-50); }
  .hj-rot-voltar {
    margin-top: var(--sp-4);
    background: none;
    border: 0;
    font: inherit;
    font-size: var(--step--1);
    color: var(--muted);
    text-decoration: underline;
    cursor: pointer;
    padding: 0.4rem 0;
    min-height: 44px;
    display: block;
  }
  .hj-rot-rotulo {
    font-size: var(--step--1);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-600);
  }
  .hj-rot-titulo { margin-top: var(--sp-2); font-size: var(--step-2); line-height: 1.2; }
  .hj-rot-etapa { margin-top: var(--sp-2); font-size: var(--step--1); color: var(--muted); font-weight: 600; }
  .hj-rot-porque { margin-top: var(--sp-3); line-height: 1.65; }
  .hj-rot-resultado .btn { margin-top: var(--sp-4); }

  /* -------------------------- Meu Mapa do Treino ----------------------- */
  .hj-mapa-box {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--sp-6);
    box-shadow: var(--shadow);
  }
  .hj-mapa-titulo { font-size: var(--step-2); }
  .hj-mapa-sub { margin-top: var(--sp-2); color: var(--muted); }
  .hj-mapa-lista {
    margin: var(--sp-5) 0 0;
    display: grid;
    gap: var(--sp-3);
  }
  @media (min-width: 700px) {
    .hj-mapa-lista { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .hj-mapa-item {
    border-left: 3px solid var(--accent);
    padding-left: var(--sp-4);
  }
  .hj-mapa-item dt {
    font-size: var(--step--1);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 700;
  }
  .hj-mapa-item dd { margin: 0.15rem 0 0; font-weight: 700; font-size: var(--step-0); }

  .hj-mapa-etapas {
    list-style: none;
    padding: 0;
    margin: var(--sp-5) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-4);
  }
  .hj-etapa { display: inline-flex; align-items: center; gap: 0.4rem; font-size: var(--step--1); color: var(--muted); }
  .hj-etapa-marca { font-weight: 800; }
  .hj-etapa--feita { color: var(--ink); font-weight: 700; }
  .hj-etapa--feita .hj-etapa-marca { color: #1f8a54; }

  .hj-continue {
    margin-top: var(--sp-6);
    padding: var(--sp-5);
    border-radius: var(--radius);
