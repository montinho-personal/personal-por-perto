---
/**
 * Central de Ferramentas do portal — /ferramentas/.
 *
 * O QUE ESTA PÁGINA É, E O QUE ELA DEIXOU DE SER
 *
 * Nasceu como o Meu Mapa do Treino: uma jornada de sete etapas sobre
 * treino e acompanhamento. Funcionava para sete ferramentas; com 24 (as
 * calculadoras de calorias ficaram de fora dela por não serem etapa da
 * jornada) virou uma página que mostrava menos de um terço do que o
 * portal tem. Agora ela é uma BIBLIOTECA: responde "que ferramenta resolve
 * a minha dúvida?" para quem sabe o que quer, e mantém o Mapa como
 * experiência guiada para quem não sabe por onde começar.
 *
 * Tudo sai do catálogo em src/data/ferramentas.ts: cards, filtros, busca,
 * schema. Publicar uma ferramenta é acrescentar a entrada lá.
 *
 * O QUE É HTML E O QUE É JAVASCRIPT
 *
 * Todos os cards, todos os links e todas as seções estão no HTML: sem JS a
 * página é a biblioteca inteira, rastreável, com as calculadoras de
 * calorias extras atrás de um <details>. O JS acrescenta a busca por
 * intenção, os filtros, o roteador de quatro perguntas e o mapa salvo no
 * navegador — nenhum dos quatro esconde conteúdo de quem não o tem.
 */
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaMontinho from '../../components/CtaMontinho.astro';
import Card from '../../components/FerramentaCard.astro';
import { breadcrumbSchema, itemListSchema } from '../../lib/schema';
import { site } from '../../data/site';
import { CATEGORIAS, catalogo, destaques, porCategoria } from '../../data/ferramentas';
import { rotas } from '../../lib/links';
import { ETAPAS } from '../../lib/jornada';
import { formatDateLong } from '../../lib/slug';

const path = '/ferramentas';
const atualizadoEm = '2026-09-23';

const crumbs = [
  { nome: 'Início', url: '/' },
  { nome: 'Ferramentas', url: path },
];

const total = catalogo.length;
const DESTAQUES = destaques();

/* 55 caracteres. */
const title = 'Ferramentas Fitness Grátis: Treino, Calorias e Personal';
/* 153 caracteres com 24 ferramentas. */
const description = `${total} calculadoras e diagnósticos gratuitos: organize o treino, estime as calorias de cada atividade, escolha um personal e veja quanto custa. Sem cadastro.`;

const urlCanonica = new URL(path + '/', site.dominio).href;

const schema = [
  breadcrumbSchema(crumbs),
  {
    '@type': 'CollectionPage',
    '@id': `${urlCanonica}#webpage`,
    url: urlCanonica,
    name: 'Ferramentas do Personal por Perto',
    description,
    inLanguage: site.idioma,
    dateModified: atualizadoEm,
    isPartOf: { '@id': `${site.dominio}/#website` },
  },
  itemListSchema(
    'Ferramentas e calculadoras do Personal por Perto',
    catalogo.map((f) => f.nome),
    site.dominio,
    catalogo.map((f) => new URL(f.url, site.dominio).href),
  ),
];

/* Exemplos de busca: as dúvidas mais buscadas no portal, na forma em que aparecem no Search Console. */
const EXEMPLOS = ['quanto custa um personal', 'não consigo manter a academia', 'calorias correndo', 'personal online vale a pena'];

---

<Base title={title} description={description} path={path} schema={schema}>
  <Breadcrumbs crumbs={crumbs} />

  <!-- Ícones: um sistema só, um símbolo por categoria. -->
  <!-- `hidden` não vale para elemento SVG: sem o display:none ele ocupa 300×150. -->
  <svg aria-hidden="true" focusable="false" style="display:none">
    <symbol id="fh-i-treino" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 9v6M3 10.5v3M18 9v6M21 10.5v3M6 12h12" />
    </symbol>
    <symbol id="fh-i-personal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="10" cy="8" r="3.5" /><path d="M3.5 20a6.5 6.5 0 0 1 13 0M15.5 12.5l2 2 3.5-4" />
    </symbol>
    <symbol id="fh-i-calorias" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3c1 3 4 4.5 4 9a4 4 0 0 1-8 0c0-2 1-3 1.5-4 .5 1.5 1.5 2 2.5 2 0-2-.5-4 0-7z" />
    </symbol>
    <symbol id="fh-i-mapa" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="9" /><path d="m15.5 8.5-2 5-5 2 2-5z" />
    </symbol>
  </svg>

  <!-- ============================= HERO ============================= -->
  <header class="section-sm fh-hero">
    <div class="container">
      <p class="eyebrow">Ferramentas do portal · grátis, sem cadastro</p>
      <h1>Calculadoras e ferramentas fitness gratuitas</h1>
      <p class="lead fh-lead">
        {total} ferramentas para organizar o treino, estimar as calorias de cada atividade, escolher
        um personal e saber quanto ele custa. Resultado na hora, método aberto, nada de e-mail.
      </p>

      <form class="fh-busca" role="search" id="fh-form" autocomplete="off" aria-label="Buscar ferramenta">
        <label for="fh-busca" class="fh-busca-rotulo">O que você quer descobrir?</label>
        <div class="fh-busca-linha">
          <input
            id="fh-busca"
            type="search"
            name="q"
            placeholder="Busque uma dúvida ou ferramenta…"
            aria-describedby="fh-busca-dica"
            enterkeyhint="search"
          />
          <button type="submit" class="btn btn-primary fh-busca-btn">Buscar</button>
        </div>
        <p id="fh-busca-dica" class="fh-busca-dica">
          Ex.:{' '}
          {EXEMPLOS.map((e, i) => (
            <>
              <button type="button" class="fh-exemplo" data-exemplo={e}>{e}</button>{i < EXEMPLOS.length - 1 ? ' · ' : ''}
            </>
          ))}
        </p>
      </form>

      <div class="fh-chips" role="group" aria-label="Filtrar ferramentas por necessidade">
        <button type="button" class="fh-chip is-ativo" data-cat="todos" aria-pressed="true">
          Todas <span class="fh-chip-n">{total}</span>
        </button>
        {CATEGORIAS.map((c) => (
          <button type="button" class="fh-chip" data-cat={c.id} aria-pressed="false">
            {c.nome} <span class="fh-chip-n">{porCategoria(c.id).length}</span>
          </button>
        ))}
      </div>
      <p id="fh-status" class="sr-only" role="status" aria-live="polite"></p>
    </div>
  </header>

  <!-- ===================== RESULTADOS DA BUSCA (JS) ================== -->
  <section class="section-sm fh-resultados" id="fh-resultados" hidden aria-labelledby="fh-resultados-h">
    <div class="container">
      <h2 id="fh-resultados-h" class="fh-h2">Resultados</h2>
      <div class="fh-grade" id="fh-resultados-lista"></div>
      <div class="fh-zero" id="fh-zero" hidden>
        <p class="fh-zero-titulo">Não encontramos uma ferramenta exatamente para isso.</p>
        <p class="fh-zero-texto">
          Estas são as mais próximas do que costuma ser procurado — ou busque o assunto no conteúdo do portal.
        </p>
        <div class="fh-grade" id="fh-zero-lista"></div>
        <div class="fh-zero-acoes">
          <a class="btn btn-secondary" id="fh-zero-portal" href={rotas.cidades}>Buscar no conteúdo do portal</a>
          <button type="button" class="fh-limpar" id="fh-limpar">Limpar a busca</button>
        </div>
      </div>
    </div>
  </section>

  <div id="fh-biblioteca">
    <!-- ========================= MEU MAPA DO TREINO ==================== -->
    <!-- Primeiro bloco da biblioteca, de propósito: quem não sabe o nome
         da ferramenta que precisa também não sabe que "categoria" procurar,
         e é essa pessoa que mais precisa de ajuda logo na chegada. Quem já
         sabe o que quer já resolveu no campo de busca, no hero, antes de
         rolar até aqui — o Mapa não atrapalha esse caminho. -->
    <section class="section-sm tint fh-mapa" id="mapa-do-treino" aria-labelledby="mapa-h">
      <div class="container">
        <div class="fh-mapa-box">
          <div class="fh-mapa-cab">
            <svg class="fh-mapa-ico" aria-hidden="true"><use href="#fh-i-mapa" /></svg>
            <div>
              <p class="eyebrow">Não sabe por onde começar?</p>
              <h2 id="mapa-h" class="fh-h2">Faça o Meu Mapa do Treino</h2>
              <p class="fh-mapa-sub">
                Quatro perguntas indicam qual ferramenta usar primeiro. Cada resultado sugere a etapa
                seguinte já com o seu contexto, sem perguntar de novo o que você acabou de responder.
              </p>
            </div>
          </div>
          <ol class="fh-etapas" aria-label="As sete etapas do Mapa do Treino">
            {ETAPAS.map((e) => <li>{e.nome}</li>)}
          </ol>
          <div class="fh-mapa-acoes">
            <button type="button" class="btn btn-primary" id="hj-abrir-roteador">
              Descobrir meu próximo passo&nbsp;→
            </button>
            <p class="fh-mapa-micro">Serve só para indicar por onde começar. Nada é guardado fora do seu navegador.</p>
          </div>
          <div id="hj-roteador" class="hj-rot" hidden></div>
          <noscript>
            <p class="fh-mapa-micro">
              O roteador precisa de JavaScript. Sem ele, as sete etapas estão nas seções abaixo, na
              ordem em que aparecem em "Organizar e avaliar o treino" e "Escolher, pagar e avaliar um personal".
            </p>
          </noscript>
        </div>
        <div id="hj-mapa" hidden></div>
      </div>
    </section>

    <!-- =========================== DESTAQUES ========================== -->
    <section class="section-sm fh-secao" id="destaques" data-cat="destaques" aria-labelledby="destaques-h">
      <div class="container">
        <div class="fh-secao-cab">
          <h2 id="destaques-h" class="fh-h2">Comece por estas</h2>
          <p class="fh-secao-sub">
            Seleção editorial: as ferramentas que respondem às dúvidas mais buscadas no portal, a começar
            por preço de personal, a consulta mais frequente do Search Console.
          </p>
        </div>
        <div class="fh-grade">
          {DESTAQUES.map((f, i) => <Card f={f} pos={i + 1} origem="destaques" />)}
        </div>
      </div>
    </section>

    <!-- =========================== CATEGORIAS ========================= -->
    {CATEGORIAS.map((c) => {
      const lista = porCategoria(c.id);
      const abertas = lista.slice(0, c.mostrarNoHub);
      const mais = lista.slice(c.mostrarNoHub);
      return (
        <section class="section-sm fh-secao" id={`cat-${c.id}`} data-cat={c.id} aria-labelledby={`cat-${c.id}-h`}>
          <div class="container">
            <div class="fh-secao-cab">
              <h2 id={`cat-${c.id}-h`} class="fh-h2">{c.titulo}</h2>
              <p class="fh-secao-sub">{c.descricao}</p>
            </div>
            <div class="fh-grade">
              {abertas.map((f, i) => <Card f={f} pos={i + 1} origem="categoria" />)}
            </div>
            {mais.length > 0 && (
              <details class="fh-mais" id={`mais-${c.id}`}>
                <summary>
                  <span class="fh-mais-rotulo">Mais {mais.length} {mais.length === 1 ? 'atividade' : 'atividades'}</span>
                  <span class="fh-mais-lista" aria-hidden="true">{mais.map((f) => f.nomeCurto).join(' · ')}</span>
                </summary>
                <div class="fh-grade fh-grade-mais">
                  {mais.map((f, i) => <Card f={f} pos={abertas.length + i + 1} origem="mais" />)}
                </div>
              </details>
            )}
            {c.hub && (
              <p class="fh-secao-rodape">
                <a href={c.hub}>Ver todas as {lista.length} calculadoras de calorias, com exemplos →</a>
              </p>
            )}
          </div>
        </section>
      );
    })}
  </div>

  <!-- ========================= NÃO ENCONTROU ========================= -->
  <section class="section-sm tint" aria-labelledby="nao-encontrou-h">
    <div class="container fh-nao">
      <h2 id="nao-encontrou-h" class="fh-h2">Não encontrou o que queria?</h2>
      <p class="fh-secao-sub">
        Nem toda dúvida vira ferramenta. O conteúdo do portal cobre o resto: guias de contratação,
        treino e emagrecimento, e o panorama de personal trainer em cada cidade.
      </p>
      <form class="fh-busca-portal" action={rotas.cidades} method="get" role="search" aria-label="Buscar no conteúdo do portal">
        <label for="fh-busca-portal" class="sr-only">Buscar cidade ou assunto no portal</label>
        <input id="fh-busca-portal" type="search" name="q" placeholder="Buscar cidade ou assunto…" />
        <button type="submit" class="btn btn-secondary">Buscar</button>
      </form>
      <ul class="fh-nao-links">
        <li><a href={rotas.guias} data-artigo="guias">Guias de contratação</a></li>
        <li><a href={rotas.musculacao} data-artigo="musculacao">Musculação</a></li>
        <li><a href={rotas.emagrecimento} data-artigo="emagrecimento">Emagrecimento</a></li>
        <li><a href={rotas.cidades} data-artigo="cidades">Personal trainer por cidade</a></li>
      </ul>
    </div>
  </section>

  <!-- ======================= COMO SÃO FEITAS ========================= -->
  <section class="section-sm" aria-labelledby="como-h">
    <div class="container">
      <article class="prose fh-artigo">
        <p class="fh-atualizado">Atualizado em {formatDateLong(atualizadoEm)}</p>
        <h2 id="como-h">Como estas ferramentas são feitas</h2>
        <p>
          Nenhuma delas sorteia resposta nem usa inteligência artificial para inventar texto. São
          determinísticas: as mesmas entradas produzem sempre o mesmo resultado, calculado por regras
          descritas na própria página de cada ferramenta. Nas calculadoras de calorias, a fórmula fica
          visível e a fonte de cada número é citada — inclusive quando o valor foi interpolado em vez
          de medido, e a página diz isso.
        </p>
        <p>
          <strong>São gratuitas e não pedem cadastro</strong> porque bloquear resultado atrás de
          formulário transforma ajuda em isca. O resultado completo aparece na hora, sem e-mail nem
          telefone. A única informação opcional é a cidade, usada para dizer se o atendimento
          presencial é viável no seu caso — e dá para pular.
        </p>
        <p>
          <strong>O que fica no seu navegador fica só nele.</strong> O Mapa do Treino guarda o que
          você respondeu — frequência, objetivo, gargalo, formato — no seu próprio aparelho, para a
          ferramenta seguinte não perguntar de novo. Nada é enviado para servidor, e o botão de apagar
          está sempre à vista.
        </p>
        <p>
          <strong>O que elas não fazem:</strong> não prescrevem treino, não fazem avaliação física,
          não diagnosticam nada e não substituem a orientação individual de um profissional. Quem tem
          dor, lesão ou alguma condição de saúde deve conversar com um médico ou fisioterapeuta antes
          de começar a treinar — e levar essa orientação para quem for acompanhar.
        </p>
        <p>
          O portal é mantido por um profissional que atende presencialmente na região de Alphaville e
          online no Brasil inteiro. Quando o seu perfil combina com esse trabalho, isso aparece no
          resultado; quando não combina, a ferramenta diz isso com todas as letras. Essa é a troca: a
          ferramenta precisa ser útil mesmo para quem nunca vai contratar nada. Os critérios estão em
          <a href={rotas.comoAvaliamos}>Como avaliamos</a>.
        </p>
      </article>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <CtaMontinho variante="destaque" />
    </div>
  </section>

  <script>
    import { iniciarCentral } from '../../scripts/hubFerramentas.client';
    import { iniciarHub } from '../../scripts/hubJornada.client';
    iniciarCentral();
    iniciarHub();
  </script>
</Base>

<style>
  .fh-hero { padding-block-end: var(--sp-5); }
  .fh-hero h1 { max-width: 20ch; }
  .fh-lead { max-width: 60ch; }

  /* ------------------------------ Busca ------------------------------ */
  .fh-busca { margin-top: var(--sp-5); max-width: 720px; }
  .fh-busca-rotulo { display: block; font-weight: 700; margin-bottom: var(--sp-2); }
  .fh-busca-linha { display: flex; gap: var(--sp-2); }
  .fh-busca input[type='search'] {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 52px;
    padding: 0.7rem 1rem;
    font: inherit;
    font-size: var(--step-0);
    border: 2px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
    color: var(--ink);
    -webkit-appearance: none;
    appearance: none;
  }
  .fh-busca input:focus-visible { outline: 3px solid var(--accent); outline-offset: 1px; border-color: var(--brand-600); }
  .fh-busca-btn { min-height: 52px; flex-shrink: 0; }
  .fh-busca-dica { margin-top: var(--sp-2); font-size: var(--step--1); color: var(--muted); line-height: 1.7; }
  .fh-exemplo {
    background: none;
    border: 0;
    padding: 0.15rem 0;
    font: inherit;
    font-size: inherit;
    color: var(--brand-600);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    cursor: pointer;
  }
  .fh-exemplo:hover { color: var(--accent-600); }

  /* ------------------------------ Chips ------------------------------ */
  .fh-chips {
    display: flex;
    gap: var(--sp-2);
    margin-top: var(--sp-5);
    overflow-x: auto;
    padding-bottom: 4px;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .fh-chips::-webkit-scrollbar { display: none; }
  .fh-chip {
    flex: 0 0 auto;
    scroll-snap-align: start;
    min-height: 44px;
    padding: 0.5rem 1rem;
    border: 2px solid var(--line);
    border-radius: 999px;
    background: #fff;
    font: inherit;
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--ink-soft);
    cursor: pointer;
    white-space: nowrap;
  }
  .fh-chip:hover { border-color: var(--brand-600); color: var(--ink); }
  .fh-chip.is-ativo { background: var(--brand-600); border-color: var(--brand-600); color: #fff; }
  .fh-chip:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  .fh-chip-n { font-weight: 600; opacity: 0.75; margin-left: 0.15rem; }

  /* ---------------------------- Seções ------------------------------- */
  .fh-h2 { font-size: var(--step-2); }
  .fh-secao-cab { max-width: 70ch; margin-bottom: var(--sp-5); }
  .fh-secao-sub { margin-top: var(--sp-2); color: var(--muted); line-height: 1.6; }
  .fh-secao-rodape { margin-top: var(--sp-5); font-weight: 700; }
  .fh-grade { display: grid; gap: var(--sp-4); }
  @media (min-width: 640px) { .fh-grade { grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); } }

  /* ---------------------------- "Mais" ------------------------------- */
  .fh-mais { margin-top: var(--sp-4); border: 1px dashed var(--line); border-radius: var(--radius); }
  .fh-mais summary {
    cursor: pointer;
    padding: var(--sp-4) var(--sp-5);
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem var(--sp-4);
    align-items: baseline;
    min-height: 48px;
  }
  .fh-mais summary::-webkit-details-marker { display: none; }
  .fh-mais summary::before { content: '+'; font-weight: 800; color: var(--accent-600); margin-right: 0.25rem; }
  .fh-mais[open] summary::before { content: '–'; }
  .fh-mais summary:focus-visible { outline: 3px solid var(--accent); outline-offset: -3px; border-radius: var(--radius); }
  .fh-mais-rotulo { font-weight: 700; }
  .fh-mais-lista { font-size: var(--step--1); color: var(--muted); }
  .fh-grade-mais { padding: 0 var(--sp-5) var(--sp-5); }

  /* ------------------------------ Mapa ------------------------------- */
  .fh-mapa-box {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--sp-6);
    box-shadow: var(--shadow-sm);
  }
  .fh-mapa-cab { display: flex; gap: var(--sp-4); align-items: flex-start; }
  .fh-mapa-ico { flex-shrink: 0; width: 44px; height: 44px; color: var(--accent-600); margin-top: 0.2rem; }
  .fh-mapa-sub { margin-top: var(--sp-2); color: var(--ink-soft); line-height: 1.6; max-width: 62ch; }
  .fh-etapas {
    list-style: none;
    padding: 0;
    margin: var(--sp-5) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0;
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--ink-soft);
    counter-reset: etapa;
  }
  .fh-etapas li { display: inline-flex; align-items: center; counter-increment: etapa; }
  .fh-etapas li::before {
    content: counter(etapa);
    width: 22px; height: 22px; border-radius: 50%;
    background: var(--brand-700); color: #fff;
    font-size: 0.75rem; display: inline-flex; align-items: center; justify-content: center;
    margin-right: 0.4rem;
  }
  .fh-etapas li + li::before { margin-left: 0; }
  .fh-etapas li:not(:last-child)::after { content: '→'; color: var(--muted); font-weight: 400; margin: 0 0.6rem; }
  .fh-mapa-acoes { margin-top: var(--sp-5); display: flex; flex-wrap: wrap; gap: var(--sp-3) var(--sp-5); align-items: center; }
  .fh-mapa-micro { font-size: var(--step--1); color: var(--muted); line-height: 1.5; max-width: 48ch; }
  @media (max-width: 480px) { .fh-mapa-acoes .btn { width: 100%; } }

  /* ----------------------------- Zero ------------------------------- */
  .fh-zero-titulo { font-weight: 750; font-size: var(--step-1); }
  .fh-zero-texto { margin: var(--sp-2) 0 var(--sp-5); color: var(--muted); }
  .fh-zero-acoes { margin-top: var(--sp-5); display: flex; flex-wrap: wrap; gap: var(--sp-3); align-items: center; }
  .fh-limpar { background: none; border: 0; font: inherit; color: var(--muted); text-decoration: underline; cursor: pointer; min-height: 44px; padding: 0 0.5rem; }

  /* -------------------------- Não encontrou -------------------------- */
  .fh-nao { max-width: 760px; }
  .fh-busca-portal { display: flex; gap: var(--sp-2); margin-top: var(--sp-4); max-width: 560px; }
