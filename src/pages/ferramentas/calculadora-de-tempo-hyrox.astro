---
/**
 * Calculadora de tempo do Hyrox — o pace que a meta pede, e o tempo final
 * que o pace dá.
 *
 * A PERGUNTA
 * "Para fazer o Hyrox em 1h30, em que pace eu corro?" A prova é sempre a
 * mesma — 8 × 1 km de corrida, cada um seguido de uma estação —, então o
 * tempo final é corrida + estações. O motor (lib/corrida/tempoHyrox.ts)
 * não inventa o tempo das estações: usa o da pessoa ou a proporção medida
 * no estudo com atletas amadores (Brandt et al. 2025).
 *
 * DO GOOGLE, 27/10 (prints do Renato, em
 * docs/pesquisas/2026-10-27-tempo-hyrox/prints/, 01 a 08) e AnswerThePublic
 * de "tempo hyrox" (mesma pasta): o autocompletar pede tempo por categoria
 * (dupla, pro, open) e "tempo médio"; "As pessoas também perguntam": quanto
 * tempo dura um Hyrox, qual o melhor tempo, o pace 7 é ruim?, qual o
 * recorde. Um concorrente já ranqueia com uma calculadora de tempo — o
 * formato é o que a busca pede. A visão geral de IA traz médias por
 * categoria citando blogs: NÃO é fonte, e esses números não entram.
 * Registro em docs/calculadora-de-tempo-hyrox.md.
 */
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import Sidebar from '../../components/Sidebar.astro';
import AutorMontinho from '../../components/AutorMontinho.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import { breadcrumbSchema, articleSchema, faqSchema, personMontinhoSchema } from '../../lib/schema';
import { formatDateLong } from '../../lib/slug';
import { site } from '../../data/site';
import { whatsappUrl } from '../../lib/links';
import {
  BRANDT_CORRIDA_MIN,
  BRANDT_ESTACOES_MIN,
  BRANDT_SLED_PULL_S,
  BRANDT_SLED_PUSH_S,
  BRANDT_TOTAL_MIN,
  FONTES,
  HYSCIENCE_ROXZONE,
  HYSCIENCE_TOTAL_S,
  HYSCIENCE_V1,
  HYSCIENCE_V8,
  NOTA_ESTIMATIVA,
  PARTE_ESTACOES,
  estacoesPelaMeta,
  estacoesPeloPace,
  formataPace,
  formataTempo,
  formataTempoExtenso,
  frasePlano,
  paceParaMeta,
  tempoPeloPace,
  type Plano,
} from '../../lib/corrida/tempoHyrox';

const path = '/ferramentas/calculadora-de-tempo-hyrox';
const atualizadoEm = '2026-10-27';

const crumbs = [
  { nome: 'Início', url: '/' },
  { nome: 'Ferramentas', url: '/ferramentas/' },
  { nome: 'Calculadora de tempo do Hyrox', url: path },
];

/* ── Exemplos resolvidos no servidor, pelo mesmo motor da calculadora ── */
const ok = (r: ReturnType<typeof paceParaMeta>): Plano => {
  if (!r.ok) throw new Error(r.mensagem);
  return r;
};
const META_MIN = 90;
const EX = ok(paceParaMeta(META_MIN * 60, estacoesPelaMeta(META_MIN * 60)));
const EX_QUEDA = ok(paceParaMeta(META_MIN * 60, estacoesPelaMeta(META_MIN * 60), true));
const METAS = [60, 70, 75, 80, 90, 100, 110, 120].map((m) => ok(paceParaMeta(m * 60, estacoesPelaMeta(m * 60))));
const PACES = [300, 360, 420, 480].map((p) => ok(tempoPeloPace(p, estacoesPeloPace(p))));
const PACE7 = PACES[2];
/** Quanto o pace 7 fica acima da mediana dos amadores, em segundos. */
const PACE7_ACIMA = PACE7.tempoFinal - BRANDT_TOTAL_MIN * 60;
const pct = (x: number) => `${Math.round(x * 100)}%`;
const min = (x: number) => x.toLocaleString('pt-BR', { maximumFractionDigits: 1 });
const kmh = (x: number) => x.toLocaleString('pt-BR', { maximumFractionDigits: 2 });

/* 56 caracteres. "tempo hyrox" e "tempo médio" vêm do autocompletar (27/10). */
const title = 'Calculadora de Tempo do Hyrox: Pace da Meta e Tempo Médio';
/* 152 caracteres. */
const description =
  'Calculadora de tempo do Hyrox: o pace que a sua meta pede, o tempo final pelo seu pace, as parciais da prova e quanto dura um Hyrox, segundo os estudos.';

const faqs = [
  {
    pergunta: 'Quanto tempo dura um Hyrox?',
    resposta: `Depende do nível. No primeiro estudo sobre a prova, 11 atletas amadores fizeram uma simulação da categoria Open individual em ${min(BRANDT_TOTAL_MIN)} minutos (mediana), com ${min(BRANDT_CORRIDA_MIN)} minutos de corrida e ${min(BRANDT_ESTACOES_MIN)} de estações. Num grupo de 24 atletas Pro masculino, numa etapa oficial, o tempo médio foi de ${formataTempo(HYSCIENCE_TOTAL_S)}.`,
  },
  {
    pergunta: 'O pace 7 é ruim no Hyrox?',
    resposta: `Não. Correndo os 8 km a 7:00 por km, a corrida leva ${formataTempoExtenso(PACE7.corrida)}. Com as estações na proporção do estudo com atletas amadores (${formataTempoExtenso(PACE7.estacoes)}), a prova fecha perto de ${formataTempo(PACE7.tempoFinal)} — cerca de ${Math.round(PACE7_ACIMA / 60)} minutos acima da mediana de ${min(BRANDT_TOTAL_MIN)} minutos daquele grupo, que já treinava Hyrox havia mais de um ano. Para a primeira prova, terminar bem é mais importante que o ritmo.`,
  },
  {
    pergunta: 'Qual é um bom tempo no Hyrox?',
    resposta: `Bom é o tempo que você consegue sustentar até a wall ball. Como referência dos estudos: ${min(BRANDT_TOTAL_MIN)} minutos foi a mediana de atletas amadores numa simulação, e ${formataTempo(HYSCIENCE_TOTAL_S)}, a média de atletas Pro masculino numa etapa oficial. Médias por categoria que circulam na internet não têm fonte oficial que pudéssemos conferir, por isso não estão aqui.`,
  },
  {
    pergunta: 'Qual o recorde e o melhor tempo do Hyrox?',
    resposta: 'Os recordes mudam a cada temporada e ficam no ranking oficial da Hyrox. Como não conseguimos conferir a fonte oficial, não reproduzimos números de recorde aqui — os que aparecem em resumos de busca citam blogs, não o ranking.',
  },
  {
    pergunta: 'Qual o tempo médio do Hyrox em dupla, Open e Pro?',
    resposta: `Não há estudo publicado com a média de cada categoria. Os dois que existem são de atletas amadores numa simulação da categoria Open individual (${min(BRANDT_TOTAL_MIN)} minutos) e de atletas Pro masculino numa etapa oficial (${formataTempo(HYSCIENCE_TOTAL_S)}). Para dupla, onde as estações são divididas, a calculadora funciona do mesmo jeito: informe o tempo que a dupla leva nas estações.`,
  },
  {
    pergunta: 'Quanto tempo leva cada estação do Hyrox?',
    resposta: `No estudo com atletas amadores, as estações de carga mais pesada foram as mais rápidas: o sled push levou ${BRANDT_SLED_PUSH_S} segundos e o sled pull, ${BRANDT_SLED_PULL_S} segundos (medianas). As oito estações somaram ${min(BRANDT_ESTACOES_MIN)} minutos. A calculadora divide o tempo das estações em partes iguais, porque não há dado publicado de cada uma.`,
  },
  {
    pergunta: 'O ritmo de corrida cai ao longo da prova?',
    resposta: `Cai. Em atletas Pro masculino, numa etapa oficial, a velocidade passou de ${kmh(HYSCIENCE_V1)} km/h na primeira corrida para ${kmh(HYSCIENCE_V8)} km/h na oitava. Marque "ritmo que cai" na calculadora para ver as parciais com essa queda: para uma meta de 1h30, a 1ª corrida sai a ${formataPace(EX_QUEDA.pacePrimeira)} por km e a 8ª, a ${formataPace(EX_QUEDA.paceUltima)}.`,
  },
  {
    pergunta: 'A Roxzone entra na conta?',
    resposta: `Entra, dentro de "estações e transições". A Roxzone é a área de passagem entre a corrida e cada estação, e ali se anda ou corre devagar: na etapa estudada com atletas Pro, a velocidade nela foi de ${kmh(HYSCIENCE_ROXZONE)} km/h, a mais baixa da prova.`,
  },
  {
    pergunta: 'A calculadora de tempo do Hyrox é gratuita?',
    resposta: 'É, sem cadastro. A conta acontece no seu navegador e nada do que você digita é enviado.',
  },
];

const relacionados = [
  {
    url: '/guias/treino-hyrox/',
    titulo: 'Treino de Hyrox',
    descricao: 'Corrida, força e treinos combinados: como a semana se organiza.',
    tipo: 'Guia',
  },
  {
    url: '/guias/o-que-e-hyrox/',
    titulo: 'O que é Hyrox',
    descricao: 'As 8 estações, os pesos de cada categoria, quanto tempo dura e quanto custa.',
    tipo: 'Guia',
  },
  {
    url: '/calorias/hyrox/',
    titulo: 'Quantas calorias gasta uma prova de Hyrox?',
    descricao: 'O gasto da prova pelo seu tempo e pace, corrida e estações separadas.',
    tipo: 'Calculadora',
  },
  {
    url: '/ferramentas/calculadora-de-pace/',
    titulo: 'Calculadora de pace',
    descricao: 'Pace, tempo e velocidade da esteira para qualquer distância.',
    tipo: 'Ferramenta',
  },
];

const whatsHyrox = whatsappUrl(
  'Oi, Montinho! Vim pela calculadora de tempo do Hyrox do Personal por Perto e queria saber sobre a preparação para a prova.',
);

const schema = [
  breadcrumbSchema(crumbs),
  articleSchema({ titulo: title, descricao: description, url: new URL(path, site.dominio).href, atualizadoEm }),
  faqSchema(faqs),
  personMontinhoSchema(),
];

/* Linhas curtas: a fórmula precisa caber em 320px. */
const formula = `tempo final =
corrida (8 km × pace)
+ estações e transições

pace = (meta − estações) ÷ 8

estações em branco:
${pct(PARTE_ESTACOES)} do tempo final,
como no estudo com amadores`;
---

<Base title={title} description={description} path={path} ogType="article" schema={schema}>
  <Breadcrumbs crumbs={crumbs} />

  <header class="th-hero">
    <div class="container th-hero-inner">
      <p class="eyebrow">Ferramenta · Hyrox</p>
      <h1>Calculadora de tempo do Hyrox: o pace que a sua meta pede</h1>
      <p class="th-hero-lead">
        Informe a meta de tempo e veja em que pace correr os 8 km — ou informe o seu pace e veja
        em quanto termina. Para fazer a prova em 1h30, com as estações na proporção medida em atletas
        amadores, o pace médio é <strong>{formataPace(EX.pace)} por km</strong>.
      </p>
      <p class="th-micro">Grátis · sem cadastro · a conta acontece no seu navegador</p>
    </div>
  </header>

  <div class="container th-layout">
    <article class="th-main">
      <section id="th-app" class="th-app" aria-labelledby="th-app-h">
        <h2 id="th-app-h" class="th-app-h">Calcule o seu tempo</h2>

        <div class="th-campos">
          <div class="th-campo">
            <span class="th-rotulo" id="th-modo-rotulo">O que você quer descobrir?</span>
            <div class="th-presets" role="group" aria-labelledby="th-modo-rotulo">
              <button type="button" class="th-preset th-modo is-ativo" data-modo="meta" aria-pressed="true">
                O pace para a minha meta
              </button>
              <button type="button" class="th-preset th-modo" data-modo="pace" aria-pressed="false">
                O tempo final pelo meu pace
              </button>
            </div>
          </div>

          <div class="th-campo" data-so="meta">
            <span class="th-rotulo">Meta de tempo final</span>
            <div class="th-duplo">
              <label class="th-sub"><input id="th-meta-h" type="text" inputmode="numeric" autocomplete="off" value="1" aria-label="Horas" /> h</label>
              <label class="th-sub"><input id="th-meta-m" type="text" inputmode="numeric" autocomplete="off" value="30" aria-label="Minutos" /> min</label>
            </div>
          </div>

          <div class="th-campo" data-so="pace" hidden>
            <span class="th-rotulo">Pace médio de corrida (por km)</span>
            <div class="th-duplo">
              <label class="th-sub"><input id="th-pace-m" type="text" inputmode="numeric" autocomplete="off" value="7" aria-label="Minutos por km" /> min</label>
              <label class="th-sub"><input id="th-pace-s" type="text" inputmode="numeric" autocomplete="off" value="00" aria-label="Segundos" /> s</label>
            </div>
          </div>

          <div class="th-campo">
            <label for="th-estacoes">Estações e transições, somadas (minutos)</label>
            <input id="th-estacoes" type="text" inputmode="numeric" autocomplete="off" placeholder="em branco: proporção do estudo" />
            <p class="th-dica">
              O tempo das 8 estações mais a Roxzone. Se você já fez uma prova ou um simulado, use o seu. Em
              branco, a conta usa a proporção medida em atletas amadores: {pct(PARTE_ESTACOES)} do tempo final.
            </p>
          </div>

          <label class="th-check">
            <input id="th-queda" type="checkbox" />
            Ritmo que cai ao longo da prova (como no estudo com atletas Pro)
          </label>
        </div>

        <p id="th-erro" class="th-erro" role="status" hidden></p>

        <div id="th-saida" class="th-saida" role="status" aria-live="polite">
          <p class="th-resultado">
            <span class="th-numero">{formataPace(EX.pace)}</span>
            <span class="th-unidade">por km, em média</span>
          </p>
          <p class="th-frase">{frasePlano(EX)}</p>
          <p class="th-origem">
            Estações e transições: {formataTempoExtenso(EX.estacoes)}, pela proporção do estudo com atletas
            amadores. Se você já sabe o seu tempo nas estações, digite no campo acima.
          </p>

          <dl class="th-detalhes">
            <div><dt>Corrida (8 km)</dt><dd class="th-d-corrida">{formataTempo(EX.corrida)}</dd></div>
            <div><dt>Estações e transições</dt><dd class="th-d-estacoes">{formataTempo(EX.estacoes)}</dd></div>
            <div><dt>Por estação</dt><dd class="th-d-por">{formataTempo(EX.porEstacao)}</dd></div>
            <div><dt>Velocidade média</dt><dd class="th-d-kmh">{EX.kmh.toLocaleString('pt-BR', { maximumFractionDigits: 1 })} km/h</dd></div>
          </dl>
          <p class="th-nota th-queda-nota"></p>

          <div class="tabela-rolavel th-parciais">
            <table>
              <caption>As parciais da prova, trecho a trecho</caption>
              <thead>
                <tr><th scope="col">Trecho</th><th scope="col">Duração</th><th scope="col">Pace</th><th scope="col">Relógio</th></tr>
              </thead>
              <tbody>
                {EX.parciais.map((x) => (
                  <tr class:list={[x.tipo === 'estacao' && 'th-estacao']}>
                    <th scope="row">{x.nome}</th>
                    <td>{formataTempo(x.duracao)}</td>
                    <td>{x.pace ? formataPace(x.pace) : '—'}</td>
                    <td>{formataTempo(x.acumulado)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <p class="th-nota">{NOTA_ESTIMATIVA}</p>

          <div class="th-proximo">
            <p class="th-proximo-lead">
              O pace da meta é o ponto de partida do treino. O Montinho Personal, que assina o conteúdo do
              portal, prepara alunos para o Hyrox — presencial na região de Alphaville e Barueri e online
              para todo o Brasil.
            </p>
            <div class="th-proximo-acoes">
              <a class="th-btn th-btn-primario th-whats" href={whatsHyrox} target="_blank" rel="noopener" data-track="hyrox:cta-whatsapp">
                Falar com o Montinho sobre treino para o Hyrox
              </a>
              <a class="th-btn th-btn-secundario" href="/guias/treino-hyrox/" data-track="hyrox-tempo:treino">
                Ver como treinar para o Hyrox
              </a>
            </div>
          </div>
        </div>
      </section>

      <div class="prose th-conteudo">
        <h2>Quanto tempo dura uma prova de Hyrox</h2>
        <p>
          A prova é sempre a mesma: 8 corridas de 1 km, cada uma seguida de uma estação, na mesma ordem
          — do SkiErg à wall ball. O que muda é quanto cada um leva. Os dois estudos publicados com tempos
          de prova dão a referência:
        </p>
        <ul>
          <li>
            <strong>Atletas amadores, simulação da categoria Open individual:</strong>{' '}
            {min(BRANDT_TOTAL_MIN)} minutos no total (mediana de 11 pessoas), com {min(BRANDT_CORRIDA_MIN)}{' '}
            minutos de corrida e {min(BRANDT_ESTACOES_MIN)} de estações.
          </li>
          <li>
            <strong>Atletas Pro masculino, etapa oficial de Madri 2025:</strong>{' '}
            {formataTempo(HYSCIENCE_TOTAL_S)} em média, entre 24 atletas.
          </li>
        </ul>
        <p>
          Nos dois, a corrida levou mais tempo que todas as estações somadas — e, no estudo com amadores,
          terminar mais rápido se associou a mais capacidade aeróbica e mais volume de treino de
          resistência. Os números por categoria que aparecem em resumos de busca (Open feminino, duplas)
          citam blogs, não o ranking oficial, e por isso não estão aqui. O formato completo, com as cargas
          de cada categoria, está em <a href="/guias/o-que-e-hyrox/">o que é Hyrox</a>.
        </p>

        <h2>Tabela: o pace para cada meta</h2>
        <p>
          Com as estações e transições na proporção do estudo com amadores ({pct(PARTE_ESTACOES)} do
          tempo final). Se você é mais rápido ou mais lento nas estações que isso, a calculadora acima
          refaz a conta com o seu tempo.
        </p>
        <div class="tabela-rolavel">
          <table>
            <caption>Meta de tempo final → pace médio de corrida</caption>
            <thead>
              <tr><th scope="col">Meta</th><th scope="col">Estações</th><th scope="col">Corrida</th><th scope="col">Pace por km</th></tr>
            </thead>
            <tbody>
              {METAS.map((p) => (
                <tr>
                  <th scope="row">{formataTempo(p.tempoFinal)}</th>
                  <td>{formataTempo(p.estacoes)}</td>
                  <td>{formataTempo(p.corrida)}</td>
                  <td>{formataPace(p.pace)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h2>O pace 7 é ruim?</h2>
        <p>
          Não. A 7:00 por km, os 8 km de corrida levam {formataTempoExtenso(PACE7.corrida)}. Com as
          estações na proporção do estudo, a prova fecha perto de {formataTempo(PACE7.tempoFinal)} — cerca de{' '}
          {Math.round(PACE7_ACIMA / 60)} minutos acima da mediana de {min(BRANDT_TOTAL_MIN)} minutos dos atletas
          amadores do estudo, que já treinavam Hyrox havia mais de um ano. O mesmo raciocínio para outros
          ritmos:
        </p>
        <div class="tabela-rolavel">
          <table>
            <caption>Pace de corrida → tempo final previsto</caption>
            <thead>
              <tr><th scope="col">Pace</th><th scope="col">Corrida</th><th scope="col">Estações</th><th scope="col">Tempo final</th></tr>
            </thead>
            <tbody>
              {PACES.map((p) => (
                <tr>
                  <th scope="row">{formataPace(p.pace)}</th>
                  <td>{formataTempo(p.corrida)}</td>
                  <td>{formataTempo(p.estacoes)}</td>
                  <td>{formataTempo(p.tempoFinal)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>
          Para converter o pace em velocidade de esteira, ou ver o ritmo de outras distâncias, use a{' '}
          <a href="/ferramentas/calculadora-de-pace/">calculadora de pace</a>.
        </p>

        <h2>O ritmo cai — e as parciais mostram onde</h2>
        <p>
          No estudo com atletas Pro masculino, a velocidade de corrida caiu de {kmh(HYSCIENCE_V1)} km/h na
          primeira corrida para {kmh(HYSCIENCE_V8)} km/h na oitava, e foi ainda menor na Roxzone,{' '}
          {kmh(HYSCIENCE_ROXZONE)} km/h. Os pesquisadores concluíram que sustentar um ritmo relativo mais
          alto é o que encurta o tempo de corrida.
        </p>
        <p>
          Marcando "ritmo que cai" na calculadora, as parciais seguem essa proporção sem mudar o tempo
          total de corrida. Para a meta de 1h30, a 1ª corrida sai a {formataPace(EX_QUEDA.pacePrimeira)} por
          km e a 8ª, a {formataPace(EX_QUEDA.paceUltima)} — o que ajuda a não sair rápido demais no
          começo e chegar sem perna nas últimas estações.
        </p>

        <h2>O tempo das estações</h2>
        <p>
          No estudo com amadores, as estações de carga mais pesada foram as mais rápidas: o sled push levou{' '}
          {BRANDT_SLED_PUSH_S} segundos e o sled pull, {BRANDT_SLED_PULL_S} (medianas). O pico de esforço
          apareceu na última estação, a wall ball. Como não há dado publicado do tempo de cada uma das
          oito, a calculadora divide o tempo total das estações em partes iguais — é a simplificação
          desta conta, e o seu simulado é a melhor fonte para corrigi-la.
        </p>
        <p>{NOTA_ESTIMATIVA}</p>

        <h2>Como baixar o seu tempo</h2>
        <p>
          Pelos estudos, o que mais pesa é o fôlego: capacidade aeróbica e volume de treino de resistência.
          Força para as estações evita que elas virem gargalo, e os treinos combinados ensinam a correr com
          a perna cansada. Como a semana se organiza está no{' '}
          <a href="/guias/treino-hyrox/">artigo de treino de Hyrox</a>. Se você tem dor, lesão ou alguma
          condição de saúde, converse com o médico ou o fisioterapeuta antes de aumentar o treino.
        </p>

        <h2>Como esta conta é feita</h2>
        <p class="th-formula">{formula}</p>
        <p>
          Com "ritmo que cai", a velocidade desce em linha reta da 1ª à 8ª corrida, na proporção do
          estudo com atletas Pro ({kmh(HYSCIENCE_V1)} → {kmh(HYSCIENCE_V8)} km/h), e a escala é ajustada
          para o tempo total de corrida não mudar. Nenhum número desta página foi escrito à mão: todos
          saem do mesmo motor que a calculadora usa, e os testes conferem que as parciais terminam no
          tempo final e que metas impossíveis não ganham pace inventado.
        </p>
        <p class="th-revisao">
          Revisado em {formatDateLong(atualizadoEm)} por <a href="/montinho-personal/">Montinho</a>,
          personal trainer.
        </p>

        <h2>Referências</h2>
        <ul class="th-fontes">
          {FONTES.map((f) => (
            <li>
              <a href={f.url} target="_blank" rel="noopener noreferrer">{f.rotulo}</a> — {f.resumo}
            </li>
          ))}
        </ul>
      </div>

      <Faq faqs={faqs} titulo="Perguntas frequentes sobre o tempo do Hyrox" />

      <AutorMontinho />
      <RelatedArticles itens={relacionados} />
    </article>

    <Sidebar />
  </div>

  <script>
    import { iniciarCalculadoraTempoHyrox } from '../../scripts/calculadoraTempoHyrox.client';
    import { tabelasRolaveis } from '../../scripts/tabelasRolaveis';
