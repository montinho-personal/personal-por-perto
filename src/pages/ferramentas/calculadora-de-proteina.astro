---
/**
 * Calculadora de proteína — página e ferramenta.
 *
 * POR QUE ESTA CALCULADORA
 *
 * Vinte e oito artigos do portal falam de proteína, oito no cluster de
 * Mounjaro — o de mais tráfego do site —, e nenhum dizia quanto.
 *
 * AS INTENÇÕES DE BUSCA QUE A PÁGINA COBRE, cada uma com lugar próprio:
 *   calculadora de proteína, quanto por dia  → a ferramenta
 *   proteína por kg, tabela por peso         → "Quanto de proteína por dia"
 *   proteína para hipertrofia                → perfil e seção "ganhar músculo"
 *   proteína para emagrecer                  → perfil e seção "emagrecer"
 *   proteína com Mounjaro / Ozempic          → seção própria, SEM gramas: o
 *                                              cluster de Mounjaro manda a meta
 *                                              para médico e nutricionista
 *   proteína para idosos                     → perfil e seção "65 anos ou mais"
 *   proteína por refeição, quanto absorve    → "Por refeição"
 *   excesso de proteína faz mal, rim         → "Quando não usar esta conta"
 *   whey conta, precisa de whey              → FAQ
 *
 * Nenhum número foi escrito à mão: tudo sai de src/lib/nutricao/proteina.ts.
 */
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import Sidebar from '../../components/Sidebar.astro';
import AutorMontinho from '../../components/AutorMontinho.astro';
import WhatsAppCta from '../../components/WhatsAppCta.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import { breadcrumbSchema, articleSchema, faqSchema, personMontinhoSchema } from '../../lib/schema';
import { formatDateLong } from '../../lib/slug';
import { site } from '../../data/site';
import {
  ALTURA_PADRAO,
  FONTES,
  IMC_PESO_AJUSTADO,
  NOTA_NAO_E_DIETA,
  NOTA_NAO_PRESCRICAO,
  NOTA_PESO_AJUSTADO,
  NOTA_RIM,
  NOTA_TOTAL,
  NOTA_TREINO,
  PERFIS,
  PESO_PADRAO,
  REFEICOES,
  REFEICOES_PADRAO,
  formataFaixaGkg,
  formataFaixaGramas,
  formataFaixaRefeicao,
  formataImc,
  fraseContexto,
  perfil,
  proteina,
  tabelaPorPeso,
} from '../../lib/nutricao/proteina';

const path = '/ferramentas/calculadora-de-proteina';
const atualizadoEm = '2026-09-25';

const crumbs = [
  { nome: 'Início', url: '/' },
  { nome: 'Ferramentas', url: '/ferramentas/' },
  { nome: 'Calculadora de proteína', url: path },
];

/* ── Exemplos resolvidos no servidor, pelo mesmo motor da ferramenta ── */
const PERFIL_PADRAO = 'forca';
const EX = proteina(PESO_PADRAO, ALTURA_PADRAO, PERFIL_PADRAO);
const POR = Object.fromEntries(PERFIS.map((p) => [p.id, proteina(PESO_PADRAO, ALTURA_PADRAO, p.id)]));
const TAB = tabelaPorPeso();
const g = (id: string) => formataFaixaGramas(POR[id].gramasMin, POR[id].gramasMax);
const EX_OBESIDADE = proteina(110, 165, 'emagrecer');

/* 48 caracteres. */
const title = 'Calculadora de Proteína: Quantos Gramas por Dia?';
/* 150 caracteres. */
const description =
  'Calcule quantos gramas de proteína por dia para ganhar músculo, emagrecer ou depois dos 65 — com a faixa de cada diretriz, por refeição e com a fonte.';

const faqs = [
  {
    pergunta: 'Quantas gramas de proteína eu preciso por dia?',
    resposta: `Depende do peso e do objetivo. Para ${PESO_PADRAO} kg: cerca de ${g('saude')} g sem treino regular, ${g('forca')} g para ganhar músculo com treino de força, ${g('emagrecer')} g emagrecendo e ${g('idoso')} g depois dos 65 anos. A calculadora faz a conta com o seu peso.`,
  },
  {
    pergunta: 'Quanto de proteína por kg para hipertrofia?',
    resposta: 'De 1,6 a 2,2 g por kg por dia. Na maior meta-análise sobre o tema, o ganho de massa magra com treino de força parou de crescer, em média, perto de 1,6 g/kg; a ponta de 2,2 cobre quem responde acima da média.',
  },
  {
    pergunta: 'Quanto de proteína comer para emagrecer?',
    resposta: 'A faixa mais citada é de 1,2 a 2,0 g por kg por dia, junto com treino de força — é a combinação que protege o músculo durante o déficit. Com obesidade, a conta usa um peso ajustado, menor que o atual; o nutricionista define o número.',
  },
  {
    pergunta: 'Quanto de proteína quem usa Mounjaro ou Ozempic deve comer?',
    resposta: 'Esse número é definido com o seu médico e o seu nutricionista, e por isso esta calculadora não tem perfil para quem usa o remédio: a conta é feita sobre um peso ajustado, e não sobre o peso total, e depende do contexto clínico. O que as diretrizes de 2025 deixam claro é que proteína adequada e treino de força estão entre as prioridades para preservar massa magra durante o tratamento — e que o apetite reduzido torna a meta mais difícil de bater.',
  },
  {
    pergunta: 'Idoso precisa de mais proteína?',
    resposta: 'Sim. Depois dos 65, a recomendação sobe para pelo menos 1,0 a 1,2 g por kg por dia, e para 1,2 ou mais em quem treina. Quem tem doença renal é exceção e precisa de orientação médica.',
  },
  {
    pergunta: 'Quanto de proteína o corpo aproveita por refeição?',
    resposta: 'O número de 20 a 25 g que circula como limite vem de estudos com proteína de digestão rápida, sem outros alimentos junto — é uma simplificação. Para quem quer ganhar músculo, a sugestão mais usada é cerca de 0,4 g por kg por refeição, em pelo menos quatro refeições, o que distribui o total do dia.',
  },
  {
    pergunta: 'Excesso de proteína faz mal aos rins?',
    resposta: 'Para quem tem doença renal, a orientação é limitar — e esta calculadora não se aplica. Para as demais pessoas, as faixas desta página vêm de diretrizes para adultos saudáveis. Em qualquer dúvida sobre saúde, a conversa é com o médico.',
  },
  {
    pergunta: 'Preciso tomar whey para bater a proteína?',
    resposta: 'Não. A meta é do dia inteiro, somando carne, ovo, leite, feijão e o que mais você come. O whey é comida em pó — útil quando a rotina não fecha a conta, dispensável quando fecha.',
  },
];

const relacionados = [
  {
    url: '/mounjaro-e-treino/como-evitar-perda-de-massa-muscular/',
    titulo: 'Mounjaro: como evitar perda de massa muscular',
    descricao: 'Treino de força e proteína — as duas peças que preservam o músculo durante o tratamento.',
    tipo: 'Mounjaro e treino',
  },
  {
    url: '/emagrecimento/como-preservar-massa-muscular-emagrecendo/',
    titulo: 'Como preservar massa muscular emagrecendo',
    descricao: 'Onde a proteína entra no déficit, junto com o treino.',
    tipo: 'Emagrecimento',
  },
  {
    url: '/musculacao/whey-protein-o-que-e-como-tomar/',
    titulo: 'Whey protein: o que é e como tomar',
    descricao: 'Quando o suplemento ajuda a fechar a conta — e quando é dispensável.',
    tipo: 'Musculação',
  },
  {
    url: '/calorias/gasto-calorico-diario/',
    titulo: 'Quantas calorias eu gasto por dia?',
    descricao: 'A outra metade da conta: o gasto do dia, em faixa e com as fontes.',
    tipo: 'Calorias',
  },
];

const schema = [
  breadcrumbSchema(crumbs),
  articleSchema({ titulo: title, descricao: description, url: new URL(path, site.dominio).href, atualizadoEm }),
  faqSchema(faqs),
  personMontinhoSchema(),
];
---

<Base title={title} description={description} path={path} ogType="article" schema={schema}>
  <Breadcrumbs crumbs={crumbs} />

  <header class="pt-hero">
    <div class="container pt-hero-inner">
      <p class="eyebrow">Ferramenta de treino</p>
      <h1>Calculadora de proteína: quantos gramas por dia?</h1>
      <p class="pt-hero-lead">
        A quantidade de proteína depende do peso e do que você está fazendo — treinar para ganhar
        músculo, emagrecer ou passar dos 65. Cada situação tem a sua diretriz, e a
        calculadora usa a faixa de cada uma. Para {PESO_PADRAO} kg treinando força:{' '}
        <strong>{formataFaixaGramas(EX.gramasMin, EX.gramasMax)} g por dia</strong>.
      </p>
      <p class="pt-micro">Grátis · sem cadastro · a conta acontece no seu navegador</p>
    </div>
  </header>

  <div class="container pt-layout">
    <article class="pt-main">
      <section id="pt-app" class="pt-app" aria-labelledby="pt-app-h">
        <h2 id="pt-app-h" class="pt-app-h">Calculadora de proteína por dia</h2>

        <div class="pt-campos">
          <div class="pt-par">
            <div class="pt-campo">
              <label for="pt-peso">Peso (kg)</label>
              <input id="pt-peso" type="text" inputmode="decimal" autocomplete="off" value={PESO_PADRAO} />
            </div>
            <div class="pt-campo">
              <label for="pt-altura">Altura (cm)</label>
              <input id="pt-altura" type="text" inputmode="decimal" autocomplete="off" value={ALTURA_PADRAO} />
            </div>
          </div>

          <div class="pt-campo">
            <span class="pt-rotulo" id="pt-perfil-rotulo">A sua situação</span>
            <div class="pt-presets pt-presets-sem-rotulo" role="group" aria-labelledby="pt-perfil-rotulo">
              {PERFIS.map((p) => (
                <button
                  type="button"
                  class:list={['pt-preset', 'pt-perfil', p.id === PERFIL_PADRAO && 'is-ativo']}
                  data-perfil={p.id}
                  aria-pressed={String(p.id === PERFIL_PADRAO)}
                >
                  {p.nomeCurto}
                </button>
              ))}
            </div>
            <p class="pt-dica pt-perfil-slot" id="pt-perfil-dica">
              {perfil(PERFIL_PADRAO).nome}: {formataFaixaGkg(perfil(PERFIL_PADRAO))} g por kg.
            </p>
          </div>

          <div class="pt-campo">
            <span class="pt-rotulo" id="pt-refeicoes-rotulo">Refeições por dia</span>
            <div class="pt-presets pt-presets-sem-rotulo" role="group" aria-labelledby="pt-refeicoes-rotulo">
              {REFEICOES.map((n) => (
                <button
                  type="button"
                  class:list={['pt-preset', 'pt-refeicao', n === REFEICOES_PADRAO && 'is-ativo']}
                  data-refeicoes={String(n)}
                  aria-pressed={String(n === REFEICOES_PADRAO)}
                >
                  {n}
                </button>
              ))}
            </div>
          </div>
        </div>

        <p id="pt-erro" class="pt-erro" role="status" hidden></p>

        <div id="pt-saida" class="pt-saida" role="status" aria-live="polite">
          <p class="pt-resultado">
            <span class="pt-numero">{formataFaixaGramas(EX.gramasMin, EX.gramasMax)}</span>
            <span class="pt-unidade">g de proteína por dia</span>
          </p>
          <p class="pt-frase">{fraseContexto(EX)}</p>

          <dl class="pt-detalhes">
            <div><dt>Por quilo</dt><dd class="pt-d-gkg">{formataFaixaGkg(EX)} g/kg</dd></div>
            <div><dt class="pt-d-refeicao-rotulo">Por refeição ({REFEICOES_PADRAO})</dt><dd class="pt-d-refeicao">{formataFaixaRefeicao(EX.porRefeicaoMin, EX.porRefeicaoMax)} g</dd></div>
            <div><dt>IMC</dt><dd class="pt-d-imc">{formataImc(EX.imc)}</dd></div>
          </dl>

          <p class="pt-nota pt-nota-ajustado" hidden>{NOTA_PESO_AJUSTADO}</p>
          <p class="pt-nota pt-nota-perfil">{perfil(PERFIL_PADRAO).nota}</p>
          <p class="pt-nota">{NOTA_RIM}</p>

          <div class="pt-proximo">
            <p class="pt-proximo-lead">
              Proteína sustenta o que o treino estimula — sozinha, não constrói músculo. Se o objetivo é
              ganhar ou preservar massa magra, a outra metade é o treino de força bem montado, com
              carga que progride. <strong>A dieta é com o nutricionista; o treino, com quem acompanha
              você de perto.</strong>
            </p>
            <div class="pt-proximo-acoes">
              <a class="pt-btn pt-btn-primario" href="/personal-trainer/" data-track="ferramenta-proteina:cta-local">
                Encontrar personal na minha cidade
              </a>
              <a
                class="pt-btn pt-btn-secundario pt-whats"
                href="https://wa.me/"
                target="_blank"
                rel="noopener"
                data-track="ferramenta-proteina:cta-whatsapp"
              >
                Falar com o Montinho sobre acompanhamento online
              </a>
            </div>
            <p class="pt-proximo-nota">
              O Personal por Perto é um portal editorial. O diretório de cidades é gratuito; o
              Montinho Personal é o profissional que assina o conteúdo do portal e atende online
              para todo o Brasil.
            </p>
          </div>
        </div>
      </section>

      <div class="prose pt-conteudo">
        <h2>Quanto de proteína por dia, por quilo</h2>
        <p>
          A recomendação de proteína é dada em gramas por quilo de peso por dia, e muda conforme a
          situação. Cada linha da calculadora vem de uma diretriz diferente:
        </p>
        <ul class="pt-perfis">
          {PERFIS.map((p) => (
            <li>
              <p class="pt-perfil-nome">
                {p.nome} <span class="pt-perfil-gkg">{formataFaixaGkg(p)} g/kg</span>
              </p>
              <p>{p.nota}</p>
              <p class="pt-perfil-ex">Para {PESO_PADRAO} kg: {g(p.id)} g por dia · fonte: {p.fonte}.</p>
            </li>
          ))}
        </ul>

        <h2>Tabela de proteína por peso</h2>
        <div class="tabela-rolavel">
          <table>
            <caption>Gramas de proteína por dia</caption>
            <thead>
              <tr>
                <th scope="col">Peso</th>
                {PERFIS.map((p) => <th scope="col">{p.nomeCurto}</th>)}
              </tr>
            </thead>
            <tbody>
              {TAB.map((l) => (
                <tr>
                  <th scope="row">{l.peso} kg</th>
                  {l.faixas.map((f) => <td>{formataFaixaGramas(f.min, f.max)} g</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h2>Proteína para hipertrofia</h2>
        <p>
          A meta-análise mais usada sobre o tema reuniu 49 estudos com treino de força e mostrou que o
          ganho de massa magra para de crescer, em média, perto de 1,6 g por kg por dia. A ponta de
          cima, 2,2, é o limite do intervalo de confiança: cobre quem responde acima da média. Mais do
          que isso não mostrou ganho extra de músculo. {NOTA_TREINO}
        </p>

        <h2>Proteína para emagrecer</h2>
        <p>
          No déficit calórico, parte do peso perdido pode ser músculo — e proteína somada ao treino de
          força é o que protege a massa magra. A faixa de 1,2 a 2,0 g/kg aparece tanto no posicionamento de
          nutrição esportiva de 2016 quanto no de 2025 para perda de peso importante. Pessoas magras e
          já treinadas, em corte, são o caso em que a diretriz de nutrição esportiva cita valores mais
          altos, até 3,1 g/kg.
        </p>
        <p>
          O cuidado é com o peso usado na conta. {NOTA_PESO_AJUSTADO} Por exemplo: com 110 kg e 1,65 m
          (IMC {formataImc(EX_OBESIDADE.imc)}), a conta pelo peso total daria{' '}
          {formataFaixaGramas(EX_OBESIDADE.gramasMin, EX_OBESIDADE.gramasMax)} g — um teto, não uma meta.
        </p>

        <h2>Proteína para quem usa Mounjaro ou Ozempic</h2>
        <p>
          Esta calculadora não tem um perfil para quem usa remédio da classe GLP-1, e é de propósito.
          Em 2025, quatro sociedades de medicina do estilo de vida, nutrição e obesidade publicaram
          juntas as prioridades de nutrição para esse tratamento: proteína adequada e treino de força
          estão entre elas, para preservar massa magra. Mas a meta de proteína é calculada sobre um peso
          ajustado, e não sobre o peso total, e depende do contexto clínico — é conta para o seu médico
          e o seu nutricionista, não para uma calculadora de internet.
        </p>
        <p>
          O que dá para levar daqui: com o apetite reduzido pelo remédio, bater a meta costuma ser o
          difícil, e dividir a proteína em várias refeições ajuda. O treino que protege o músculo está no
          guia de{' '}
          <a href="/mounjaro-e-treino/como-evitar-perda-de-massa-muscular/">como evitar perda de massa
          muscular com Mounjaro</a>.
        </p>

        <h2>Proteína depois dos 65 anos</h2>
        <p>
          Depois dos 65, o corpo precisa de mais proteína que o adulto jovem para manter músculo e
          função, e a recomendação sobe: pelo menos 1,0 a
          1,2 g por kg por dia para quem tem mais de 65 anos, 1,2 ou mais para quem treina e 1,2 a 1,5
          para a maioria dos que têm doença aguda ou crônica — nesse último caso, com orientação. Quem
          tem doença renal grave fora da diálise é exceção e pode precisar limitar.
        </p>

        <h2>Por refeição: quanto o corpo aproveita</h2>
        <p>
          Para quem quer ganhar músculo, a sugestão mais usada é dividir: cerca de 0,4 g por kg por
          refeição, em pelo menos quatro refeições — para {PESO_PADRAO} kg, em torno de{' '}
          {formataFaixaRefeicao(POR.forca.porRefeicaoMin, POR.forca.porRefeicaoMin)} g cada. O limite de
          20 a 25 g por vez que circula por aí vem de estudos com proteína de digestão rápida, sem outro
          alimento junto, e não vale como regra geral; distribuir serve para bater o total do dia sem
          depender de uma refeição enorme. {NOTA_TOTAL}
        </p>

        <h2>Quando não usar esta conta</h2>
        <p>{NOTA_RIM}</p>
        <p>{NOTA_NAO_E_DIETA}</p>

        <h2>Como esta conta é feita</h2>
        <p>
          A calculadora multiplica o seu peso pela faixa de gramas por quilo da situação escolhida e
          divide o resultado pelas refeições. Com IMC de {IMC_PESO_AJUSTADO} ou mais, ela avisa que o
          número pelo peso total é um teto: as diretrizes de emagrecimento usam peso ajustado, e a
          calculadora não inventa uma fórmula que as fontes conferidas não mostram. Os gramas do dia são
          arredondados de 5 em 5.
        </p>
        <p>
          Nenhum número desta página foi escrito à mão. Todos saem do mesmo motor que a calculadora usa,
          e os testes conferem cada faixa contra a diretriz de origem.
        </p>
        <p class="pt-revisao">
          Revisado em {formatDateLong(atualizadoEm)} por <a href="/montinho-personal/">Montinho</a>,
          personal trainer. {NOTA_NAO_PRESCRICAO}
        </p>

        <h2>Referências</h2>
        <ul class="pt-fontes">
          {FONTES.map((f) => (
            <li>
              <a href={f.url} target="_blank" rel="noopener noreferrer">{f.rotulo}</a> — {f.resumo}
            </li>
          ))}
        </ul>
      </div>

      <Faq faqs={faqs} titulo="Perguntas frequentes sobre proteína" />

      <WhatsAppCta tema="alimentacao" />
      <AutorMontinho />
      <RelatedArticles itens={relacionados} />
    </article>

    <Sidebar />
  </div>

  <script>
    import { iniciarCalculadoraProteina } from '../../scripts/calculadoraProteina.client';
    import { tabelasRolaveis } from '../../scripts/tabelasRolaveis';
    iniciarCalculadoraProteina();
    tabelasRolaveis();
  </script>
  <style>
    .pt-hero {
      background: linear-gradient(160deg, var(--brand-700), var(--brand-800));
      color: #eceef2;
      padding-block: var(--sp-7);
      border-bottom: 4px solid var(--accent);
    }
    .pt-hero-inner { max-width: 780px; }
    .pt-hero h1 { color: #fff; max-width: 24ch; }
    .pt-hero :global(.eyebrow) { color: #ffb488; }
    .pt-hero-lead {
      margin-top: var(--sp-4);
      font-size: var(--step-1);
      line-height: 1.55;
      color: #d9dde3;
      max-width: 62ch;
    }
    .pt-hero-lead strong { color: #fff; }
    .pt-micro { margin-top: var(--sp-3); font-size: var(--step--1); color: #aab0ba; }

    .pt-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-6);
      padding-block: var(--sp-7);
    }
    @media (min-width: 980px) {
      .pt-layout { grid-template-columns: minmax(0, 1fr) 300px; gap: var(--sp-7); }
    }
    .pt-main { min-width: 0; max-width: 760px; }

    .pt-app {
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      padding: var(--sp-5);
      background: var(--surface);
      box-shadow: var(--shadow-sm);
    }
    .pt-app-h { font-size: var(--step-1); margin-bottom: var(--sp-4); }

    .pt-campos { display: grid; gap: var(--sp-4); }
    /* Dois campos lado a lado; empilham antes de apertar, para o Tab só descer. */
    .pt-par { display: grid; gap: var(--sp-4); grid-template-columns: 1fr; }
    @media (min-width: 520px) {
      .pt-par { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sp-3); }
    }
    .pt-campo label,
    .pt-campo .pt-rotulo {
      display: block;
      font-weight: 700;
      font-size: var(--step--1);
      margin-bottom: 0.4rem;
    }
    .pt-campo input[type='text'] {
      width: 100%;
      min-height: 48px;
      padding: 0.6rem 0.8rem;
      font: inherit;
      font-size: var(--step-1);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--bg);
      color: var(--ink);
    }
    .pt-campo input:focus-visible { outline: 3px solid var(--accent); outline-offset: 1px; }
    .pt-dica { margin-top: 0.5rem; font-size: var(--step--1); color: var(--muted); line-height: 1.5; }
    /* Primeira pintura; o reservaAltura corrige para a largura real. */
    .pt-perfil-slot { min-height: 1.5em; }

    .pt-presets { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.5rem; }
    .pt-presets-sem-rotulo { margin-top: 0; }
    .pt-preset {
      min-height: 40px;
      padding: 0.35rem 0.8rem;
