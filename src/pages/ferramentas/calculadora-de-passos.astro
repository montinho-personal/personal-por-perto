---
/**
 * Calculadora de passos — página e ferramenta.
 *
 * POR QUE ESTA CALCULADORA
 *
 * "10 mil passos em km" tem ~1,9 mil buscas por mês (exportação de
 * 14/10/2026), dez vezes "calculadora de passos" — e o portal não tinha
 * nenhuma página que convertesse passos em distância. A calorias da
 * caminhada recusava a conta de propósito, porque a regra que circula
 * (0,415 × altura) não tem fonte. Esta página faz a conta com fonte: o
 * passo medido por velocidade no estudo CADENCE-Adults. Plano, crítica do
 * briefing, prints e método em docs/calculadora-de-passos.md.
 *
 * AS INTENÇÕES DE BUSCA QUE A PÁGINA COBRE, cada uma com lugar próprio:
 *   calculadora de passos, passos para km     → a ferramenta, modo "passos em km"
 *   10 mil passos em km (e 5, 7, 8, 20 mil)   → H2 de 10 mil e tabela passos → km
 *   quantos passos tem 1 km, 5 km             → modo "km em passos", H2 e tabela por altura
 *   quanto tempo 10 mil passos, 30 minutos    → H2 de tempo e tabela por minutos
 *   10 mil passos calorias                    → H2 de calorias, tabela por peso, link à caminhada
 *   quantos passos por dia, sair do sedentarismo, 5 mil é bom → H2 de passos por dia (resume e linka o artigo)
 *   quantos passos para perder 1 kg           → H2 próprio, sem número mágico
 *   passos no iPhone / celular                → H2 do celular
 *
 * Todos os números saem do motor em src/lib/caminhada/passos.ts. Nenhuma
 * combinação vira URL: o pré-preenchimento vai no fragmento (#p=10000).
 */
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import Sidebar from '../../components/Sidebar.astro';
import AutorMontinho from '../../components/AutorMontinho.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import { breadcrumbSchema, articleSchema, faqSchema, personMontinhoSchema } from '../../lib/schema';
import { formatDateLong } from '../../lib/slug';
import { site } from '../../data/site';
import {
  FONTE_CADENCE,
  INCERTEZA_PASSO,
  KCAL_POR_KG_GORDURA,
  METAS_COMPARADAS,
  RITMOS,
  arredondaKcal,
  arredondaPassos,
  faixaKm,
  faixaPassos,
  formataFaixaKcal,
  formataFaixaKm,
  formataFaixaPassos,
  formataKm,
  formataPassos,
  formataTempo,
  kcalDePassos,
  kmDePassos,
  minutosDePassos,
  passoEstimado,
  passosDeKm,
  ritmo,
  tabelaAlturas,
  tabelaKmPassos,
  tabelaMinutos,
  tabelaPassosKm,
  tabelaPesos,
} from '../../lib/caminhada/passos';

const path = '/ferramentas/calculadora-de-passos';
const atualizadoEm = '2026-10-14';

const crumbs = [
  { nome: 'Início', url: '/' },
  { nome: 'Ferramentas', url: '/ferramentas/' },
  { nome: 'Calculadora de passos', url: path },
];

/* ── Exemplos resolvidos no servidor, pelo mesmo motor da ferramenta ── */
const MOD = ritmo('moderado');
const PASSO = passoEstimado(MOD.cadencia);
const PASSO_CM = Math.round(PASSO);
const km = (p: number) => formataKm(kmDePassos(p, PASSO));
const F10 = faixaKm(10000, PASSO);
const F1KM = faixaPassos(1, PASSO);
const F5KM = faixaPassos(5, PASSO);
const P1KM = arredondaPassos(passosDeKm(1, PASSO));
const P5KM = arredondaPassos(passosDeKm(5, PASSO));
const P10KM = arredondaPassos(passosDeKm(10, PASSO));
const T10 = formataTempo(minutosDePassos(10000, MOD.cadencia));
const T5 = formataTempo(minutosDePassos(5000, MOD.cadencia));
const T1KM = formataTempo(minutosDePassos(passosDeKm(1, PASSO), MOD.cadencia));
const K10 = kcalDePassos(10000, 70, PASSO, MOD.cadencia);
const K5 = kcalDePassos(5000, 70, PASSO, MOD.cadencia);
const DIAS_1KG = Math.round(KCAL_POR_KG_GORDURA / K10.liquida);
const P30 = arredondaPassos(30 * MOD.cadencia);
const P60 = arredondaPassos(60 * MOD.cadencia);
const P40 = arredondaPassos(40 * MOD.cadencia);
const INC = Math.round(INCERTEZA_PASSO * 100);
const POR_RITMO = RITMOS.map((r) => {
  const cm = passoEstimado(r.cadencia);
  return { r, cm, km: kmDePassos(10000, cm), min: minutosDePassos(10000, r.cadencia) };
});
const LEVE = POR_RITMO[0];
const MRAP = POR_RITMO[POR_RITMO.length - 1];

const TAB_PASSOS = tabelaPassosKm(PASSO);
const TAB_KM = tabelaKmPassos(PASSO);
const TAB_MIN = tabelaMinutos(PASSO, MOD.cadencia);
const TAB_ALT = tabelaAlturas(MOD.cadencia);
const TAB_PESO = tabelaPesos(10000, PASSO, MOD.cadencia);

/* 60 caracteres. */
const title = 'Calculadora de Passos: 10 Mil Passos em Km, Tempo e Calorias';
const description = `10 mil passos dão cerca de ${km(10000)} (${formataFaixaKm(F10.min, F10.max)}). Converta em km, tempo e calorias pela sua altura e ritmo e veja quanto falta para a meta do dia.`;

const faqs = [
  {
    pergunta: 'Quantos km são 10 mil passos?',
    resposta: `Cerca de ${km(10000)} em ritmo moderado, com um passo médio de ${PASSO_CM} cm — e entre ${formataFaixaKm(F10.min, F10.max, 'e')} para a maioria das pessoas. Quem é mais alto ou anda mais rápido dá passos maiores: no ritmo leve, 10 mil passos ficam perto de ${formataKm(LEVE.km)}; no muito rápido, de ${formataKm(MRAP.km)}.`,
  },
  {
    pergunta: 'Quantos passos tem 1 km?',
    resposta: `Cerca de ${formataPassos(P1KM)} passos em ritmo moderado — entre ${formataFaixaPassos(F1KM.min, F1KM.max, 'e')} conforme a altura e a passada. Uma pessoa de 1,60 m dá perto de ${formataPassos(TAB_ALT[1].passosPorKm)} passos por km; uma de 1,80 m, perto de ${formataPassos(TAB_ALT[3].passosPorKm)}.`,
  },
  {
    pergunta: 'Quantos passos são 5 km?',
    resposta: `Cerca de ${formataPassos(P5KM)} passos em ritmo moderado (${formataFaixaPassos(F5KM.min, F5KM.max)}). 10 km ficam perto de ${formataPassos(P10KM)} passos.`,
  },
  {
    pergunta: 'Quanto tempo leva para dar 10 mil passos?',
    resposta: `Cerca de ${T10} caminhando sem parar em ritmo moderado (${MOD.cadencia} passos por minuto). Em ritmo leve, perto de ${formataTempo(LEVE.min)}; bem rápido, ${formataTempo(MRAP.min)}. Ao longo do dia, espalhados entre casa, trabalho e deslocamento, ninguém percebe esse tempo de uma vez.`,
  },
  {
    pergunta: 'Quantos passos dou em 30 minutos de caminhada? E em 1 hora?',
    resposta: `Em ritmo moderado, cerca de ${formataPassos(P30)} passos em 30 minutos, ${formataPassos(P40)} em 40 e ${formataPassos(P60)} em 1 hora. Caminhando mais rápido, a conta sobe, porque o número de passos por minuto aumenta junto com a velocidade.`,
  },
  {
    pergunta: 'Quantas calorias queimam 10 mil passos?',
    resposta: `Para 70 kg em ritmo moderado, ${formataFaixaKcal(K10.min, K10.max)} brutas — o centro da estimativa é ${arredondaKcal(K10.kcal)} kcal. Desse total, cerca de ${arredondaKcal(K10.liquida)} kcal são o acréscimo real ao dia; o resto você gastaria parado no mesmo tempo. Quem pesa mais gasta mais: veja a tabela por peso na página.`,
  },
  {
    pergunta: 'Quantos passos devo dar para perder 1 kg?',
    resposta: `Não existe um número: 1 kg de peso não corresponde a uma quantidade fixa de passos. Na conta teórica, ${formataPassos(10000)} passos a mais por dia somariam a energia de 1 kg de gordura (${formataPassos(KCAL_POR_KG_GORDURA)} kcal) em uns ${DIAS_1KG} dias para quem pesa 70 kg — mas o corpo compensa parte do gasto, e em estudos com programas de caminhada a perda média foi de cerca de 1,3 kg em 16 semanas. O que decide é o balanço do dia inteiro, alimentação incluída.`,
  },
  {
    pergunta: 'É bom dar 5 mil passos por dia? E 3 mil?',
    resposta: 'É melhor que 2 ou 3 mil, e o ganho de saúde aparece antes dos 10 mil. Numa revisão de 57 estudos (Ding e colaboradores, 2025), o risco de morte caiu de forma marcada até 5 a 7 mil passos por dia, e 7 mil foi associado a 47% menos risco que 2 mil. Se hoje você dá 3 mil, chegar a 5 mil já é um avanço real — o que conta é subir a partir de onde você está.',
  },
  {
    pergunta: 'Quantos passos por dia para sair do sedentarismo?',
    resposta: 'A classificação mais usada (Tudor-Locke e Bassett, 2004) chama de "estilo de vida sedentário" quem dá menos de 5 mil passos por dia, e de "pouco ativo" a faixa de 5 mil a 7,5 mil. Os próprios autores avisam que é uma classificação, não uma meta obrigatória — para quem tem alguma limitação, o objetivo é o que dá para sustentar, combinado com o médico.',
  },
  {
    pergunta: '10 mil passos por dia é obrigatório?',
    resposta: 'Não. O número nasceu de um slogan comercial japonês dos anos 1960, não de um estudo. A pesquisa recente mostra benefício em várias faixas: para adultos com menos de 60 anos, a queda de risco continua até 8 a 10 mil; acima dos 60, até 6 a 8 mil. 10 mil é uma referência popular, não uma linha entre "adianta" e "não adianta".',
  },
  {
    pergunta: 'A altura muda quantos passos tenho por km?',
    resposta: `Muda, e o ritmo também. Pela mesma conta desta página, 10 mil passos em ritmo moderado dão cerca de ${formataKm(TAB_ALT[1].km10mil)} para quem mede 1,60 m e ${formataKm(TAB_ALT[3].km10mil)} para quem mede 1,80 m. A mesma pessoa encurta o passo devagar e alonga rápido — por isso a calculadora pergunta o ritmo, além da altura.`,
  },
  {
    pergunta: 'O passo do homem e da mulher é diferente?',
    resposta: `Na média, sim, porque os homens costumam ser mais altos. Mas, para a mesma altura, a diferença é pequena: num estudo com adultos jovens, a passada dividida pela altura não teve diferença estatística entre homens e mulheres, e a diferença que outros estudos encontram fica perto de 2% — dentro da margem de ±${INC}% da calculadora. Por isso a conta usa a sua altura e o seu ritmo, e não o sexo.`,
  },
  {
    pergunta: 'Por que o km do meu celular é diferente do desta calculadora?',
    resposta: 'O celular e o relógio também estimam o tamanho do seu passo — pela altura do cadastro, pelo GPS ou pelos dois — e cada marca faz isso de um jeito. Além disso, a própria contagem de passos tem erro: em revisões de estudos, relógios e pulseiras erraram de −9% a +12% na média. Para a conta mais precisa, meça o seu passo numa distância conhecida e use o modo "Medir meu passo".',
  },
];

const relacionados = [
  {
    url: '/emagrecimento/quantos-passos-por-dia/',
    titulo: 'Quantos passos por dia para emagrecer',
    descricao: 'A faixa que funciona, de onde veio a meta dos 10 mil e por que passos não substituem a musculação.',
    tipo: 'Emagrecimento',
  },
  {
    url: '/calorias/caminhada/',
    titulo: 'Calorias da caminhada',
    descricao: 'O gasto com tempo, distância, ritmo e inclinação — com o seu peso.',
    tipo: 'Calculadora',
  },
  {
    url: '/ferramentas/calculadora-de-pace/',
    titulo: 'Calculadora de pace',
    descricao: 'Para quem quer saber o ritmo por km e a velocidade da esteira.',
    tipo: 'Calculadora',
  },
  {
    url: '/guias/personal-trainer-para-quem-trabalha-sentado/',
    titulo: 'Personal para quem trabalha sentado',
    descricao: 'Como somar movimento a um dia que acontece na cadeira.',
    tipo: 'Guia',
  },
];

const schema = [
  breadcrumbSchema(crumbs),
  articleSchema({ titulo: title, descricao: description, url: new URL(path, site.dominio).href, publicadoEm: atualizadoEm, atualizadoEm }),
  faqSchema(faqs),
  personMontinhoSchema(),
];

const urlCompartilhar = new URL(`${path}/`, site.dominio).href;
---

<Base title={title} description={description} path={path} ogType="article" schema={schema}>
  <Breadcrumbs crumbs={crumbs} />

  <header class="ps-hero">
    <div class="container ps-hero-inner">
      <p class="eyebrow">Ferramenta de caminhada</p>
      <h1>Calculadora de passos: quantos km são os seus passos?</h1>
      <p class="ps-hero-lead">
        10 mil passos dão cerca de <strong>{km(10000)}</strong> em ritmo moderado — entre{' '}
        {formataFaixaKm(F10.min, F10.max, 'e')}, conforme a sua altura e o seu ritmo. Digite os seus passos e
        veja a distância, o tempo e quanto falta para a meta.
      </p>
      <p class="ps-micro">Grátis · sem cadastro · a conta acontece no seu navegador</p>
    </div>
  </header>

  <div class="container ps-layout">
    <article class="ps-main">
      <section id="ps-app" class="ps-app" aria-labelledby="ps-app-h">
        <h2 id="ps-app-h" class="ps-app-h">O que você quer descobrir?</h2>

        <div id="ps-modos" class="ps-modos" role="group" aria-labelledby="ps-app-h">
          <button type="button" class="ps-modo is-ativo" data-modo="passos" aria-pressed="true">
            <strong>Passos em km</strong><span>"quantos km eu andei?"</span>
          </button>
          <button type="button" class="ps-modo" data-modo="km" aria-pressed="false">
            <strong>Km em passos</strong><span>"quantos passos são 5 km?"</span>
          </button>
          <button type="button" class="ps-modo" data-modo="meta" aria-pressed="false">
            <strong>Quanto falta?</strong><span>meta do dia</span>
          </button>
          <button type="button" class="ps-modo" data-modo="medir" aria-pressed="false">
            <strong>Medir meu passo</strong><span>a conta mais precisa</span>
          </button>
        </div>

        <div class="ps-campos">
          <div class="ps-bloco" data-bloco="passos">
            <div class="ps-campo">
              <label for="ps-passos" class="ps-rotulo-campo">Quantos passos?</label>
              <input id="ps-passos" type="text" inputmode="numeric" enterkeyhint="done" autocomplete="off" value="10000" />
            </div>
            <div class="ps-chips" role="group" aria-label="Atalhos de passos">
              {[5000, 7000, 8000, 10000, 12000, 15000].map((v) => (
                <button type="button" class="ps-chip" data-preset="passos" data-valor={String(v)}>{formataPassos(v)}</button>
              ))}
            </div>
          </div>

          <div class="ps-bloco" data-bloco="km" hidden>
            <div class="ps-campo">
              <label for="ps-km" class="ps-rotulo-campo">Quantos km?</label>
              <input id="ps-km" type="text" inputmode="decimal" enterkeyhint="done" autocomplete="off" value="5" />
            </div>
            <div class="ps-chips" role="group" aria-label="Atalhos de distância">
              {[1, 2, 3, 5, 8, 10].map((v) => (
                <button type="button" class="ps-chip" data-preset="km" data-valor={String(v)}>{v} km</button>
              ))}
            </div>
          </div>

          <div class="ps-bloco" data-bloco="meta" hidden>
            <div class="ps-duo-largo">
              <div class="ps-campo">
                <label for="ps-meta">Minha meta</label>
                <input id="ps-meta" type="text" inputmode="numeric" enterkeyhint="next" autocomplete="off" value="10000" />
              </div>
              <div class="ps-campo">
                <label for="ps-feitos">Já fiz hoje</label>
                <input id="ps-feitos" type="text" inputmode="numeric" enterkeyhint="done" autocomplete="off" placeholder="ex.: 6.400" />
              </div>
            </div>
            <div class="ps-chips" role="group" aria-label="Atalhos de meta">
              {[6000, 7000, 8000, 10000].map((v) => (
                <button type="button" class="ps-chip" data-preset="meta" data-valor={String(v)}>Meta {formataPassos(v)}</button>
              ))}
            </div>
            <p class="ps-dica">Copie o número do relógio ou do celular. Não é preciso conectar nada.</p>
          </div>

          <div class="ps-bloco" data-bloco="medir" hidden>
            <ol class="ps-passos-medir">
              <li>Escolha uma distância conhecida: uma volta de pista (400 m), um quarteirão medido no mapa ou 100 m de esteira.</li>
              <li>Caminhe no seu ritmo normal e conte os passos — ou zere o contador do celular antes.</li>
              <li>Digite os dois números: a calculadora divide a distância pelos passos.</li>
            </ol>
            <div class="ps-duo-largo">
              <div class="ps-campo">
                <label for="ps-med-m">Distância (metros)</label>
                <input id="ps-med-m" type="text" inputmode="decimal" enterkeyhint="next" autocomplete="off" placeholder="ex.: 400" />
              </div>
              <div class="ps-campo">
                <label for="ps-med-p">Passos contados</label>
                <input id="ps-med-p" type="text" inputmode="numeric" enterkeyhint="done" autocomplete="off" placeholder="ex.: 560" />
              </div>
            </div>
          </div>

        </div>

        <details id="ps-preciso" class="ps-preciso">
          <summary>Deixar mais preciso e calcular calorias <span class="ps-opcional">altura, ritmo, peso — tudo opcional</span></summary>
          <div class="ps-preciso-corpo">
            <div class="ps-bloco">
              <span class="ps-rotulo-campo" id="ps-ritmo-rotulo">Em que ritmo você anda?</span>
              <div class="ps-chips" role="group" aria-labelledby="ps-ritmo-rotulo">
                {RITMOS.map((r) => (
                  <button type="button" class:list={['ps-chip', r.id === 'moderado' && 'is-ativo']} data-ritmo={r.id} aria-pressed={String(r.id === 'moderado')}>
                    {r.nome}
                  </button>
                ))}
              </div>
              <p id="ps-ritmo-dica" class="ps-dica">{MOD.comoReconhecer}</p>
            </div>
            <div class="ps-trio-largo">
              <div class="ps-campo">
                <label for="ps-altura">Altura (cm)</label>
                <input id="ps-altura" type="text" inputmode="decimal" autocomplete="off" placeholder="ex.: 170" />
              </div>
              <div class="ps-campo">
                <label for="ps-peso">Peso (kg)</label>
                <input id="ps-peso" type="text" inputmode="decimal" autocomplete="off" placeholder="para calorias" />
              </div>
              <div class="ps-campo">
                <label for="ps-passo">Seu passo (cm)</label>
                <input id="ps-passo" type="text" inputmode="decimal" autocomplete="off" placeholder="72" aria-describedby="ps-passo-dica" />
              </div>
            </div>
            <p id="ps-passo-dica" class="ps-dica">Não precisa medir: a calculadora já estima o seu passo (o número cinza no campo) pela altura e pelo ritmo. Só preencha se você mediu.</p>
            <div id="ps-resumo" class="ps-resumo" hidden>
              <p id="ps-resumo-txt"></p>
              <a href="#ps-resultado" class="ps-link-btn" id="ps-resumo-ver">Ver o resultado completo</a>
            </div>
          </div>
        </details>
        <p id="ps-aviso" class="ps-aviso" role="status" hidden></p>
        <p id="ps-anuncio" class="sr-only" aria-live="polite"></p>

        <div id="ps-resultado" class="ps-resultado" role="region" aria-label="Resultado">
          <noscript>
            <p class="ps-vazio">A calculadora precisa de JavaScript. As tabelas abaixo trazem as contas mais comuns já prontas.</p>
          </noscript>
        </div>

        <div class="ps-compartilha">
          <button type="button" id="ps-compartilhar" class="ps-link-btn">Compartilhar a calculadora</button>
          <a
            id="ps-whats"
            class="ps-link-btn"
            href={`https://wa.me/?text=${encodeURIComponent(`Usei essa calculadora para descobrir quantos km meus passos representam. Testa também: ${urlCompartilhar}`)}`}
            target="_blank"
            rel="noopener"
          >Enviar no WhatsApp</a>
        </div>
      </section>

      <div class="prose ps-conteudo">
        <h2 id="10-mil-passos-em-km">Quantos km são 10 mil passos?</h2>
        <p>
          <strong>Cerca de {km(10000)}</strong>, em ritmo moderado e com um passo médio de {PASSO_CM} cm. Para
          a maioria das pessoas, entre {formataFaixaKm(F10.min, F10.max, 'e')}. A conta é uma multiplicação: passos
          × tamanho do passo. O que muda de pessoa para pessoa é o tamanho do passo — e ele depende menos da
          altura do que a maioria das calculadoras supõe, e mais do ritmo.
        </p>
        <div class="tabela-rolavel">
          <table data-ps-tabela="ritmos">
            <caption>10 mil passos por ritmo de caminhada (passo médio, sem altura informada)</caption>
            <thead><tr><th scope="col">Ritmo</th><th scope="col">Velocidade</th><th scope="col">Passo</th><th scope="col">10 mil passos</th><th scope="col">Tempo</th></tr></thead>
            <tbody>
              {POR_RITMO.map((l) => (
                <tr>
                  <th scope="row">{l.r.nome}</th>
                  <td>~{l.r.velocidade.toLocaleString('pt-BR')} km/h</td>
                  <td>{Math.round(l.cm)} cm</td>
                  <td>{formataKm(l.km)}</td>
                  <td>{formataTempo(l.min)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>
          Quem anda devagar encurta o passo; quem acelera, alonga. Por isso o mesmo contador de 10 mil passos
          pode ser {formataKm(LEVE.km)} num passeio e {formataKm(MRAP.km)} numa caminhada apressada. Com a sua
          altura e o seu ritmo, a calculadora acima ajusta a conta.
        </p>

        <h2 id="tabela-passos-km">Tabela de passos para km</h2>
        <p>
          Em ritmo moderado, com o passo médio de {PASSO_CM} cm. Se você preencheu altura, ritmo ou passo na
          calculadora, a tabela se ajusta a você.
        </p>
        <p id="ps-tabelas-nota" class="ps-tabelas-nota" hidden></p>
        <div class="ps-duas-tabelas">
          <div class="tabela-rolavel">
            <table data-ps-tabela="passos">
              <caption>Passos → km</caption>
              <thead><tr><th scope="col">Passos</th><th scope="col">Distância</th></tr></thead>
              <tbody>
                {TAB_PASSOS.map((l) => (
                  <tr><th scope="row">{formataPassos(l.passos)}</th><td data-passos={String(l.passos)}>{formataKm(l.km)}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="tabela-rolavel">
            <table data-ps-tabela="km">
              <caption>Km → passos</caption>
              <thead><tr><th scope="col">Distância</th><th scope="col">Passos</th></tr></thead>
              <tbody>
                {TAB_KM.map((l) => (
                  <tr><th scope="row">{l.km} km</th><td data-km={String(l.km)}>{formataPassos(l.passos)}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
        <p>
          5 mil passos dão perto de {km(5000)}; 8 mil, {km(8000)}; 20 mil, {km(20000)}. São estimativas: com
          a margem de ±{INC}% do passo, cada número pode variar um pouco para mais ou para menos.
        </p>

        <h2 id="passos-por-km">Quantos passos tem 1 km?</h2>
        <p>
          <strong>Cerca de {formataPassos(P1KM)} passos</strong> em ritmo moderado — entre{' '}
          {formataFaixaPassos(F1KM.min, F1KM.max, 'e')} conforme a altura e a passada. 5 km ficam perto de{' '}
          {formataPassos(P5KM)} passos, e 10 km, de {formataPassos(P10KM)}. Pela altura, no mesmo ritmo:
        </p>
        <div class="tabela-rolavel">
          <table>
            <caption>Passos por km e 10 mil passos em km, por altura (ritmo moderado)</caption>
            <thead><tr><th scope="col">Altura</th><th scope="col">Passo</th><th scope="col">Passos em 1 km</th><th scope="col">10 mil passos</th></tr></thead>
            <tbody>
              {TAB_ALT.map((l) => (
                <tr>
                  <th scope="row">{(l.altura / 100).toLocaleString('pt-BR', { minimumFractionDigits: 2 })} m</th>
                  <td>{Math.round(l.passoCm)} cm</td>
                  <td>{formataPassos(l.passosPorKm)}</td>
                  <td>{formataKm(l.km10mil)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h2 id="tempo">Quanto tempo leva para dar 10 mil passos?</h2>
        <p>
          <strong>Cerca de {T10}</strong> caminhando sem parar em ritmo moderado, que é de uns{' '}
          {MOD.cadencia} passos por minuto. 5 mil passos levam {T5}; 1 km, {T1KM}. A conta do tempo não
          depende do tamanho do passo: é o número de passos dividido pelos passos por minuto.
        </p>
        <div class="tabela-rolavel">
          <table data-ps-tabela="minutos">
            <caption>Minutos de caminhada → passos e distância (ritmo moderado)</caption>
            <thead><tr><th scope="col">Caminhada</th><th scope="col">Passos</th><th scope="col">Distância</th></tr></thead>
            <tbody>
              {TAB_MIN.map((l) => (
                <tr><th scope="row">{formataTempo(l.minutos)}</th><td data-min-passos={String(l.minutos)}>{formataPassos(l.passos)}</td><td data-min-km={String(l.minutos)}>{formataKm(l.km)}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>
          Os passos por minuto são os que o estudo CADENCE-Adults mediu em cada velocidade. Cerca de 100
          passos por minuto é o ponto em que a caminhada passa a contar como atividade moderada — mas quem
          anda "normal", a uns 5 km/h, costuma dar mais que isso.
        </p>

        <h2 id="calorias">Quantas calorias 10 mil passos gastam?</h2>
        <p>
          Para 70 kg em ritmo moderado, <strong>{formataFaixaKcal(K10.min, K10.max)}</strong> — o centro da
          estimativa é {arredondaKcal(K10.kcal)} kcal. É o gasto bruto: inclui o que você gastaria parado
          no mesmo tempo. O acréscimo real ao dia fica perto de {arredondaKcal(K10.liquida)} kcal. 5 mil
          passos, metade disso: {formataFaixaKcal(K5.min, K5.max)}.
        </p>
        <div class="tabela-rolavel">
          <table>
            <caption>10 mil passos em ritmo moderado: gasto estimado por peso</caption>
            <thead><tr><th scope="col">Peso</th><th scope="col">Gasto bruto</th><th scope="col">Acréscimo ao dia</th></tr></thead>
            <tbody>
              {TAB_PESO.map((l) => (
                <tr><th scope="row">{l.peso} kg</th><td>{formataFaixaKcal(l.min, l.max)}</td><td>~{arredondaKcal(l.liquida)} kcal</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>
          A faixa existe porque a conta passa por duas estimativas: o tamanho do passo (que dá a distância e
          a velocidade) e o gasto de cada velocidade. Nunca é "x calorias por passo" — o mesmo passo custa
          mais rápido do que devagar. Para a conta com o seu tempo, ritmo e inclinação, a{' '}
          <a href="/calorias/caminhada/" data-ps-link="calorias-caminhada">calculadora de calorias da caminhada</a>{' '}
          usa o mesmo método e os mesmos ritmos desta página.
        </p>

        <h2 id="passos-por-dia">Quantos passos por dia?</h2>
        <p>
          <strong>Não existe um número certo para todo mundo</strong>, e 10 mil não é uma linha entre "adianta"
          e "não adianta". A meta nasceu de um slogan comercial japonês dos anos 1960. A pesquisa veio depois:
        </p>
        <ul>
          <li>
            Numa revisão de 57 estudos publicada em 2025, 7 mil passos por dia foram associados a 47% menos
            risco de morte que 2 mil, e a curva achata a partir de 5 a 7 mil para mortalidade, doença
            cardiovascular e demência. Para diabetes, câncer e sintomas depressivos, o benefício continua subindo.
          </li>
          <li>
            Em outra análise, de 15 grupos de pessoas acompanhadas por anos, a queda de risco seguiu até 8 a 10
            mil passos em quem tem menos de 60 anos e até 6 a 8 mil acima dos 60.
          </li>
          <li>Cada mil passos a mais por dia foi associado a 15% menos risco de morte por qualquer causa.</li>
        </ul>
        <p>
          São estudos de observação: mostram associação, não provam que os passos sozinhos causaram o
          benefício. Mas apontam na mesma direção — <strong>mais passos que hoje</strong> costuma ser a
          estratégia útil, seja qual for o ponto de partida. Abaixo de 5 mil por dia é o que a classificação
          de Tudor-Locke chama de estilo de vida sedentário; ela é usada para descrever, não para prescrever.
        </p>
        <p>
          O Guia de Atividade Física do Ministério da Saúde não fala em passos: recomenda pelo menos 150 minutos
          por semana de atividade moderada, mais fortalecimento muscular duas vezes por semana. Se você tem
          alguma condição de saúde, dor ao caminhar ou está voltando depois de muito tempo parado, comece pelo
          que dá e combine o ritmo com o seu médico ou fisioterapeuta. Para o lado do emagrecimento, o artigo{' '}
          <a href="/emagrecimento/quantos-passos-por-dia/" data-ps-link="artigo-passos-por-dia">quantos passos por dia para emagrecer</a>{' '}
          entra no detalhe.
        </p>

        <h2 id="perder-1-kg">Quantos passos para perder 1 kg?</h2>
        <p>
          <strong>Não há um número de passos que corresponda a 1 kg.</strong> A conta teórica existe: para quem
          pesa 70 kg, 10 mil passos a mais acrescentam perto de {arredondaKcal(K10.liquida)} kcal ao dia, e a
          energia de 1 kg de gordura (cerca de {formataPassos(KCAL_POR_KG_GORDURA)} kcal) se somaria em uns{' '}
          {DIAS_1KG} dias — se nada mais mudasse. Só que muda: o corpo compensa parte do gasto, a fome se
          ajusta e o próprio gasto cai conforme o peso cai.
        </p>
        <p>
          Na prática, numa revisão de programas só de caminhada com contador de passos, sem dieta, a perda
          média foi de cerca de 1,3 kg em 16 semanas. Os passos ajudam porque somam gasto todos os dias sem
          cansar a ponto de atrapalhar o resto da rotina — esse movimento do dia a dia, fora do treino, é o
          que a fisiologia chama de NEAT. O resultado no peso, porém, depende do balanço do dia inteiro,
          alimentação incluída, e a musculação é o que segura a massa magra no processo.
        </p>

        <h2 id="passo-e-passada">Passo ou passada: qual é a diferença?</h2>
        <p>
          <strong>Passo</strong> é o movimento de um pé até o contato do outro pé no chão — é o que o celular
          e o relógio contam. <strong>Passada</strong> é o ciclo completo, dois passos: do pé direito até o
          pé direito de novo. Muita calculadora mistura as duas palavras, e o resultado erra pela metade ou
          pelo dobro. Esta página usa sempre o passo.
        </p>
        <h3>Como medir o seu passo</h3>
        <p>
          Caminhe no seu ritmo normal por uma distância conhecida — uma volta de pista de 400 m é o ideal — e
          conte os passos. Divida a distância pelos passos: 400 m em 560 passos dão um passo de 71 cm. Repita
          duas vezes e use a média. O modo "Medir meu passo" faz a conta e passa a usar o seu passo no resto
          da calculadora.
        </p>

        <h3>Homem e mulher têm passo diferente?</h3>
        <p>
          Na média, sim — mas quase toda a diferença vem da altura. Num estudo com 42 adultos jovens
          (homens com 1,79 m e mulheres com 1,70 m de altura média), as mulheres deram mais passos por
          minuto, e o tamanho da passada dividido pela altura não teve diferença estatística entre os
          sexos em nenhuma velocidade. Outros estudos acham uma diferença pequena que sobra depois de
          descontar a altura; nos dados desse estudo, ela fica perto de 2%, bem dentro da margem de ±{INC}%
          da calculadora. A própria fórmula que circula (0,415 para homens, 0,413 para mulheres) separa os
          sexos por meio por cento. Por isso a calculadora usa a altura e o ritmo, e não pergunta o sexo.
        </p>

        <h2 id="celular">Por que o celular mostra outro km?</h2>
        <p>
          O iPhone, o Android e os relógios também estimam o tamanho do passo — pela altura do cadastro, pelo
          GPS quando ele está ligado, ou pelos dois —, e cada marca faz isso do seu jeito. Por isso dois
          aparelhos dão distâncias diferentes para os mesmos passos. A própria contagem também erra: numa
          revisão de estudos com relógios e pulseiras, o erro médio ficou entre −9% e +12%, quase sempre
          contando a menos. Vale confirmar que a altura no cadastro do aparelho está certa.
        </p>

        <h2 id="como-calculamos">Como esta conta é feita</h2>
        <p>
          <strong>Distância</strong> = passos × tamanho do passo. <strong>Passos</strong> = distância ÷ tamanho
          do passo. <strong>Tempo</strong> = passos ÷ passos por minuto. Nada é arredondado antes do fim, e a
          exibição arredonda ao grão que a estimativa sustenta: "7,2 km", nunca "7,183 km".
        </p>
        <p>
          O tamanho do passo vem do {FONTE_CADENCE.rotuloCurto}, que mediu, em esteira, os passos por minuto
          de 254 adultos de 21 a 85 anos em cada velocidade. Velocidade dividida por passos por minuto dá o
          passo médio: cerca de 63 cm a 4 km/h, 71 cm a 4,8 km/h e 83 cm a 6,4 km/h, praticamente igual nas
          três faixas de idade. Com a altura informada, a calculadora ajusta esse passo na proporção da
          altura média do estudo (1,70 m) — uma suposição, declarada como tal.
        </p>
        <p>
          A fórmula que circula na maioria das calculadoras — passo = 0,415 × altura para homens e 0,413 para
          mulheres — bate com esses dados só perto de 4,8 km/h, e não encontramos o estudo de onde ela saiu.
          A margem de ±{INC}% vem da variação medida entre as pessoas do estudo na mesma velocidade. As
          calorias usam o gasto de cada velocidade do Compêndio de Atividades Físicas (2024), o mesmo método
          da calculadora de caminhada. A conta acontece no seu navegador; o que você digita não é enviado a
          lugar nenhum. O histórico do "Quanto falta?", se você salvar, fica só neste aparelho.
        </p>
        <p class="ps-revisao">
          Revisado em {formatDateLong(atualizadoEm)} por <a href="/montinho-personal/">Montinho</a>,
          personal trainer.
        </p>

        <div class="ps-proximo">
          <h2>Próximo passo</h2>
          <p>
            Se a sua pergunta é o gasto, a{' '}
            <a href="/calorias/caminhada/" data-ps-link="calorias-caminhada">calculadora de calorias da caminhada</a>{' '}
            usa tempo, ritmo e inclinação. Se você já corre ou quer controlar o ritmo por km, a{' '}
            <a href="/ferramentas/calculadora-de-pace/" data-ps-link="pace">calculadora de pace</a> faz essa
            conta. E se a ideia é ir além das caminhadas, a{' '}
            <a href="/ferramentas/treino-para-minha-rotina/" data-ps-link="rotina">Treino para Minha Rotina</a>{' '}
            mostra como encaixar o treino de força nos dias que você tem.
          </p>
          <p>
            Caminhar mais é o começo. Quem quer organizar treino e atividade física com alguém acompanhando de
            perto encontra um profissional na própria cidade.
          </p>
          <a class="ps-btn ps-btn-primario" href="/personal-trainer/" data-ps-link="personal" data-track="ferramenta-passos:cta-local">
            Encontrar personal na minha cidade
          </a>
        </div>

        <h2>Referências</h2>
        <ul class="ps-fontes">
          <li>
            <a href={FONTE_CADENCE.url} target="_blank" rel="noopener noreferrer">{FONTE_CADENCE.rotulo}</a>{' '}
            — passos por minuto medidos em cada velocidade de esteira; é a base do tamanho do passo e do tempo.
          </li>
          <li>
            <a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC10978594/" target="_blank" rel="noopener noreferrer">Lordall J, Oates AR, Lanovaz JL, et al. Spatiotemporal walking performance in different settings: effects of walking speed and sex. Frontiers in Sports and Active Living, 2024</a>{' '}
            — homens e mulheres: passada proporcional à altura, sem diferença estatística entre os sexos.
          </li>
          <li>
            <a href="https://pubmed.ncbi.nlm.nih.gov/40713949/" target="_blank" rel="noopener noreferrer">Ding D, et al. Daily steps and health outcomes in adults: a systematic review and dose-response meta-analysis. Lancet Public Health, 2025</a>{' '}
            — 7 mil × 2 mil passos/dia e as curvas por desfecho.
          </li>
          <li>
            <a href="https://pubmed.ncbi.nlm.nih.gov/35247352/" target="_blank" rel="noopener noreferrer">Paluch AE, et al. Daily steps and all-cause mortality: a meta-analysis of 15 international cohorts. Lancet Public Health, 2022</a>{' '}
            — os limites por idade (menos e mais de 60 anos).
          </li>
          <li>
            <a href="https://pubmed.ncbi.nlm.nih.gov/37555441/" target="_blank" rel="noopener noreferrer">Banach M, et al. The association between daily step count and all-cause and cardiovascular mortality: a meta-analysis. Eur J Prev Cardiol, 2023</a>{' '}
            — cada mil passos a mais.
          </li>
          <li>
            <a href="https://pubmed.ncbi.nlm.nih.gov/14715035/" target="_blank" rel="noopener noreferrer">Tudor-Locke C, Bassett DR. How many steps/day are enough? Preliminary pedometer indices for public health. Sports Med, 2004</a>{' '}
            — a classificação por faixa e a origem dos 10 mil.
          </li>
          <li>
            <a href="https://pubmed.ncbi.nlm.nih.gov/18195317/" target="_blank" rel="noopener noreferrer">Richardson CR, et al. A meta-analysis of pedometer-based walking interventions and weight loss. Ann Fam Med, 2008</a>{' '}
            — a perda média com programas de caminhada.
          </li>
          <li>
            <a href="https://pubmed.ncbi.nlm.nih.gov/39080098/" target="_blank" rel="noopener noreferrer">Revisão guarda-chuva sobre a validade de relógios e pulseiras. Sports Med, 2024</a>{' '}
            — o erro médio da contagem de passos.
          </li>
          <li>
            <a href="https://pubmed.ncbi.nlm.nih.gov/21872751/" target="_blank" rel="noopener noreferrer">Hall KD, et al. Quantification of the effect of energy imbalance on bodyweight. The Lancet, 2011</a>{' '}
            — por que a conta de 7.700 kcal por quilo não se cumpre em linha reta.
          </li>
          <li>
            <a href="https://pacompendium.com/walking/" target="_blank" rel="noopener noreferrer">2024 Adult Compendium of Physical Activities — caminhada</a>{' '}
            — o gasto de cada velocidade, usado nas calorias.
          </li>
          <li>
            <a href="https://bvsms.saude.gov.br/bvs/publicacoes/guia_atividade_fisica_populacao_brasileira.pdf" target="_blank" rel="noopener noreferrer">Ministério da Saúde. Guia de Atividade Física para a População Brasileira, 2021</a>.
          </li>
        </ul>
      </div>

      <Faq faqs={faqs} titulo="Perguntas frequentes sobre passos" />

