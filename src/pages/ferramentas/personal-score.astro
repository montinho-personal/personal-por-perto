      content: '✓';
      position: absolute;
      left: 0;
      color: #1f8a54;
      font-weight: 800;
    }

    /* Pontos de atenção */
    .ps-atencao {
      border: 1px solid var(--line);
      border-left: 4px solid var(--accent);
      border-radius: var(--radius);
      padding: var(--sp-4) var(--sp-5);
      margin-bottom: var(--sp-3);
