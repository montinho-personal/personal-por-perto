      border-top: 1px solid var(--line-soft);
    }
    .ps-continuar h3 { font-size: var(--step-1); margin-bottom: var(--sp-3); }
    .ps-links { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--sp-2); }
    .ps-links a { color: var(--brand-600); font-weight: 600; }
    .ps-aviso {
      margin-top: var(--sp-5);
      font-size: var(--step--1);
      color: var(--muted);
      line-height: 1.5;
    }
    .ps-rodape {
      margin-top: var(--sp-6);
      padding-top: var(--sp-5);
      border-top: 1px solid var(--line-soft);
      display: flex;
      flex-wrap: wrap;
      gap: var(--sp-3) var(--sp-4);
      align-items: center;
    }
    .ps-feedback {
      font-size: var(--step--1);
      color: var(--muted);
      display: flex;
      align-items: center;
      gap: var(--sp-3);
      flex-wrap: wrap;
      margin-right: auto;
    }
    .ps-feedback button,
    .ps-compartilhar {
      border: 1px solid var(--line);
      background: #fff;
      border-radius: 999px;
      padding: 0.4rem 0.9rem;
      font: inherit;
      font-size: var(--step--1);
      cursor: pointer;
      min-height: 44px;
    }
    .ps-feedback button:hover, .ps-compartilhar:hover { border-color: var(--brand); }
    .ps-refazer {
      background: none;
      border: 0;
      font: inherit;
      font-size: var(--step--1);
      color: var(--muted);
      text-decoration: underline;
      cursor: pointer;
      padding: 0.4rem 0;
      min-height: 44px;
