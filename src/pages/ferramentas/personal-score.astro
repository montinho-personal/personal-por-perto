    .ps-proximo-btn { margin-top: var(--sp-4); }
    .ps-limitacoes {
      border-top: 1px solid var(--line-soft);
      padding-top: var(--sp-5);
    }
    .ps-limitacoes ul { margin: 0; padding-left: 1.2rem; display: grid; gap: var(--sp-2); }
    .ps-limitacoes li { font-size: var(--step--1); color: var(--muted); line-height: 1.55; }

    .ps-compat {
      margin-top: var(--sp-6);
      border-radius: var(--radius);
      padding: var(--sp-5);
      background: linear-gradient(155deg, var(--brand-700), var(--brand-800));
      color: #d4d8df;
      border-top: 4px solid var(--accent);
    }
    .ps-compat h3 { color: #fff; font-size: var(--step-1); }
    .ps-compat p { margin-top: var(--sp-3); line-height: 1.6; }
    .ps-acoes { margin-top: var(--sp-5); display: grid; gap: var(--sp-3); }
    .ps-acoes .btn { width: 100%; }
    .ps-acoes-nota { font-size: var(--step--1); color: #aab0ba; text-align: center; margin: 0; }
    .ps-continuar {
      margin-top: var(--sp-6);
