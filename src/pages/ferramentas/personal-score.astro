    .ps-atencao h4 { font-size: var(--step-0); line-height: 1.3; }
    .ps-atencao p { margin-top: var(--sp-3); line-height: 1.65; font-size: var(--step--1); }
    .ps-atencao strong { color: var(--ink); }
    .ps-atencao-relato { color: var(--ink-soft); }
    .ps-atencao-link {
      display: inline-block;
      margin-top: var(--sp-3);
      font-size: var(--step--1);
      font-weight: 600;
      color: var(--brand-600);
    }

    /* Perguntas: o entregável central */
    .ps-perguntas {
      border: 2px solid var(--brand-600);
      border-radius: var(--radius);
      padding: var(--sp-5);
      background: var(--bg-tint);
