    /* ---------------------------- Editorial ----------------------------- */
    .ps-conteudo { padding-block: var(--sp-8); }
    .ps-artigo { max-width: var(--container-narrow); margin-inline: auto; }
    .ps-atualizado { color: var(--muted); font-size: var(--step--1); margin-bottom: var(--sp-5); }
    .ps-artigo h2 { margin-top: var(--sp-7); font-size: var(--step-2); }
    .ps-artigo p { margin-top: var(--sp-4); line-height: 1.7; }
    .ps-faq { margin-top: var(--sp-5); }
    .ps-faq h3 { font-size: var(--step-0); line-height: 1.35; }
    .ps-faq p { margin-top: var(--sp-2); }
    .ps-disclosure {
      margin-top: var(--sp-7);
      background: var(--bg-tint);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: var(--sp-5);
    }
    .ps-disclosure h2 { margin-top: 0; font-size: var(--step-1); }
    .ps-metodologia-nota { font-size: var(--step--1); color: var(--muted); }
  </style>

