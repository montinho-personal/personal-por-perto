---
/**
 * Calculadora de pace — página e ferramenta.
 *
 * POR QUE ESTA CALCULADORA
 *
 * O portal tinha a conta de quanto a corrida gasta (/calorias/corrida/),
 * mas nenhuma página respondia a pergunta que vem antes: "em que ritmo eu
 * corro?" — nem a que vem depois de toda inscrição em prova: "que pace eu
 * preciso para fazer 10 km em 50 minutos?". Plano e crítica do briefing em
 * docs/calculadora-pace.md.
 *
 * AS INTENÇÕES DE BUSCA QUE A PÁGINA COBRE, cada uma com lugar próprio:
 *   calculadora de pace, calcular pace       → a ferramenta, modo "meu pace"
 *   pace para 5 km em 25 min, meia em 2h      → modo "meta", atalhos e tabela de metas
 *   quanto tempo vou levar                    → modo "meu tempo"
 *   pace para km/h, velocidade da esteira     → conversor e as duas tabelas de esteira
 *   tabela de pace                            → "Tabela de pace"
 *   o que é pace, como calcular               → "O que é pace" e "Como calcular"
 *   tempo de 400 m, parciais                  → resultado (pista e parciais) e FAQ
 *   baixar 10 s por km                        → modo "comparar" e FAQ
 *   bom pace, pace de iniciante               → "Qual é um bom pace?"
 *
 * Paces, tempos e velocidades das tabelas e dos exemplos saem do motor em
 * src/lib/corrida/pace.ts. Os números de fora (estudo da esteira, recordes)
 * estão escritos no texto, com a fonte.
 * Nenhuma combinação vira URL: o link do cálculo vai no fragmento (#…).
 */
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import Sidebar from '../../components/Sidebar.astro';
import AutorMontinho from '../../components/AutorMontinho.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import { breadcrumbSchema, articleSchema, faqSchema, personMontinhoSchema } from '../../lib/schema';
import { formatDateLong } from '../../lib/slug';
import { site } from '../../data/site';
import {
  DISTANCIAS,
  METAS,
  REDUCOES,
  comparar,
  distanciaPronta,
  formataEsteira,
  formataKm,
  formataPace,
  formataTempo,
  formataTempoExtenso,
  formataVelocidade,
  paceDaVelocidade,
  paceDe,
  paceParaFicarAbaixo,
  pacePorMilha,
  pista,
  tabelaEsteira,
  tabelaPace,
  tabelaTempos,
  tabelaVelocidades,
  tempoDe,
  velocidadeDe,
} from '../../lib/corrida/pace';

const path = '/ferramentas/calculadora-de-pace';
const atualizadoEm = '2026-10-06';

const crumbs = [
  { nome: 'Início', url: '/' },
  { nome: 'Ferramentas', url: '/ferramentas/' },
  { nome: 'Calculadora de pace', url: path },
];

/* ── Exemplos resolvidos no servidor, pelo mesmo motor da ferramenta ── */
const km = (id: string) => distanciaPronta(id)!.km;
const EX_PACE = paceDe(5, 27 * 60 + 30);
const pMeta = (id: string, min: number) => paceDe(km(id), min * 60);
const P5_30 = pMeta('5k', 30);
const P5_25 = pMeta('5k', 25);
const P10_60 = pMeta('10k', 60);
const P10_50 = pMeta('10k', 50);
const PISTA_5 = pista(300);
const PISTA_4 = pista(240);
const CMP_10 = comparar(330, 320);
const ESTEIRA_6 = velocidadeDe(360);
const ESTEIRA_530 = velocidadeDe(330);
const ESTEIRA_7 = velocidadeDe(420);
const KMH_630 = velocidadeDe(390);
const P_14 = paceDaVelocidade(14);
const P_12 = paceDaVelocidade(12);
const P_8 = paceDaVelocidade(8);
const P_10_45 = pMeta('10k', 45);
const P_10_40 = pMeta('10k', 40);
const P_10_70 = pMeta('10k', 70);
const P_10_90 = pMeta('10k', 90);
const P5_20 = pMeta('5k', 20);
const P5_22 = pMeta('5k', 22);
const P5_37 = pMeta('5k', 37);
const P5_14 = pMeta('5k', 14);
const TAB_5KM = tabelaTempos(5, 15, 40);
const TAB_10KM = tabelaTempos(10, 40, 90, 5);
const TAB_MEIA = tabelaTempos(km('21k'), 80, 180, 5);
const TAB_MARATONA = tabelaTempos(km('42k'), 180, 360, 15);
const P21 = (min: number) => pMeta('21k', min);
const SUB = (id: string, min: number) => paceParaFicarAbaixo(km(id), min * 60);
const P42_120 = pMeta('42k', 120);
/** "4:15,95": o pace exato da maratona em 3 horas, com duas casas, calculado — não digitado. */
const EXATO_SUB3 = paceDe(km('42k'), 3 * 3600);
const EXATO_SUB3_TXT = `${Math.floor(EXATO_SUB3 / 60)}:${(EXATO_SUB3 % 60).toFixed(2).padStart(5, '0').replace('.', ',')}`;
const P10_55 = pMeta('10k', 55);
const P_CAMINHADA = paceDaVelocidade(5);
const TEMPO_10_A_6 = tempoDe(10, 360);

const TAB_PACE = tabelaPace();
const TAB_ESTEIRA = tabelaEsteira();
const TAB_VELOCIDADES = tabelaVelocidades();
const DIST_TAB_PACE = ['5 km', '10 km', 'Meia', 'Maratona'];

/* 53 caracteres. */
const title = 'Calculadora de Pace e Km/h: Corrida, Esteira e Tabela';
/* 144 caracteres. */
const description =
  'Calcule seu pace por km e o ritmo da sua meta em 5 km, 10 km, meia e maratona. Converte pace em km/h na esteira e traz tabelas de tempo prontas.';

const faqs = [
  {
    pergunta: 'Como calcular o pace?',
    resposta: `Divida o tempo pela distância. 10 km em 55 minutos são 3.300 segundos ÷ 10 = 330 segundos por quilômetro, ou seja, ${formataPace(P10_55)} por km — ${formataVelocidade(velocidadeDe(P10_55))} km/h.`,
  },
  {
    pergunta: 'Qual o pace ideal para 5 km? 22 ou 37 minutos é bom?',
    resposta: `Não existe um ideal: é o que você sustenta hoje nos 5 km inteiros. 5 km em 30 minutos pedem ${formataPace(P5_30)} por km; em 25, ${formataPace(P5_25)}; em 20, ${formataPace(P5_20)}. 22 minutos (${formataPace(P5_22)}) é ritmo de quem já treina com regularidade; 37 minutos (${formataPace(P5_37)}) é uma ótima marca para quem está começando. O número que importa é o seu de um mês para o outro.`,
  },
  {
    pergunta: 'É possível correr 5 km em 14 minutos?',
    resposta: `É, mas é ritmo de corredor de alto nível: pace ${formataPace(P5_14)} por km, ${formataVelocidade(velocidadeDe(P5_14), 1)} km/h. O recorde mundial de 5 km de rua está abaixo de 13 minutos.`,
  },
  {
    pergunta: 'Qual o pace para correr 10 km em 1 hora? E em 40 minutos?',
    resposta: `Em 1 hora, ${formataPace(P10_60)} por km (${formataVelocidade(velocidadeDe(P10_60))} km/h); para fechar abaixo da hora, ${formataPace(SUB('10k', 60))}. Em 1h10, ${formataPace(P_10_70)}; em 1h30, ${formataPace(P_10_90)}; em 50 minutos, ${formataPace(P10_50)}; em 45, ${formataPace(P_10_45)}. 10 km em 40 minutos pedem ${formataPace(P_10_40)} por km, meta de corredor amador bem treinado.`,
  },
  {
    pergunta: 'Qual o pace para a meia maratona?',
    resposta: `Para fechar abaixo de 2 horas, ${formataPace(SUB('21k', 120))} por km ou mais rápido. Abaixo de 1h50, ${formataPace(SUB('21k', 110))}; de 1h45, ${formataPace(SUB('21k', 105))}; de 1h30, ${formataPace(SUB('21k', 90))}. Em vários desses casos o pace é um segundo mais rápido que a divisão arredondada, porque o pace arredondado estoura o tempo.`,
  },
  {
    pergunta: 'É possível correr 21 km em 2 horas?',
    resposta: `É, e está entre as metas mais buscadas para a primeira meia: ${formataPace(P21(120))} por km do começo ao fim, ou 5 km a cada ${formataTempo(tempoDe(5, P21(120)))}. O que decide não é a conta, é a base — quem ainda não corre 10 km com folga precisa construí-la antes.`,
  },
  {
    pergunta: 'Qual o pace para a maratona sub 4, sub 3:30 e sub 3?',
    resposta: `Sub 4: ${formataPace(SUB('42k', 240))} por km. Sub 3:30: ${formataPace(SUB('42k', 210))}. Sub 3: ${formataPace(SUB('42k', 180))} — não 4:16, que é o que a divisão arredondada mostra: 4:16 cravado termina em ${formataTempo(tempoDe(km('42k'), 256))}. Como o relógio quase sempre mede mais que os 42,195 km oficiais, vale ter folga. A 5:30 por km, a maratona sai em ${formataTempo(tempoDe(km('42k'), 330))}.`,
  },
  {
    pergunta: 'Qual é o pace de um maratonista de elite? Já correram 42 km em menos de 2 horas?',
    resposta: `Já. 42 km em 2 horas pedem ${formataPace(P42_120)} por km — ${formataVelocidade(velocidadeDe(P42_120), 1)} km/h do começo ao fim —, e o recorde mundial masculino está abaixo disso desde a Maratona de Londres de 2026 (Sabastian Sawe, 1:59:30). Antes, só Eliud Kipchoge tinha corrido abaixo de 2 horas (1:59:40, em 2019), num evento montado para isso, que não valeu como recorde. Os melhores maratonistas do mundo correm entre 2:50 e 3:00 por km.`,
  },
  {
    pergunta: 'Como converter pace em km/h?',
    resposta: `Divida 60 pelo pace em minutos decimais, com os segundos virando fração de minuto (30 s = 0,5): pace 5:00 = 60 ÷ 5 = 12 km/h; pace 6:30 = 60 ÷ 6,5 = ${formataVelocidade(KMH_630)} km/h. No caminho inverso, 60 ÷ km/h dá os minutos por km: 14 km/h = ${formataPace(P_14)}/km; 15 km/h = ${formataPace(paceDaVelocidade(15))}/km; 9 km/h = ${formataPace(paceDaVelocidade(9))}/km.`,
  },
  {
    pergunta: 'Quanto é o pace na esteira?',
    resposta: `A esteira mostra km/h; o pace é 60 dividido por esse número. Velocidade 10 = ${formataPace(paceDaVelocidade(10))} por km; 12 = ${formataPace(P_12)}. Para treinar num pace: 6:00 pede ${formataVelocidade(ESTEIRA_6)} km/h no painel, 5:30 pede ${formataEsteira(ESTEIRA_530)} e 7:00 pede ${formataEsteira(ESTEIRA_7)}. Vale para qualquer marca de esteira.`,
  },
  {
    pergunta: 'Quanto tempo é 1 km na esteira?',
    resposta: `O tempo de 1 km é o próprio pace. A 10 km/h, ${formataPace(paceDaVelocidade(10))}; a 12 km/h, ${formataPace(P_12)}; a 8 km/h, ${formataPace(P_8)}; caminhando a 6 km/h, ${formataPace(paceDaVelocidade(6))}.`,
  },
  {
    pergunta: 'Quanto eu ganho baixando 10 segundos por quilômetro?',
    resposta: `Em 5 km, ${formataTempoExtenso(CMP_10.porDistancia[0].segundos)}; em 10 km, ${formataTempoExtenso(CMP_10.porDistancia[1].segundos)}; na meia, ${formataTempoExtenso(CMP_10.porDistancia[2].segundos)}; na maratona, ${formataTempoExtenso(CMP_10.porDistancia[3].segundos)}. Para quem corre a 5:30, é perto de 3% de ritmo.`,
  },
  {
    pergunta: 'Pace 4:30, 7:00 ou 10:00: qual é um bom pace?',
    resposta: `Depende da fase — nenhum dos três é ruim. 4:30 (${formataVelocidade(velocidadeDe(270), 1)} km/h) dá 10 km em ${formataTempo(tempoDe(10, 270))}, ritmo de amador bem treinado. 7:00 (${formataVelocidade(velocidadeDe(420), 1)} km/h) é corrida de verdade: 5 km em ${formataTempo(tempoDe(5, 420))}. 10:00 (${formataVelocidade(velocidadeDe(600))} km/h) é velocidade de caminhada rápida, um bom começo alternando trote e caminhada. Acelerar antes da hora aumenta o risco de dor; se ela aparecer e não passar, procure um médico ou fisioterapeuta.`,
  },
  {
    pergunta: 'Dá para calcular o pace da natação?',
    resposta: `Dá. Na natação o pace é contado por 100 metros: 1.500 metros em 30 minutos são 15 centenas, ou ${formataPace(paceDe(1.5, 1800) / 10)} por 100 m. Na calculadora, escolha "Outra" distância e a unidade em metros: o pace por 100 m aparece junto do resultado.`,
  },
  {
    pergunta: 'Existe pace para bike?',
    resposta: `Quase ninguém usa: no ciclismo a referência é a velocidade média em km/h, porque subida, vento e marcha fazem o ritmo por quilômetro variar demais. O modo "Meu pace" dá a velocidade média junto — 30 km em 1h15 são ${formataVelocidade(velocidadeDe(paceDe(30, 4500)))} km/h.`,
  },
  {
    pergunta: 'O pace desta calculadora é o mesmo do Strava e do relógio?',
    resposta: 'É o mesmo pace médio: tempo total dividido pela distância total. A diferença costuma vir da distância que o GPS mediu, que erra alguns metros por quilômetro, e da pausa automática, que conta só o tempo em movimento. Para comparar com uma prova, use o tempo e a distância oficiais.',
  },
  {
    pergunta: 'Em que pace fazer o tempo run?',
    resposta: 'Tempo run é um treino contínuo em ritmo "confortavelmente difícil": dá para manter, não para conversar. Na descrição do treinador Jack Daniels, fica perto do ritmo que você sustentaria por cerca de uma hora de prova. Se você sabe o seu tempo numa prova assim, a calculadora dá o pace; o ajuste do treino é com quem acompanha você.',
  },
];

const relacionados = [
  {
    url: '/calorias/corrida/',
    titulo: 'Calorias da corrida',
    descricao: 'Com o pace em mãos, o passo seguinte: quanto esse treino gasta para o seu peso.',
    tipo: 'Calculadora',
  },
  {
    url: '/guias/primeira-corrida-de-rua/',
    titulo: 'Primeira corrida de rua',
    descricao: 'Como se preparar para a primeira prova de 5 km, da inscrição à largada.',
    tipo: 'Guia',
  },
  {
    url: '/guias/personal-trainer-para-corredores/',
    titulo: 'Musculação para corredores',
    descricao: 'O que a força faz pela economia de corrida e como encaixá-la na semana.',
    tipo: 'Guia',
  },
  {
    url: '/emagrecimento/esteira-ou-bicicleta/',
    titulo: 'Esteira ou bicicleta?',
    descricao: 'Qual das duas gasta mais, cansa menos e combina com o seu objetivo.',
    tipo: 'Emagrecimento',
  },
];

const schema = [
  breadcrumbSchema(crumbs),
  articleSchema({ titulo: title, descricao: description, url: new URL(path, site.dominio).href, atualizadoEm }),
  faqSchema(faqs),
  personMontinhoSchema(),
];
---

<Base title={title} description={description} path={path} ogType="article" schema={schema}>
  <Breadcrumbs crumbs={crumbs} />

  <header class="pc-hero">
    <div class="container pc-hero-inner">
      <p class="eyebrow">Ferramenta de corrida</p>
      <h1>Calculadora de pace: qual é o seu ritmo de corrida?</h1>
      <p class="pc-hero-lead">
        Pace é o tempo para correr 1 km: divida o tempo pela distância. 5 km em 27:30 dão{' '}
        <strong>{formataPace(EX_PACE)} por km</strong>, ou {formataVelocidade(velocidadeDe(EX_PACE))} km/h.
      </p>
      <p class="pc-micro">Grátis · sem cadastro · a conta acontece no seu navegador</p>
    </div>
  </header>

  <div class="container pc-layout">
    <article class="pc-main">
      <section id="pc-app" class="pc-app" aria-labelledby="pc-app-h">
        <h2 id="pc-app-h" class="pc-app-h">O que você quer descobrir?</h2>

        <div id="pc-modos" class="pc-modos" role="group" aria-labelledby="pc-app-h">
          <button type="button" class="pc-modo is-ativo" data-modo="pace" aria-pressed="true">
            <strong>Meu pace</strong><span>distância + tempo</span>
          </button>
          <button type="button" class="pc-modo" data-modo="meta" aria-pressed="false">
            <strong>Pace para uma meta</strong><span>"quero fazer 10 km em 50 min"</span>
          </button>
          <button type="button" class="pc-modo" data-modo="tempo" aria-pressed="false">
            <strong>Meu tempo</strong><span>distância + pace</span>
          </button>
          <button type="button" class="pc-modo" data-modo="distancia" aria-pressed="false">
            <strong>Minha distância</strong><span>tempo + pace</span>
          </button>
          <button type="button" class="pc-modo" data-modo="velocidade" aria-pressed="false" aria-label="Pace e km/h: esteira">
            <strong>Pace ↔ km/h</strong><span>esteira</span>
          </button>
          <button type="button" class="pc-modo" data-modo="comparar" aria-pressed="false">
            <strong>Comparar ritmos</strong><span>"e se eu baixar 10 s?"</span>
          </button>
        </div>

        <div class="pc-campos">
          <div class="pc-bloco" data-bloco="metas" hidden>
            <span class="pc-rotulo-campo" id="pc-metas-rotulo">Metas comuns</span>
            <div class="pc-chips pc-chips-metas" role="group" aria-labelledby="pc-metas-rotulo">
              {METAS.map((m, i) => <button type="button" class="pc-chip" data-meta={String(i)} aria-pressed="false">{m.rotulo}</button>)}
            </div>
          </div>

          <div class="pc-bloco" data-bloco="dist">
            <span class="pc-rotulo-campo" id="pc-dist-rotulo">Qual a distância?</span>
            <div class="pc-chips" role="group" aria-labelledby="pc-dist-rotulo">
              {DISTANCIAS.map((d) => (
                <button type="button" class:list={['pc-chip', d.id === '5k' && 'is-ativo']} data-dist={d.id} aria-pressed={String(d.id === '5k')} aria-label={d.nome}>
                  {d.curto}
                </button>
              ))}
              <button type="button" class="pc-chip" data-dist="outra" aria-pressed="false">Outra</button>
            </div>
            <div id="pc-dist-outra-box" class="pc-outra" hidden>
              <div class="pc-campo">
                <label for="pc-dist-outra">Distância</label>
                <input id="pc-dist-outra" type="text" inputmode="decimal" autocomplete="off" placeholder="ex.: 8,4" />
              </div>
              <div class="pc-campo pc-campo-unidade">
                <label for="pc-unidade">Unidade</label>
                <select id="pc-unidade">
                  <option value="km">km</option>
                  <option value="m">metros</option>
                  <option value="mi">milhas</option>
                </select>
              </div>
            </div>
          </div>

          <fieldset class="pc-bloco" data-bloco="tempo">
            <legend id="pc-tempo-rotulo" class="pc-rotulo-campo">Quanto tempo levou?</legend>
            <div class="pc-trio">
              <div class="pc-campo"><label for="pc-h">horas</label><input id="pc-h" type="text" inputmode="numeric" enterkeyhint="next" aria-label="horas" autocomplete="off" maxlength="2" /></div>
              <div class="pc-campo"><label for="pc-m">min</label><input id="pc-m" type="text" inputmode="numeric" enterkeyhint="next" aria-label="minutos" autocomplete="off" maxlength="3" /></div>
              <div class="pc-campo"><label for="pc-s">seg</label><input id="pc-s" type="text" inputmode="numeric" enterkeyhint="next" aria-label="segundos" autocomplete="off" maxlength="2" /></div>
            </div>
          </fieldset>

          <fieldset class="pc-bloco" data-bloco="pace" hidden>
            <legend id="pc-pace-rotulo" class="pc-rotulo-campo">Qual o seu pace?</legend>
            <div class="pc-duo">
              <div class="pc-campo"><label for="pc-pm">min/km</label><input id="pc-pm" type="text" inputmode="numeric" enterkeyhint="next" aria-label="minutos por km" autocomplete="off" maxlength="2" /></div>
              <div class="pc-campo"><label for="pc-ps">seg</label><input id="pc-ps" type="text" inputmode="numeric" enterkeyhint="next" aria-label="segundos" autocomplete="off" maxlength="2" /></div>
            </div>
          </fieldset>

          <div class="pc-bloco" data-bloco="conversor" hidden>
            <div class="pc-conversor">
              <fieldset class="pc-sub">
                <legend class="pc-rotulo-campo">Pace</legend>
                <div class="pc-duo">
                  <div class="pc-campo"><label for="pc-cpm">min/km</label><input id="pc-cpm" type="text" inputmode="numeric" enterkeyhint="next" aria-label="minutos por km" autocomplete="off" maxlength="2" /></div>
                  <div class="pc-campo"><label for="pc-cps">seg</label><input id="pc-cps" type="text" inputmode="numeric" enterkeyhint="next" aria-label="segundos" autocomplete="off" maxlength="2" /></div>
                </div>
              </fieldset>
              <span class="pc-igual" aria-hidden="true">=</span>
              <div class="pc-campo pc-sub">
                <label for="pc-kmh" class="pc-rotulo-campo">Velocidade (km/h)</label>
                <input id="pc-kmh" type="text" inputmode="decimal" autocomplete="off" />
              </div>
            </div>
            <p class="pc-dica">Digite em qualquer um dos lados: o outro se preenche.</p>
          </div>

          <div class="pc-bloco" data-bloco="comparar" hidden>
            <div class="pc-comparar">
              <fieldset class="pc-sub">
                <legend class="pc-rotulo-campo">Seu pace hoje</legend>
                <div class="pc-duo">
                  <div class="pc-campo"><label for="pc-am">min/km</label><input id="pc-am" type="text" inputmode="numeric" enterkeyhint="next" aria-label="minutos por km, hoje" autocomplete="off" maxlength="2" /></div>
                  <div class="pc-campo"><label for="pc-as">seg</label><input id="pc-as" type="text" inputmode="numeric" enterkeyhint="next" aria-label="segundos, hoje" autocomplete="off" maxlength="2" /></div>
                </div>
              </fieldset>
              <fieldset class="pc-sub">
                <legend class="pc-rotulo-campo">Pace da meta</legend>
                <div class="pc-duo">
                  <div class="pc-campo"><label for="pc-bm">min/km</label><input id="pc-bm" type="text" inputmode="numeric" enterkeyhint="next" aria-label="minutos por km, meta" autocomplete="off" maxlength="2" /></div>
                  <div class="pc-campo"><label for="pc-bs">seg</label><input id="pc-bs" type="text" inputmode="numeric" enterkeyhint="next" aria-label="segundos, meta" autocomplete="off" maxlength="2" /></div>
                </div>
              </fieldset>
            </div>
            <span class="pc-rotulo-campo" id="pc-reduz-rotulo">Ou baixe o pace de hoje em</span>
            <div class="pc-chips" role="group" aria-labelledby="pc-reduz-rotulo">
              {REDUCOES.map((r) => <button type="button" class="pc-chip" data-reduz={String(r)} aria-label={`Baixar ${r} segundos por quilômetro`}>−{r} s/km</button>)}
            </div>
          </div>
        </div>

        <p id="pc-aviso" class="pc-aviso" role="status" hidden></p>
        <p id="pc-anuncio" class="sr-only" aria-live="polite"></p>

        <div id="pc-resultado" class="pc-resultado" role="region" aria-label="Resultado">
          <noscript>
            <p class="pc-vazio">A calculadora precisa de JavaScript. As tabelas abaixo trazem as contas mais comuns já prontas.</p>
          </noscript>
        </div>

        <div class="pc-compartilha">
          <button type="button" id="pc-copiar-calculo" class="pc-link-btn" hidden>Copiar o link deste cálculo</button>
          <button type="button" id="pc-compartilhar" class="pc-link-btn">Compartilhar a calculadora</button>
          <a
            id="pc-whats"
            class="pc-link-btn"
            href={`https://wa.me/?text=${encodeURIComponent(`Estou usando essa calculadora de pace para organizar minhas metas de corrida. Testa aí: ${new URL(`${path}/`, site.dominio).href}`)}`}
            target="_blank"
            rel="noopener"
          >Enviar no WhatsApp</a>
