---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import CtaMontinho from '../../components/CtaMontinho.astro';
import Sidebar from '../../components/Sidebar.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import InstagramFollow from '../../components/InstagramFollow.astro';
import AutorMontinho from '../../components/AutorMontinho.astro';
import ContextualCta from '../../components/ContextualCta.astro';
import FerramentaInline from '../../components/FerramentaInline.astro';
import VideoYouTube from '../../components/VideoYouTube.astro';
import { breadcrumbSchema, articleSchema, faqSchema, personMontinhoSchema } from '../../lib/schema';
import { formatDateLong } from '../../lib/slug';
import { site } from '../../data/site';
import { rotas } from '../../lib/links';
import { fontesExternas } from '../../data/fontesExternas';

const nsca = fontesExternas.nsca;
const sbme = fontesExternas.sbme;

const relacionados = [
  {
    url: '/mounjaro-e-treino/mounjaro-e-musculacao/',
    titulo: 'Quem usa Mounjaro pode fazer musculação?',
    descricao: 'A liberação para treinar é do médico, mas o treino de força tem papel específico durante o uso do medicamento. Entenda por quê.',
    tipo: 'Mounjaro e Treino',
  },
  {
    url: '/mounjaro-e-treino/treino-para-quem-usa-mounjaro/',
    titulo: 'Treino para quem usa Mounjaro: como adaptar',
    descricao: 'Como ajustar intensidade, volume e cardio a uma fase de menor ingestão calórica, sem promessas nem radicalismo.',
    tipo: 'Mounjaro e Treino',
  },
  {
    url: '/mounjaro-e-treino/fraqueza-para-treinar/',
    titulo: 'Mounjaro dá fraqueza para treinar? O que fazer',
    descricao: 'Por que a disposição pode cair em algumas fases e como manejar o treino nos dias de menos energia.',
    tipo: 'Mounjaro e Treino',
  },
  {
    url: '/mounjaro-e-treino/parei-o-mounjaro/',
    titulo: 'Parei o Mounjaro: como manter peso e massa muscular',
    descricao: 'O que muda quando o tratamento acaba, por que a fome volta com força e qual o papel real do treino de força na manutenção.',
    tipo: 'Mounjaro e Treino',
  },
  {
    url: '/guias/personal-trainer-para-emagrecimento/',
    titulo: 'Personal trainer para emagrecimento: como escolher',
    descricao: 'Ajustar treino de força e progressão ao seu momento, sem perder músculo pelo caminho, é trabalho de um profissional qualificado.',
    tipo: 'Guia',
  },
];

const path = '/mounjaro-e-treino/como-evitar-perda-de-massa-muscular';
const atualizadoEm = '2026-11-16';
const crumbs = [
  { nome: 'Início', url: '/' },
  { nome: 'Mounjaro e Treino', url: '/mounjaro-e-treino/' },
  { nome: 'Como não perder massa muscular tomando Mounjaro', url: path },
];

const faqs = [
  {
    pergunta: 'Mounjaro faz perder massa muscular?',
    resposta:
      'Junto com a gordura, sai também massa magra. No estudo de composição corporal do SURMOUNT-1, quem usou tirzepatida por 72 semanas perdeu 21,3% do peso, 33,9% da gordura e 10,9% da massa magra; cerca de 75% do que saiu foi gordura e 25% massa magra, a mesma proporção do grupo placebo. Massa magra não é só músculo: inclui água e órgãos.',
  },
  {
    pergunta: 'Como não perder massa magra tomando Mounjaro?',
    resposta:
      'As duas medidas com melhor suporte são treino de força regular e proteína suficiente. Numa meta-análise com idosos com obesidade em dieta, a musculação três vezes por semana evitou 93,5% da perda de massa magra causada pela restrição. Nenhuma das duas garante perda zero, e o tratamento é sempre acompanhado pelo médico.',
  },
  {
    pergunta: 'O que comer para não perder massa magra tomando Mounjaro?',
    resposta:
      'Proteína em todas as refeições, porque o apetite menor faz a pessoa comer pouco dela sem perceber: carnes, ovos, laticínios e leguminosas. Numa meta-análise com adultos acima de 50 anos em dieta, quem comeu mais proteína manteve mais massa magra e perdeu mais gordura. A quantidade certa para você é definida pelo nutricionista.',
  },
  {
    pergunta: 'Tomar Mounjaro sem treinar faz perder mais músculo?',
    resposta:
      'Sem o estímulo do treino de força, o corpo tem menos motivo para manter o músculo durante o déficit. Nos estudos de dieta, foi justamente o treino de força que reduziu a perda de massa magra. Caminhar faz bem e ajuda no gasto, mas não substitui a musculação nesse papel.',
  },
  {
    pergunta: 'Pode aplicar Mounjaro e ir treinar?',
    resposta:
      'O que costuma pesar no treino não é a aplicação, e sim os efeitos dos dias seguintes, como náusea e falta de energia. Nesses dias, reduza a intensidade e mantenha o movimento. Dúvida sobre horário de aplicação é com o médico que prescreveu.',
  },
  {
    pergunta: 'Existe um Mounjaro que não perde massa magra?',
    resposta:
      'O noticiário fala de moléculas novas e de combinações em estudo para reduzir a perda de músculo durante o emagrecimento com remédio. São pesquisas, e qualquer medicamento é decisão do médico. Enquanto isso, treino de força e proteína continuam sendo o que está ao seu alcance.',
  },
  {
    pergunta: 'Como sei se estou perdendo massa magra e não só gordura?',
    resposta:
      'O sinal mais útil é a força: se as cargas do treino caem semana após semana, sem relação com um dia ruim, algo precisa de ajuste. Medidas e um exame de composição corporal, como a bioimpedância repetida nas mesmas condições, completam a leitura. Diante de qualquer sinal, converse com o médico e revise treino e alimentação com os profissionais.',
  },
];

/* 47 caracteres. Reescrita de 16/11/2026 pelas buscas do SerpApi. */
const title = 'Como Não Perder Massa Muscular Tomando Mounjaro';
const description =
  'Mounjaro faz perder massa muscular? O que os estudos mediram, como treino e proteína protegem o músculo e como saber se você está perdendo.';

const capa = '/capas-conteudo/como-evitar-perda-de-massa-muscular.webp';
const capaAlt =
  'Arte da capa: braço com halter dentro de um escudo — como evitar perda de massa muscular com treino, proteína e estratégia — Personal por Perto';

const schema = [
  breadcrumbSchema(crumbs),
  articleSchema({ titulo: title, descricao: description, url: new URL(path, site.dominio).href, imagem: new URL(capa, site.dominio).href, atualizadoEm }),
  faqSchema(faqs),
  personMontinhoSchema(),
];
---

<Base title={title} description={description} path={path} ogType="article" image={capa} schema={schema}>
  <Breadcrumbs crumbs={crumbs} />
  <div class="container guide-layout">
    <article class="article-page">
    <p class="eyebrow">Mounjaro e Treino</p>
    <h1>Como não perder massa muscular tomando Mounjaro</h1>
    <p class="updated">Atualizado em {formatDateLong(atualizadoEm)}</p>

    <figure style="margin: 0 0 var(--sp-5)">
      <img
        src={capa}
        alt={capaAlt}
        width="1200"
        height="675"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        style="width: 100%; height: auto; border-radius: var(--radius-lg); box-shadow: var(--shadow-lg)"
      />
    </figure>

    <p class="lead">
      O Mounjaro (tirzepatida) não "come" o músculo, mas emagrecer leva junto
      uma parte de massa magra — e com o apetite baixo fica fácil comer pouca
      proteína e treinar menos. Duas medidas têm o melhor suporte para
      proteger o músculo: treino de força regular e proteína em todas as
      refeições.
    </p>

    <div class="callout"><strong>Aviso importante:</strong> este é um conteúdo educativo sobre exercício físico, produzido por profissional de educação física — não é orientação médica. Não inicie, interrompa nem ajuste a dose de nenhum medicamento por conta própria: decisões sobre o tratamento com Mounjaro (tirzepatida) são do seu médico. Em caso de sintomas ou dúvidas sobre o medicamento, procure quem o prescreveu.</div>

    <div class="prose">
      <h2>Mounjaro faz perder massa muscular?</h2>
      <p>
        Faz perder massa magra, como qualquer emagrecimento grande. No estudo
        de composição corporal do SURMOUNT-1, 160 participantes fizeram
        densitometria (DXA) no início e depois de 72 semanas. Com
        tirzepatida, o peso caiu 21,3%, a gordura 33,9% e a massa magra
        10,9%.
      </p>
      <p>
        Do peso perdido, cerca de <strong>75% foi gordura e 25% massa
        magra</strong> — a mesma proporção do grupo que tomou placebo e
        emagreceu menos. Ou seja: a proporção é a do emagrecimento, não um
        efeito à parte do remédio. E massa magra não é só músculo: entra na
        conta também água e órgãos.
      </p>
      <p>
        O risco prático está no dia a dia. Com o apetite reduzido, a pessoa
        come menos de tudo, inclusive proteína, e muitas vezes treina menos
        porque falta energia. É aí que dá para agir.
      </p>

      <h2>1. Treino de força, não só caminhada</h2>
      <p>
        O treino de força é o sinal mais forte para o corpo manter o músculo
        enquanto perde peso. Numa meta-análise de 2018 com idosos com
        obesidade em dieta, a musculação três vezes por semana evitou
        <strong>93,5% da perda de massa magra</strong> causada pela restrição
        de calorias. O estudo não era com Mounjaro, mas o mecanismo é o mesmo:
        déficit grande, músculo em risco.
      </p>
      <p>
        Caminhar faz bem para a saúde e para o gasto do dia, mas não
        substitui a musculação nesse papel. Dá para treinar força em casa,
        com halteres e elásticos, desde que o treino fique mais difícil com o
        tempo — veja <a href="/musculacao/treino-em-casa-para-iniciantes/">treino
        em casa para iniciantes</a>. Como ajustar volume e intensidade nesta
        fase está em <a href="/mounjaro-e-treino/treino-para-quem-usa-mounjaro/">treino
        para quem usa Mounjaro</a>, e os princípios gerais, em
        <a href="/emagrecimento/como-preservar-massa-muscular-emagrecendo/">como
        preservar massa muscular emagrecendo</a>.
      </p>

      <FerramentaInline
        id="auditoria"
        texto="Nem todo treino que se chama de força entrega estímulo de força. A análise olha o seu treino atual e diz se ele está protegendo massa magra — ou só gastando energia que agora está escassa."
        acao="Analisar se o meu treino protege massa muscular"
      />

      <p>
        Nos dias seguintes à aplicação em que vêm náusea ou falta de energia,
        reduza a intensidade em vez de faltar. O passo a passo está em
        <a href="/mounjaro-e-treino/nausea-e-treino/">náusea e treino</a>.
      </p>

      <h2>2. Proteína em todas as refeições</h2>
      <p>
        Numa meta-análise de 2016 com adultos acima de 50 anos em dieta, quem
        comeu mais proteína <strong>manteve mais massa magra e perdeu mais
        gordura</strong> do que quem comeu a quantidade habitual.
      </p>
      <p>
        Com o Mounjaro, o desafio é comer essa proteína com pouca fome. Ter
        uma fonte de proteína em todas as refeições — carnes, ovos,
        laticínios, leguminosas — ajuda a não deixar ela de lado quando o
        prato fica menor. Pular refeições por falta de apetite vai na direção
        contrária. <strong>A quantidade certa para você é definida pelo
        nutricionista</strong>, junto com o médico, porque depende do peso, da
        composição corporal e da saúde de cada um.
      </p>

      <h2>Como saber se você está perdendo músculo</h2>
      <ul>
        <li>
          <strong>Força:</strong> anote as cargas do treino. Se elas caem
          semana após semana, sem relação com um dia ruim, é o sinal mais
          informativo.
        </li>
        <li>
          <strong>Medidas:</strong> braço e coxa, sempre no mesmo ponto,
          mostram mais do que a balança.
        </li>
        <li>
          <strong>Composição corporal:</strong> a bioimpedância ajuda, desde
          que repetida nas mesmas condições — veja
          <a href="/emagrecimento/bioimpedancia/">como ler a bioimpedância</a>.
        </li>
        <li>
          <strong>Cansaço que não passa:</strong> fadiga persistente, mesmo
          fora do treino, é motivo para falar com o médico.
        </li>
      </ul>
      <p>
        A balança sozinha engana: ela mostra o peso total, mas não separa o
        que saiu de gordura e o que saiu de massa magra.
      </p>

      <h2>Existe um "novo Mounjaro" que não perde massa magra?</h2>
      <p>
        O noticiário fala de moléculas novas e de combinações em estudo para
        reduzir a perda de músculo durante o emagrecimento com remédio. São
        pesquisas, e qualquer medicamento é decisão do médico. O que está ao
        seu alcance hoje continua sendo o treino de força e a proteína.
      </p>

      <div class="callout">
        <strong>Resumindo:</strong> treino de força regular — ajustado por um
        <a href="/guias/personal-trainer-para-emagrecimento/">profissional de educação física</a> —
        e proteína em todas as refeições, na quantidade definida pelo
        nutricionista. Nenhum dos dois garante perda zero de músculo, mas
        juntos melhoram muito a qualidade do resultado, em linha com o que
        orientam entidades como a
        <a href={nsca.url} target="_blank" rel="noopener">{nsca.nome}</a>
        e a
        <a href={sbme.url} target="_blank" rel="noopener">{sbme.nome}</a>.
        Decisões sobre o medicamento são sempre do seu médico.
      </div>

      <h2>Referências</h2>
      <ul class="fontes">
        <li><a href="https://pubmed.ncbi.nlm.nih.gov/39996356/" target="_blank" rel="noopener noreferrer">Look M, Dunn JP, Kushner RF, et al. Body composition changes during weight reduction with tirzepatide in the SURMOUNT-1 study of adults with obesity or overweight. Diabetes, Obesity and Metabolism, 2025</a></li>
        <li><a href="https://pubmed.ncbi.nlm.nih.gov/29596307/" target="_blank" rel="noopener noreferrer">Sardeli AV, Komatsu TR, Mori MA, et al. Resistance Training Prevents Muscle Loss Induced by Caloric Restriction in Obese Elderly Individuals: A Systematic Review and Meta-Analysis. Nutrients, 2018</a></li>
        <li><a href="https://pubmed.ncbi.nlm.nih.gov/26883880/" target="_blank" rel="noopener noreferrer">Kim JE, O'Connor LE, Sands LP, et al. Effects of dietary protein intake on body composition changes after weight loss in older adults: a systematic review and meta-analysis. Nutrition Reviews, 2016</a></li>
        <li>Conferidas em 16/11/2026.</li>
      </ul>
    </div>

    <VideoYouTube
      id="ul6Xi60zPeY"
      titulo="Montinho: usa Mounjaro? O peso cai, mas o que você está perdendo?"
      legenda="No vídeo: Montinho sobre o que se perde junto com o peso no tratamento e por que, no treino, menos é mais. Conteúdo educativo; o uso do medicamento é sempre com acompanhamento médico."
      short
    />

    <Faq faqs={faqs} />

    <ContextualCta path={path} assunto={title} />
    <InstagramFollow tema="geral" />
    <AutorMontinho />

    <RelatedArticles itens={relacionados} />
    </article>

    <Sidebar />
  </div>

  <section class="section-sm">
    <div class="container">
      <CtaMontinho variante="destaque" />
    </div>
  </section>
</Base>

<style>
  .guide-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-6);
    padding-block: var(--sp-7);
  }
  @media (min-width: 980px) {
    .guide-layout {
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: var(--sp-7);
    }
  }
  .article-page {
    min-width: 0;
    max-width: 760px;
  }
  .updated {
    color: var(--muted);
    font-size: var(--step--1);
    margin-top: var(--sp-2);
  }
  .lead {
    margin-top: var(--sp-4);
    font-size: var(--step-1);
    color: var(--ink-soft);
    line-height: 1.55;
  }
  .article-page .prose {
    margin-top: var(--sp-5);
  }
  .fontes {
    font-size: var(--step--1);
    color: var(--ink-soft);
    line-height: 1.6;
  }
</style>
