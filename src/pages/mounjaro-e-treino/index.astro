---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { breadcrumbSchema, itemListSchema } from '../../lib/schema';
import { site } from '../../data/site';
import { rotas } from '../../lib/links';
import ContextualCta from '../../components/ContextualCta.astro';

const path = '/mounjaro-e-treino';
const crumbs = [
  { nome: 'Início', url: '/' },
  { nome: 'Mounjaro e Treino', url: path },
];

const artigos = [
  {
    url: '/mounjaro-e-treino/mounjaro-e-musculacao/',
    titulo: 'Quem usa Mounjaro pode fazer musculação?',
    desc: 'Por que o treino de força é especialmente relevante durante o uso do medicamento, e o que conversar com o médico antes.',
    tag: 'Musculação',
  },
  {
    url: '/mounjaro-e-treino/como-evitar-perda-de-massa-muscular/',
    titulo: 'Como evitar perda de massa muscular usando Mounjaro',
    desc: 'O que os estudos mostram sobre perda de massa magra em emagrecimentos rápidos, e o papel do treino de força e da proteína.',
    tag: 'Massa muscular',
  },
  {
    url: '/mounjaro-e-treino/treino-para-quem-usa-mounjaro/',
    titulo: 'Treino para quem usa Mounjaro: como adaptar',
    desc: 'Como ajustar intensidade, volume e cardio a uma fase de menor ingestão calórica — sem promessas nem radicalismo.',
    tag: 'Adaptação do treino',
  },
  {
    url: '/mounjaro-e-treino/fraqueza-para-treinar/',
    titulo: 'Mounjaro dá fraqueza para treinar? O que fazer',
    desc: 'Por que a disposição pode cair em algumas fases, como manejar o treino nos dias ruins e quando procurar o médico.',
    tag: 'Energia e disposição',
  },
  {
    url: '/mounjaro-e-treino/quanto-tempo-dura-a-fraqueza/',
    titulo: 'Quanto tempo dura a fraqueza do Mounjaro?',
    desc: 'Por que a disposição vem em ondas e volta a cada aumento de dose, o que fazer com o treino enquanto passa e quando o tempo vira sinal de alerta.',
    tag: 'Energia e disposição',
  },
  {
    url: '/mounjaro-e-treino/perda-de-forca-no-mounjaro/',
    titulo: 'Mounjaro e perda de força: o que muda no treino',
    desc: 'A diferença entre um dia sem energia e uma queda que persiste por semanas, como ajustar carga sem perder estímulo e quando levar ao médico.',
    tag: 'Força e massa magra',
  },
  {
    url: '/mounjaro-e-treino/fraqueza-nas-pernas/',
    titulo: 'Fraqueza nas pernas com Mounjaro: o que pode ser',
    desc: 'Por que as pernas sentem primeiro, como adaptar o treino de membros inferiores e quais sinais não são assunto de treino.',
    tag: 'Energia e disposição',
  },
  {
    url: '/mounjaro-e-treino/parei-o-mounjaro/',
    titulo: 'Parei o Mounjaro: como manter peso e massa muscular',
    desc: 'O que muda quando o tratamento acaba, por que a fome volta com força e qual o papel real do treino de força na manutenção.',
    tag: 'Depois do tratamento',
  },
  {
    url: '/mounjaro-e-treino/nausea-e-treino/',
    titulo: 'Náusea e treino: como organizar a semana',
    desc: 'O critério para treinar ou descansar, como encontrar a janela do dia em que o corpo coopera e o que ajustar na sessão.',
    tag: 'Efeitos e rotina',
  },
  {
    url: '/mounjaro-e-treino/caibras-e-hidratacao/',
    titulo: 'Cãibras em quem usa Mounjaro: o que fazer no treino',
    desc: 'O que fazer no momento, o que ajustar no treino e por que suplementar mineral por conta própria atrapalha mais do que ajuda.',
    tag: 'Efeitos e rotina',
  },
  {
    url: '/mounjaro-e-treino/mounjaro-e-idosos/',
    titulo: 'Mounjaro e treino depois dos 60: o que muda',
    desc: 'Por que a margem menor muda o plano, por que treinar leve demais é o erro mais caro dessa faixa e o sinal que não existe nas outras idades.',
    tag: 'Depois dos 60',
  },
  {
    url: '/mounjaro-e-treino/cardio-para-quem-usa-mounjaro/',
    titulo: 'Cardio para quem usa Mounjaro: como encaixar sem perder músculo',
    desc: 'O papel do cardio durante o tratamento, por que ele não substitui o treino de força e como combinar os dois na semana.',
    tag: 'Cardio',
  },
  {
    url: '/mounjaro-e-treino/ozempic-e-treino/',
    titulo: 'Ozempic e treino: como adaptar a musculação',
    desc: 'A indicação original do medicamento, a queda de energia das primeiras semanas e o que muda quando o tratamento acaba.',
    tag: 'Ozempic',
  },
];

const title = 'Mounjaro e treino: musculação, massa muscular e adaptação do exercício';
const description =
  'Conteúdo educativo sobre exercício para quem usa Mounjaro (tirzepatida): musculação, preservação de massa muscular e adaptação do treino. Não substitui orientação médica.';

const capa = '/capas-conteudo/mounjaro-e-treino.webp';
const capaAlt =
  'Arte da capa: silhueta segurando um halter ao lado da palavra massa muscular em destaque — Mounjaro e treino: musculação e preservação de massa muscular — Personal por Perto';

const schema = [
  breadcrumbSchema(crumbs),
  itemListSchema('Artigos sobre Mounjaro e treino', artigos.map((a) => a.titulo), new URL(path, site.dominio).href),
];
---

<Base title={title} description={description} path={path} image={capa} schema={schema}>
  <Breadcrumbs crumbs={crumbs} />
  <header class="section-sm tint">
    <div class="container">
      <p class="eyebrow">Conteúdo editorial · Exercício e saúde</p>
      <h1>Mounjaro e Treino</h1>
      <p class="lead" style="max-width: 62ch">
        Conteúdos educativos sobre exercício físico para quem usa Mounjaro
        (tirzepatida) sob prescrição médica — com foco em treino de força,
        preservação de massa muscular e adaptação da rotina.
      </p>
      <p class="aviso-medico" style="max-width: 62ch">
        <strong>Aviso importante:</strong> este conteúdo trata de exercício, não
        de medicamento. Não inicie, interrompa nem ajuste dose de nenhum
        medicamento por conta própria — decisões sobre o tratamento são do seu
        médico. Em caso de sintomas, procure atendimento de saúde.
      </p>
      <figure style="margin: var(--sp-6) 0 0; max-width: 720px">
        <img
          src={capa}
          alt={capaAlt}
          width="1200"
          height="675"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          style="display: block; width: 100%; height: auto; border-radius: var(--radius-lg); box-shadow: var(--shadow-lg)"
        />
      </figure>

    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="grid grid-2">
        {
          artigos.map((a) => (
            <a class="card card-hover guide" href={a.url}>
              <span class="pill">{a.tag}</span>
              <h2>{a.titulo}</h2>
              <p>{a.desc}</p>
              <span class="guide-link">Ler artigo →</span>
            </a>
          ))
        }
      </div>
      <p class="muted small" style="margin-top: var(--sp-6)">
        A base de ciência do exercício por trás destes artigos está nos
        conteúdos de <a href={rotas.emagrecimento}>emagrecimento</a> e de
        <a href={rotas.musculacao}>musculação</a>. Para acompanhamento
        individualizado, veja <a href="/guias/personal-trainer-para-emagrecimento/">como
        escolher um personal trainer com experiência em emagrecimento</a>.
      </p>
    </div>
  </section>

  <section class="section-sm">
    <div class="container container-narrow">
      <ContextualCta path={path} assunto={title} />
    </div>
  </section>
</Base>

<style>
  .guide {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--ink);
  }
  .guide:hover {
    text-decoration: none;
  }
  .guide h2 {
    font-size: var(--step-2);
  }
  .guide p {
    color: var(--ink-soft);
    flex: 1;
  }
  .guide-link {
    font-weight: 700;
    color: var(--brand-600);
  }
  .small {
    font-size: var(--step--1);
  }
  .aviso-medico {
    margin-top: var(--sp-4);
    padding: var(--sp-4);
    background: #fff;
    border: 1px solid var(--line);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius);
    font-size: var(--step--1);
    color: var(--ink-soft);
    line-height: 1.6;
  }
</style>
