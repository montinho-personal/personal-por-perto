---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { breadcrumbSchema, itemListSchema } from '../../lib/schema';
import { site } from '../../data/site';
import { rotas } from '../../lib/links';

const path = '/mounjaro-e-treino';
const crumbs = [
  { nome: 'Início', url: '/' },
  { nome: 'Mounjaro e Treino', url: path },
];

const artigos = [
  {
    url: '/mounjaro-e-treino/mounjaro-e-musculacao/',
    titulo: 'Quem usa Mounjaro pode fazer musculação?',
    desc: 'Por que o treino de força é especialmente relevante durante o uso do medicamento, e o que conversar com o médico antes.',
    tag: 'Musculação',
  },
  {
    url: '/mounjaro-e-treino/como-evitar-perda-de-massa-muscular/',
    titulo: 'Como evitar perda de massa muscular usando Mounjaro',
    desc: 'O que os estudos mostram sobre perda de massa magra em emagrecimentos rápidos, e o papel do treino de força e da proteína.',
    tag: 'Massa muscular',
  },
  {
    url: '/mounjaro-e-treino/treino-para-quem-usa-mounjaro/',
    titulo: 'Treino para quem usa Mounjaro: como adaptar',
    desc: 'Como ajustar intensidade, volume e cardio a uma fase de menor ingestão calórica — sem promessas nem radicalismo.',
    tag: 'Adaptação do treino',
  },
  {
    url: '/mounjaro-e-treino/fraqueza-para-treinar/',
    titulo: 'Mounjaro dá fraqueza para treinar? O que fazer',
    desc: 'Por que a disposição pode cair em algumas fases, como manejar o treino nos dias ruins e quando procurar o médico.',
    tag: 'Energia e disposição',
  },
  {
    url: '/mounjaro-e-treino/cardio-para-quem-usa-mounjaro/',
    titulo: 'Cardio para quem usa Mounjaro: como encaixar sem perder músculo',
    desc: 'O papel do cardio durante o tratamento, por que ele não substitui o treino de força e como combinar os dois na semana.',
    tag: 'Cardio',
  },
];

const title = 'Mounjaro e treino: musculação, massa muscular e adaptação do exercício';
const description =
  'Conteúdo educativo sobre exercício para quem usa Mounjaro (tirzepatida): musculação, preservação de massa muscular e adaptação do treino. Não substitui orientação médica.';

const schema = [
  breadcrumbSchema(crumbs),
  itemListSchema('Artigos sobre Mounjaro e treino', artigos.map((a) => a.titulo), new URL(path, site.dominio).href),
];
---

<Base title={title} description={description} path={path} schema={schema}>
  <Breadcrumbs crumbs={crumbs} />
  <header class="section-sm tint">
    <div class="container">
      <p class="eyebrow">Conteúdo editorial · Exercício e saúde</p>
      <h1>Mounjaro e Treino</h1>
      <p class="lead" style="max-width: 62ch">
        Conteúdos educativos sobre exercício físico para quem usa Mounjaro
        (tirzepatida) sob prescrição médica — com foco em treino de força,
        preservação de massa muscular e adaptação da rotina.
      </p>
      <p class="aviso-medico" style="max-width: 62ch">
        <strong>Aviso importante:</strong> este conteúdo trata de exercício, não
        de medicamento. Não inicie, interrompa nem ajuste dose de nenhum
        medicamento por conta própria — decisões sobre o tratamento são do seu
        médico. Em caso de sintomas, procure atendimento de saúde.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="grid grid-2">
        {
          artigos.map((a) => (
            <a class="card card-hover guide" href={a.url}>
              <span class="pill">{a.tag}</span>
              <h2>{a.titulo}</h2>
              <p>{a.desc}</p>
              <span class="guide-link">Ler artigo →</span>
            </a>
          ))
        }
      </div>
      <p class="muted small" style="margin-top: var(--sp-6)">
        A base de ciência do exercício por trás destes artigos está nos
        conteúdos de <a href={rotas.emagrecimento}>emagrecimento</a> e de
        <a href={rotas.musculacao}>musculação</a>. Para acompanhamento
        individualizado, veja <a href="/guias/personal-trainer-para-emagrecimento/">como
        escolher um personal trainer com experiência em emagrecimento</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .guide {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--ink);
  }
  .guide:hover {
    text-decoration: none;
  }
  .guide h2 {
    font-size: var(--step-2);
  }
  .guide p {
    color: var(--ink-soft);
    flex: 1;
  }
  .guide-link {
    font-weight: 700;
    color: var(--brand-600);
  }
  .small {
    font-size: var(--step--1);
  }
  .aviso-medico {
    margin-top: var(--sp-4);
    padding: var(--sp-4);
    background: #fff;
    border: 1px solid var(--line);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius);
    font-size: var(--step--1);
    color: var(--ink-soft);
    line-height: 1.6;
  }
</style>
