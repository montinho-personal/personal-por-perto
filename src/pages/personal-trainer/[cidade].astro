---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Toc from '../../components/Toc.astro';
import Faq from '../../components/Faq.astro';
import CtaMontinho from '../../components/CtaMontinho.astro';
import CityCard from '../../components/CityCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import InstagramFollow from '../../components/InstagramFollow.astro';
import AutorMontinho from '../../components/AutorMontinho.astro';
import WhatsAppCta from '../../components/WhatsAppCta.astro';
import { whatsappUrl } from '../../lib/links';
import { cidades, relacionadas, vizinhasDe, getCidade } from '../../data/cidades';
import { cityFaqs } from '../../lib/cityFaqs';
import { rotas, anchorCidade, anchorComoEscolher, anchorQuantoCusta } from '../../lib/links';
import { fontesExternas } from '../../data/fontesExternas';
import { formatNumber, faixaBRL, formatDateLong, formatBRL } from '../../lib/slug';
import {
  breadcrumbSchema,
  faqSchema,
  articleSchema,
  itemListSchema,
  servicoCidadeSchema,
  personMontinhoSchema,
} from '../../lib/schema';
import { site } from '../../data/site';

export function getStaticPaths() {
  return cidades.map((cidade) => ({
    params: { cidade: cidade.slug },
    props: { cidade },
  }));
}

const { cidade } = Astro.props;
const n = cidade.nome;
const path = `/personal-trainer/${cidade.slug}`;
const url = new URL(path, site.dominio).href;

// Capa única da cidade (gerada por scripts/gen-capas.ts): WebP na página,
// PNG para Open Graph e dados estruturados.
const capaWebp = `/capas/personal-trainer-${cidade.slug}.webp`;
const capaPng = `/capas/personal-trainer-${cidade.slug}.png`;
const capaAlt = `Personal trainer em ${n} (${cidade.uf}) — guia do Personal por Perto`;

// Alphaville é a base presencial do profissional destacado: a página usa
// fotos reais no lugar da capa padrão + vídeo do personal. Santana de
// Parnaíba (parte do complexo) também recebe fotos reais no corpo.
const ehAlphaville = cidade.slug === 'alphaville-sp';
const ehSantana = cidade.slug === 'santana-de-parnaiba-sp';
const ehBarueri = cidade.slug === 'barueri-sp';
const ehAldeia = cidade.slug === 'aldeia-da-serra-sp';
const ehTambore = cidade.slug === 'tambore-sp';
const fotoTransformacao = '/montinho/personal-trainer-alphaville.webp';
const altTransformacao =
  'Antes e depois do Montinho Personal, personal trainer em Alphaville: da adolescência com sobrepeso ao físico definido após mais de 20 anos de musculação';

// Arte de capa personalizada (cartão-postal local): quando presente,
// substitui a capa gerada no hero, no Open Graph e no sitemap de imagens.
const capaArte = cidade.capaArte;
const imagemOg = capaArte ? capaArte.src : ehAlphaville ? fotoTransformacao : capaPng;
// Dimensões reais do criativo: paisagem 3:2 (padrão) ou retrato 2:3 (pôster).
const capaW = capaArte?.vertical ? 1000 : 1200;
const capaH = capaArte?.vertical ? 1500 : 800;

const faqs = cityFaqs(cidade);
const relac = relacionadas(cidade, 4);
// Vizinhas reais (geográficas) para linkagem contextual na prosa.
const vizinhas = vizinhasDe(cidade);
const viz1 = vizinhas[0];
const viz2 = vizinhas[1];
const oms = fontesExternas.oms;
const ms = fontesExternas.ministerioSaude;
const nsca = fontesExternas.nsca;
const acsm = fontesExternas.acsm;

const isRegiao = cidade.tipo === 'regiao';
const cidadeMae = cidade.cidadeMae ? getCidade(cidade.cidadeMae) : undefined;

// Breadcrumb: regiões ganham o município "mãe" no caminho.
const crumbs = [
  { nome: 'Início', url: '/' },
  { nome: 'Cidades', url: '/personal-trainer/' },
  { nome: cidade.estado, url: `/estado/${cidade.estadoSlug}/` },
  ...(cidadeMae
    ? [{ nome: cidadeMae.nome, url: `/personal-trainer/${cidadeMae.slug}/` }]
    : []),
  { nome: n, url: path },
];

// Texto da seção "Mercado de Personal Trainers" (usa dado próprio ou fallback).
const mercadoTexto =
  cidade.mercado ??
  `O mercado de personal trainers em ${n} acompanha a oferta de academias, estúdios e espaços ao ar livre da região. ${cidade.academias ?? ''} A procura tende a crescer entre quem busca constância, orientação segura e um treino desenhado para o próprio objetivo.`;

const conclusaoTexto =
  cidade.conclusao ??
  `Contratar um personal trainer em ${n} é investir em segurança, método e constância. Com a estrutura local certa e um profissional alinhado ao seu objetivo, fica muito mais fácil treinar bem e manter o resultado ao longo do tempo.`;

const toc = [
  { id: 'panorama', label: `Panorama de ${n}` },
  { id: 'mercado', label: 'Mercado de personais' },
  { id: 'como-escolher', label: 'Como escolher' },
  { id: 'precos', label: 'Quanto custa' },
  { id: 'onde-treinar', label: 'Onde treinar' },
  { id: 'objetivos', label: 'Treino por objetivo' },
  { id: 'beneficios', label: 'Benefícios' },
  { id: 'avaliar', label: 'Como avaliar' },
  { id: 'perguntas-frequentes', label: 'Perguntas frequentes' },
  { id: 'conclusao', label: 'Conclusão' },
];

const tiposTreino = [
  'Treino para emagrecimento',
  'Treino para hipertrofia',
  'Treino para iniciantes',
  'Treino feminino',
  'Treino para idosos',
  'Treino ao ar livre',
];

const title = `Personal Trainer em ${n} (${cidade.uf}): guia completo e quanto custa`;
const description = `Como escolher um personal trainer em ${n} (${cidade.uf}), quanto custa (${faixaBRL(
  cidade.precos.avulsaMin,
  cidade.precos.avulsaMax,
)} a aula), onde treinar e dicas por objetivo. Guia editorial independente, atualizado.`;

const schema = [
  breadcrumbSchema(crumbs),
  articleSchema({
    titulo: title,
    descricao: description,
    url,
    imagem: new URL(capaPng, site.dominio).href,
    atualizadoEm: cidade.atualizadoEm,
  }),
  servicoCidadeSchema(cidade),
  itemListSchema(`Tipos de treino com personal trainer em ${n}`, tiposTreino, url),
  faqSchema(faqs),
  personMontinhoSchema(),
];

const objetivoDesc: Record<string, string> = {
  'Treino para emagrecimento':
    'Combina exercícios de força e condicionamento com gasto calórico controlado e progressão gradual. É a especialidade do acompanhamento online mais procurado por quem precisa de constância.',
  'Treino para hipertrofia':
    'Foca em ganho de massa muscular com periodização de cargas, volume adequado e técnica correta para evoluir sem lesões.',
  'Treino para iniciantes':
    'Começa pela adaptação do corpo, aprendizado dos movimentos e construção de hábito, com cargas leves e muita atenção à execução.',
  'Treino feminino':
    'Respeita objetivos e fases específicas, do fortalecimento de glúteos e core ao condicionamento geral, sem mitos sobre "ficar masculinizada".',
  'Treino para idosos':
    'Prioriza força funcional, equilíbrio e prevenção de quedas, com avaliação cuidadosa e respeito às condições de saúde.',
  'Treino ao ar livre':
    `Aproveita os espaços públicos de ${n} para treino funcional, corrida e mobilidade, uma alternativa econômica e prazerosa ao ambiente fechado.`,
};
---

<Base title={title} description={description} path={path} ogType="article" image={imagemOg} schema={schema}>
  <Breadcrumbs crumbs={crumbs} />

  <!-- HERO -->
  <header class="hero">
    <div class="container">
      <p class="eyebrow">
        {isRegiao ? 'Guia da região' : 'Guia da cidade'} · {cidade.contexto ?? cidade.estado}
      </p>
      <h1>Personal Trainer em {n} <span>({cidade.uf})</span></h1>
      <p class="hero-intro">
        Contratar um personal trainer em {n} significa ter um treino desenhado para
        o seu objetivo, com acompanhamento de quem entende o ritmo {isRegiao ? 'da região' : 'da cidade'} — das
        academias e condomínios aos parques ao ar livre. Os valores variam de
        <strong>{faixaBRL(cidade.precos.avulsaMin, cidade.precos.avulsaMax)}</strong> por
        aula avulsa, e o formato online costuma ser a opção mais acessível e flexível.
      </p>

      <div class="trust-strip">
        <span>✔ Guia editorial independente</span>
        <span>✔ Dados locais reais e fontes oficiais</span>
        <span>✔ Atualizado em {formatDateLong(cidade.atualizadoEm)}</span>
      </div>

      {
        capaArte ? (
          <figure class={capaArte.vertical ? 'capa capa-vertical' : 'capa'}>
            <img
              src={capaArte.src}
              alt={capaArte.alt}
              width={capaW}
              height={capaH}
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
            <figcaption>{capaArte.legenda}</figcaption>
          </figure>
        ) : ehAlphaville ? (
          <figure class="capa">
            <img
              src={fotoTransformacao}
              alt={altTransformacao}
              width="1200"
              height="1200"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
            <figcaption>
              Transformação real do Montinho Personal — mais de 40 kg eliminados e a
              vivência que hoje orienta alunos em Alphaville e região.
            </figcaption>
          </figure>
        ) : (
          <figure class="capa">
            <picture>
              <source srcset={capaWebp} type="image/webp" />
              <img
                src={capaPng}
                alt={capaAlt}
                width="1200"
                height="630"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </picture>
            <figcaption>
              Guia de personal trainer em {n} ({cidade.uf}) — panorama local, faixas de
              preço e onde treinar. Personal por Perto.
            </figcaption>
          </figure>
        )
      }
    </div>
  </header>

  <!-- STATS -->
  <section class="stats-band">
    <div class="container stats-grid">
      {
        cidade.populacao && (
          <div class="stat">
            <div class="stat-num">{formatNumber(cidade.populacao)}</div>
            <div class="stat-label">habitantes (Censo {cidade.populacaoAno})</div>
          </div>
        )
      }
      {
        cidade.idhm && (
          <div class="stat">
            <div class="stat-num">{cidade.idhm.toLocaleString('pt-BR')}</div>
            <div class="stat-label">IDHM ({cidade.idhmClasse})</div>
          </div>
        )
      }
      {
        isRegiao && cidadeMae && (
          <div class="stat">
            <div class="stat-num">{cidadeMae.uf}</div>
            <div class="stat-label">{cidade.contexto ?? `Região de ${cidadeMae.nome}`}</div>
          </div>
        )
      }
      <div class="stat">
        <div class="stat-num">{cidade.parques.length}+</div>
        <div class="stat-label">espaços para treino citados</div>
      </div>
      <div class="stat">
        <div class="stat-num">{formatBRL(cidade.precos.onlineMin)}</div>
        <div class="stat-label">a partir de / mês (online)</div>
      </div>
    </div>
  </section>

  <!-- CORPO -->
  <div class="container layout">
    <article class="prose article">
      <section id="panorama">
        <h2>Panorama de {n} para quem treina</h2>
        <p>{cidade.resumoEconomico}</p>
        <p>
          Para quem leva o treino a sério, vale entender o contexto local. {cidade.culturaEsportiva}
        </p>
        <div class="callout">
          <strong>Clima e treino:</strong>
          {cidade.clima} {cidade.climaTreino}
        </div>
        <p>
          A mobilidade também pesa na decisão. {cidade.mobilidade} Na prática, isso
          influencia a escolha entre treinar perto de casa, do trabalho ou contar com
          um personal que vá até você.
        </p>
        {
          cidade.bairrosNobres.length > 0 && (
            <p>
              A demanda por personal trainer se concentra em bairros como{' '}
              <strong>{cidade.bairrosNobres.slice(0, 4).join(', ')}</strong>, mas a oferta
              cresce em toda a cidade, incluindo regiões como {cidade.bairrosPopulares.slice(0, 3).join(', ')}.
            </p>
          )
        }
        {
          viz1 && (
            <p>
              {n} também está perto de outras localidades com boa estrutura para treino:
              quem mora na divisa costuma considerar um{' '}
              <a href={`/personal-trainer/${viz1.slug}/`}>{anchorCidade(viz1, 0)}</a>
              {viz2 && (
                <>
                  {' '}ou mesmo o{' '}
                  <a href={`/personal-trainer/${viz2.slug}/`}>{anchorCidade(viz2, 2)}</a>
                </>
              )}, dependendo de onde fica a academia ou o trabalho.
            </p>
          )
        }
      </section>

      <section id="mercado">
        <h2>O mercado de personal trainers em {n}</h2>
        <p>{mercadoTexto}</p>
        {
          cidade.destaquesFitness.length > 0 && (
            <>
              <p>Em resumo, o que define o cenário de treino em {n}:</p>
              <ul class="check-list">
                {cidade.destaquesFitness.map((d) => (<li>{d}</li>))}
              </ul>
            </>
          )
        }
      </section>

      <section id="como-escolher">
        <h2>Como escolher um personal trainer em {n}</h2>
        <p>
          Escolher um bom profissional é menos sobre preço e mais sobre adequação ao
          seu objetivo. Antes de fechar, considere estes pontos:
        </p>
        <ul class="check-list">
          <li>
            <strong>Registro profissional ativo:</strong> é o que garante que o
            profissional pode prescrever treino legalmente — peça o número e confirme a
            habilitação.
          </li>
          <li><strong>Experiência com o seu objetivo:</strong> emagrecimento, hipertrofia, reabilitação e performance pedem abordagens diferentes.</li>
          <li><strong>Avaliação inicial:</strong> um bom personal avalia antes de prescrever — não entrega treino genérico.</li>
          <li><strong>Logística:</strong> em {n}, pese a distância e o trânsito; às vezes o online resolve melhor a sua rotina.</li>
          <li><strong>Método e acompanhamento:</strong> como ele mede evolução, reavalia e ajusta o plano ao longo do tempo.</li>
        </ul>
        <p>
          Esses critérios valem para qualquer cidade — o guia
          <a href={rotas.comoEscolher}>{anchorComoEscolher(0)}</a> detalha cada um deles
          com exemplos e sinais de alerta. A seção <a href="#avaliar">Como avaliar um
          profissional</a> logo abaixo traz o passo a passo prático. E, se a sua
          prioridade é constância sem depender de deslocamento, vale olhar o
          <a href="#objetivos">treino por objetivo</a> e o formato online.
        </p>
      </section>

      <section id="precos">
        <h2>Quanto custa um personal trainer em {n}?</h2>
        <p>
          Em {n}, uma aula avulsa presencial costuma custar entre
          <strong>{faixaBRL(cidade.precos.avulsaMin, cidade.precos.avulsaMax)}</strong>.
          Pacotes mensais saem mais em conta por sessão, e o
          <a href="/guias/personal-online-funciona/">acompanhamento online</a> é,
          em geral, a opção mais econômica. Veja as faixas médias de mercado:
        </p>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Formato</th>
                <th>Faixa de preço</th>
                <th>Melhor para</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Aula avulsa (presencial)</td>
                <td>{faixaBRL(cidade.precos.avulsaMin, cidade.precos.avulsaMax)}</td>
                <td>Experimentar ou treinos pontuais</td>
              </tr>
              <tr>
                <td>Pacote mensal (2–3x/semana)</td>
                <td>{faixaBRL(cidade.precos.mensalMin, cidade.precos.mensalMax)}</td>
                <td>Quem quer presença e constância</td>
              </tr>
              <tr>
                <td>Acompanhamento online (mês)</td>
                <td>{faixaBRL(cidade.precos.onlineMin, cidade.precos.onlineMax)}</td>
                <td>Rotina apertada e melhor custo-benefício</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="muted small">
          Valores médios de mercado, apenas para referência. Podem variar conforme a
          experiência do profissional, o bairro, a estrutura usada e a frequência.
        </p>
        <p>
          Para comparar os formatos com calma e entender o que faz o preço subir ou
          cair, veja o guia <a href={rotas.quantoCusta}>{anchorQuantoCusta(1)}</a>, com
          tabela por cidade e dicas de como economizar sem perder qualidade.
        </p>
      </section>

      {
        ehTambore && (
          <section id="conheca-o-personal">
            <h2>Conheça o personal que atende Tamboré</h2>
            <p>
              O <strong>Montinho Personal</strong>, destacado pelo portal, tem base
              na vizinha Alphaville e chega aos residenciais Tamboré em poucos
              minutos — atendendo em casa, na academia do condomínio ou em
              academias da região. A jornada é a credencial: mais de 40 kg
              eliminados e mais de 20 anos de musculação:
            </p>
            <div class="fotos-grid">
              <figure class="foto-personal">
                <img
                  src="/montinho/personal-trainer-tambore.webp"
                  alt="Montinho Personal em academia após o treino, com o físico definido por mais de 20 anos de musculação — personal trainer que atende Tamboré, Alphaville e região"
                  width="900"
                  height="1599"
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>
                  Rotina de treino em dia: a vivência que orienta os alunos de
                  Tamboré e região.
                </figcaption>
              </figure>
              <figure class="foto-personal">
                <img
                  src="/montinho/treinador-condominios-tambore.webp"
                  alt="Montinho Personal de frente ao espelho da academia, mostrando a definição do abdômen — treinador que atende os condomínios de Tamboré e Alphaville"
                  width="900"
                  height="975"
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>
                  Resultado que se mantém: o padrão levado aos atendimentos nos
                  condomínios de Tamboré.
                </figcaption>
              </figure>
            </div>
            <figure class="video-short">
              <iframe
                src="https://www.youtube-nocookie.com/embed/yndKE1GrnUQ"
                title="Vídeo do Montinho Personal, personal trainer que atende Tamboré"
                width="340"
                height="604"
                loading="lazy"
                allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
              />
              <figcaption>
                No vídeo: o Montinho Personal, profissional destacado pelo portal em
                Tamboré e região.
              </figcaption>
            </figure>
          </section>
        )
      }

      {
        ehAldeia && (
          <section id="conheca-o-personal">
            <h2>Conheça o personal que atende a Aldeia da Serra</h2>
            <p>
              O <strong>Montinho Personal</strong>, destacado pelo portal, tem base
              na vizinha Alphaville e chega às Moradas da Aldeia pela Estrada Dr.
              Yojiro Takaoka em poucos minutos. A jornada é a credencial: mais de
              40 kg eliminados e mais de 20 anos de musculação:
            </p>
            <div class="fotos-grid">
              <figure class="foto-personal">
                <img
                  src="/montinho/personal-trainer-aldeia-da-serra.webp"
                  alt="Antes e depois do Montinho Personal: da adolescência com sobrepeso ao físico definido — personal trainer que atende a Aldeia da Serra, Alphaville e região"
                  width="1200"
                  height="1200"
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>
                  Antes e depois reais: a transformação que virou método nos
                  atendimentos na Aldeia da Serra.
                </figcaption>
              </figure>
              <figure class="foto-personal">
                <img
                  src="/montinho/treinador-em-aldeia-da-serra.webp"
                  alt="Montinho Personal executando elevação de pernas na cadeira romana, com o abdômen contraído — treinador que atende a Aldeia da Serra e a região de Alphaville"
                  width="900"
                  height="1600"
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>
                  Execução antes de carga: o padrão que orienta os treinos em
                  condomínio e academia na Aldeia da Serra.
                </figcaption>
              </figure>
            </div>
            <figure class="video-short">
              <iframe
                src="https://www.youtube-nocookie.com/embed/yndKE1GrnUQ"
                title="Vídeo do Montinho Personal, personal trainer que atende a Aldeia da Serra"
                width="340"
                height="604"
                loading="lazy"
                allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
              />
              <figcaption>
                No vídeo: o Montinho Personal, profissional destacado pelo portal na
                Aldeia da Serra e região.
              </figcaption>
            </figure>
          </section>
        )
      }

      {
        ehBarueri && (
          <section id="conheca-o-personal">
            <h2>Conheça o personal que atende Barueri</h2>
            <p>
              O <strong>Montinho Personal</strong>, destacado pelo portal, tem base
              em Alphaville — distrito do próprio município — e atende de Barueri
              aos condomínios da região. A jornada é a credencial: mais de 40 kg
              eliminados e mais de 20 anos de musculação:
            </p>
            <div class="fotos-grid">
              <figure class="foto-personal">
                <img
                  src="/montinho/personal-trainer-barueri.webp"
                  alt="Antes e depois do Montinho Personal: transformação de mais de 40 kg — personal trainer que atende Barueri, Alphaville e região"
                  width="1200"
                  height="1200"
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>
                  Antes e depois reais: a transformação que virou método nos
                  atendimentos em Barueri.
                </figcaption>
              </figure>
              <figure class="foto-personal">
                <img
                  src="/montinho/treinador-em-barueri.webp"
                  alt="Montinho Personal de costas em pose de duplo bíceps ao ar livre — treinador que atende Barueri e a região oeste da Grande São Paulo"
                  width="900"
                  height="1600"
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>
                  Treino ao ar livre também faz parte do método — como nos parques
                  públicos de Barueri.
                </figcaption>
              </figure>
            </div>
            <figure class="video-short">
              <iframe
                src="https://www.youtube-nocookie.com/embed/yndKE1GrnUQ"
                title="Vídeo do Montinho Personal, personal trainer com base em Alphaville, Barueri"
                width="340"
                height="604"
                loading="lazy"
                allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
              />
              <figcaption>
                No vídeo: o Montinho Personal, profissional destacado pelo portal em
                Barueri e região.
              </figcaption>
