---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CityCard from '../../components/CityCard.astro';
import { cidades } from '../../data/cidades';
import { estados } from '../../data/estados';
import { breadcrumbSchema, itemListSchema } from '../../lib/schema';
import { emCidade } from '../../lib/gramatica';
import { site } from '../../data/site';

const path = '/personal-trainer';
const crumbs = [
  { nome: 'Início', url: '/' },
  { nome: 'Cidades', url: path },
];

const norm = (s: string) =>
  s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();

// Agrupa por estado (apenas estados com cidades publicadas)
const porEstado = estados
  .map((e) => ({
    estado: e,
    lista: cidades
      .filter((c) => c.estadoSlug === e.slug)
      .sort((a, b) => (b.populacao ?? 0) - (a.populacao ?? 0)),
  }))
  .filter((g) => g.lista.length > 0);

const title = 'Personal Trainer por cidade no Brasil — guias locais';
const description =
  'Encontre guias de personal trainer por cidade: quanto custa, como escolher, onde treinar e dicas locais. Cobertura crescente das principais cidades brasileiras.';

const schema = [
  breadcrumbSchema(crumbs),
  itemListSchema(
    'Cidades com guia de personal trainer',
    cidades.map((c) => `Personal Trainer ${emCidade(c)}`),
    new URL(path, site.dominio).href,
  ),
];
---

<Base title={title} description={description} path={path} schema={schema}>
  <Breadcrumbs crumbs={crumbs} />

  <header class="section-sm tint">
    <div class="container">
      <p class="eyebrow">Diretório de cidades</p>
      <h1>Personal Trainer por cidade</h1>
      <p class="lead" style="max-width: 62ch">
        Cada cidade tem seu próprio guia, com dados locais reais, faixas de preço,
        onde treinar e como escolher o profissional certo. Já são
        <strong>{cidades.length} cidades</strong> em {porEstado.length} estados.
      </p>

      <div class="busca-wrap">
        <label for="busca-cidade" class="sr-only">Buscar cidade</label>
        <span class="busca-ico" aria-hidden="true">🔎</span>
        <input
          type="search"
          id="busca-cidade"
          class="busca-input"
          placeholder="Buscar sua cidade ou estado (ex.: Goiânia, SP, Bahia)…"
          autocomplete="off"
        />
      </div>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <p class="busca-status" id="busca-status" aria-live="polite" hidden></p>

      <div class="grid grid-3" id="busca-resultados" hidden></div>

      <p class="busca-vazio" id="busca-vazio" hidden>
        Nenhuma cidade encontrada com esse nome. O portal cresce sempre — enquanto
        isso, o <a href="/montinho-personal/">acompanhamento online</a> atende todo o Brasil.
      </p>

      <div id="busca-browse">
        {
          porEstado.map(({ estado, lista }) => (
            <div class="estado-bloco" data-uf={estado.uf}>
              <div class="estado-head">
                <h2>
                  <a href={`/estado/${estado.slug}/`}>{estado.nome}</a>
                  <span class="pill pill-neutral">{estado.uf}</span>
                </h2>
                <a class="estado-link" href={`/estado/${estado.slug}/`}>
                  Ver hub do estado →
                </a>
              </div>
              <div class="grid grid-3">
                {lista.map((c) => (
                  <div
                    class="busca-item"
                    data-nome={norm(c.nome)}
                    data-uf={norm(c.uf)}
                    data-estado={norm(estado.nome)}
                  >
                    <CityCard cidade={c} />
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-sm tint">
    <div class="container text-center">
      <h2>Não encontrou a sua cidade?</h2>
      <p class="lead">
        O portal adiciona novas cidades constantemente. Enquanto isso, o
        acompanhamento online atende todo o Brasil.
      </p>
      <a class="btn btn-primary btn-lg" href="/montinho-personal/" style="margin-top: var(--sp-4)">
        Ver acompanhamento online
      </a>
    </div>
  </section>
</Base>

<script>
  const input = document.getElementById('busca-cidade') as HTMLInputElement | null;
  const items = Array.from(document.querySelectorAll<HTMLElement>('.busca-item'));
  const browse = document.getElementById('busca-browse');
  const resultados = document.getElementById('busca-resultados');
  const status = document.getElementById('busca-status');
  const vazio = document.getElementById('busca-vazio');

  // Normaliza: remove acentos, minúsculas, e simplifica (ç→c, hífens/espaços).
  const norm = (s: string) =>
    s
      .normalize('NFD')
      .replace(/[̀-ͯ]/g, '')
      .toLowerCase()
      .replace(/[^a-z0-9 ]/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();

  // Distância de edição aproximada de "pat" como SUBtrecho de "text"
  // (algoritmo de Sellers). Retorna o menor nº de erros para casar o termo
  // em qualquer parte do texto — tolera letra trocada, faltando ou sobrando.
  function fuzzy(text: string, pat: string): number {
    const n = text.length;
    const m = pat.length;
    if (m === 0) return 0;
    let prev = new Array(m + 1);
    for (let i = 0; i <= m; i++) prev[i] = i;
    let best = m;
    for (let j = 1; j <= n; j++) {
      const cur = new Array(m + 1);
      cur[0] = 0; // o casamento pode começar em qualquer posição do texto
      for (let i = 1; i <= m; i++) {
        const cost = text[j - 1] === pat[i - 1] ? 0 : 1;
        cur[i] = Math.min(prev[i - 1] + cost, prev[i] + 1, cur[i - 1] + 1);
      }
      if (cur[m] < best) best = cur[m];
      prev = cur;
    }
    return best;
  }

  // Erros tolerados conforme o tamanho do termo (quanto maior, mais folga).
  function maxErros(len: number): number {
    if (len <= 3) return 0;
    if (len <= 5) return 1;
    if (len <= 8) return 2;
    return 3;
  }

  // Pontua um item para o termo q. Menor = mais relevante. -1 = não casa.
  function pontuar(el: HTMLElement, q: string): number {
    const nome = el.dataset.nome || '';
    const uf = el.dataset.uf || '';
    const estado = el.dataset.estado || '';

    if (q.length <= 3 && uf === q) return 0; // sigla exata do estado (ex.: sp)
    if (nome.startsWith(q)) return 1; // começa com o termo
    if (nome.includes(q)) return 2; // contém o termo
    if (q.length >= 3 && estado.includes(q)) return 3; // nome do estado

    const erros = maxErros(q.length);
    if (erros > 0) {
      const dNome = fuzzy(nome, q); // typo no nome da cidade
      if (dNome <= erros) return 4 + dNome;
      if (q.length >= 4) {
        const dEstado = fuzzy(estado, q); // typo no nome do estado
        if (dEstado <= erros) return 8 + dEstado;
      }
    }
    return -1;
  }

  function filtrar() {
    if (!input || !browse || !resultados) return;
    const q = norm(input.value);

    // Sem termo: volta à navegação por estado.
    if (!q) {
      resultados.hidden = true;
      resultados.replaceChildren();
      browse.hidden = false;
      if (status) status.hidden = true;
      if (vazio) vazio.hidden = true;
      return;
    }

    // Com termo: lista única, ordenada por relevância.
    const achados: { el: HTMLElement; score: number; nome: string }[] = [];
    for (const el of items) {
      const score = pontuar(el, q);
      if (score >= 0) achados.push({ el, score, nome: el.dataset.nome || '' });
    }
    achados.sort((a, b) => a.score - b.score || a.nome.localeCompare(b.nome));

    browse.hidden = true;
    resultados.replaceChildren(
      ...achados.map(({ el }) => el.cloneNode(true) as HTMLElement),
    );
    resultados.hidden = achados.length === 0;

    if (status) {
      status.hidden = achados.length === 0;
      const n = achados.length;
      status.textContent =
        n === 1 ? '1 cidade encontrada' : `${n} cidades encontradas`;
    }
    if (vazio) vazio.hidden = achados.length !== 0;
  }

  input?.addEventListener('input', filtrar);

  // Termo vindo da busca do menu (ex.: /personal-trainer/?q=osasco)
  const q0 = new URLSearchParams(location.search).get('q');
  if (input && q0) {
    input.value = q0;
    filtrar();
    input.focus();
  }
</script>

<style>
  .busca-wrap {
    position: relative;
    margin-top: var(--sp-5);
    max-width: 540px;
  }
  .busca-ico {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.05rem;
    opacity: 0.7;
  }
  .busca-input {
    width: 100%;
    padding: 0.9rem 1rem 0.9rem 2.8rem;
    font-size: var(--step-0);
    border: 1.5px solid var(--line);
    border-radius: 999px;
    background: #fff;
    color: var(--ink);
    box-shadow: var(--shadow-sm);
  }
  .busca-input:focus {
    outline: none;
    border-color: var(--brand);
    box-shadow: 0 0 0 3px var(--brand-100);
  }
  .busca-status {
    margin-bottom: var(--sp-5);
    color: var(--ink-soft);
    font-size: var(--step--1);
  }
  .busca-vazio {
    background: var(--bg-tint);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--sp-5);
    text-align: center;
    color: var(--ink-soft);
  }
  .busca-item {
    min-width: 0;
    display: flex;
  }
  .estado-bloco + .estado-bloco {
    margin-top: var(--sp-8);
  }
  .estado-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: var(--sp-5);
    padding-bottom: var(--sp-3);
    border-bottom: 2px solid var(--brand-50);
  }
  .estado-head h2 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--step-2);
  }
  .estado-link {
    font-weight: 700;
    font-size: var(--step--1);
  }
</style>
