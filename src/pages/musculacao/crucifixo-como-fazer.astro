---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import CtaMontinho from '../../components/CtaMontinho.astro';
import Sidebar from '../../components/Sidebar.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import InstagramFollow from '../../components/InstagramFollow.astro';
import AutorMontinho from '../../components/AutorMontinho.astro';
import ContextualCta from '../../components/ContextualCta.astro';
import VideoYouTube from '../../components/VideoYouTube.astro';
import { breadcrumbSchema, articleSchema, faqSchema, personMontinhoSchema } from '../../lib/schema';
import { formatDateLong } from '../../lib/slug';
import { site } from '../../data/site';

const relacionados = [
  {
    url: '/musculacao/treino-de-peito/',
    titulo: 'Treino de peito: como montar o seu (e os erros)',
    descricao: 'Onde o crucifixo se encaixa dentro do treino completo.',
    tipo: 'Musculação',
  },
  {
    url: '/musculacao/supino-como-fazer/',
    titulo: 'Supino: como fazer, variações e erros comuns',
    descricao: 'O multiarticular que o crucifixo complementa — nunca substitui.',
    tipo: 'Musculação',
  },
  {
    url: '/musculacao/treinar-com-dor-no-ombro/',
    titulo: 'Treinar com dor no ombro: o que pode e o que não pode',
    descricao: 'O cuidado que define a amplitude segura do crucifixo.',
    tipo: 'Musculação',
  },
];

const path = '/musculacao/crucifixo-como-fazer';
const atualizadoEm = '2026-09-04';
const crumbs = [
  { nome: 'Início', url: '/' },
  { nome: 'Musculação', url: '/musculacao/' },
  { nome: 'Crucifixo: como fazer', url: path },
];

const faqs = [
  {
    pergunta: 'Qual a diferença entre crucifixo e supino?',
    resposta:
      'O supino é multiarticular: ombro e cotovelo trabalham juntos, com peitoral, deltoide anterior e tríceps dividindo a carga — é o exercício de força e de progressão pesada. O crucifixo isola a função principal do peitoral (aduzir o braço), com o cotovelo quase fixo e cargas bem menores. Um constrói a base; o outro completa o estímulo com amplitude e tensão contínua.',
  },
  {
    pergunta: 'Até onde devo descer os halteres no crucifixo?',
    resposta:
      'Até sentir o alongamento firme no peitoral com o ombro ainda confortável — em geral com os cotovelos um pouco abaixo da linha do tronco. Descer além disso transfere o estresse para a articulação do ombro e a cápsula anterior. O limite é individual: quem tem histórico de desconforto no ombro trabalha com amplitude mais curta, sem prejuízo relevante.',
  },
  {
    pergunta: 'Crucifixo reto, inclinado ou na máquina: qual escolher?',
    resposta:
      'O reto enfatiza a porção medial do peitoral; o inclinado desloca o trabalho para a porção superior, geralmente a mais defasada; o peck deck (máquina) mantém tensão constante e é o mais seguro para chegar perto da falha. Não é escolha excludente: alternar entre eles ao longo dos ciclos cobre o peitoral por completo.',
  },
  {
    pergunta: 'Quanto peso usar no crucifixo?',
    resposta:
      'Menos do que o orgulho sugere. O crucifixo coloca o peso na ponta de uma alavanca longa — o braço quase estendido —, o que multiplica a tensão com pouca carga. Halteres que permitam 10 a 15 repetições com descida controlada e alongamento completo entregam mais peitoral do que pesos altos com cotovelo dobrando e amplitude encurtando.',
  },
  {
    pergunta: 'O cotovelo fica esticado ou dobrado no crucifixo?',
    resposta:
      'Levemente dobrado — em torno de 10 a 20 graus — e fixo nesse ângulo do início ao fim. Se o cotovelo dobra mais durante a descida, o movimento vira um supino disfarçado e perde a característica de isolamento; se fica travado em extensão total, o estresse no cotovelo e no ombro sobe sem necessidade.',
  },
];

const title = 'Crucifixo: como fazer (reto, inclinado e máquina)';
const description =
  'Crucifixo: a diferença para o supino, até onde descer, cotovelo fixo, as versões reto, inclinado e peck deck, e os erros que tiram o peitoral do movimento.';

const capa = '/capas-conteudo/crucifixo-como-fazer.webp';
const capaAlt =
  'Arte da capa: guia do crucifixo com halteres no banco, posição inicial e final, cotovelos levemente flexionados, escápulas apoiadas e abertura em arco sem exagerar — crucifixo: como fazer, técnica, postura e amplitude — Personal por Perto';

const schema = [
  breadcrumbSchema(crumbs),
  articleSchema({ titulo: title, descricao: description, url: new URL(path, site.dominio).href, imagem: new URL(capa, site.dominio).href, atualizadoEm }),
  faqSchema(faqs),
  personMontinhoSchema(),
];
---

<Base title={title} description={description} path={path} ogType="article" image={capa} schema={schema}>
  <Breadcrumbs crumbs={crumbs} />
  <div class="container guide-layout">
    <article class="article-page">
    <p class="eyebrow">Musculação</p>
    <h1>Crucifixo: o isolador que o supino não substitui</h1>
    <p class="updated">Atualizado em {formatDateLong(atualizadoEm)}</p>

    <figure style="margin: 0 0 var(--sp-5)">
      <img
        src={capa}
        alt={capaAlt}
        width="1200"
        height="675"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        style="width: 100%; height: auto; border-radius: var(--radius-lg); box-shadow: var(--shadow-lg)"
      />
    </figure>

    <p class="lead">
      Todo treino de peito gira em torno do supino — e é justo. Mas o
      peitoral tem uma função que o supino nunca isola por completo:
      aduzir o braço, o movimento de "abraçar".
    </p>

    <p class="lead">
      É exatamente isso que o crucifixo treina. Este guia mostra a
      execução, o limite de amplitude que protege o ombro e como as três
      versões — reto, inclinado e máquina — se dividem.
    </p>

    <div class="prose">
      <h2>O que o crucifixo treina</h2>
      <p>
        O peitoral maior é o protagonista quase solitário: com o cotovelo
        fixo, o tríceps sai da jogada e o deltoide anterior participa só
        como coadjuvante. É o exercício de isolamento clássico do peito.
      </p>

      <p>
        O diferencial está na posição alongada: no fundo do movimento, o
        peitoral trabalha esticado sob tensão — estímulo que o
        <a href="/musculacao/supino-como-fazer/">supino</a> entrega menos,
        porque a barra para no tronco antes do alongamento máximo.
      </p>

      <VideoYouTube
        id="uDMmccuPVPQ"
        titulo="Como fazer crucifixo reto — Leandro Twin"
        legenda="No vídeo: Leandro Twin demonstra a execução correta do crucifixo reto com halteres."
      />

      <h2>A execução, passo a passo</h2>
      <p>
        <strong>Posição.</strong> Deitado no banco reto, pés firmes no
        chão, escápulas retraídas e deprimidas — o mesmo "encaixe" do
        supino. Halteres acima do peito, palmas frente a frente.
      </p>

      <p>
        <strong>O cotovelo.</strong> Levemente dobrado, 10 a 20 graus,
        e travado nesse ângulo. Ele não dobra nem estica durante a série
        — apenas o ombro se move.
      </p>

      <p>
        <strong>A descida.</strong> Abra os braços em arco amplo, como se
        abraçasse um barril, até sentir o alongamento firme no peitoral —
        em geral com os cotovelos pouco abaixo da linha do tronco.
        Controle total: 2 a 3 segundos.
      </p>

      <p>
        <strong>A subida.</strong> Feche o arco pensando em juntar os
        braços, não em empurrar. Os halteres se aproximam no topo sem se
        chocarem — e sem o peitoral sair de tensão.
      </p>

      <h2>O limite que protege o ombro</h2>
      <p>
        O fundo do crucifixo é a posição de maior estresse sobre a cápsula
        anterior do ombro. A regra prática: desça até o alongamento firme
        do peito, nunca até a "pontada" na articulação.
      </p>

      <p>
        Quem tem histórico de desconforto — ou já leu o guia sobre
        <a href="/musculacao/treinar-com-dor-no-ombro/">treinar com dor no
        ombro</a> — trabalha com amplitude um degrau mais curta ou migra
        para o peck deck, que estabiliza a trajetória. Dor articular
        recorrente é assunto de médico ou fisioterapeuta, não de
        insistência.
      </p>

      <h2>Reto, inclinado e máquina: a divisão de trabalho</h2>
      <p>
        <strong>Crucifixo reto.</strong> A versão-base, com ênfase na
        porção medial do peitoral. É por onde se aprende o padrão.
      </p>

      <p>
        <strong>Crucifixo inclinado.</strong> Banco entre 30 e 45 graus,
        trabalho deslocado para a porção superior do peito — a mais
        defasada na maioria das pessoas. Execução idêntica, carga um
        pouco menor.
      </p>

      <VideoYouTube
        id="uy9Xk3SVrms"
        titulo="Como fazer crucifixo inclinado — Leandro Twin"
        legenda="No vídeo: Leandro Twin demonstra a versão inclinada, com ênfase na porção superior do peitoral."
      />

      <p>
        <strong>Peck deck (máquina).</strong> Tensão constante do início
        ao fim, trajetória guiada e segurança para chegar perto da falha
        sem ajudante. A melhor escolha para séries finais e para quem
        está aprendendo. É a única variação que se <em>regula</em> antes
        de executar, e o ajuste do assento decide qual músculo trabalha —
        a execução detalhada está em <a
        href="/musculacao/voador-como-fazer/">voador: como fazer</a>.
      </p>

      <p>
        <strong>Crucifixo na polia (cross-over).</strong> O primo em pé:
        cabos mantêm tensão em todo o arco e permitem variar o ângulo do
        puxe — complemento avançado, mesma lógica.
      </p>

      <h2>Os erros mais comuns</h2>
      <p>
        <strong>Virar supino no meio da série.</strong> Cotovelo dobrando
        na descida para aguentar a carga. Sinal claro de peso demais.
      </p>

      <p>
        <strong>Descer fundo demais.</strong> Amplitude que o ombro não
        comporta troca estímulo por risco.
      </p>

      <p>
        <strong>Bater os halteres no topo.</strong> O choque tira a
        tensão do peitoral no ponto de encurtamento — pare um palmo antes.
      </p>

      <p>
        <strong>Perder o encaixe da escápula.</strong> Ombros enrolando
        para a frente no fundo do movimento entregam a carga à
        articulação.
      </p>

      <p>
        <strong>Pressa na descida.</strong> A fase excêntrica em
        alongamento é o coração do exercício — despencar é desperdiçá-la.
      </p>

      <h2>Séries, repetições e onde encaixar</h2>
      <p>
        De 3 a 4 séries de 10 a 15 repetições, depois do trabalho pesado
        de empurrar, dentro do
        <a href="/musculacao/treino-de-peito/">treino de peito</a>. Como
        isolador, o crucifixo fecha a sessão — não a abre.
      </p>

      <p>
        A progressão aqui é medida em controle e amplitude antes de
        carga: subir 2 kg mantendo a descida lenta vale mais que subir 6
        encurtando o arco.
      </p>

      <h2>Quando vale ter alguém olhando</h2>
      <p>
        O crucifixo tem dois pontos cegos: o ângulo do cotovelo, que
        dobra sem o praticante notar, e o limite de descida, que cada
        ombro define de um jeito. Ambos precisam de olho externo para
        calibrar.
      </p>

      <p>
        Um personal trainer define a amplitude segura para a sua
        articulação, escolhe entre halteres, máquina e polia conforme o
        momento do treino e garante que o isolador continue isolando. É
        ajuste fino — e é onde o crucifixo deixa de ser coadjuvante
        decorativo para virar diferença visível no peitoral.
      </p>
    </div>

    <Faq faqs={faqs} titulo="Perguntas frequentes sobre o crucifixo" />

    <ContextualCta path={path} assunto={title} />
    <InstagramFollow tema="hipertrofia" />
    <AutorMontinho />

    <RelatedArticles itens={relacionados} />
    </article>

    <Sidebar />
  </div>

  <section class="section-sm">
    <div class="container">
      <CtaMontinho variante="destaque" />
    </div>
  </section>
</Base>

<style>
  .guide-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-6);
    padding-block: var(--sp-7);
  }
  @media (min-width: 980px) {
    .guide-layout {
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: var(--sp-7);
    }
  }
  .article-page {
    min-width: 0;
    max-width: 760px;
  }
  .updated {
    color: var(--muted);
    font-size: var(--step--1);
    margin-top: var(--sp-2);
  }
  .lead {
    margin-top: var(--sp-4);
    font-size: var(--step-1);
    color: var(--ink-soft);
    line-height: 1.55;
  }
  .article-page .prose {
    margin-top: var(--sp-5);
  }
</style>
