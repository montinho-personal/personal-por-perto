---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { breadcrumbSchema, itemListSchema } from '../../lib/schema';
import { site } from '../../data/site';
import { rotas } from '../../lib/links';

const path = '/musculacao';
const crumbs = [
  { nome: 'Início', url: '/' },
  { nome: 'Musculação', url: path },
];

const artigos = [
  {
    url: '/musculacao/treino-para-iniciantes/',
    titulo: 'Treino de musculação para iniciantes: como começar',
    desc: 'Por onde começar, adaptação nas primeiras semanas, erros comuns de quem treina sozinho e quando faz sentido ter acompanhamento.',
    tag: 'Para começar',
  },
  {
    url: '/musculacao/hipertrofia-como-funciona/',
    titulo: 'Hipertrofia: como funciona o crescimento muscular',
    desc: 'Tensão mecânica, estresse metabólico, volume de treino e sobrecarga progressiva explicados de forma acessível.',
    tag: 'Hipertrofia',
  },
  {
    url: '/musculacao/abc-ou-full-body/',
    titulo: 'ABC ou Full Body: qual a melhor divisão de treino',
    desc: 'Prós e contras de cada divisão, frequência de estímulo por grupo muscular e para quem cada formato costuma fazer mais sentido.',
    tag: 'Divisão de treino',
  },
  {
    url: '/musculacao/quantas-series-e-repeticoes/',
    titulo: 'Quantas séries e repetições fazer por grupo muscular',
    desc: 'Volume de treino, faixas de repetição por objetivo e o conceito de séries efetivas.',
    tag: 'Volume de treino',
  },
  {
    url: '/musculacao/progressao-de-carga/',
    titulo: 'Como progredir de carga na musculação',
    desc: 'O princípio da sobrecarga progressiva, formas de progredir além do peso e como evitar platôs e lesões.',
    tag: 'Progressão',
  },
  {
    url: '/musculacao/descanso-entre-series/',
    titulo: 'Quanto tempo descansar entre séries',
    desc: 'O que o intervalo muda no treino, o que a literatura indica por objetivo e por que "suar mais" descansando menos é mito.',
    tag: 'Descanso',
  },
  {
    url: '/musculacao/treinar-ate-a-falha/',
    titulo: 'Treinar até a falha funciona?',
    desc: 'Falha muscular, repetições em reserva (RIR) e o que as meta-análises indicam sobre treinar no limite.',
    tag: 'Intensidade',
  },
  {
    url: '/musculacao/cardio-e-musculacao-no-mesmo-dia/',
    titulo: 'Cardio e musculação no mesmo dia: como combinar',
    desc: 'Efeito de interferência, ordem dos treinos e como organizar a semana sem comprometer os dois objetivos.',
    tag: 'Cardio',
  },
  {
    url: '/musculacao/quanto-tempo-para-ver-resultados/',
    titulo: 'Quanto tempo demora para ver resultados na musculação?',
    desc: 'Linha do tempo realista: adaptação neural, primeiras mudanças mensuráveis e o que acelera ou atrasa o progresso.',
    tag: 'Resultados',
  },
  {
    url: '/musculacao/dor-muscular-pos-treino/',
    titulo: 'Dor muscular pós-treino: posso treinar mesmo assim?',
    desc: 'O que é a dor tardia (DOMS), quando dá para treinar com dor e quando o sinal merece avaliação.',
    tag: 'Recuperação',
  },
  {
    url: '/musculacao/treino-em-casa-para-iniciantes/',
    titulo: 'Treino em casa para iniciantes: como começar sem equipamentos',
    desc: 'Os 6 padrões de movimento, o plano de 3 sessões semanais e como progredir sem pesos — do zero à constância.',
    tag: 'Treino em casa',
  },
  {
    url: '/musculacao/treinar-com-dor-no-joelho/',
    titulo: 'Dor no joelho: dá para treinar? O que ajustar na musculação',
    desc: 'Quando dá para treinar ajustando amplitude, variações e carga — e quais sinais pedem médico antes de qualquer plano.',
    tag: 'Dores e limitações',
  },
  {
    url: '/musculacao/treinar-com-dor-lombar/',
    titulo: 'Dor lombar e musculação: como treinar com segurança',
    desc: 'Por que movimento supera repouso na dor lombar comum, o que ajustar no treino e os sinais de alerta.',
    tag: 'Dores e limitações',
  },
  {
    url: '/musculacao/treinar-com-dor-no-ombro/',
    titulo: 'Dor no ombro: dá para treinar? O que ajustar na musculação',
    desc: 'Ajustes práticos, o papel do manguito rotador, o equilíbrio entre empurrar e puxar e os sinais que pedem médico.',
    tag: 'Dores e limitações',
  },
  {
    url: '/musculacao/creatina-o-que-e-como-tomar/',
    titulo: 'Creatina: o que é, para que serve e como tomar',
    desc: 'Dose diária, saturação, mitos sobre rins e retenção, qual comprar e o que esperar de resultado real.',
    tag: 'Suplementação',
  },
  {
    url: '/musculacao/musculacao-depois-dos-40/',
    titulo: 'Musculação depois dos 40: o que muda e como treinar',
    desc: 'O que muda de verdade (recuperação, técnica, aquecimento), como frear a sarcopenia e a volta segura de quem parou.',
    tag: 'Treino 40+',
  },
  {
    url: '/musculacao/quanto-tempo-de-treino-por-dia/',
    titulo: 'Quanto tempo de treino por dia é suficiente?',
    desc: 'Por que o músculo conta séries, não minutos: faixas práticas por rotina e os ladrões de tempo do treino.',
    tag: 'Rotina de treino',
  },
  {
    url: '/musculacao/whey-protein-o-que-e-como-tomar/',
    titulo: 'Whey protein: o que é, para que serve e como tomar',
    desc: 'Quando vale a pena, concentrado vs. isolado, a verdade sobre a janela anabólica e como escolher marca.',
    tag: 'Suplementação',
  },
  {
    url: '/musculacao/treino-de-gluteos/',
    titulo: 'Treino de glúteos: o que funciona de verdade (e o que é mito)',
    desc: 'As três famílias de exercícios que constroem glúteos, frequência e volume ideais e os prazos honestos.',
    tag: 'Glúteos',
  },
  {
    url: '/musculacao/musculacao-feminina-mitos/',
    titulo: 'Musculação feminina: 7 mitos que ainda atrapalham (e a verdade)',
    desc: '"Vou ficar grande?", "pesado é perigoso?", "só cardio emagrece?" — os mitos desmontados com fisiologia.',
    tag: 'Treino feminino',
  },
  {
    url: '/musculacao/alongamento-antes-do-treino/',
    titulo: 'Alongamento antes do treino: ajuda ou atrapalha?',
    desc: 'O que a ciência revisou: aquecimento dinâmico antes, alongamento estático depois — e por quê.',
    tag: 'Aquecimento',
  },
  {
    url: '/musculacao/treino-abc-como-montar/',
    titulo: 'Treino ABC: como montar o seu (com exemplo completo)',
    desc: 'A divisão mais usada do Brasil explicada: para quem rende, exemplo das três sessões e como rodar a semana.',
    tag: 'Divisão de treino',
  },
  {
    url: '/musculacao/bulking-e-cutting/',
    titulo: 'Bulking e cutting: o que são, como fazer e quem realmente precisa',
    desc: 'Superávits e déficits nas doses certas, o fim do bulking sujo e quando a recomposição substitui os ciclos.',
    tag: 'Estratégia',
  },
  {
    url: '/musculacao/sono-e-ganho-de-massa/',
    titulo: 'Sono e ganho de massa muscular: o treino invisível',
    desc: 'O que a privação de sono faz com síntese proteica, hormônios e força — e o protocolo para dormir a favor do treino.',
    tag: 'Recuperação',
  },
  {
    url: '/musculacao/maquina-ou-peso-livre/',
    titulo: 'Máquina ou peso livre: qual é melhor?',
    desc: 'A ciência encerrou o debate: hipertrofia igual quando o esforço se equivale. Veja as vantagens reais de cada um e como combinar.',
    tag: 'Comparativo',
  },
  {
    url: '/musculacao/destreino/',
    titulo: 'Destreino: quanto tempo parado você perde músculo?',
    desc: 'A perda real começa após 3-4 semanas, a memória muscular acelera a volta e 1 treino semanal mantém seus ganhos.',
    tag: 'Recuperação',
  },
  {
    url: '/musculacao/agachamento-como-fazer/',
    titulo: 'Agachamento: como fazer, variações e erros comuns',
    desc: 'Técnica em cinco pontos, o mito do joelho passar do pé, profundidade e butt wink, e as variações que valem a pena.',
    tag: 'Técnica',
  },
  {
    url: '/musculacao/treino-de-abdomen/',
    titulo: 'Treino de abdômen: o que funciona de verdade',
    desc: 'Por que abdominal não queima gordura localizada, as quatro funções do core e quanto treinar por semana.',
    tag: 'Abdômen',
  },
  {
    url: '/musculacao/supino-como-fazer/',
    titulo: 'Supino: como fazer, variações e erros comuns',
    desc: 'Escápulas, ângulo de cotovelo e amplitude: os detalhes que separam peitoral crescendo de ombro doendo.',
    tag: 'Técnica',
  },
  {
    url: '/musculacao/levantamento-terra-como-fazer/',
    titulo: 'Levantamento terra: como fazer e erros comuns',
    desc: 'Técnica do chão ao topo, lombar neutra, variações (convencional, sumô, romeno) e por que o volume deve ser baixo.',
    tag: 'Técnica',
  },
  {
    url: '/musculacao/treino-de-costas/',
    titulo: 'Treino de costas: como montar o seu',
    desc: 'Por que você sente o bíceps na puxada, os quatro padrões que montam um dia completo e os mitos que sobrevivem.',
    tag: 'Costas',
  },
  {
    url: '/musculacao/treino-de-bracos/',
    titulo: 'Treino de braços: bíceps e tríceps',
    desc: 'O tríceps é dois terços do braço, quanto de estímulo indireto você já recebe e por que somar séries não destrava.',
    tag: 'Braços',
  },
  {
    url: '/musculacao/cafeina-pre-treino/',
    titulo: 'Cafeína no pré-treino: quanto tomar e quando',
    desc: 'A dose com respaldo, café x suplemento, tolerância e o custo escondido que a cafeína cobra do seu sono.',
    tag: 'Suplementos',
  },
  {
    url: '/musculacao/treino-de-ombro/',
    titulo: 'Treino de ombro: como montar o seu',
    desc: 'As três porções do deltoide, por que a lateral define a largura e a elevação lateral sem castigar a articulação.',
    tag: 'Ombro',
  },
  {
    url: '/musculacao/treino-de-pernas/',
    titulo: 'Treino de pernas: como montar o seu',
    desc: 'Os quatro padrões de um dia completo, por que o posterior de coxa não cresce e onde a panturrilha entra.',
    tag: 'Pernas',
  },
  {
    url: '/musculacao/aquecimento-antes-do-treino/',
    titulo: 'Aquecimento antes do treino: como fazer certo',
    desc: 'Para que ele serve, quanto tempo dura, o que são séries de aproximação e por que 20 min de esteira não contam.',
    tag: 'Aquecimento',
  },
  {
    url: '/musculacao/frequencia-de-treino/',
    titulo: 'Frequência de treino: quantas vezes treinar por semana',
    desc: 'Por que a frequência só distribui o volume, quanto de recuperação cada grupo pede e como escolher a sua.',
    tag: 'Frequência',
  },
  {
    url: '/musculacao/suplementos-que-nao-funcionam/',
    titulo: 'Suplementos que não funcionam: a lista honesta',
    desc: 'BCAA, glutamina, termogênicos e outros itens sem respaldo — e a lista curta e barata do que tem evidência.',
    tag: 'Suplementos',
  },
  {
    url: '/musculacao/musculacao-e-postura/',
    titulo: 'Musculação e postura: o que o treino resolve',
    desc: 'Por que não existe postura única correta, quais músculos priorizar e o que o treino não consegue resolver.',
    tag: 'Postura',
  },
];

const title = 'Musculação: guias sobre treino, hipertrofia e progressão de carga';
const description =
  'Conteúdos sobre musculação com base na ciência do exercício: como começar, hipertrofia, divisão de treino, volume de séries e progressão de carga.';

const schema = [
  breadcrumbSchema(crumbs),
  itemListSchema('Artigos sobre musculação', artigos.map((a) => a.titulo), new URL(path, site.dominio).href),
];
---

<Base title={title} description={description} path={path} schema={schema}>
  <Breadcrumbs crumbs={crumbs} />
  <header class="section-sm tint">
    <div class="container">
      <p class="eyebrow">Conteúdo editorial</p>
      <h1>Musculação</h1>
      <p class="lead" style="max-width: 60ch">
        Conteúdos práticos sobre treino de musculação, com base em princípios
        estabelecidos da ciência do exercício — para treinar melhor, sozinho ou
        com acompanhamento profissional.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="grid grid-2">
        {
          artigos.map((a) => (
            <a class="card card-hover guide" href={a.url}>
              <span class="pill">{a.tag}</span>
              <h2>{a.titulo}</h2>
              <p>{a.desc}</p>
              <span class="guide-link">Ler artigo →</span>
            </a>
          ))
        }
      </div>
      <p class="muted small" style="margin-top: var(--sp-6)">
        Quer decidir se vale a pena contratar acompanhamento? Veja os guias
        <a href={rotas.comoEscolher}>como escolher um personal trainer</a> e
        <a href={rotas.quantoCusta}>quanto custa um personal trainer</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .guide {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--ink);
  }
  .guide:hover {
    text-decoration: none;
  }
  .guide h2 {
    font-size: var(--step-2);
  }
  .guide p {
    color: var(--ink-soft);
    flex: 1;
  }
  .guide-link {
    font-weight: 700;
    color: var(--brand-600);
  }
  .small {
    font-size: var(--step--1);
  }
</style>
