---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import CtaMontinho from '../../components/CtaMontinho.astro';
import Sidebar from '../../components/Sidebar.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import InstagramFollow from '../../components/InstagramFollow.astro';
import AutorMontinho from '../../components/AutorMontinho.astro';
import ContextualCta from '../../components/ContextualCta.astro';
import FerramentaInline from '../../components/FerramentaInline.astro';
import { breadcrumbSchema, articleSchema, faqSchema, personMontinhoSchema } from '../../lib/schema';
import { formatDateLong } from '../../lib/slug';
import { site } from '../../data/site';

const relacionados = [
  {
    url: '/musculacao/rosca-direta-como-fazer/',
    titulo: 'Rosca direta: como fazer e os erros comuns',
    descricao: 'O exercício-base de bíceps — e o que a Scott corrige nele.',
    tipo: 'Musculação',
  },
  {
    url: '/musculacao/rosca-concentrada-como-fazer/',
    titulo: 'Rosca concentrada: como fazer e os erros comuns',
    descricao: 'A outra rosca com apoio, e por que ela resolve um problema diferente.',
    tipo: 'Musculação',
  },
  {
    url: '/musculacao/treino-de-bracos/',
    titulo: 'Treino de braços: como montar',
    descricao: 'Onde a Scott entra na sessão e quanto volume de braço faz sentido na semana.',
    tipo: 'Musculação',
  },
  {
    url: '/musculacao/rosca-martelo-como-fazer/',
    titulo: 'Rosca martelo: como fazer e os erros comuns',
    descricao: 'A pegada que traz braquial e braquiorradial para o trabalho.',
    tipo: 'Musculação',
  },
];

const path = '/musculacao/rosca-scott-como-fazer';
const atualizadoEm = '2026-09-06';
const crumbs = [
  { nome: 'Início', url: '/' },
  { nome: 'Musculação', url: '/musculacao/' },
  { nome: 'Rosca Scott: como fazer', url: path },
];

const faqs = [
  {
    pergunta: 'Para que serve a rosca Scott?',
    resposta:
      'Ela serve para tirar o resto do corpo da jogada. Com os braços apoiados no banco inclinado, não há como balançar o tronco, jogar o quadril nem dar impulso com o ombro — o cotovelo é a única articulação que se move. Por isso a Scott costuma ser feita com bem menos peso que a rosca direta, e isso não é sinal de fraqueza: é o número real, sem a ajuda que você nem percebia estar usando.',
  },
  {
    pergunta: 'Rosca Scott ou rosca direta: qual escolher?',
    resposta:
      'Não competem. A rosca direta permite mais carga total e é a escolha de exercício principal do braço; a Scott entrega tensão numa posição que a direta quase não visita, com o braço à frente do corpo e o cotovelo aberto. Na prática, a maioria dos programas comporta as duas: a direta primeiro, para carga, e a Scott depois, com peso menor e execução limpa. Se você só tem espaço para uma e treina sozinho, a Scott tem a vantagem de ser praticamente impossível de fazer com impulso.',
  },
  {
    pergunta: 'Pode estender o cotovelo por completo na rosca Scott?',
    resposta:
      'Pode descer até o cotovelo quase estendido, controlando — o que não pode é chegar lá em queda livre. A parte de baixo da Scott é a posição mais alongada e mais vulnerável do movimento, e é ali que aparecem as queixas de dor na dobra do cotovelo, geralmente depois de uma descida solta com carga alta. Desça devagar, pare pouco antes do travamento e recomece sem quicar. Se já existe dor na região, isso não é assunto de técnica: procure um médico ou fisioterapeuta antes de continuar.',
  },
  {
    pergunta: 'Barra W, barra reta ou halteres na rosca Scott?',
    resposta:
      'A barra W é a escolha padrão porque a pegada semi-supinada alivia o punho, e é o que a maioria das pessoas consegue sustentar sem desconforto. A barra reta exige supinação completa e cobra mais do punho, mas coloca o bíceps na posição de maior vantagem para supinar. Os halteres permitem trabalhar um braço por vez, o que expõe diferenças entre os lados que a barra esconde. Nenhuma das três é superior: escolha a que você consegue executar sem dor no punho.',
  },
  {
    pergunta: 'Quantas séries de rosca Scott fazer?',
    resposta:
      'De 2 a 4 séries de 8 a 15 repetições resolvem, normalmente depois do exercício principal de bíceps. Vale contar o total de roscas da semana antes de somar mais uma: quem já faz direta, alternada e martelo pode estar acumulando volume no mesmo grupo sem perceber, e o bíceps também trabalha em toda puxada e remada do treino de costas.',
  },
];

const title = 'Rosca Scott: como fazer e por que a parte difícil é embaixo';
const description =
  'Rosca Scott no banco inclinado: o encaixe que vem antes da carga, por que o peso cai em relação à rosca direta, por que a parte mais difícil é a de baixo, os erros que cobram no cotovelo e onde ela entra no treino de braço.';

const schema = [
  breadcrumbSchema(crumbs),
  articleSchema({ titulo: title, descricao: description, url: new URL(path, site.dominio).href, atualizadoEm }),
  faqSchema(faqs),
  personMontinhoSchema(),
];
---

<Base title={title} description={description} path={path} ogType="article" schema={schema}>
  <Breadcrumbs crumbs={crumbs} />
  <div class="container guide-layout">
    <article class="article-page">
    <p class="eyebrow">Musculação</p>
    <h1>Rosca Scott: como fazer e por que a parte difícil é embaixo</h1>
    <p class="updated">Atualizado em {formatDateLong(atualizadoEm)}</p>

    <p class="lead">
      A rosca Scott é o exercício de bíceps que <strong>não deixa
      trapacear</strong>. Com os braços apoiados no banco inclinado, some o
      balanço de tronco, some o impulso de quadril, some a ajuda do ombro —
      e sobra o cotovelo fazendo o trabalho sozinho.
    </p>

    <p class="lead">
      É por isso que quase todo mundo precisa baixar bastante a carga em
      relação à rosca direta, e por isso que a parte de baixo do movimento é
      a que mais exige — e a que mais cobra quando é feita com pressa.
    </p>

    <div class="prose">
      <h2>O que a rosca Scott treina — e o que ela impede</h2>
      <p>
        O músculo é o mesmo de qualquer rosca: o bíceps braquial, com ajuda
        do braquial por baixo dele. O que muda é a <strong>posição do
        braço</strong>. No banco Scott o úmero fica à frente do tronco,
        apoiado na almofada inclinada, e isso tem duas consequências
        práticas.
      </p>

      <p>
        A primeira é mecânica: com o ombro já flexionado, a porção longa do
        bíceps — a que passa por cima da articulação do ombro — começa a
        série encurtada de um lado. Sobra mais trabalho para a porção curta,
        o oposto do que acontece na rosca inclinada, em que o braço fica
        atrás do corpo.
      </p>

      <p>
        A segunda é de comportamento, e é a mais importante no dia a dia:
        <strong>o banco elimina toda a compensação</strong>. Não dá para
        jogar o tronco para trás, não dá para usar o ombro, não dá para
        roubar com o quadril. O peso que sobe na Scott é o peso que o
        cotovelo levanta de verdade.
      </p>

      <h2>Primeiro o encaixe, depois a carga</h2>
      <p>
        A regulagem leva quinze segundos e decide se o exercício vai
        funcionar. Sente-se e ajuste a altura do assento até que a
        <strong>borda superior da almofada fique encaixada na axila</strong>,
        com o peito encostado nela. Se a almofada ficar na altura do meio do
        braço, o cotovelo perde apoio e escorrega a cada repetição.
      </p>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Se o encaixe estiver…</th>
              <th>O que acontece</th>
              <th>Correção</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Almofada abaixo da axila</td>
              <td>O braço escorrega e o ombro entra para ajudar — volta a ser rosca em pé</td>
              <td>Suba o assento</td>
            </tr>
            <tr>
              <td>Almofada encaixada na axila</td>
              <td>Cotovelo firme, ombro estável, bíceps como único motor</td>
              <td>É aqui</td>
            </tr>
            <tr>
              <td>Ombros levantados junto à orelha</td>
              <td>Trapézio tenso, e o desconforto no pescoço aparece antes da fadiga do braço</td>
              <td>Desça o assento e relaxe o ombro</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p>
        Os pés ficam apoiados no chão, o peito encostado na almofada e os
        cotovelos abertos na largura dos ombros — nem colados no tronco, nem
        abrindo para fora durante a série.
      </p>

      <h2>A execução, passo a passo</h2>
      <p>
        <strong>A subida.</strong> Suba a barra flexionando o cotovelo, sem
        empurrar o peito contra a almofada para ganhar impulso. O movimento
        termina quando o antebraço chega perto da vertical — passar disso não
        acrescenta nada, pelo motivo explicado logo abaixo.
      </p>

      <p>
        <strong>A descida.</strong> Aqui é onde o exercício acontece. Desça
        devagar, controlando, até o cotovelo ficar <em>quase</em> estendido.
        Não solte o peso, não quique no fim e não recomece usando o repique
        da barra.
      </p>

      <p>
        <strong>O punho.</strong> Firme e alinhado com o antebraço. Punho que
        dobra para trás com a carga é o primeiro sinal de que o peso está
        alto demais ou de que a barra escolhida não é a certa para você.
      </p>

      <p>
        <strong>Os cotovelos.</strong> Parados no lugar em que foram
        encaixados. Cotovelo que desliza para os lados durante a série
        significa que a almofada está mal ajustada ou que a carga venceu.
      </p>

      <h2>Por que a parte difícil é embaixo</h2>
      <p>
        Na rosca em pé, o ponto mais pesado é o meio do movimento, com o
        antebraço paralelo ao chão. No banco Scott, a almofada inclinada
        muda essa conta: <strong>o trecho mais exigente é o inicial</strong>,
        com o braço estendido, e a resistência vai diminuindo conforme o
        antebraço se aproxima da vertical.
      </p>

      <p>
        Duas consequências saem daí. A primeira: apertar a contração lá em
        cima rende pouco, porque em cima quase não há resistência — quem faz
        a Scott caçando o "pico" está insistindo justamente na parte fácil.
        A segunda é mais séria: a região onde o exercício é mais pesado é
        também a de maior alongamento, e é ali que aparecem as queixas de dor
        na dobra do cotovelo, quase sempre depois de descidas soltas com
        carga alta.
      </p>

      <p>
        A leitura prática é simples: <strong>ganhe a série na descida</strong>.
        Controle a volta, pare pouco antes do travamento e recomece sem
        impulso. Dor persistente no cotovelo não é problema de técnica a ser
        resolvido com ajuste fino — é assunto de médico ou fisioterapeuta, e
        vale interromper o exercício até ter essa avaliação.
      </p>

      <h2>Os erros que aparecem em toda academia</h2>
      <p>
        <strong>Carga de rosca direta no banco Scott.</strong> É o erro
        número um, e produz todos os outros. Sem compensação disponível, o
        corpo compensa do jeito que consegue: levantando o ombro, empurrando
        o peito na almofada ou encurtando a amplitude.
      </p>

      <p>
        <strong>Descer em queda livre.</strong> Metade do estímulo mora na
        fase excêntrica, e é justamente a metade que a pressa joga fora — com
        o agravante de ser a posição mais vulnerável do cotovelo.
      </p>

      <p>
        <strong>Amplitude pela metade.</strong> Subir e descer só o pedaço do
        meio mantém a série confortável e elimina o que a Scott tem de melhor,
        que é a posição alongada.
      </p>

      <p>
        <strong>Escorregar do apoio.</strong> Se a cada repetição o braço
        anda um pouco na almofada, o encaixe está errado — volte ao ajuste do
        assento antes de culpar o exercício.
      </p>

      <h2>Barra W, barra reta ou halteres?</h2>
      <p>
        A <strong>barra W</strong> é o padrão, porque a pegada semi-supinada
        tira pressão do punho e permite concentrar o desconforto onde ele
        deve estar: no bíceps. A <strong>barra reta</strong> exige supinação
        completa, o que coloca o bíceps na melhor posição para o que ele faz
        além de flexionar o cotovelo — mas nem todo punho aceita.
      </p>

      <p>
        Os <strong>halteres</strong> permitem um braço por vez, e essa é a
        versão mais reveladora das três: diferenças entre os lados que a
        barra disfarça aparecem imediatamente quando cada braço precisa
        levantar o próprio peso. Se um lado fica claramente para trás, vale
        começar as séries por ele.
      </p>

      <h2>Onde ela entra no treino de braço</h2>
      <p>
        De 2 a 4 séries de 8 a 15 repetições, depois do exercício principal
        de bíceps. A <a href="/musculacao/rosca-direta-como-fazer/">rosca
        direta</a> costuma vir antes, quando a carga ainda está disponível; a
        Scott depois, com peso menor e execução limpa.
      </p>

      <p>
        Vale um cuidado de programação que quase ninguém faz: a Scott, a
        <a href="/musculacao/rosca-concentrada-como-fazer/">rosca
        concentrada</a> e a rosca na polia com apoio resolvem o mesmo
        problema — estabilizar o braço para isolar o cotovelo. Fazer as três
        na mesma sessão é repetir a solução, não somar estímulo. Escolha uma
        e varie ao longo dos meses.
      </p>

      <p>
        E some o que vem de fora do treino de braço: o bíceps trabalha em
        toda <a href="/musculacao/puxada-como-fazer/">puxada</a> e em toda
        remada do dia de costas. A conta do volume semanal precisa incluir
        isso — o assunto está detalhado no guia de
        <a href="/musculacao/treino-de-bracos/">treino de braços</a>.
      </p>

      <FerramentaInline
        id="auditoria"
        texto="Quatro roscas na mesma sessão, todas com o braço na mesma posição, é o empilhamento mais comum do treino de braço — e ele consome tempo sem entregar estímulo novo. A análise olha a sua semana inteira e mostra se o volume está distribuído ou concentrado."
        acao="Analisar a distribuição do meu treino"
      />

      <h2>Quando vale ter alguém olhando</h2>
      <p>
        A rosca Scott é um exercício simples de aprender e fácil de fazer mal
        por um motivo específico: como o banco esconde a compensação, o erro
        não aparece no espelho — aparece semanas depois, como dor no cotovelo
        ou como um braço que não evolui. Um olhar externo resolve isso em uma
        série.
      </p>

      <p>
        E se já existe dor na dobra do cotovelo, no punho ou no ombro, a
        ordem se inverte: primeiro a avaliação de um médico ou
        fisioterapeuta, depois o ajuste do treino. Nenhuma correção de
        técnica substitui esse diagnóstico.
      </p>

      <div class="callout">
        <strong>Resumindo:</strong> a rosca Scott existe para tirar a
        compensação da jogada, e o preço disso é uma carga bem menor que a da
        rosca direta — o que é o número honesto, não um problema. Encaixe a
        almofada na axila antes de escolher o peso, mantenha punho firme e
        cotovelos parados, e lembre que a parte pesada é a de baixo: ganhe a
        série na descida, controlando até quase estender, sem quicar. De 2 a
        4 séries depois do exercício principal, contando as outras roscas da
        semana — e o bíceps que já trabalhou no dia de costas.
      </div>
    </div>

    <Faq faqs={faqs} titulo="Perguntas frequentes sobre a rosca Scott" />

    <ContextualCta path={path} assunto={title} />
    <InstagramFollow tema="geral" />
    <AutorMontinho />

    <RelatedArticles itens={relacionados} />
    </article>

    <Sidebar />
  </div>

  <section class="section-sm">
    <div class="container">
      <CtaMontinho variante="destaque" />
    </div>
  </section>
</Base>

<style>
  .guide-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-6);
    padding-block: var(--sp-7);
  }
  @media (min-width: 980px) {
    .guide-layout {
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: var(--sp-7);
    }
  }
  .article-page {
    min-width: 0;
    max-width: 760px;
  }
  .updated {
    color: var(--muted);
    font-size: var(--step--1);
    margin-top: var(--sp-2);
  }
  .lead {
    margin-top: var(--sp-4);
    font-size: var(--step-1);
    color: var(--ink-soft);
    line-height: 1.55;
  }
  .article-page .prose {
    margin-top: var(--sp-5);
  }
</style>
