---
/**
 * Quanto tempo descansar entre séries — artigo com a calculadora e o timer.
 *
 * POR QUE A FERRAMENTA MORA AQUI
 *
 * A consulta principal da calculadora ("quanto tempo descansar entre
 * séries") é a deste artigo. Uma URL nova em /ferramentas/ disputaria com
 * ele, e a SERP é híbrida — o mesmo caso da calculadora de calorias da
 * musculação. O artigo não aparecia no Search Console de 30/09, então o
 * título novo e a ferramenta no topo não arriscam nada que funcionava, e os
 * 15 links internos que já apontavam para cá passam a levar à ferramenta.
 *
 * AUDITORIA DE 05/10/2026 (fisiologia, código, UX e SEO)
 *
 * - Os estudos passaram a ser descritos pelo que mediram: Senna (2016) foi
 *   no voador e mediu total de repetições; Longo (2022), em iniciantes na
 *   extensora, perna contra perna; o de autosseleção (Alonso-Aubin, 2024),
 *   uma sessão só. O teto de 4 min da hipertrofia é escolha da conta, não
 *   achado de estudo — o texto agora diz isso.
 * - A primeira dobra dá a resposta curta em números (do motor), como fazem
 *   todos os concorrentes da SERP.
 * - FAQs que repetiam seções saíram; as que contradiziam a tabela (isolador
 *   "nunca passa de 2 min", que valia só para hipertrofia) foram corrigidas.
 * - Ferramenta: o "como foi?" agora aparece com o descanso já correndo.
 *
 * Plano, crítica ao briefing e regras do motor: docs/calculadora-descanso.md.
 */
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import CtaMontinho from '../../components/CtaMontinho.astro';
import Sidebar from '../../components/Sidebar.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import InstagramFollow from '../../components/InstagramFollow.astro';
import AutorMontinho from '../../components/AutorMontinho.astro';
import ContextualCta from '../../components/ContextualCta.astro';
import VideoYouTube from '../../components/VideoYouTube.astro';
import { breadcrumbSchema, articleSchema, faqSchema, personMontinhoSchema } from '../../lib/schema';
import { formatDateLong } from '../../lib/slug';
import { site } from '../../data/site';
import { rotas } from '../../lib/links';
import {
  ATALHOS,
  ESFORCOS,
  FAIXAS_REPS,
  FEEDBACKS,
  FONTES,
  NOTA_RELOGIO,
  NOTA_SEGURANCA,
  OBJETIVOS,
  TIPOS_GENERICOS,
  calcular,
  exercicio,
  formataFaixa,
  formataFaixaFrase,
  type Esforco,
  type FaixaReps,
  type Objetivo,
} from '../../lib/forca/descanso';

const path = '/musculacao/descanso-entre-series';
const atualizadoEm = '2026-10-05';
const crumbs = [
  { nome: 'Início', url: '/' },
  { nome: 'Musculação', url: '/musculacao/' },
  { nome: 'Quanto tempo descansar entre séries', url: path },
];

/* ── Tudo abaixo sai do mesmo motor da calculadora ── */
type R = ReturnType<typeof calcular>;
const de = (objetivo: Objetivo, id: string, reps: FaixaReps, esforco: Esforco) =>
  calcular({ objetivo, demanda: exercicio(id)!.demanda, reps, esforco });
const frase = (r: R) => formataFaixaFrase(r.min, r.max);

const TABELA_IDS = [
  'agachamento',
  'leg-press',
  'terra',
  'supino',
  'remada-curvada',
  'puxada',
  'desenvolvimento',
  'hip-thrust',
  'rosca-direta',
  'triceps-pulley',
  'elevacao-lateral',
  'extensora',
  'panturrilha',
];
const TABELA = TABELA_IDS.map((id) => ({
  ex: exercicio(id)!,
  hip: de('hipertrofia', id, '9-12', 'perto'),
  forca: de('forca', id, '1-5', 'perto'),
}));

const SUPINO_HIP = de('hipertrofia', 'supino', '6-8', 'perto');
const SUPINO_FORCA = de('forca', 'supino', '1-5', 'perto');
const AGACH_HIP = de('hipertrofia', 'agachamento', '6-8', 'perto');
const AGACH_FORCA = de('forca', 'agachamento', '1-5', 'perto');
const ROSCA_HIP = de('hipertrofia', 'rosca-direta', '9-12', 'perto');
const ROSCA_FALHA = de('hipertrofia', 'rosca-direta', '9-12', 'falha');
const LATERAL = de('hipertrofia', 'elevacao-lateral', '13-15', 'perto');
const PESADO_HIP = de('hipertrofia', 'agachamento', '9-12', 'perto');
const COMPOSTO_HIP = de('hipertrofia', 'supino', '9-12', 'perto');
const ISOLADOR_HIP = de('hipertrofia', 'rosca-direta', '9-12', 'perto');
const ISOLADOR_FORCA = de('forca', 'rosca-direta', '1-5', 'perto');
const FORCA_IGUAL = frase(AGACH_FORCA) === frase(SUPINO_FORCA);

const fonte = (id: string) => FONTES.find((f) => f.id === id)!;

const faqs = [
  {
    pergunta: 'Quanto tempo descansar entre séries?',
    resposta: `Depende do exercício e de quão perto da falha a série terminou. Para hipertrofia, em séries de 9 a 12 repetições perto da falha, a conta desta página dá ${frase(PESADO_HIP)} em exercícios pesados como agachamento, ${frase(COMPOSTO_HIP)} em compostos como supino e remada, e ${frase(ISOLADOR_HIP)} em isoladores como rosca e tríceps. O que vale é a próxima série render como a anterior.`,
  },
  {
    pergunta: 'Quanto descansar entre séries para hipertrofia?',
    resposta: `De ${frase(ISOLADOR_HIP)} em isoladores e ${frase(COMPOSTO_HIP)} em compostos, mais nos compostos pesados levados perto da falha. Descansar mais de 60 segundos tende a render um pouco mais de músculo; acima de cerca de 90 segundos, os estudos já não veem diferença — o tempo extra vale quando deixa você repetir as repetições.`,
  },
  {
    pergunta: 'Quanto descansar entre séries para força?',
    resposta: FORCA_IGUAL
      ? `${frase(AGACH_FORCA).replace(/^./, (c) => c.toUpperCase())} nos exercícios pesados, tanto no agachamento quanto no supino, com 1 a 5 repetições perto da falha. Em isoladores, ${frase(ISOLADOR_FORCA)}.`
      : `${frase(AGACH_FORCA).replace(/^./, (c) => c.toUpperCase())} no agachamento e ${frase(SUPINO_FORCA)} no supino, com 1 a 5 repetições perto da falha. Em isoladores, ${frase(ISOLADOR_FORCA)}.`,
  },
  {
    pergunta: '1 minuto de descanso é suficiente?',
    resposta: `Para hipertrofia em isoladores com 8 ou mais repetições, 1 minuto é o começo da faixa: a elevação lateral fica em ${frase(LATERAL)}. Em compostos pesados, 1 minuto tende a custar repetições nas séries seguintes — e com carga alta, até um isolador como o voador rendeu mais com 2 minutos.`,
  },
  {
    pergunta: '2 minutos de descanso é muito?',
    resposta: `Não. Para um composto levado perto da falha, 2 minutos é o começo da faixa: o supino com 6 a 8 repetições fica em ${frase(SUPINO_HIP)}. Em isoladores, para hipertrofia, 2 minutos já é a ponta de cima — a rosca perto da falha fica em ${frase(ROSCA_HIP)}.`,
  },
  {
    pergunta: 'Posso descansar 5 minutos entre séries?',
    resposta: `Pode, e em força faz sentido: ${frase(AGACH_FORCA)} é a faixa do agachamento com poucas repetições. Para hipertrofia, a conta desta página para em 4 minutos por escolha nossa: os estudos não veem ganho de músculo acima de cerca de 90 segundos, então descansar ainda mais só deixa o treino mais longo.`,
  },
  {
    pergunta: 'Quanto descansar entre séries de supino?',
    resposta: `Para hipertrofia, com 6 a 8 repetições perto da falha, ${frase(SUPINO_HIP)}. Para força, com 1 a 5 repetições, ${frase(SUPINO_FORCA)}. Num estudo com carga de 3 repetições máximas, o supino rendeu bem mais repetições com 3 a 5 minutos de descanso do que com 1.`,
  },
  {
    pergunta: 'Quanto descansar entre séries de agachamento?',
    resposta: `Para hipertrofia, com 6 a 8 repetições perto da falha, ${frase(AGACH_HIP)} — é o exercício que mais cansa o corpo inteiro. Para força, com 1 a 5 repetições, ${frase(AGACH_FORCA)}.`,
  },
  {
    pergunta: 'Quanto descansar entre séries de bíceps?',
    resposta: `Na rosca, para hipertrofia, ${frase(ROSCA_HIP)} com 9 a 12 repetições perto da falha, e ${frase(ROSCA_FALHA)} se a série vai até a falha. Isoladores recuperam mais rápido que compostos.`,
  },
  {
    pergunta: 'Descansar demais atrapalha a hipertrofia?',
    resposta:
      'Não há sinal disso. Uma meta-análise de 2024 não viu diferença de hipertrofia entre descansos acima de cerca de 90 segundos. O custo de descansar muito é o tempo do treino, não o músculo.',
  },
];

const relacionados = [
  {
    url: '/musculacao/treinar-ate-a-falha/',
    titulo: 'Treinar até a falha funciona?',
    descricao: 'A proximidade da falha é a pergunta que mais mexe no descanso. Entenda RIR e séries efetivas.',
    tipo: 'Musculação',
  },
  {
    url: '/musculacao/quantas-series-e-repeticoes/',
    titulo: 'Quantas séries e repetições fazer por grupo muscular',
    descricao: 'O descanso responde "quanto tempo entre elas"; aqui, "quantas".',
    tipo: 'Musculação',
  },
  {
    url: '/musculacao/progressao-de-carga/',
    titulo: 'Progressão de carga',
    descricao: 'Um descanso bem dosado é o que deixa anotar mais uma repetição na próxima sessão.',
    tipo: 'Musculação',
  },
  {
    url: '/musculacao/tecnicas-avancadas-de-treino/',
    titulo: 'Técnicas avançadas de treino',
    descricao: 'Drop-set, rest-pause e bi-set: onde o descanso segue outra lógica.',
    tipo: 'Musculação',
  },
];

/* 56 caracteres. */
const title = 'Quanto tempo descansar entre séries? Calculadora e timer';
const description = `Para hipertrofia, de ${formataFaixaFrase(ISOLADOR_HIP.min, PESADO_HIP.max)} conforme o exercício; para força, ${frase(AGACH_FORCA)}. Calcule seu descanso e use o timer, que se ajusta à série que você fez.`;

const capa = '/capas-conteudo/descanso-entre-series.webp';
const capaAlt =
  'Arte da capa: cronômetro dividido em três faixas — força, hipertrofia e resistência — ao lado de um halter — quanto tempo descansar entre séries — Personal por Perto';

const schema = [
  breadcrumbSchema(crumbs),
  articleSchema({ titulo: title, descricao: description, url: new URL(path, site.dominio).href, imagem: new URL(capa, site.dominio).href, atualizadoEm }),
  faqSchema(faqs),
  personMontinhoSchema(),
];

const whatsCompartilhar = `https://wa.me/?text=${encodeURIComponent(`Calculadora de descanso entre séries com timer. Testa no seu treino: ${new URL(path + '/', site.dominio).href}`)}`;
---

<Base title={title} description={description} path={path} ogType="article" image={capa} schema={schema}>
  <Breadcrumbs crumbs={crumbs} />
  <div class="container guide-layout">
    <article class="article-page">
    <p class="eyebrow">Musculação · Calculadora</p>
    <h1>Quanto tempo descansar entre séries? Calculadora e timer</h1>
    <p class="updated">Atualizado em {formatDateLong(atualizadoEm)}</p>

    <p class="lead">
      <strong>Resposta curta:</strong> para hipertrofia, {frase(ISOLADOR_HIP)} em isoladores,
      {frase(COMPOSTO_HIP)} em compostos e {frase(PESADO_HIP)} em agachamento, terra e leg press; para
      força, {frase(AGACH_FORCA)}. Para o seu exercício, responda 4 perguntas — e use o timer no lugar
      do cronômetro da academia.
    </p>

    <section id="ds-app" class="ds-app" aria-labelledby="ds-app-h">
      <h2 id="ds-app-h" class="sr-only" tabindex="-1">Calculadora de descanso entre séries</h2>

      <div id="ds-recentes" class="ds-recentes" hidden>
        <p class="ds-recentes-h">Continuar de onde parou</p>
        <ul id="ds-recentes-lista" class="ds-recentes-lista"></ul>
        <button type="button" id="ds-recentes-apagar" class="ds-link-btn">Apagar estes exercícios do aparelho</button>
      </div>

      <div id="ds-perguntas" class="ds-perguntas">
        <p id="ds-progresso" class="ds-progresso">0 de 4 respondidas</p>

        <fieldset class="ds-grupo" data-grupo="objetivo">
          <legend class="ds-rotulo"><span class="ds-num" aria-hidden="true">1</span> Qual é o objetivo deste treino?</legend>
          <div class="ds-opcoes ds-opcoes-cards">
            {OBJETIVOS.map((o) => (
              <button type="button" class="ds-card" data-valor={o.id} aria-pressed="false">
                <span class="ds-card-nome">{o.nome}</span>
                <span class="ds-card-dica">{o.dica}</span>
              </button>
            ))}
          </div>
        </fieldset>

        <fieldset class="ds-grupo">
          <legend class="ds-rotulo"><span class="ds-num" aria-hidden="true">2</span> Qual exercício?</legend>
          <div class="ds-busca-caixa">
            <label for="ds-busca" class="sr-only">Buscar exercício</label>
            <input
              id="ds-busca"
              type="text"
              inputmode="search"
              autocomplete="off"
              placeholder="Digite: supino, agachamento, rosca…"
              role="combobox"
              aria-autocomplete="list"
              aria-expanded="false"
              aria-controls="ds-sugestoes"
            />
            <ul id="ds-sugestoes" class="ds-sugestoes" role="listbox" aria-label="Exercícios encontrados" hidden></ul>
          </div>
          <p id="ds-busca-status" class="ds-busca-status" aria-live="polite"></p>
          <div class="ds-opcoes ds-opcoes-chips" data-grupo="atalho" role="group" aria-label="Exercícios comuns">
            {ATALHOS.map((id) => (
              <button type="button" class="ds-chip" data-valor={id} aria-pressed="false">{exercicio(id)!.nome}</button>
            ))}
          </div>
          <button type="button" id="ds-nao-encontrei" class="ds-link-btn" aria-expanded="false" aria-controls="ds-generico">Não encontrei meu exercício</button>
          <div id="ds-generico" class="ds-generico" hidden>
            <p class="ds-dica">Sem problema. Ele é mais parecido com qual destes?</p>
            <div class="ds-opcoes ds-opcoes-cards ds-opcoes-1col" data-grupo="generico">
              {TIPOS_GENERICOS.map((t) => (
                <button type="button" class="ds-card" data-valor={t.id} aria-pressed="false">
                  <span class="ds-card-nome">{t.nome}</span>
                  <span class="ds-card-dica">{t.dica}</span>
                </button>
              ))}
            </div>
          </div>
        </fieldset>

        <fieldset class="ds-grupo" data-grupo="reps">
          <legend class="ds-rotulo"><span class="ds-num" aria-hidden="true">3</span> Quantas repetições por série?</legend>
          <div class="ds-opcoes ds-opcoes-chips">
            {FAIXAS_REPS.map((f) => (
              <button type="button" class="ds-chip" data-valor={f.id} aria-pressed="false">{f.nome}</button>
            ))}
          </div>
          <label class="ds-mini" for="ds-reps-num">ou digite o número</label>
          <input id="ds-reps-num" class="ds-input-curto" type="text" inputmode="numeric" autocomplete="off" placeholder="Ex.: 10" />
        </fieldset>

        <fieldset class="ds-grupo" data-grupo="esforco">
          <legend class="ds-rotulo"><span class="ds-num" aria-hidden="true">4</span> Como você termina a série?</legend>
          <div class="ds-opcoes ds-opcoes-cards">
            {ESFORCOS.map((e) => (
              <button type="button" class="ds-card" data-valor={e.id} aria-pressed="false">
                <span class="ds-card-nome">{e.nome}</span>
                <span class="ds-card-dica">{e.frase}</span>
              </button>
            ))}
          </div>
          <button type="button" id="ds-abre-avancado" class="ds-link-btn" aria-expanded="false" aria-controls="ds-avancado">Sei meu RIR ou RPE</button>
          <div id="ds-avancado" class="ds-avancado" hidden>
            <div class="ds-escala" role="group" aria-label="Escala">
              <button type="button" class="ds-chip" data-escala="rir" aria-pressed="true">RIR</button>
              <button type="button" class="ds-chip" data-escala="rpe" aria-pressed="false">RPE</button>
            </div>
            <label class="ds-mini" for="ds-escala-valor">Valor</label>
            <input id="ds-escala-valor" class="ds-input-curto" type="text" inputmode="decimal" autocomplete="off" placeholder="Ex.: 2" />
          </div>
        </fieldset>

        <p id="ds-aviso" class="ds-aviso" role="status" hidden></p>

        <noscript>
          <p class="ds-aviso">
            A calculadora e o timer precisam de JavaScript. A <a href="#tabela-por-exercicio">tabela por exercício</a>,
            logo abaixo, traz as faixas calculadas para os exercícios mais comuns.
          </p>
        </noscript>

        <div id="ds-resultado" class="ds-resultado" hidden>
          <p class="ds-resultado-rotulo">Descanso sugerido</p>
          <p class="ds-faixa" aria-hidden="true"></p>
          <p class="sr-only ds-faixa-extenso"></p>
          <p class="ds-contexto"></p>
          <p class="ds-inicio"></p>
          <button type="button" id="ds-iniciar" class="ds-btn ds-btn-primario ds-btn-grande">Terminei a 1ª série — iniciar descanso</button>
          <details class="ds-por-que">
            <summary>Por que esse descanso?</summary>
            <p class="ds-por-que-texto"></p>
            <p class="ds-nota">{NOTA_RELOGIO}</p>
          </details>
          <p class="ds-nota ds-nota-tecnicas" hidden></p>
          <p class="ds-nota" hidden><a class="ds-artigo">Como fazer o exercício</a></p>
        </div>
      </div>

      <div id="ds-timer" class="ds-timer" hidden>
        <h3 id="ds-timer-h" class="ds-timer-ex" tabindex="-1"><span id="ds-timer-ex">Seu exercício</span></h3>
        <p id="ds-timer-serie" class="ds-timer-serie"></p>

        <div id="ds-contando" class="ds-contando">
          <p id="ds-tempo" class="ds-tempo" role="timer" aria-live="off">0:00</p>
          <div class="ds-barra-trilho" aria-hidden="true"><div id="ds-barra" class="ds-barra"></div></div>
          <div class="ds-controles">
            <button type="button" class="ds-btn ds-btn-secundario" data-soma="-15">−15 s<span class="sr-only"> (menos 15 segundos)</span></button>
            <button type="button" id="ds-pausar" class="ds-btn ds-btn-secundario">Pausar</button>
            <button type="button" class="ds-btn ds-btn-secundario" data-soma="30">+30 s<span class="sr-only"> (mais 30 segundos)</span></button>
          </div>
          <button type="button" id="ds-pular" class="ds-btn ds-btn-secundario ds-btn-largo">Pular descanso</button>
        </div>

        <div id="ds-fim" class="ds-fim" hidden>
          <h4 id="ds-fim-h" class="ds-fim-h" tabindex="-1">Fim do descanso</h4>
          <p id="ds-fim-proxima" class="ds-fim-proxima">Hora da próxima série</p>
          <p class="ds-dica">Ainda ofegante? Pode dar mais um tempo.</p>
          <div class="ds-controles ds-controles-2">
            <button type="button" id="ds-fiz" class="ds-btn ds-btn-primario ds-btn-grande">Fiz a série — iniciar descanso</button>
            <button type="button" class="ds-btn ds-btn-secundario ds-btn-grande" data-soma="30">+30 s<span class="sr-only"> (mais 30 segundos de descanso)</span></button>
          </div>
          <button type="button" class="ds-link-btn" data-encerrar>Terminei este exercício</button>
        </div>

        <div id="ds-retorno" class="ds-retorno" hidden>
          <p id="ds-retorno-h" class="ds-retorno-h">Como foi a série, comparada à anterior?</p>
          <div class="ds-opcoes ds-opcoes-lista">
            {FEEDBACKS.map((f) => (
              <button type="button" class="ds-card ds-card-linha" data-feedback={f.id} aria-pressed="false">{f.nome}</button>
            ))}
          </div>
          <p id="ds-ajuste" class="ds-ajuste" hidden></p>
          <details class="ds-anotar">
            <summary>Anotar repetições e carga (opcional)</summary>
            <div class="ds-anotar-campos">
              <label>Repetições <input id="ds-anota-reps" class="ds-input-curto" type="text" inputmode="numeric" autocomplete="off" /></label>
              <label>Carga (kg) <input id="ds-anota-carga" class="ds-input-curto" type="text" inputmode="decimal" autocomplete="off" /></label>
            </div>
            <p id="ds-anota-aviso" class="ds-mini" hidden>Repetições: número inteiro de 1 a 100. Carga: até 1000 kg, com vírgula se precisar.</p>
            <p class="ds-mini">Fica só neste aparelho, durante esta visita.</p>
          </details>
          <button type="button" class="ds-link-btn" data-encerrar>Terminei este exercício</button>
        </div>

        <div class="ds-historico-box" hidden>
          <p class="ds-mini">Esta sessão</p>
          <ol id="ds-historico" class="ds-historico"></ol>
        </div>

        <div class="ds-prefs">
          <button type="button" id="ds-som" class="ds-chip ds-pref" aria-pressed="false">Bipe no fim</button>
          <button type="button" id="ds-vibrar" class="ds-chip ds-pref" aria-pressed="true">Vibrar no fim</button>
        </div>
        <p class="ds-mini ds-tela-aberta">Deixe esta tela aberta: com o celular bloqueado, o aviso do fim pode atrasar.</p>
        <p class="ds-seguranca">{NOTA_SEGURANCA}</p>
      </div>

      <p id="ds-anuncio" class="sr-only" aria-live="polite"></p>

      <div class="ds-compartilha">
        <button type="button" id="ds-compartilhar" class="ds-link-btn">Compartilhar a calculadora</button>
        <a id="ds-whats" class="ds-link-btn" href={whatsCompartilhar} target="_blank" rel="noopener">Mandar no WhatsApp</a>
      </div>
    </section>

    <p class="ds-micro">Grátis · sem cadastro · a conta e o timer rodam no seu navegador · nada do que você anota sai do aparelho</p>

    <div class="prose">
      <h2 id="tabela-por-exercicio">Quanto descansar em cada exercício</h2>
      <p>
        A mesma conta da calculadora, para os exercícios mais comuns, com a série terminando perto da
        falha. Na força, o teto de 5 minutos iguala os compostos; o que muda de verdade é entre
        composto e isolador.
      </p>
      <div class="tabela-rolavel">
        <table>
          <caption>Faixa de descanso por exercício: hipertrofia com 9 a 12 repetições, força com 1 a 5</caption>
          <thead>
            <tr><th scope="col">Exercício</th><th scope="col">Hipertrofia</th><th scope="col">Força</th></tr>
          </thead>
          <tbody>
            {TABELA.map((l) => (
              <tr>
                <th scope="row">{l.ex.artigo ? <a href={l.ex.artigo}>{l.ex.nome}</a> : l.ex.nome}</th>
                <td>{formataFaixa(l.hip)}</td>
                <td>{formataFaixa(l.forca)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p>
        Se a série termina mais longe da falha, o descanso cai; se vai até a falha, pode subir. É isso
        que a calculadora acima ajusta.
      </p>

      <figure class="ds-capa">
        <img src={capa} alt={capaAlt} width="1200" height="675" loading="lazy" decoding="async" />
      </figure>

      <h2>O que o intervalo entre séries muda no treino</h2>
      <p>
        Cada série consome a fonte rápida de energia do músculo e a capacidade de gerar força. O
        intervalo é o tempo que o corpo tem para repor parte disso antes da próxima. Se a pausa
        é curta demais, você começa a série seguinte ainda em déficit — faz menos repetições, com
        menos carga ou com pior técnica.
      </p>
      <p>
        O efeito acumulado é uma queda no volume que você consegue fazer com qualidade. Como
        mostra o artigo sobre <a href="/musculacao/quantas-series-e-repeticoes/">quantas séries e
        repetições fazer</a>, esse volume é um dos principais motores da hipertrofia — e o
        intervalo é, na prática, a ferramenta para protegê-lo.
      </p>

      <h2>Quanto descansar para hipertrofia</h2>
      <p>
        A regra antiga era descansar pouco, de 30 a 60 segundos, pela ideia de que mais estresse
        metabólico daria mais crescimento. A pesquisa enfraqueceu essa lógica. Num estudo com
        homens treinados, com os mesmos exercícios e séries, quem descansou 3 minutos ganhou mais
        força no supino e no agachamento e mais espessura na coxa do que quem descansou 1 (<a
        href={fonte('schoenfeld').url} target="_blank" rel="noopener">Schoenfeld e colegas, 2016</a>).
      </p>
      <p>
        Uma meta-análise de 2024 encontrou um pequeno benefício em descansar <strong>mais de 60
        segundos</strong>, e nenhuma diferença apreciável acima de cerca de 90 segundos (<a
        href={fonte('singer').url} target="_blank" rel="noopener">Singer e colegas, 2024</a>). E um
        estudo com iniciantes na cadeira extensora ajuda a entender por quê: a perna que descansou
        1 minuto e fez séries extras para igualar o volume cresceu o mesmo que a de 3 minutos (<a
        href={fonte('longo').url} target="_blank" rel="noopener">Longo e colegas, 2022</a>).
      </p>
      <div class="callout">
        <strong>Na prática:</strong> o descanso não faz o músculo crescer sozinho — ele vale pelas
        repetições que deixa você fazer na próxima série. Por isso a calculadora começa em 1 minuto
        para hipertrofia e sobe quando o exercício e a proximidade da falha pedem.
      </div>

      <h2>Quanto descansar para força</h2>
      <p>
        Para força máxima, a referência é de <strong>3 a 5 minutos</strong> nos exercícios pesados.
        Uma revisão da literatura viu que, com cargas de 50% a 90% do 1RM, descansos desse tamanho
        permitiram mais repetições ao longo das séries e deram mais ganho de força (<a
        href={fonte('desalles').url} target="_blank" rel="noopener">de Salles e colegas, 2009</a>).
        Se você ainda não sabe a sua carga máxima, a <a href="/ferramentas/calculadora-1rm/"
        data-rest-link="1rm">calculadora de 1RM</a> estima pela série que você já faz.
      </p>

      <h2>Exercícios compostos e isoladores</h2>
      <p>
        Agachamento, terra e leg press cansam o corpo inteiro; supino e remada usam vários músculos;
        rosca, tríceps e elevação lateral, um só. A diferença foi medida: com carga de 3 repetições
        máximas, o voador (o crucifixo na máquina) já rendeu mais repetições com 2 minutos de descanso
        do que com 1; no supino, só 3 ou 5 minutos fizeram diferença, e a queda de série para série
        foi bem menor do que com 1 minuto (<a href={fonte('senna').url} target="_blank"
        rel="noopener">Senna e colegas, 2016</a>). Por isso a calculadora pergunta o exercício — e você
        não precisa saber se ele é composto ou isolador: ela sabe.
      </p>

      <h2>Descansar pouco para "suar mais" é mito</h2>
      <p>
        Suor e falta de ar medem o esforço do coração e o calor da sessão, não o estímulo que o
        músculo recebeu. Uma série começada cedo porque você ainda estava ofegante gera
        <em>menos</em> repetições efetivas, não mais resultado. Pausas curtas fazem sentido quando o
        objetivo é condicionamento ou o tempo do treino é curto — e essa troca deve ser consciente.
      </p>

      <h2>Como saber se você precisa descansar mais</h2>
      <p>{NOTA_RELOGIO}</p>
      <ul>
        <li>Ainda ofegante, sem conseguir controlar a respiração para começar a série.</li>
        <li>A série seguinte perde muitas repetições com a mesma carga.</li>
        <li>A execução piora: amplitude encurta, o tronco ajuda, a barra sai torta.</li>
      </ul>
      <p>
        Perto da falha, perder 1 ou 2 repetições de uma série para outra é normal, mesmo com
        descanso longo — é fadiga acumulada. O timer acima leva isso em conta quando sugere o
        próximo tempo.
      </p>

      <h2>Quanto descansar entre um exercício e outro</h2>
      <p>
        Não há estudo que separe esse intervalo. Na prática, ele é o tempo de arrumar o próximo
        exercício somado ao descanso que esse próximo exercício pede: antes de um composto pesado,
        pelo menos {frase(PESADO_HIP)} em hipertrofia; quando o próximo é um isolador,
        {frase(ISOLADOR_HIP)} já bastam.
      </p>

      <h2>Superset, drop-set, rest-pause e circuito</h2>
      <ul>
        <li>
          <strong>Superset ou bi-set:</strong> não há descanso entre os dois exercícios da dupla; o
          descanso vem depois da rodada. Se os exercícios são de músculos diferentes, a rodada
          pode seguir a faixa do exercício mais pesado dela.
        </li>
        <li>
          <strong>Drop-set:</strong> a carga cai sem pausa; o descanso conta só depois da última queda.
        </li>
        <li>
          <strong>Rest-pause:</strong> as pausas de 10 a 20 segundos fazem parte da série, não são
          descanso entre séries. Depois do bloco, descanse a faixa normal do exercício.
        </li>
        <li>
          <strong>Circuito:</strong> a recuperação incompleta é o estímulo. A calculadora, com
          objetivo "condicionamento", mostra a faixa curta para isso.
        </li>
      </ul>
      <p>
        Mais sobre essas técnicas em <a href="/musculacao/tecnicas-avancadas-de-treino/">técnicas
        avançadas de treino</a>.
      </p>

      <h2>Descansar "até estar pronto" funciona?</h2>
      <p>
        Para manter a qualidade da série, parece funcionar. Num estudo de uma sessão de agachamento
        pesado com 13 pessoas treinadas, quem escolheu o próprio descanso (perto de 1 min 37 s, em
        média) rendeu o mesmo que quem descansou 2 minutos fixos (<a href={fonte('alonso').url}
        target="_blank" rel="noopener">Alonso-Aubin e colegas, 2024</a>). Para quem está começando,
        um tempo de referência pode ajudar a não voltar cedo demais — o timer desta página começa
        numa faixa e ajusta pelo que aconteceu na sua série.
      </p>

      <h2 id="como-calculamos">Como a calculadora chega na faixa</h2>
      <p>
        A conta parte do exercício — quanto ele cansa o corpo inteiro — e anda numa escada de
        intervalos práticos: 30 s, 45 s, 1, 1:30, 2, 2:30, 3, 4 e 5 minutos. Poucas repetições
        (carga alta) sobem um degrau; muitas descem, menos quando a série longa vai perto da falha.
        Série até a falha sobe; longe da falha desce. Força sobe um degrau e nunca fica abaixo de
        1:30 em isolador e 2 minutos em composto; resistência e condicionamento descem dois.
        Hipertrofia fica entre 1 e 4 minutos.
      </p>
      <p>
        O que <strong>não</strong> entra, de propósito: o seu tempo de treino — há sinal de que
        treinados se beneficiam mais de descansos longos, mas o que muda neles é a carga e a
        proximidade da falha, que a conta já pergunta — e a porcentagem do 1RM, que repetições e
        proximidade da falha já dizem. Ninguém validou uma fórmula de segundos para cada exercício;
        por isso o resultado é faixa, e não número exato. É referência de treino, não avaliação
        médica nem prescrição individual — esse ajuste fino é papel de um <a
        href={rotas.comoEscolher}>personal trainer qualificado</a>.
      </p>

      <h2>Quando parar o treino em vez de descansar mais</h2>
      <p>{NOTA_SEGURANCA}</p>
    </div>

    <VideoYouTube
      id="NHCnxfLEvwk"
