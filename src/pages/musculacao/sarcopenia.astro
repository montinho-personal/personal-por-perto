 * "dá para reverter?". Sem vídeo (nenhum Short do tema).
 * Fontes (17/11/2026): EWGSOP2 2019 (resumo; pontos de corte da força de
 * preensão conferidos em dois estudos independentes que os citam), ICFSR
 * 2018, PROT-AGE 2013, Fiatarone 1994, Peterson 2010, Anker 2016.
 */
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import CtaMontinho from '../../components/CtaMontinho.astro';
import Sidebar from '../../components/Sidebar.astro';
