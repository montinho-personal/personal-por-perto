---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import CtaMontinho from '../../components/CtaMontinho.astro';
import Sidebar from '../../components/Sidebar.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import InstagramFollow from '../../components/InstagramFollow.astro';
import AutorMontinho from '../../components/AutorMontinho.astro';
import ContextualCta from '../../components/ContextualCta.astro';
import FerramentaInline from '../../components/FerramentaInline.astro';
import { breadcrumbSchema, articleSchema, faqSchema, personMontinhoSchema } from '../../lib/schema';
import { formatDateLong } from '../../lib/slug';
import { site } from '../../data/site';
import { rotas } from '../../lib/links';
import { cidades } from '../../data/cidades';

/*
 * Artigo criado em 08/10/2026 a partir dos prints e da pesquisa de
 * palavras-chave de "coach de academia" (260 buscas/mês). Antes dele, o
 * Google mostrava uma página de cidade qualquer para essa busca — dez
 * cidades diferentes em 90 dias. Registro em docs/artigo-coach-de-academia.md.
 */

/*
 * Preços: as mesmas medianas das cidades do portal que a ferramenta
 * Presencial ou Online usa, calculadas do dado — nenhum valor digitado.
 */
const mediana = (v: number[]) => {
  const o = [...v].sort((a, b) => a - b);
  const m = Math.floor(o.length / 2);
  return o.length % 2 ? o[m] : (o[m - 1] + o[m]) / 2;
};
type CampoPreco = keyof (typeof cidades)[number]['precos'];
const faixa = (min: CampoPreco, max: CampoPreco) => ({
  min: mediana(cidades.map((c) => c.precos[min])),
  max: mediana(cidades.map((c) => c.precos[max])),
});
const ONLINE = faixa('onlineMin', 'onlineMax');
const PRESENCIAL = faixa('mensalMin', 'mensalMax');
const brl = (v: number) => `R$ ${v.toLocaleString('pt-BR')}`;

const SMART_FIT_PERSONAL = 'https://www.smartfit.com.br/news/academia/personal-trainer-smart-fit/';
const CROSSFIT_L1 = 'https://crossfit.com/essentials/crossfits-coaching-courses-and-credentials-explained';
const LEI_9696 = 'https://www2.camara.leg.br/legin/fed/lei/1998/lei-9696-1-setembro-1998-374623-normaatualizada-pl.html';

const relacionados = [
  {
    url: '/guias/personal-trainer-em-academia/',
    titulo: 'Personal trainer em academia: como funciona',
    descricao: 'Se a academia aceita personal de fora, quanto custa e quando vale mais que o professor de salão.',
    tipo: 'Guia',
  },
  {
    url: '/guias/personal-online-funciona/',
    titulo: 'Personal trainer online funciona?',
    descricao: 'O formato que muita gente chama de "coach online": para quem funciona e como reconhecer um serviço sério.',
    tipo: 'Guia',
  },
  {
    url: rotas.quantoCusta,
    titulo: 'Quanto custa um personal trainer',
    descricao: 'Faixas por formato — avulsa, pacote mensal e online — e o que muda o preço.',
    tipo: 'Guia',
  },
  {
    url: rotas.comoEscolher,
    titulo: 'Como escolher um personal trainer',
    descricao: 'Critérios para contratar bem, seja qual for o nome que o profissional usa.',
    tipo: 'Guia',
  },
];

const path = '/guias/coach-de-academia';
const publicadoEm = '2026-10-08';
const atualizadoEm = '2026-10-08';
const crumbs = [
  { nome: 'Início', url: '/' },
  { nome: 'Guias', url: '/guias/' },
  { nome: 'Coach de academia', url: path },
];

const faqs = [
  {
    pergunta: 'O que é coach na academia?',
    resposta:
      'Na academia, "coach" é um nome, não uma profissão à parte. Ele aparece em três situações: o professor que conduz a aula no CrossFit e no treino funcional, que nesses lugares se chama coach; a consultoria de treino online, em que o profissional monta e ajusta o plano a distância; e o coach comportamental, que trabalha motivação e hábito, mas não monta treino. Para saber de qual se trata, pergunte quem vai escrever o seu treino e se ele vai estar ao seu lado na execução.',
  },
  {
    pergunta: 'Qual a diferença entre coach e personal trainer?',
    resposta:
      'O personal trainer acompanha a sua sessão do começo ao fim, corrige cada série e ajusta o plano conforme você evolui. O coach, dependendo do lugar, conduz uma aula em grupo, acompanha você a distância ou trabalha só a parte de hábito e motivação. A diferença que importa não é o nome: é se existe alguém planejando o seu treino e se ele vê você executar.',
  },
  {
    pergunta: 'Quanto custa um coach de musculação?',
    resposta: `Quando "coach" quer dizer consultoria online — o uso mais comum para musculação —, a faixa na cidade mediana do portal vai de ${brl(ONLINE.min)} a ${brl(ONLINE.max)} por mês. O pacote presencial com personal, de 2 a 3 sessões por semana, fica entre ${brl(PRESENCIAL.min)} e ${brl(PRESENCIAL.max)}. A aula de CrossFit ou funcional com coach costuma vir dentro da mensalidade do box ou do estúdio. São estimativas editoriais por cidade, não pesquisa de preço.`,
  },
  {
    pergunta: 'Precisa ser formado em educação física para ser coach de academia?',
    resposta:
      'Para montar e conduzir treino, sim: no Brasil, a profissão de educação física é regulamentada por lei (Lei 9.696/1998), e prescrever exercício é trabalho desse profissional. Certificados de marca, como o Level 1 da CrossFit — um curso de dois dias —, são formação complementar e não substituem a graduação. O coach comportamental, que não prescreve treino, não precisa dessa formação.',
  },
  {
    pergunta: 'Como se chama a pessoa que treina os alunos na academia?',
    resposta:
      'Depende do vínculo. Quem a academia contrata para atender o salão inteiro é o professor de salão, também chamado de instrutor; ele está incluído na mensalidade e divide a atenção entre todos os alunos. Quem você contrata para acompanhar só você é o personal trainer. No CrossFit e em estúdios de funcional, quem conduz a aula costuma se apresentar como coach.',
  },
];

const title = 'Coach de Academia: o Que É e a Diferença para o Personal';
const description =
  'Coach de academia: o que é, a diferença para o personal trainer e o professor de salão, quanto custa um coach de musculação e quem pode montar seu treino.';

const schema = [
  breadcrumbSchema(crumbs),
  articleSchema({ titulo: title, descricao: description, url: new URL(path, site.dominio).href, publicadoEm, atualizadoEm }),
  faqSchema(faqs),
  personMontinhoSchema(),
];
---

<Base title={title} description={description} path={path} ogType="article" schema={schema}>
  <Breadcrumbs crumbs={crumbs} />
  <div class="container guide-layout">
    <article class="article-page">
    <p class="eyebrow">Quem faz o quê na academia</p>
    <h1>Coach de academia: o que é e qual a diferença para o personal trainer</h1>
    <p class="updated">Atualizado em {formatDateLong(atualizadoEm)}</p>

    <p class="lead">
      "Coach de academia" é um nome, não uma profissão à parte. A palavra
      cobre três coisas diferentes: o professor que conduz a aula no CrossFit
      e no funcional, a consultoria de treino online e o coach comportamental,
      que trabalha motivação e hábito sem montar treino. O personal trainer é
      outra coisa — é quem fica ao seu lado a sessão inteira. Antes de
      contratar, a pergunta útil não é o nome: é <strong>quem escreve o seu
      treino e se essa pessoa vê você executar</strong>.
    </p>

    <div class="prose">
      <h2>O que é coach na academia</h2>
      <p>
        Na prática, quem diz "meu coach de academia" pode estar falando de
        três profissionais:
      </p>
      <ul>
        <li>
          <strong>O professor da aula de CrossFit ou de funcional.</strong>
          Nos boxes, "coach" é o título de quem conduz a turma: ensina o
          movimento, ajusta a carga de cada um e controla o tempo do treino
          do dia. A própria CrossFit chama de "coaching" a formação de quem
          dá aula, começando pelo{' '}
          <a href={CROSSFIT_L1} target="_blank" rel="noopener">curso Level 1</a>,
          de dois dias. A atenção é dividida com a turma, mas o coach está ali
          olhando a execução.
        </li>
        <li>
          <strong>A consultoria online.</strong> O profissional monta o
          treino a partir de uma conversa inicial, entrega pelo aplicativo e
          ajusta a distância — muitas vezes com o nome de "coach". A Smart
          Fit, por exemplo, chama assim a sua consultoria online e a descreve
          como opção para quem quer um treino direcionado{' '}
          <a href={SMART_FIT_PERSONAL} target="_blank" rel="noopener">"sem
          depender de um personal presencial em todos os horários"</a>.
        </li>
        <li>
          <strong>O coach comportamental.</strong> Fora do mundo do treino,
          "coach" é quem ajuda a definir metas, criar rotina e manter a
          constância. É o sentido que a visão geral do Google costuma dar à
          palavra. Esse profissional não prescreve exercício.
        </li>
      </ul>
      <p>
        Há ainda o <strong>coach de performance</strong>, expressão usada para
        a preparação física de quem treina para um esporte — corrida, luta,
        futebol. É o trabalho de preparador físico, com nome em inglês.
      </p>

      <h2>Qual a diferença entre coach e personal trainer</h2>
      <p>
        A diferença está em duas perguntas: <strong>quem planeja</strong> o
        seu treino e <strong>quem vê você executar</strong>.
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th></th><th>Planeja o seu treino?</th><th>Vê você executar?</th><th>Atenção</th></tr>
          </thead>
          <tbody>
            <tr><td>Personal trainer</td><td>Sim, a partir de avaliação</td><td>Sim, a sessão toda</td><td>Só sua</td></tr>
            <tr><td>Coach de CrossFit ou funcional</td><td>Treino do dia, igual para a turma, com ajustes</td><td>Sim, durante a aula</td><td>Dividida com a turma</td></tr>
            <tr><td>Coach online (consultoria)</td><td>Sim, a partir de conversa ou questionário</td><td>Por vídeo, quando você manda</td><td>Sua, a distância</td></tr>
            <tr><td>Professor de salão (instrutor)</td><td>Ficha inicial</td><td>Quando você pede ajuda</td><td>Dividida com o salão</td></tr>
            <tr><td>Coach comportamental</td><td>Não</td><td>Não</td><td>Hábito e motivação</td></tr>
          </tbody>
        </table>
      </div>
      <p>
        Nenhum formato é melhor em si. Quem já executa bem os exercícios e
        precisa de plano e cobrança costuma se dar bem com o coach online.
        Quem está começando, voltando de lesão ou travou na evolução ganha
        mais com alguém ao lado corrigindo em tempo real.
      </p>

      <h2>Coach, instrutor e personal: quem é quem dentro da academia</h2>
      <p>
        O <strong>professor de salão</strong> — o instrutor — é funcionário
        da academia e já está incluído na mensalidade. A Smart Fit descreve
        bem o papel: ele monta a ficha inicial, explica os aparelhos e tira
        dúvida, mas{' '}
        <a href={SMART_FIT_PERSONAL} target="_blank" rel="noopener">circula
        pelo salão atendendo vários alunos</a> e não fica ao seu lado contando
        repetição. Algumas academias chamam esse professor de coach; o papel
        é o mesmo.
      </p>
      <p>
        O <strong>personal trainer</strong> é contratado por você, à parte. Se
        ele vai treinar você dentro de uma academia, a academia precisa
        aceitar personal de fora — as regras variam por rede e por unidade, e
        o <a href="/guias/personal-trainer-em-academia/">guia de personal em
        academia</a> mostra o que perguntar na recepção antes de fechar.
      </p>

      <h2>Quanto custa um coach de musculação</h2>
      <p>
        Depende de qual coach. A aula com coach de CrossFit ou de funcional
        costuma vir dentro da mensalidade do box ou do estúdio. Quando o
        coach é consultoria online — o sentido mais comum quando a pessoa
        pensa em musculação —, a conta fica assim, na cidade mediana do
        portal:
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Formato</th><th>Faixa por mês</th></tr>
          </thead>
          <tbody>
            <tr><td>Coach online (consultoria)</td><td>{brl(ONLINE.min)} a {brl(ONLINE.max)}</td></tr>
            <tr><td>Personal presencial, 2 a 3 vezes por semana</td><td>{brl(PRESENCIAL.min)} a {brl(PRESENCIAL.max)}</td></tr>
          </tbody>
        </table>
      </div>
      <p class="small">
        Estimativas editoriais calculadas das faixas das cidades do portal,
        não pesquisa de preço. A diferença existe porque o presencial vende a
        hora exclusiva do profissional; o online vende planejamento e ajuste
        contínuo.
      </p>

      <FerramentaInline
        id="presencial-ou-online"
        texto="A diferença de preço só vale a pena se o formato servir para você. A ferramenta pergunta como você treina hoje — se já executa bem, se tem academia perto, se a rotina muda toda semana — e diz se o acompanhamento a distância dá conta ou se você precisa de alguém ao lado."
        acao="Ver se o online serve para mim"
      />

      <h2>Quem pode montar o seu treino</h2>
      <p>
        No Brasil, a profissão de educação física é regulamentada pela{' '}
        <a href={LEI_9696} target="_blank" rel="noopener">Lei 9.696/1998</a>,
        e montar e conduzir treino é trabalho desse profissional — se chame
        ele de coach, professor ou personal. Certificados de marca, como o
        Level 1 da CrossFit, são complemento, não substituem a graduação. Já
        o coach comportamental pode ajudar muito com rotina e motivação, mas
        não é ele quem deve escolher exercício, série e carga.
      </p>
      <p>Antes de contratar qualquer um deles, quatro perguntas resolvem:</p>
      <ol>
        <li>Quem vai escrever o meu treino, e qual a formação dessa pessoa?</li>
        <li>Vai haver avaliação antes? O que vai ser medido?</li>
        <li>Como você acompanha a minha execução — ao vivo, por vídeo ou não acompanha?</li>
        <li>De quanto em quanto tempo o plano muda, e com base em quê?</li>
      </ol>
      <p>
        Se você mora em <a href="/personal-trainer/alphaville-sp/">Alphaville</a>{' '}
        ou em <a href="/personal-trainer/barueri-sp/">Barueri</a>, as páginas
        da região mostram as academias conferidas, as faixas de preço locais
        e como funciona o atendimento em condomínio.
      </p>
    </div>

    <Faq faqs={faqs} />

    <ContextualCta path={path} assunto={title} />
    <InstagramFollow tema="geral" />
    <AutorMontinho />

    <RelatedArticles itens={relacionados} />
    </article>

    <Sidebar />
  </div>

  <section class="section-sm">
    <div class="container">
      <CtaMontinho variante="destaque" />
    </div>
  </section>
</Base>

<style>
  .guide-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-6);
    padding-block: var(--sp-7);
  }
  @media (min-width: 980px) {
    .guide-layout {
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: var(--sp-7);
    }
  }
  .article-page {
    min-width: 0;
    max-width: 760px;
  }
  .updated {
    color: var(--muted);
    font-size: var(--step--1);
    margin-top: var(--sp-2);
  }
  .lead {
    margin-top: var(--sp-4);
    font-size: var(--step-1);
    color: var(--ink-soft);
    line-height: 1.55;
  }
  .article-page .prose {
    margin-top: var(--sp-5);
  }
  .small {
    font-size: var(--step--1);
  }
</style>
