---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { breadcrumbSchema, itemListSchema } from '../../lib/schema';
import { site } from '../../data/site';

const path = '/guias';
const crumbs = [
  { nome: 'Início', url: '/' },
  { nome: 'Guias', url: path },
];

const guias = [
  {
    url: '/guias/como-escolher-personal-trainer/',
    titulo: 'Como escolher um personal trainer',
    desc: 'O passo a passo completo: registro profissional, especialização, avaliação inicial, método e sinais de alerta.',
    tag: 'Guia essencial',
  },
  {
    url: '/guias/quanto-custa-personal-trainer/',
    titulo: 'Quanto custa um personal trainer',
    desc: 'Faixas de preço por formato (avulsa, mensal e online), o que influencia o valor e como economizar sem perder qualidade.',
    tag: 'Preços',
  },
  {
    url: '/guias/personal-online-funciona/',
    titulo: 'Personal trainer online funciona?',
    desc: 'Para quem o formato online funciona bem, como reconhecer um serviço sério e o que perguntar antes de contratar.',
    tag: 'Online x presencial',
  },
  {
    url: '/guias/quantas-vezes-por-semana-personal-trainer/',
    titulo: 'Quantas vezes por semana treinar com personal trainer',
    desc: 'O que define a frequência ideal, faixas comuns por objetivo e como decidir considerando orçamento e rotina.',
    tag: 'Frequência',
  },
  {
    url: '/guias/personal-trainer-para-iniciantes/',
    titulo: 'Personal trainer para iniciantes: vale a pena contratar?',
    desc: 'Por que quem nunca treinou se beneficia especialmente de acompanhamento, e como decidir entre começar sozinho ou acompanhado.',
    tag: 'Iniciantes',
  },
  {
    url: '/guias/personal-trainer-para-emagrecimento/',
    titulo: 'Personal trainer para emagrecimento: como escolher',
    desc: 'O que procurar num profissional com foco em emagrecimento, e sinais de alerta específicos desse nicho.',
    tag: 'Emagrecimento',
  },
  {
    url: '/guias/personal-trainer-para-terceira-idade/',
    titulo: 'Personal trainer para terceira idade: como escolher',
    desc: 'Por que o acompanhamento é especialmente valioso depois dos 60, o que procurar no profissional e sinais de alerta.',
    tag: 'Terceira idade',
  },
  {
    url: '/guias/vale-a-pena-contratar-personal-trainer/',
    titulo: 'Vale a pena contratar um personal trainer?',
    desc: 'Uma resposta honesta: para quem costuma valer muito, para quem talvez não precise agora e as alternativas intermediárias.',
    tag: 'Decisão',
  },
  {
    url: '/guias/personal-trainer-a-domicilio/',
    titulo: 'Personal trainer a domicílio: como funciona e quanto custa',
    desc: 'O que o profissional leva, espaço necessário, diferença de preço e para quem o atendimento em casa faz mais sentido.',
    tag: 'A domicílio',
  },
  {
    url: '/guias/personal-trainer-em-condominio/',
    titulo: 'Personal trainer em condomínio: como funciona e quanto custa',
    desc: 'Regras do prédio, o que a portaria exige, custo do treino em dupla e se a academia do condomínio dá conta.',
    tag: 'Condomínio',
  },
  {
    url: '/guias/avaliacao-fisica/',
    titulo: 'Avaliação física: o que é, o que mede e por que importa',
    desc: 'Anamnese, composição corporal, perimetria e testes — o que reavaliar a cada 8-12 semanas revela sobre o seu plano.',
    tag: 'Avaliação',
  },
  {
    url: '/guias/personal-trainer-para-mulheres/',
    titulo: 'Personal trainer para mulheres: o guia completo',
    desc: 'O que muda (e o que não muda) no treino feminino, os mitos que travam resultado e os ajustes por fase da vida.',
    tag: 'Por perfil',
  },
];

const title = 'Guias sobre personal trainer — como escolher, preços e contratação';
const description =
  'Guias completos e independentes sobre personal trainer: como escolher, quanto custa, online x presencial, frequência ideal e como escolher por objetivo.';

const schema = [
  breadcrumbSchema(crumbs),
  itemListSchema('Guias do portal', guias.map((g) => g.titulo), new URL(path, site.dominio).href),
];
---

<Base title={title} description={description} path={path} schema={schema}>
  <Breadcrumbs crumbs={crumbs} />
  <header class="section-sm tint">
    <div class="container">
      <p class="eyebrow">Conteúdo editorial</p>
      <h1>Guias sobre personal trainer</h1>
      <p class="lead" style="max-width: 60ch">
        Conteúdos aprofundados para você decidir com segurança — independentemente da
        cidade onde treina.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="grid grid-3">
        {
          guias.map((g) => (
            <a class="card card-hover guide" href={g.url}>
              <span class="pill">{g.tag}</span>
              <h2>{g.titulo}</h2>
              <p>{g.desc}</p>
              <span class="guide-link">Ler guia →</span>
            </a>
          ))
        }
      </div>
      <p class="muted small" style="margin-top: var(--sp-6)">
        Quer aprender sobre o treino em si? Veja os conteúdos de
        <a href="/musculacao/">musculação</a> e de
        <a href="/emagrecimento/">emagrecimento</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .guide {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--ink);
  }
  .guide:hover {
    text-decoration: none;
  }
  .guide h2 {
    font-size: var(--step-2);
  }
  .guide p {
    color: var(--ink-soft);
    flex: 1;
  }
  .guide-link {
    font-weight: 700;
    color: var(--brand-600);
  }
  .small {
    font-size: var(--step--1);
  }
</style>
