---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import CtaMontinho from '../../components/CtaMontinho.astro';
import Sidebar from '../../components/Sidebar.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import InstagramFollow from '../../components/InstagramFollow.astro';
import AutorMontinho from '../../components/AutorMontinho.astro';
import ContextualCta from '../../components/ContextualCta.astro';
import FerramentaInline from '../../components/FerramentaInline.astro';
import { breadcrumbSchema, articleSchema, faqSchema, personMontinhoSchema } from '../../lib/schema';
import { formatDateLong } from '../../lib/slug';
import { site } from '../../data/site';

/*
 * Cobertura de evento (modelo: artigo + varreduras até a prova + resultado
 * no dia). Registro de fatos, fontes e pendências em
 * docs/eventos/hyrox-sao-paulo-2026.md — só entra aqui o que está
 * "Confirmado" lá. As rotinas de varredura e de resultado atualizam esta
 * página; "Última verificação" e atualizadoEm só sobem com fato novo.
 */

/** Data de conferência das fontes, no formato DD/MM/AAAA. */
const ultimaVerificacao = '19/10/2026';

const HYROX_OFICIAL = 'https://hyrox.com/event/hyrox-sao-paulo-2/';
const INGRESSOS = 'https://brazil.hyrox.com/event/hyrox-so-paulo-season-26-27-aj4v8a';
const ANHEMBI = 'https://distritoanhembi.com.br/en/events/hyrox-sao-paulo-2026-2/';
const HYRESULT = 'https://www.hyresult.com/event/s9-2026-sao-paulo';
const HORA_DO_BURPEE =
  'https://horadoburpee.com.br/uncategorized/hyrox-sp-abre-o-calendario-26-27-confira-os-resultados/';

/** Cronograma provisório da página oficial (sujeito a mudança). */
const SABADO: [string, string][] = [
  ['8h às 10h', 'Individual masculino e Adaptive masculino'],
  ['10h30 às 11h40', 'Duplas masculinas'],
  ['12h10 às 12h30', 'Duplas femininas Pro'],
  ['12h40 às 12h50', 'Individual feminino Pro'],
  ['13h20 às 14h20', 'Duplas femininas'],
  ['14h30 às 15h20', 'Individual feminino e Adaptive feminino'],
  ['15h50 às 17h30', 'Duplas mistas'],
  ['18h às 18h30', 'Duplas masculinas Pro'],
  ['18h40 às 19h30', 'Individual masculino Pro'],
  ['20h', 'Revezamento masculino'],
  ['20h10 às 20h20', 'Revezamento misto'],
  ['20h30', 'Revezamento feminino'],
];
const DOMINGO: [string, string][] = [
  ['8h às 9h10', 'Individual masculino e Adaptive masculino'],
  ['9h40 às 10h20', 'Duplas masculinas'],
  ['10h50 às 11h20', 'Duplas femininas'],
  ['11h30 às 11h40', 'Individual feminino'],
  ['12h10 às 13h10', 'Duplas mistas'],
];

const relacionados = [
  {
    url: '/calorias/hyrox/',
    titulo: 'Quantas calorias gasta uma prova de Hyrox?',
    descricao: 'O gasto da prova pelo seu tempo final e pelo pace, com a conta aberta.',
    tipo: 'Calculadora',
  },
  {
    url: '/guias/personal-trainer-para-corredores/',
    titulo: 'Personal trainer para corredores',
    descricao: 'O que o acompanhamento muda para quem treina corrida — inclusive a força.',
    tipo: 'Guia',
  },
  {
    url: '/personal-trainer/sao-paulo-sp/',
    titulo: 'Personal trainer em São Paulo',
    descricao: 'Preços, formatos e onde treinar na capital.',
    tipo: 'Cidade',
  },
];

const path = '/guias/hyrox-sao-paulo-2026';
const publicadoEm = '2026-10-12';
const atualizadoEm = '2026-10-19';
const crumbs = [
  { nome: 'Início', url: '/' },
  { nome: 'Guias', url: '/guias/' },
  { nome: 'HYROX São Paulo 2026', url: path },
];

const faqs = [
  {
    pergunta: 'Quando é o HYROX São Paulo 2026?',
    resposta:
      'Nos dias 17 e 18 de outubro de 2026, sábado e domingo, segundo a página oficial do evento. É a terceira edição da prova em São Paulo. O sábado concentra a maior parte das divisões, incluindo as Pro e os revezamentos; o domingo tem individual, duplas e duplas mistas pela manhã.',
  },
  {
    pergunta: 'Onde vai ser o HYROX São Paulo 2026?',
    resposta:
      'No Distrito Anhembi, nos pavilhões Expo 1 e 2, na Av. Olavo Fontoura, 1209 – Santana, São Paulo. O endereço está na página oficial do evento e na página do próprio Anhembi.',
  },
  {
    pergunta: 'Qual o horário do HYROX São Paulo 2026?',
    resposta:
      'Pelo cronograma provisório da página oficial, as largadas vão das 8h às 20h30 no sábado e das 8h às 13h10 no domingo, com cada divisão numa faixa de horário. O horário individual de cada atleta fica na lista de largada oficial, linkada na página do evento, e a organização avisa que não é permitido trocar de horário.',
  },
  {
    pergunta: 'Quanto custa a inscrição do HYROX São Paulo 2026?',
    resposta:
      'Na plataforma oficial de inscrição, conferida em 13/10/2026: R$ 649 no individual (Open, Pro e Adaptive), R$ 599 por atleta nas duplas e R$ 399 por integrante no revezamento. O preço pode mudar e a disponibilidade varia por categoria — confira a sua na plataforma antes de contar com a vaga.',
  },
  {
    pergunta: 'Quanto custa o ingresso para assistir ao HYROX?',
    resposta:
      'R$ 54 por dia, com meia-entrada a R$ 27, na plataforma oficial. Crianças menores de 12 anos não pagam, mas precisam de ingresso, e menores de 16 anos devem estar acompanhados de um adulto com ingresso de espectador.',
  },
  {
    pergunta: 'Onde é a retirada do kit do HYROX São Paulo?',
    resposta:
      'Quem compete no sábado pode fazer o credenciamento antecipado na sexta, 16/10, das 10h às 19h, na loja PUMA do Morumbi Shopping. No fim de semana, o credenciamento é no local: sábado das 6h30 às 20h30 e domingo das 6h30 até a última onda, sempre só no dia em que você compete. É obrigatório levar documento, e não é permitido retirar por outra pessoa.',
  },
  {
    pergunta: 'Vai ter transmissão ao vivo do HYROX São Paulo?',
    resposta:
      'Até a última verificação, a página oficial não anuncia transmissão desta etapa. Os tempos, porém, aparecem no placar ao vivo durante a prova, segundo a organização. Se uma transmissão for anunciada, ela entra aqui.',
  },
  {
    pergunta: 'Quem ganhou o HYROX São Paulo 2026?',
    resposta:
      'Na categoria Pro individual, Bruno Henrique Carvalho venceu o masculino em 58:41 e a espanhola Manuela Garcia venceu o feminino em 1:07:37. A melhor brasileira no Pro feminino foi Bruna Berbel, com 1:10:23.',
  },
  {
    pergunta: 'Onde ver os resultados do HYROX São Paulo 2026?',
    resposta:
      'Os tempos oficiais saem no sistema de resultados do HYROX, com as parciais de cada estação. A classificação completa de cada divisão também está no HYRESULT, que organiza os resultados oficiais por categoria e faixa etária.',
  },
];

const title = 'Hyrox São Paulo 2026: Resultado, Vencedores, Data e Local';
const description =
  'Resultado do Hyrox São Paulo 2026: Bruno Henrique Carvalho venceu o Pro em 58:41 e Manuela Garcia em 1:07:37. Data, local, horários e divisões da prova.';

const schema = [
  breadcrumbSchema(crumbs),
  articleSchema({ titulo: title, descricao: description, url: new URL(path, site.dominio).href, publicadoEm, atualizadoEm }),
  faqSchema(faqs),
  personMontinhoSchema(),
];
---

<Base title={title} description={description} path={path} ogType="article" schema={schema}>
  <Breadcrumbs crumbs={crumbs} />
  <div class="container guide-layout">
    <article class="article-page">
    <p class="eyebrow">Eventos</p>
    <h1>HYROX São Paulo 2026: resultado, vencedores, data e local</h1>
    <p class="updated">
      Última verificação: {ultimaVerificacao} · Atualizado em {formatDateLong(atualizadoEm)}
    </p>

    <p class="lead">
      O HYROX São Paulo 2026 aconteceu em <strong>17 e 18 de outubro</strong>,
      no <strong>Distrito Anhembi</strong>, e foi a terceira vez que a prova
      veio à cidade. No Pro individual, <strong>Bruno Henrique Carvalho</strong>
      venceu em <strong>58:41</strong> e a espanhola <strong>Manuela
      Garcia</strong> em <strong>1:07:37</strong> — o resultado está logo
      abaixo, com as fontes. Mais adiante ficam o registro de como foi a
      prova: horários de cada divisão, valores, kit e formato.
    </p>

    <div class="prose">
      <h2>Resumo do HYROX São Paulo 2026</h2>
      <div class="table-wrap">
        <table>
          <tbody>
            <tr><th scope="row">Data</th><td>17 e 18 de outubro de 2026 (sábado e domingo)</td></tr>
            <tr><th scope="row">Local</th><td>Distrito Anhembi, pavilhões Expo 1 e 2 — Av. Olavo Fontoura, 1209, Santana, São Paulo</td></tr>
            <tr><th scope="row">Edição</th><td>Terceira em São Paulo</td></tr>
            <tr><th scope="row">Formatos</th><td>Individual (Open, Pro e Adaptive), duplas e revezamento de 4</td></tr>
            <tr><th scope="row">Horários</th><td>Sábado das 8h às 20h30; domingo das 8h às 13h10 (cronograma provisório)</td></tr>
            <tr><th scope="row">Inscrição</th><td>R$ 649 individual · R$ 599 por atleta na dupla · R$ 399 por integrante no revezamento</td></tr>
            <tr><th scope="row">Ingresso (público)</th><td>R$ 54 por dia · meia R$ 27 · menores de 12 anos não pagam, mas precisam de ingresso</td></tr>
            <tr><th scope="row">Retirada do kit</th><td>Sexta, 16/10, das 10h às 19h, na PUMA do Morumbi Shopping (só para quem compete no sábado), ou no local, no dia da sua prova</td></tr>
            <tr><th scope="row">Transmissão</th><td>Não anunciada pela organização até a última verificação</td></tr>
          </tbody>
        </table>
      </div>
      <p class="small">
        Fontes: página oficial do evento, plataforma oficial de inscrição e
        página do Distrito Anhembi, conferidas em {ultimaVerificacao}. Preços e
        horários podem mudar até a prova.
      </p>

      <h2>Data e local</h2>
      <p>
        A página oficial anuncia o evento para <strong>17 e 18 de outubro de
        2026</strong> e diz que o HYROX "retorna a SP pela terceira vez". A
        prova é no <strong>Distrito Anhembi</strong>, na Av. Olavo Fontoura,
        1209, em Santana, Zona Norte de São Paulo, nos pavilhões Expo 1 e 2.
        Segundo o Anhembi, a edição anterior reuniu mais de 4 mil atletas.
      </p>

      <h2>Horários de largada por divisão</h2>
      <p>
        No HYROX não existe largada única: cada divisão sai em ondas dentro
        de uma faixa de horário. O cronograma abaixo é o da página oficial,
        marcado como <strong>provisório e sujeito a mudança</strong>. O horário
        individual de cada atleta fica na lista de largada oficial, que a
        página do evento passou a linkar (<a href="https://startlist.hyrox.com/" target="_blank" rel="noopener">startlist.hyrox.com</a>),
        e a organização avisa que não é permitido trocar de horário.
      </p>
      <div class="table-wrap">
        <table>
          <caption>Sábado, 17 de outubro</caption>
          <thead><tr><th scope="col">Horário</th><th scope="col">Divisão</th></tr></thead>
          <tbody>
            {SABADO.map(([h, d]) => <tr><td>{h}</td><td>{d}</td></tr>)}
          </tbody>
        </table>
      </div>
      <div class="table-wrap">
        <table>
          <caption>Domingo, 18 de outubro</caption>
          <thead><tr><th scope="col">Horário</th><th scope="col">Divisão</th></tr></thead>
          <tbody>
            {DOMINGO.map(([h, d]) => <tr><td>{h}</td><td>{d}</td></tr>)}
          </tbody>
        </table>
      </div>
      <p>
        O credenciamento no local abre, para cada divisão, 90 minutos antes da
        primeira onda dela. Quem quiser entrar no pavilhão antes da sua janela
        de credenciamento passa pelo balcão de espectadores, com ingresso e
        documento. As divisões Pro e os revezamentos correm só no sábado, e o
        briefing dos revezamentos é às 19h, na área de transição (zona de
        aquecimento). A organização publicou o
        <a href="https://hyrox.com/wp-content/uploads/2026/10/2627-FINAL_HYROX_SaoPaulo_VenueMap_PRINT_2215x1864mm.pdf" target="_blank" rel="noopener">mapa oficial do local</a> (PDF).
      </p>

      <h2>Retirada do kit e credenciamento</h2>
      <ul>
        <li>
          <strong>Antecipado:</strong> sexta, 16/10, das 10h às 19h, na loja
          PUMA do Morumbi Shopping — exclusivo para quem compete no sábado.
        </li>
        <li>
          <strong>No dia:</strong> sábado das 6h30 às 20h30; domingo das 6h30
          até a última onda. Só dá para se credenciar no dia em que você
          compete.
        </li>
        <li>
          <strong>Nos dois casos:</strong> documento de identidade é obrigatório, e
          não é permitido retirar o kit por outra pessoa.
        </li>
      </ul>

      <h2>Inscrição para competir × ingresso para assistir</h2>
      <p>
        As buscas por "ingresso" e "valor" do HYROX misturam duas coisas. Os
        valores abaixo são os da plataforma oficial de inscrição, conferidos
        em {ultimaVerificacao}:
      </p>
      <ul>
        <li>
          <strong>Inscrição individual</strong> (Open, Pro e Adaptive): R$ 649.
        </li>
        <li><strong>Duplas:</strong> R$ 599 por atleta.</li>
        <li><strong>Revezamento:</strong> R$ 399 por integrante.</li>
        <li>
          <strong>Ingresso de público:</strong> R$ 54 por dia, com meia-entrada
          a R$ 27. Menores de 12 anos não pagam, mas precisam de ingresso;
          menores de 16 anos entram acompanhados de um adulto com ingresso.
        </li>
      </ul>
      <p>
        A disponibilidade muda por categoria e por dia — o Anhembi avisa que
        as vagas são limitadas e tendem a acabar rápido. Antes de contar com
        a vaga, confira a sua categoria na plataforma.
      </p>

      <h2>Divisões: individual, dupla e revezamento</h2>
      <ul>
        <li><strong>Individual:</strong> você faz a prova inteira. Há Open, Pro (cargas maiores) e Adaptive, para atletas com deficiência.</li>
        <li><strong>Dupla:</strong> os dois correm juntos e dividem o trabalho das estações — masculina, feminina, mista e Pro.</li>
        <li><strong>Revezamento:</strong> equipes de quatro completam a prova juntas — masculino, feminino e misto.</li>
      </ul>
      <p>
        As regras e os pesos de cada categoria estão no regulamento oficial do
        HYROX — confira o da sua antes de treinar com a carga da prova.
        Segundo o Anhembi, a prova não tem tempo limite nem exige
        classificação prévia.
      </p>

      <h2>Como é a prova</h2>
      <p>
        O formato do HYROX é o mesmo em qualquer cidade: 8 km de corrida
        divididos em oito trechos de 1 km, cada um seguido de uma estação de
        exercício funcional, sempre na mesma ordem. Isso faz da prova um teste de corrida sob fadiga — o
        segundo quilômetro depois do sled não se parece com o primeiro.
      </p>
      <p>
        Por ser sempre igual, dá para estimar o esforço a partir do seu tempo
        e do seu ritmo de corrida.
      </p>

      <FerramentaInline
        id="hyrox"
        texto="Se você já tem um tempo de prova em mente, dá para ver quanto dele é corrida e quanto é estação. A calculadora separa as duas partes pelo seu pace e estima o gasto de cada uma — é estimativa com a conta aberta, não medição, e não diz qual será o seu tempo."
        acao="Calcular o gasto da minha prova de HYROX"
      />

      <h2>Resultado do HYROX São Paulo 2026</h2>
      <p>
        Na categoria <strong>Pro</strong>, a de carga mais pesada, o
        brasileiro <strong>Bruno Henrique Carvalho</strong> venceu o masculino
        em <strong>58:41</strong>, baixando o próprio recorde de brasileiro
        mais rápido, que era de 1:00:10. Aldo Lozano e João Almeida completaram
        o pódio. No feminino, a espanhola <strong>Manuela Garcia</strong>
        venceu com <strong>1:07:37</strong>, e a melhor brasileira foi
        <strong>Bruna Berbel</strong>, com <strong>1:10:23</strong>.
      </p>
      <table>
        <caption>Pro individual — HYROX São Paulo 2026</caption>
        <thead>
          <tr><th scope="col">Categoria</th><th scope="col">Atleta</th><th scope="col">Tempo</th></tr>
        </thead>
        <tbody>
          <tr><th scope="row">Pro masculino — 1º</th><td>Bruno Henrique Carvalho</td><td>58:41</td></tr>
          <tr><th scope="row">Pro feminino — 1ª</th><td>Manuela Garcia (Espanha)</td><td>1:07:37</td></tr>
          <tr><th scope="row">Pro feminino — melhor brasileira</th><td>Bruna Berbel</td><td>1:10:23</td></tr>
        </tbody>
      </table>
      <p class="small">
        Fontes: classificação do HYRESULT e reportagem do Hora do Burpee
        (19/10/2026), que trazem os mesmos nomes e tempos.
      </p>

      <h2>Onde assistir e resultados</h2>
      <p>
        Para ver ao vivo, o caminho é o próprio Anhembi, com ingresso de
        público. Até a última verificação, a organização não anunciou
        transmissão. Os tempos
        aparecem no placar enquanto a prova acontece, e cada atleta recebe o
        tempo final com as parciais de cada estação.
      </p>
      <p>
        A classificação completa de cada divisão, com as parciais de corrida e
        de estação, está no <a href={HYRESULT} target="_blank" rel="noopener">HYRESULT</a>.
      </p>

      <h2>Como se preparar para o HYROX</h2>
      <p>
        Na semana da prova, o treino pesado já ficou para trás. O que ainda faz diferença:
      </p>
      <ul>
        <li>
          <strong>Diminua o volume, mantenha o ritmo.</strong> Nos últimos
          dias, sessões curtas com alguns trechos no pace de prova mantêm o
          corpo afiado sem chegar cansado à largada.
        </li>
        <li>
          <strong>Nada novo no dia.</strong> Tênis, luva, alimentação e
          suplemento que você não testou em treino ficam para depois da prova.
        </li>
        <li>
          <strong>Combine o plano com a dupla ou a equipe.</strong> Quem faz
          qual parte das estações e em que ritmo vocês correm se decide
          antes, não na Roxzone.
        </li>
        <li>
          <strong>Largue mais devagar do que dá vontade.</strong> O primeiro
          quilômetro sem fadiga engana; o preço aparece nas estações do fim.
        </li>
      </ul>
      <p>
        Para a próxima edição, a preparação começa meses antes: corrida
        regular, força para as estações de empurrar e carregar, e treinos que
        juntam as duas coisas, porque é a transição que a prova cobra. Um
        personal ajuda a montar essa progressão e a corrigir a técnica das
        estações — em São Paulo, veja <a href="/personal-trainer/sao-paulo-sp/">como
        encontrar personal trainer na capital</a>. Dor que aparece no treino
        para a prova é assunto de médico ou fisioterapeuta antes de seguir.
      </p>

      <h2>Fontes</h2>
      <ul class="small">
        <li>
          <a href={HYROX_OFICIAL} target="_blank" rel="noopener">HYROX — página
          oficial do evento HYROX São Paulo</a>: datas, terceira edição,
          endereço, cronograma provisório, credenciamento, cerimônias, lista de
          largada, briefing dos revezamentos, mapa do local e o que vem no
          pacote do atleta.
        </li>
        <li>
          <a href={INGRESSOS} target="_blank" rel="noopener">HYROX Brasil —
          plataforma oficial de inscrição</a>: valores de inscrição por
          formato e de ingresso de público, e as regras de idade do público.
        </li>
        <li>
          <a href={ANHEMBI} target="_blank" rel="noopener">Distrito Anhembi —
          página do evento</a>: pavilhões Expo 1 e 2, público da edição
          anterior, formato da prova e ausência de tempo limite.
        </li>
        <li>
          <a href={HYRESULT} target="_blank" rel="noopener">HYRESULT — HYROX
          São Paulo 2026</a>: classificação por divisão (Pro masculino e
          feminino), com tempos e grafia completa dos nomes.
        </li>
        <li>
          <a href={HORA_DO_BURPEE} target="_blank" rel="noopener">Hora do
          Burpee — “HYROX SP abre o calendário 26/27, confira os
          resultados”</a> (19/10/2026): vencedores do Pro, tempos de Bruno
          Henrique Carvalho, Manuela Garcia e Bruna Berbel, e o recorde
          brasileiro anterior.
        </li>
        <li>Todas conferidas em {ultimaVerificacao}.</li>
      </ul>
    </div>

    <Faq faqs={faqs} titulo="Perguntas frequentes sobre o HYROX São Paulo 2026" />

    <ContextualCta path={path} assunto={title} />
    <InstagramFollow tema="geral" />
    <AutorMontinho />

    <RelatedArticles itens={relacionados} />
    </article>

    <Sidebar />
  </div>

  <section class="section-sm">
    <div class="container">
      <CtaMontinho variante="destaque" />
    </div>
  </section>
</Base>

<style>
  .guide-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-6);
    padding-block: var(--sp-7);
  }
  @media (min-width: 980px) {
    .guide-layout {
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: var(--sp-7);
    }
  }
  .article-page {
    min-width: 0;
    max-width: 760px;
  }
  .updated {
    color: var(--muted);
    font-size: var(--step--1);
    margin-top: var(--sp-2);
  }
  .lead {
    margin-top: var(--sp-4);
    font-size: var(--step-1);
    color: var(--ink-soft);
    line-height: 1.55;
  }
  .article-page .prose {
    margin-top: var(--sp-5);
  }
  .small {
    font-size: var(--step--1);
  }
</style>
