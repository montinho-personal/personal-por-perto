---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import CtaMontinho from '../../components/CtaMontinho.astro';
import Sidebar from '../../components/Sidebar.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import InstagramFollow from '../../components/InstagramFollow.astro';
import AutorMontinho from '../../components/AutorMontinho.astro';
import ContextualCta from '../../components/ContextualCta.astro';
import FerramentaInline from '../../components/FerramentaInline.astro';
import { breadcrumbSchema, articleSchema, faqSchema, personMontinhoSchema } from '../../lib/schema';
import { formatDateLong } from '../../lib/slug';
import { site } from '../../data/site';

/*
 * Cobertura de evento (modelo: artigo + varreduras até a prova + resultado
 * no dia). Registro de fatos, fontes e pendências em
 * docs/eventos/maratona-de-curitiba-2026.md — só entra aqui o que está
 * "Confirmado" lá. Estrutura e FAQ pelos prints e exports de busca de
 * 13/10/2026. "Última verificação" e atualizadoEm só sobem com fato novo.
 */

/** Data de conferência das fontes, no formato DD/MM/AAAA. */
const ultimaVerificacao = '20/10/2026';

const SITE_OFICIAL = 'https://maratonadecuritiba.com.br/';
const INSCRICAO = 'https://www.ticketsports.com.br/e/maratona-de-curitiba-santander-2026-86884';
const RESULTADOS = 'https://www.chiptiming.com.br/';
const REGULAMENTO =
  'https://storagefileta.blob.core.windows.net/ticketagora/arquivos/evento/86884/96bd2ae84b2848af9665c2c15721e39f639270721352025193.pdf';

/** Limite de conclusão por distância, em minutos (regulamento, item 1). */
const LIMITES: { dist: string; km: number; min: number; rotulo: string }[] = [
  { dist: '42 km', km: 42.195, min: 360, rotulo: '6h' },
  { dist: '21 km', km: 21.097, min: 180, rotulo: '3h' },
  { dist: '10 km', km: 10, min: 90, rotulo: '1h30' },
  { dist: '5 km', km: 5, min: 60, rotulo: '1h' },
];
/** Ritmo médio que cabe no limite, arredondado para baixo (lado seguro). */
const paceLimite = (km: number, min: number) => {
  const s = Math.floor((min / km) * 60);
  return `${Math.floor(s / 60)}min${String(s % 60).padStart(2, '0')}s`;
};
const PACE_42 = paceLimite(42.195, 360);

const brl = (v: number) => `R$ ${v.toLocaleString('pt-BR')}`;
/** Premiação bruta da maratona (regulamento, item 8.1), 1º ao 5º. */
const PREMIO_42_GERAL = [110000, 66000, 38000, 19000, 12000];
const PREMIO_42_BRASILEIROS = [15000, 8000, 5000, 3000, 2000];

const IDADES: [string, string][] = [
  ['5 km', '14 anos'],
  ['10 km', '18 anos'],
  ['21 km', '18 anos'],
  ['42 km', '20 anos'],
];

const relacionados = [
  {
    url: '/ferramentas/calculadora-de-pace/',
    titulo: 'Calculadora de pace',
    descricao: 'Ritmo por km, tempo de prova e velocidade para 5, 10, 21 e 42 km.',
    tipo: 'Calculadora',
  },
  {
    url: '/guias/personal-trainer-para-corredores/',
    titulo: 'Personal trainer para corredores',
    descricao: 'O que o acompanhamento muda para quem treina corrida — inclusive a força.',
    tipo: 'Guia',
  },
  {
    url: '/personal-trainer/curitiba-pr/',
    titulo: 'Personal trainer em Curitiba',
    descricao: 'Preços, formatos e onde treinar na capital paranaense.',
    tipo: 'Cidade',
  },
];

const path = '/guias/maratona-de-curitiba-2026';
const publicadoEm = '2026-10-13';
const atualizadoEm = '2026-10-20';
/* 13/10, mesma data: o regulamento abriu depois da publicação e trouxe
   premiação, horários da Expo e limites por distância. */
const crumbs = [
  { nome: 'Início', url: '/' },
  { nome: 'Guias', url: '/guias/' },
  { nome: 'Maratona de Curitiba 2026', url: path },
];

const faqs = [
  {
    pergunta: 'Quando é a Maratona de Curitiba 2026?',
    resposta:
      'No domingo, 15 de novembro de 2026, com largada na Praça Nossa Senhora de Salete, no Centro Cívico, segundo o site oficial da prova. A Expo Maratona, onde se retira o kit, acontece antes, de 12 a 14 de novembro.',
  },
  {
    pergunta: 'Qual o horário de largada da Maratona de Curitiba 2026?',
    resposta:
      'A largada é às 5h, segundo o site oficial da prova, a mesma hora registrada na plataforma oficial de inscrição. A largada é em ondas, nesta ordem: primeiro os atletas com deficiência (42 e 21 km), depois elite e público geral (42 e 21 km) e por último 10 e 5 km. A organização recomenda chegar pelo menos 40 minutos antes.',
  },
  {
    pergunta: 'Como fazer a inscrição na Maratona de Curitiba 2026?',
    resposta:
      'Só pela Ticket Sports, que é a plataforma oficial — a organização não reconhece inscrição feita em outro site. As inscrições vão até 23h59 de 31/10/2026 ou até acabar o limite de atletas, o que vier primeiro.',
  },
  {
    pergunta: 'Qual o valor da inscrição da Maratona de Curitiba 2026?',
    resposta:
      'O preço depende do lote vigente e do kit escolhido (Smart ou Standard, com upgrade para a Experiência VIP), e aparece na Ticket Sports na hora da compra. Pelo site oficial, clientes Santander têm 10% de desconto pagando com cartão de crédito do banco, e atletas com 60 anos ou mais têm 50% de desconto no kit Smart. Não há meia-entrada para estudante.',
  },
  {
    pergunta: 'Onde retirar o kit da Maratona de Curitiba 2026?',
    resposta:
      'Na Expo Maratona, no Museu Oscar Niemeyer (MON), na Rua Marechal Hermes, 999, Centro Cívico: quinta (12/11) das 10h às 20h, sexta (13/11) das 9h às 20h e sábado (14/11) das 9h às 16h, no horário agendado na inscrição. É preciso levar documento com foto, o termo de responsabilidade impresso e assinado e o comprovante de inscrição. Não há entrega de kit no dia da prova.',
  },
  {
    pergunta: 'Qual o percurso e a altimetria da Maratona de Curitiba 2026?',
    resposta:
      'Até a última verificação, o site oficial ainda mostra "Percursos em breve" para as quatro distâncias. Quando os mapas e a altimetria forem publicados, eles entram aqui.',
  },
  {
    pergunta: 'Qual a premiação da Maratona de Curitiba 2026?',
    resposta:
      `Pelo regulamento, os cinco primeiros dos 42 km, no masculino e no feminino, recebem de ${brl(PREMIO_42_GERAL[4])} a ${brl(PREMIO_42_GERAL[0])} (valor bruto, com desconto de IR). Os cinco melhores brasileiros dos 42 km ganham ainda de ${brl(PREMIO_42_BRASILEIROS[4])} a ${brl(PREMIO_42_BRASILEIROS[0])}, cumulativo com a geral. A meia maratona e as categorias de cadeirantes e deficientes visuais (inscritos no CPB) também têm premiação em dinheiro, com valores menores. Faixa etária recebe troféu, não dinheiro.`,
  },
  {
    pergunta: 'Qual o tempo limite da Maratona de Curitiba?',
    resposta: `Pelo regulamento: 6h nos 42 km, 3h nos 21 km, 1h30 nos 10 km e 1h nos 5 km, contados no relógio. Depois disso o trânsito é liberado e o atleta fica sem tempo computado. Nos 42 km, o limite pede um ritmo médio abaixo de ${PACE_42} por km.`,
  },
  {
    pergunta: 'Onde ver o resultado da Maratona de Curitiba 2026?',
    resposta:
      'Os resultados saem em até 48 horas no site da Chip Timing, que faz a cronometragem, segundo a organização. Esta página publica os vencedores depois da prova, com a fonte.',
  },
];

const title = 'Maratona de Curitiba 2026: Data, Inscrição, Kit e Horário';
const description =
  'Maratona de Curitiba 2026 em 15/11: largada no Centro Cívico, inscrição até 31/10, kit no MON, premiação, idade mínima, tempo limite e como treinar.';

const schema = [
  breadcrumbSchema(crumbs),
  articleSchema({ titulo: title, descricao: description, url: new URL(path, site.dominio).href, publicadoEm, atualizadoEm }),
  faqSchema(faqs),
  personMontinhoSchema(),
];
---

<Base title={title} description={description} path={path} ogType="article" schema={schema}>
  <Breadcrumbs crumbs={crumbs} />
  <div class="container guide-layout">
    <article class="article-page">
    <p class="eyebrow">Eventos</p>
    <h1>Maratona de Curitiba 2026: data, inscrição, kit e horário</h1>
    <p class="updated">
      Última verificação: {ultimaVerificacao} · Atualizado em {formatDateLong(atualizadoEm)}
    </p>

    <p class="lead">
      A Santander Maratona de Curitiba 2026 é no <strong>domingo, 15 de
      novembro</strong>, com largada no Centro Cívico e quatro distâncias:
      5, 10, 21 e 42 km. Abaixo, o que já está confirmado pela organização —
      inscrição, kit, idade mínima, tempo limite — o que ainda não saiu, e
      como usar o mês que falta a seu favor.
    </p>

    <div class="prose">
      <h2>Resumo da Maratona de Curitiba 2026</h2>
      <div class="table-wrap">
        <table>
          <tbody>
            <tr><th scope="row">Data</th><td>Domingo, 15 de novembro de 2026</td></tr>
            <tr><th scope="row">Largada</th><td>Praça Nossa Senhora de Salete, Centro Cívico, em ondas</td></tr>
            <tr><th scope="row">Horário</th><td>Largada às 5h, em ondas</td></tr>
            <tr><th scope="row">Distâncias</th><td>5 km, 10 km, 21,097 km e 42,195 km</td></tr>
            <tr><th scope="row">Inscrição</th><td>Só pela Ticket Sports, até 31/10/2026 às 23h59 ou até o limite de atletas</td></tr>
            <tr><th scope="row">Kit</th><td>Expo Maratona no Museu Oscar Niemeyer (MON): 12/11 das 10h às 20h, 13/11 das 9h às 20h, 14/11 das 9h às 16h, com horário agendado</td></tr>
            <tr><th scope="row">Tempo limite</th><td>42 km em 6h · 21 km em 3h · 10 km em 1h30 · 5 km em 1h</td></tr>
            <tr><th scope="row">Premiação (42 km)</th><td>{brl(PREMIO_42_GERAL[0])} ao 1º lugar masculino e feminino; bônus de até {brl(PREMIO_42_BRASILEIROS[0])} aos melhores brasileiros</td></tr>
            <tr><th scope="row">Percurso e altimetria</th><td>"Em breve" no site oficial</td></tr>
            <tr><th scope="row">Resultados</th><td>Em até 48 horas no site da Chip Timing</td></tr>
          </tbody>
        </table>
      </div>
      <p class="small">
        Fontes: site oficial, regulamento e plataforma oficial de inscrição,
        conferidos em {ultimaVerificacao}.
      </p>

      <h2>Data, local e horário de largada</h2>
      <p>
        A prova é no dia <strong>15/11/2026</strong>, com largada na Praça
        Nossa Senhora de Salete, no Centro Cívico. A largada é em ondas, nesta
        ordem: primeiro os atletas com deficiência dos 42 e 21 km, depois
        elite e público geral dos 42 e 21 km, e por último os 10 e 5 km. O
        funil de largada é organizado pelo pace informado na inscrição.
      </p>
      <p>
        A largada é às <strong>5h</strong>, segundo o site oficial, e a
        plataforma de inscrição registra a mesma hora. O site ainda não
        detalha o horário de cada onda depois da primeira. Chegue
        com pelo menos 40 minutos de antecedência, como recomenda a
        organização. A prova acontece em qualquer condição de tempo.
      </p>
      <p>
        Em 2025, segundo a organização, a maratona reuniu mais de 16 mil
        atletas — a maior edição da série que o site mostra desde 2022.
      </p>

      <h2>Inscrição e valor</h2>
      <p>
        A inscrição só vale se feita pela <strong>Ticket Sports</strong>,
        plataforma oficial; compras em outros sites não são reconhecidas. O
        prazo vai até <strong>23h59 de 31/10/2026</strong>, ou até preencher o
        limite de atletas.
      </p>
      <ul>
        <li><strong>Kit Smart:</strong> número de peito, chip, medalha de conclusão e acesso à Expo.</li>
        <li><strong>Kit Standard:</strong> o mesmo, mais camiseta da distância e par de meias oficiais.</li>
        <li>
          <strong>Experiência VIP</strong> (upgrade): fila preferencial no kit,
          largada avançada, espaço VIP com café da manhã, guarda-volumes e
          banheiros exclusivos, recovery pós-prova e gravação na medalha.
        </li>
      </ul>
      <p>
        O valor muda com o lote vigente e aparece na plataforma na hora da
        compra. Clientes Santander têm 10% de desconto pagando com o cartão de
        crédito do banco; quem tem 60 anos ou mais paga metade no kit Smart. A
        organização avisa que a meia-entrada de estudante não vale para
        corridas.
      </p>
      <p>
        A troca de titularidade gratuita ia até 09/10. Depois disso, troca de
        titular ou de distância só na entrega do kit, conforme
        disponibilidade, com taxa de R$ 50.
      </p>

      <h2>Retirada do kit</h2>
      <p>
        A Expo Maratona acontece no <strong>Museu Oscar Niemeyer (MON)</strong>,
        na Rua Marechal Hermes, 999, Centro Cívico, com horário de retirada
        agendado na inscrição:
      </p>
      <ul>
        <li><strong>Quinta, 12/11:</strong> das 10h às 20h;</li>
        <li><strong>Sexta, 13/11:</strong> das 9h às 20h;</li>
        <li><strong>Sábado, 14/11:</strong> das 9h às 16h.</li>
      </ul>
      <p>
        Mudança de data ou horário agendado vai até 15/10, conforme
        disponibilidade. Leve:
      </p>
      <ul>
        <li>documento com foto;</li>
        <li>termo de responsabilidade impresso e assinado;</li>
        <li>comprovante de inscrição.</li>
      </ul>
      <p>
        Retirada por outra pessoa só com a autorização do site oficial e o
        documento do responsável; atletas 60+ retiram pessoalmente. Não há
        entrega de kit no dia da prova. O MON tem estacionamento pago.
      </p>

      <h2>Idade mínima por distância</h2>
      <p>
        Idade completada até 31/12/2026, pelo regulamento, que segue a Norma
        12 da CBAt. Uma das respostas do site oficial cita 16 anos para os
        10 km, mas o regulamento põe os 10 km na faixa de 10 a 30 km, que
        exige 18:
      </p>
      <div class="table-wrap">
        <table>
          <thead><tr><th scope="col">Distância</th><th scope="col">Idade mínima</th></tr></thead>
          <tbody>
            {IDADES.map(([d, i]) => <tr><td>{d}</td><td>{i}</td></tr>)}
          </tbody>
        </table>
      </div>

      <h2>Percurso, altimetria e hidratação</h2>
      <p>
        Até a última verificação, o site oficial mostra "Percursos em breve"
        para as quatro distâncias — mapa e altimetria entram aqui quando
        forem publicados. Já está definido o apoio: água a cada 3 km em todas
        as distâncias; isotônico e frutas nos 21 km (um ponto de cada) e nos
        42 km (três de isotônico e dois de frutas); kit lanche na chegada.
      </p>

      <h2>Tempo limite</h2>
      <p>
        O regulamento fixa um limite de conclusão para cada distância,
        contado no relógio. Depois dele, o trânsito é liberado, a organização
        pede que o atleta entre no carro de apoio ou deixe a via, e o tempo
        não é computado. Os pontos de corte ao longo do percurso ainda estão
        "em breve".
      </p>
      <div class="table-wrap">
        <table>
          <thead><tr><th scope="col">Distância</th><th scope="col">Limite</th><th scope="col">Ritmo médio que cabe nele</th></tr></thead>
          <tbody>
            {LIMITES.map((l) => <tr><td>{l.dist}</td><td>{l.rotulo}</td><td>abaixo de {paceLimite(l.km, l.min)}/km</td></tr>)}
          </tbody>
        </table>
      </div>
      <p>
        O ritmo é a conta do limite dividido pela distância, sem margem para
        paradas — na prova, deixe folga.
      </p>

      <FerramentaInline
        id="calculadora-de-pace"
        texto="Se você tem um tempo-alvo para Curitiba, a conta que importa é o ritmo por quilômetro que ele exige — e se esse ritmo cabe no limite de 6 horas. A calculadora converte tempo em pace e pace em tempo para as quatro distâncias; ela não sabe como você está treinado, então o número é ponto de partida, não promessa."
        acao="Calcular o pace do meu tempo-alvo"
      />

      <h2>Premiação</h2>
      <p>
        Valores brutos do regulamento, dos quais é descontado o imposto de
        renda. Nos 42 km, a classificação geral vale pelo tempo bruto:
      </p>
      <div class="table-wrap">
        <table>
          <thead><tr><th scope="col">Colocação (masc. e fem.)</th><th scope="col">42 km geral</th><th scope="col">Melhores brasileiros</th></tr></thead>
          <tbody>
            {PREMIO_42_GERAL.map((v, i) => <tr><td>{i + 1}º</td><td>{brl(v)}</td><td>{brl(PREMIO_42_BRASILEIROS[i])}</td></tr>)}
          </tbody>
        </table>
      </div>
      <p>
        A premiação dos melhores brasileiros soma-se à geral. A meia maratona
        e as categorias de cadeirantes e deficientes visuais (inscritos no
        CPB) também pagam prêmio em dinheiro, com valores menores. Faixa
        etária recebe troféu no pódio, não dinheiro, e só quem comparece ao
        pódio com documento recebe. Todos que terminam dentro do tempo ganham
        medalha.
      </p>

      <h2>Não confunda com a Meia Maratona Internacional de Curitiba</h2>
      <p>
        Muita gente busca "meia maratona de Curitiba 2026" esperando esta
        prova. Os 21 km da Maratona de Curitiba, em 15/11, são uma das quatro
        distâncias deste evento. A Meia Maratona Internacional de Curitiba é
        outra corrida, com data e organização próprias.
      </p>

      <h2>Resultados</h2>
      <p>
        A organização publica os resultados em até 48 horas no site da Chip
        Timing, e as fotos oficiais no site da Foco Radical. Os vencedores da
        Maratona de Curitiba 2026 entram aqui depois da prova, somente com
        fonte oficial.
      </p>

      <h2>Como treinar para a Maratona de Curitiba</h2>
      <p>
        Com cerca de um mês até a largada, a base já está feita — não dá para
        construir em quatro semanas o que não veio nos meses anteriores. O
        que ainda muda o seu dia de prova:
      </p>
      <ul>
        <li>
          <strong>Último longão com folga.</strong> Para quem vai de 21 ou
          42 km, o treino mais longo costuma ficar duas a três semanas antes
          da prova; depois disso, o volume desce.
        </li>
        <li>
          <strong>Treine no pace de prova.</strong> Alguns trechos no ritmo
          planejado ensinam o corpo e a cabeça a segurar a largada, que é
          onde a maioria erra.
        </li>
        <li>
          <strong>Teste tudo antes.</strong> Tênis, meia, gel e café da manhã
          do dia já precisam ter passado por um treino longo.
        </li>
        <li>
          <strong>Mantenha a força, com menos carga.</strong> Duas sessões
          curtas por semana preservam o que você construiu sem cansar as
          pernas para o domingo.
        </li>
      </ul>
      <p>
        Quem está escolhendo a distância agora pode usar a descrição da
        própria organização: os 5 km para quem começa ou está voltando, os
        10 km para quem já treina com regularidade, 21 e 42 km para quem tem
        a corrida como rotina. Para montar a preparação com alguém do seu
        lado, veja <a href="/personal-trainer/curitiba-pr/">como encontrar
        personal trainer em Curitiba</a>. Dor que aparece no treino é assunto
        de médico ou fisioterapeuta antes de seguir.
      </p>

      <h2>Fontes</h2>
      <ul class="small">
        <li>
          <a href={SITE_OFICIAL} target="_blank" rel="noopener">Santander
          Maratona de Curitiba — site oficial</a>: data, local, horário de
          largada (5h) e ordem das ondas, distâncias, kits e Experiência VIP, prazo e regras da
          inscrição, Expo e retirada do kit, idades, hidratação, tempo de
          cronometragem, premiação e resultados.
        </li>
        <li>
          <a href={REGULAMENTO} target="_blank" rel="noopener">Regulamento
          oficial 2026 (PDF)</a>: limites de conclusão por distância,
          horários da Expo, idades pela Norma 12 da CBAt e valores da
          premiação.
        </li>
        <li>
          <a href={INSCRICAO} target="_blank" rel="noopener">Ticket Sports —
          plataforma oficial de inscrição</a>: data e horário de início
          registrados para o evento.
        </li>
        <li>
          <a href={RESULTADOS} target="_blank" rel="noopener">Chip Timing</a>:
          onde saem os resultados, segundo a organização.
        </li>
        <li>Todas conferidas em {ultimaVerificacao}.</li>
      </ul>
    </div>

    <Faq faqs={faqs} titulo="Perguntas frequentes sobre a Maratona de Curitiba 2026" />

    <ContextualCta path={path} assunto={title} />
    <InstagramFollow tema="geral" />
    <AutorMontinho />

    <RelatedArticles itens={relacionados} />
    </article>

    <Sidebar />
  </div>

  <section class="section-sm">
    <div class="container">
      <CtaMontinho variante="destaque" />
    </div>
  </section>
</Base>

<style>
  .guide-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-6);
    padding-block: var(--sp-7);
  }
  @media (min-width: 980px) {
    .guide-layout {
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: var(--sp-7);
    }
  }
  .article-page {
    min-width: 0;
    max-width: 760px;
  }
  .updated {
    color: var(--muted);
    font-size: var(--step--1);
    margin-top: var(--sp-2);
  }
  .lead {
    margin-top: var(--sp-4);
    font-size: var(--step-1);
    color: var(--ink-soft);
    line-height: 1.55;
  }
  .article-page .prose {
    margin-top: var(--sp-5);
  }
  .small {
    font-size: var(--step--1);
  }
</style>
