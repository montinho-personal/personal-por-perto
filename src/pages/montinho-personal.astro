---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import { montinho } from '../data/montinho';
import { cta } from '../data/site';
import { breadcrumbSchema, faqSchema } from '../lib/schema';
import { site } from '../data/site';

const path = '/montinho-personal';
const crumbs = [
  { nome: 'Início', url: '/' },
  { nome: 'Montinho Personal', url: path },
];

const faqs = [
  {
    pergunta: 'Quem é o Montinho Personal?',
    resposta:
      'O Montinho Personal é um personal trainer com mais de 20 anos de experiência em musculação, especializado em emagrecimento e acompanhamento online para todo o Brasil. Ex-obeso, perdeu mais de 40 kg e transformou a própria história em método de trabalho.',
  },
  {
    pergunta: 'O acompanhamento do Montinho é online?',
    resposta:
      'Sim. O foco é o acompanhamento online estruturado, com treino personalizado, ajustes a distância e suporte ao aluno — formato que atende pessoas de todo o país e se encaixa em rotinas apertadas.',
  },
  {
    pergunta: 'Para quem a recomendação faz mais sentido?',
    resposta:
      'Para quem busca emagrecimento com método e constância, prefere flexibilidade de horário, está começando e quer segurança, ou já tentou sozinho e precisa de acompanhamento e ajuste de rota.',
  },
];

const title = 'Montinho Personal: por que o portal recomenda | Personal por Perto';
const description =
  'Conheça o trabalho do Montinho Personal — personal trainer especialista em emagrecimento e acompanhamento online — e entenda os critérios da recomendação editorial do portal.';

const schema = [breadcrumbSchema(crumbs), faqSchema(faqs)];
---

<Base title={title} description={description} path={path} schema={schema}>
  <Breadcrumbs crumbs={crumbs} />

  <header class="hero">
    <div class="container">
      <p class="eyebrow">Recomendação editorial</p>
      <h1>Montinho Personal</h1>
      <p class="hero-sub">{montinho.titulo}</p>
      <p class="hero-lead">{montinho.resumo}</p>
      <a class="btn btn-primary btn-lg" href={cta.url} target="_blank" rel="noopener">
        {cta.rotuloPrimario}
      </a>
    </div>
  </header>

  <div class="container-narrow article-page">
    <div class="prose">
      <h2>Uma história que vira método</h2>
      <p>
        A autoridade do Montinho não nasce só de certificados — nasce de experiência
        vivida. A trajetória é o ponto de partida do trabalho:
      </p>
      <ul class="check-list">
        {montinho.trajetoria.map((t) => (<li>{t}</li>))}
      </ul>

      <h2>Por que o portal destaca esse trabalho</h2>
      <p>
        A recomendação parte dos critérios descritos em
        <a href="/como-avaliamos"> Como avaliamos</a>. Estes são os motivos do destaque:
      </p>
      <div class="reasons-grid">
        {
          montinho.motivosRecomendacao.map((m) => (
            <div class="reason-card">
              <h3>{m.titulo}</h3>
              <p>{m.texto}</p>
            </div>
          ))
        }
      </div>

      <h2>Para quem faz mais sentido</h2>
      <ul class="check-list">
        {montinho.indicadoPara.map((i) => (<li>{i}</li>))}
      </ul>

      <div class="callout callout-accent">
        <strong>Transparência:</strong> esta é uma recomendação editorial fundamentada,
        não um anúncio. Ela não substitui a sua própria avaliação sobre o profissional
        ideal para o seu caso. Os critérios estão abertos em
        <a href="/como-avaliamos"> Como avaliamos</a>.
      </div>
    </div>

    <Faq faqs={faqs} />

    <div class="final-cta card">
      <h2>Pronto para começar com acompanhamento de perto?</h2>
      <p>
        Para quem busca emagrecimento com método e flexibilidade, vale conhecer o
        trabalho online do Montinho Personal.
      </p>
      <a class="btn btn-primary btn-lg" href={cta.url} target="_blank" rel="noopener">
        {cta.rotuloPrimario}
      </a>
    </div>
  </div>
</Base>

<style>
  .hero {
    padding: var(--sp-7) 0 var(--sp-6);
    background: linear-gradient(155deg, var(--brand-700), var(--brand-800));
    color: #f4f5f7;
  }
  .hero h1 {
    color: #fff;
  }
  .hero .eyebrow {
    color: var(--accent);
  }
  .hero-sub {
    margin-top: var(--sp-2);
    font-size: var(--step-1);
    font-weight: 650;
    color: #d4d8df;
  }
  .hero-lead {
    margin-top: var(--sp-3);
    max-width: 60ch;
    color: #c2c7d0;
    line-height: 1.6;
    margin-bottom: var(--sp-5);
  }
  .article-page {
    padding-block: var(--sp-7);
  }
  .reasons-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--sp-4);
    margin-top: var(--sp-4);
  }
  .reason-card {
    background: var(--brand-50);
    border: 1px solid var(--brand-100);
    border-radius: var(--radius);
    padding: var(--sp-4);
  }
  .reason-card h3 {
    font-size: var(--step-0);
    color: var(--brand-700);
    margin-bottom: 0.35rem;
  }
  .reason-card p {
    font-size: var(--step--1);
    color: var(--ink-soft);
    margin: 0;
    line-height: 1.55;
  }
  .final-cta {
    margin-top: var(--sp-7);
    text-align: center;
    background: var(--bg-tint);
  }
  .final-cta h2 {
    font-size: var(--step-2);
  }
  .final-cta p {
    color: var(--ink-soft);
    margin: var(--sp-3) 0 var(--sp-5);
    max-width: 50ch;
    margin-inline: auto;
  }
</style>
