---
/**
 * Quantas calorias a musculação queima — artigo com a calculadora dentro.
 *
 * POR QUE A CALCULADORA MORA AQUI, E NÃO EM /calorias/musculacao/
 *
 * Este artigo já respondia a pergunta e o Search Console já o mostrava
 * subindo (de 3 para 57 impressões e da posição 53 para a 10,6 entre os
 * relatórios de 01/09 e 12/09/2026). Uma URL nova disputaria a mesma busca
 * com ele. A calculadora entra no artigo; o hub de /calorias/ aponta para
 * cá. URL, título e H1 ficam como estavam, porque são o que está
 * funcionando.
 *
 * O QUE A REVISÃO DE 23/09/2026 CORRIGIU NO TEXTO
 *
 * - "200 a 400 kcal por hora", sem fonte, virou a faixa do Compêndio 2024
 *   calculada para 70 kg (257 a 441 kcal) — o topo passa dos 400.
 * - "EPOC de 6% a 15% da sessão", sem fonte, virou os exemplos da revisão
 *   de Farinatti e Castinheiras Neto (cerca de 22 a 58 kcal) — declarados
 *   como exemplos, porque a revisão não conclui uma faixa (auditoria do
 *   mesmo dia: a primeira versão os apresentava como faixa da revisão).
 * - "10 a 13 kcal por quilo de músculo" virou os 13 de Elia, confirmados
 *   por Wang et al.; a conversão para "quilo e meio de gordura por ano"
 *   saiu, porque usava a regra dos 7.700 kcal sem a ressalva de Hall.
 * - A frase sobre relógios ganhou a fonte que a sustenta (Collins et al.).
 * - "A caminhada costuma mover mais calorias que o treino" virou conta.
 */
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import CtaMontinho from '../../components/CtaMontinho.astro';
import Sidebar from '../../components/Sidebar.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import InstagramFollow from '../../components/InstagramFollow.astro';
import AutorMontinho from '../../components/AutorMontinho.astro';
import ContextualCta from '../../components/ContextualCta.astro';
import VideoYouTube from '../../components/VideoYouTube.astro';
import FerramentaInline from '../../components/FerramentaInline.astro';
import { breadcrumbSchema, articleSchema, faqSchema, personMontinhoSchema } from '../../lib/schema';
import { formatDateLong } from '../../lib/slug';
import { site } from '../../data/site';
import { rotas } from '../../lib/links';
import {
  EPOC_MAX,
  EPOC_MIN,
  ESTUDO_MASSA,
  FONTES,
  KCAL_DIA_POR_KG_GORDURA,
  KCAL_DIA_POR_KG_MUSCULO,
  MINUTOS_PADRAO,
  MUSCULO_PADRAO,
  NOTA_EPOC,
  NOTA_ESTIMATIVA,
  NOTA_NAO_PRESCRICAO,
  PESO_PADRAO,
  SESSOES_PADRAO,
  TIPOS,
  deMusculo,
  deSemana,
  deSessao,
  formataKcal,
  formataMet,
  fraseSessao,
  leituraDoEstudo,
  tipo,
} from '../../lib/calorias/musculacao';
import { deTempo as caminhadaTempo, ritmo as ritmoCaminhada } from '../../lib/calorias/caminhada';

/* ── Números resolvidos no servidor, pelo mesmo motor da calculadora ── */
const H_VARIADO = deSessao(60, PESO_PADRAO, 'variado');
const H_BASICOS = deSessao(60, PESO_PADRAO, 'basicos');
const H_VIGOROSO = deSessao(60, PESO_PADRAO, 'vigoroso');
const SEMANA = deSemana(SESSOES_PADRAO, 60, PESO_PADRAO, 'variado');
const MUSCULO = deMusculo(MUSCULO_PADRAO);
const ESTUDO = leituraDoEstudo();
/* Os "100 kcal por quilo" do folclore, em quilos de músculo necessários. */
const KG_PARA_100 = 100 / KCAL_DIA_POR_KG_MUSCULO;

/* Meia hora de caminhada moderada todo dia, pelo motor da caminhada. */
const MOD = ritmoCaminhada('moderado');
const CAMINHADA_SEMANA = caminhadaTempo(30, PESO_PADRAO, MOD.velocidade, 0, MOD.cadencia).kcal * 7;

const n = (v: number, d = 1) => v.toLocaleString('pt-BR', { maximumFractionDigits: d });

const relacionados = [
  {
    url: '/emagrecimento/musculacao-ou-cardio-para-emagrecer/',
    titulo: 'Musculação ou cardio: o que emagrece mais?',
    descricao: 'A comparação completa entre os dois — e por que a resposta certa é a combinação.',
    tipo: 'Emagrecimento',
  },
  {
    url: '/emagrecimento/deficit-calorico-como-funciona/',
    titulo: 'Déficit calórico: como funciona para emagrecer',
    descricao: 'As calorias do treino só fazem sentido dentro do balanço do dia — entenda a conta inteira.',
    tipo: 'Emagrecimento',
  },
  {
    url: '/musculacao/hipertrofia-como-funciona/',
    titulo: 'Hipertrofia: como funciona o crescimento muscular',
    descricao: 'O verdadeiro prêmio calórico da musculação é o músculo que ela constrói — veja como.',
    tipo: 'Musculação',
  },
];

const path = '/emagrecimento/quantas-calorias-queima-a-musculacao';
const atualizadoEm = '2026-09-23';
const crumbs = [
  { nome: 'Início', url: '/' },
  { nome: 'Emagrecimento', url: '/emagrecimento/' },
  { nome: 'Quantas calorias a musculação queima?', url: path },
];

const faqs = [
  {
    pergunta: 'Quantas calorias queima 1 hora de musculação?',
    resposta: `Para ${PESO_PADRAO} kg, cerca de ${formataKcal(H_VARIADO.kcal)} kcal num treino variado de academia, ${formataKcal(H_BASICOS.kcal)} num treino de básicos pesados (agachamento, terra) e ${formataKcal(H_VIGOROSO.kcal)} num treino vigoroso, pelos valores do Compêndio de Atividades Físicas. O que mais muda o número é a escolha dos exercícios: num estudo brasileiro, 5 séries de leg press custaram cerca de ${n(ESTUDO.razaoMassa)} vez o que custaram 5 séries de crucifixo. Relógios costumam superestimar bastante.`,
  },
  {
    pergunta: 'O que é o efeito EPOC ("afterburn")? Ele é significativo?',
    resposta: `EPOC é o consumo extra de oxigênio pós-exercício: depois do treino, o corpo segue gastando um pouco mais para se recuperar. Ele pode durar bastante — um estudo mediu consumo acima do repouso 38 horas depois de um circuito pesado —, mas duração não é tamanho: nos exemplos que uma revisão de 16 estudos compara, o total somou de cerca de ${EPOC_MIN} a ${EPOC_MAX} kcal. O "metabolismo turbinado por 48 horas" do marketing acerta a duração possível e erra o que importa, que é a quantidade.`,
  },
  {
    pergunta: 'Músculo em repouso queima muitas calorias?',
    resposta: `Cada quilo de músculo gasta cerca de ${KCAL_DIA_POR_KG_MUSCULO} kcal por dia em repouso — contra ${n(KCAL_DIA_POR_KG_GORDURA)} kcal do quilo de gordura, e longe dos "100 kcal por quilo" do folclore, que exigiriam quase ${n(KG_PARA_100, 0)} kg de músculo para chegar a 100 kcal por dia. O ganho real vem do conjunto: ${n(MUSCULO_PADRAO, 0)} kg de músculo somam cerca de ${formataKcal(MUSCULO.kcalDia)} kcal por dia, ${formataKcal(MUSCULO.kcalAno)} por ano, e o corpo fica capaz de treinar mais pesado.`,
  },
  {
    pergunta: 'Devo comer as calorias que o treino queimou de volta?',
    resposta:
      'Se o objetivo é emagrecer, não — essa é uma das armadilhas mais comuns. Primeiro porque os números de apps e relógios superestimam o gasto da musculação; segundo porque "compensar" o treino com comida extra anula o déficit que faz a gordura cair. O caminho mais confiável: definir a alimentação pelo déficit calórico planejado, tratar o gasto do treino como bônus (não como crédito para gastar) e acompanhar o resultado real na balança e nas medidas ao longo das semanas, ajustando com calma.',
  },
  {
    pergunta: 'Descansar menos entre as séries queima mais calorias?',
    resposta: `Por série, não. Num estudo brasileiro, 5 séries de leg press custaram praticamente o mesmo com 1 ou com 3 minutos de descanso (cerca de ${n(ESTUDO_MASSA.legPress1min, 0)} e ${n(ESTUDO_MASSA.legPress3min, 0)} kcal). Descanso curto aumenta o gasto por hora porque cabe mais trabalho no mesmo tempo — e cobra um preço: com menos recuperação, a carga e a qualidade do estímulo de força caem. Para a maioria, funciona melhor treinar força com descansos adequados e somar cardio para ampliar o gasto.`,
  },
];

const title = 'Quantas calorias a musculação queima? A conta honesta';
/* 151 caracteres. */
const description =
  'Calcule quantas calorias a sua musculação queima por tipo de treino, o tamanho real do EPOC e quanto o músculo ganho gasta em repouso. A conta honesta.';

const capa = '/capas-conteudo/quantas-calorias-queima-a-musculacao.webp';
const capaAlt =
  'Arte da capa: personal trainer sentado no banco conferindo o relógio, com o número 600 riscado e um gráfico de barras ao lado — quantas calorias a musculação queima: a conta honesta — Personal por Perto';

const schema = [
  breadcrumbSchema(crumbs),
  articleSchema({ titulo: title, descricao: description, url: new URL(path, site.dominio).href, imagem: new URL(capa, site.dominio).href, atualizadoEm }),
  faqSchema(faqs),
  personMontinhoSchema(),
];
---

<Base title={title} description={description} path={path} ogType="article" image={capa} schema={schema}>
  <Breadcrumbs crumbs={crumbs} />
  <div class="container guide-layout">
    <article class="article-page">
    <p class="eyebrow">Emagrecimento</p>
    <h1>Quantas calorias a musculação queima? A conta honesta</h1>
    <p class="updated">Atualizado em {formatDateLong(atualizadoEm)}</p>

    <figure style="margin: 0 0 var(--sp-5)">
      <img
        src={capa}
        alt={capaAlt}
        width="1200"
        height="1200"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        style="width: 100%; height: auto; border-radius: var(--radius-lg); box-shadow: var(--shadow-lg)"
      />
    </figure>

    <p class="lead">
      Pergunte ao relógio e ele dirá 600 kcal; pergunte ao marketing e
      ele prometerá "metabolismo acelerado por 48 horas". A resposta
      honesta é menos glamourosa e mais útil: <strong>a sessão de
      musculação queima menos do que dizem — e vale mais do que
      parece</strong>.
    </p>

    <p class="lead">
      Este artigo faz a conta completa — o gasto da sessão, o tamanho real
      do "afterburn", quanto o músculo queima em repouso — e a{' '}
      <a href="#cm-app">calculadora logo abaixo</a> faz a mesma conta com o
      seu peso.
    </p>

    <section id="cm-app" class="cm-app" aria-labelledby="cm-app-h">
      <h2 id="cm-app-h" class="cm-app-h">Calcule o gasto do seu treino</h2>

      <div class="cm-modos" role="tablist" aria-label="O que você quer calcular">
        <button type="button" class="cm-modo is-ativo" data-modo="sessao" role="tab" aria-selected="true">
          Uma sessão
        </button>
        <button type="button" class="cm-modo" data-modo="semana" role="tab" aria-selected="false" tabindex="-1">
          A semana
        </button>
        <button type="button" class="cm-modo" data-modo="musculo" role="tab" aria-selected="false" tabindex="-1">
          Músculo ganho
        </button>
      </div>

      <div class="cm-campos">
        <!-- Peso e tipo de treino somem no modo "músculo ganho": ali não fazem diferença. -->
        <div id="cm-bloco-treino" class="cm-bloco">
          <div class="cm-campo">
            <label for="cm-peso">Seu peso (kg)</label>
            <input id="cm-peso" type="text" inputmode="decimal" autocomplete="off" value={PESO_PADRAO} />
          </div>
          <!--
            O seletor é o TIPO de treino, não o descanso: a medição mostra
            que o descanso não muda o custo do mesmo trabalho.
          -->
          <div class="cm-campo">
            <span class="cm-rotulo">Tipo de treino</span>
            <div class="cm-presets" role="group" aria-label="Tipo de treino">
              {TIPOS.map((t) => (
                <button
                  type="button"
                  class:list={['cm-preset', 'cm-tipo', t.id === 'variado' && 'is-ativo']}
                  data-tipo={t.id}
                  aria-pressed={String(t.id === 'variado')}
                >
                  {t.nomeCurto}
                </button>
              ))}
            </div>
            <p class="cm-dica cm-tipo-slot" id="cm-tipo-dica">
              {formataMet(tipo('variado').met)} METs — Compêndio, código {tipo('variado').codigo}.{' '}
              {tipo('variado').comoReconhecer}
            </p>
          </div>
        </div>

        <div id="cm-bloco-sessoes" class="cm-campo" hidden>
          <label for="cm-sessoes">Sessões por semana</label>
          <input id="cm-sessoes" type="text" inputmode="numeric" autocomplete="off" value={SESSOES_PADRAO} />
          <div class="cm-presets">
            {[2, 3, 4, 5].map((v) => (
              <button type="button" class="cm-preset" data-alvo="sessoes" data-valor={String(v)}>{v}×</button>
            ))}
          </div>
        </div>

        <div id="cm-bloco-minutos" class="cm-campo">
          <label for="cm-minutos">Duração do treino (minutos)</label>
          <input id="cm-minutos" type="text" inputmode="numeric" autocomplete="off" value={MINUTOS_PADRAO} />
          <div class="cm-presets">
            {[30, 45, 60, 90].map((v) => (
              <button type="button" class="cm-preset" data-alvo="minutos" data-valor={String(v)}>
                {v === 60 ? '1 hora' : v === 90 ? '1h30' : `${v} min`}
              </button>
            ))}
          </div>
        </div>

        <div id="cm-bloco-musculo" class="cm-campo" hidden>
          <label for="cm-musculo">Músculo ganho (kg)</label>
          <input id="cm-musculo" type="text" inputmode="decimal" autocomplete="off" value={MUSCULO_PADRAO} />
          <div class="cm-presets">
            {[1, 2, 3, 5].map((v) => (
              <button type="button" class="cm-preset" data-alvo="musculo" data-valor={String(v)}>{v} kg</button>
            ))}
          </div>
        </div>
      </div>

      <p id="cm-erro" class="cm-erro" role="status" hidden></p>

      <div id="cm-saida" class="cm-saida" role="status" aria-live="polite">
        <p class="cm-resultado">
          <span class="cm-numero">≈ {formataKcal(H_VARIADO.kcal)}</span>
          <span class="cm-unidade">kcal</span>
        </p>
        <p class="cm-frase">{fraseSessao(PESO_PADRAO, H_VARIADO)}</p>
        <dl class="cm-detalhes">
          <div><dt>Acréscimo real ao dia</dt><dd>≈ {formataKcal(H_VARIADO.kcalLiquida)} kcal</dd></div>
          <div><dt>EPOC nos estudos</dt><dd>{EPOC_MIN} a {EPOC_MAX} kcal</dd></div>
          <div><dt>Intensidade</dt><dd>{formataMet(H_VARIADO.met)} METs</dd></div>
          <div><dt>De onde vem o número</dt><dd>Compêndio {tipo('variado').codigo}</dd></div>
        </dl>
        <p class="cm-nota cm-nota-modo">{NOTA_EPOC}</p>
        <p class="cm-nota">{NOTA_ESTIMATIVA}</p>
      </div>
    </section>

    <div class="prose">
      <h2>O gasto da sessão: de {formataKcal(H_VARIADO.kcal)} a {formataKcal(H_VIGOROSO.kcal)} kcal por hora</h2>
      <p>
        O Compêndio de Atividades Físicas, a tabela de referência para gasto
        energético, separa a musculação em três linhas. Para {PESO_PADRAO} kg,
        uma hora de <strong>treino variado de academia</strong> (vários
        exercícios, 8 a 15 repetições) dá cerca de{' '}
        <strong>{formataKcal(H_VARIADO.kcal)} kcal</strong>; uma hora de{' '}
        <strong>básicos pesados</strong>, como agachamento e terra, cerca de{' '}
        <strong>{formataKcal(H_BASICOS.kcal)}</strong>; e uma hora de treino{' '}
        <strong>vigoroso</strong> de fisiculturismo ou powerlifting, cerca de{' '}
        <strong>{formataKcal(H_VIGOROSO.kcal)}</strong>. Corpos maiores gastam
        mais, na mesma proporção do peso.
      </p>
      <p>
        O que separa essas linhas não é o relógio: é o tipo de treino e,
        principalmente, a escolha dos exercícios. Um estudo brasileiro de Farinatti e Castinheiras Neto
        mediu {ESTUDO_MASSA.series} séries de {ESTUDO_MASSA.repeticoes} no leg
        press e no crucifixo: cerca de {n(ESTUDO_MASSA.legPress1min, 0)} a{' '}
        {n(ESTUDO_MASSA.legPress3min, 0)} kcal no leg press e{' '}
        {n(ESTUDO_MASSA.crucifixo1min, 0)} a {n(ESTUDO_MASSA.crucifixo3min, 0)} no
        crucifixo. O exercício que move muito músculo custou{' '}
        <strong>{n(ESTUDO.razaoMassa)} vez</strong> o gasto do outro. E o descanso quase não mexeu no
        resultado: com 1 ou com 3 minutos entre as séries, o leg press custou
        praticamente o mesmo. Descansar menos não torna cada série mais cara;
        só faz caber mais série na mesma hora.
      </p>
      <p>
        E os relógios? Aqui eles erram por um motivo medido. Na musculação,
        a frequência cardíaca sobe mais do que o consumo de oxigênio: Collins
        e colegas encontraram, ao levantar peso, uma relação entre as duas com
        cerca de <strong>metade da inclinação</strong> da do exercício
        aeróbico. Para a mesma frequência, o gasto real é bem menor — e um
        aparelho que aplica a lógica da corrida à academia infla o número.
        Trate o número do pulso como curiosidade, não como crédito calórico.
      </p>

      <h2>EPOC: o "afterburn" no tamanho certo</h2>
      <p>
        O consumo extra de oxigênio pós-exercício (EPOC) existe:
        depois de uma sessão intensa, o corpo gasta energia adicional
        para repor estoques, reparar tecido e voltar ao equilíbrio. Treinos
        pesados e intensos são os que mais o provocam.
      </p>
      <p>
        E ele pode durar bastante: depois de 31 minutos de um circuito pesado,
        Schuenke e colegas ainda mediram o consumo de oxigênio acima do repouso{' '}
        <strong>38 horas depois</strong>. É daí que o marketing tira as
        &ldquo;48 horas de metabolismo acelerado&rdquo;. O erro está em
        confundir duração com tamanho.
      </p>
      <p>
        Quanto ele soma? Uma revisão de 16 estudos sobre o EPOC da
        musculação compara exemplos em que o total ficou{' '}
        <strong>entre cerca de {EPOC_MIN} e {EPOC_MAX} kcal</strong> — e ela
        mesma avisa que as diferenças de método, principalmente no tempo de
        medição, impedem cravar um valor geral. Ao lado das{' '}
        {formataKcal(H_VARIADO.kcal)} kcal de uma hora de treino variado, é um
        acréscimo real, bem-vindo e pequeno. O emagrecimento continua sendo
        decidido pelo <a href="/emagrecimento/deficit-calorico-como-funciona/">balanço
        calórico do dia</a>.
      </p>

      <h2>O músculo em repouso: o mito dos 100 kcal por quilo</h2>
      <p>
        "Cada quilo de músculo queima 100 calorias por dia" é uma das lendas
        mais repetidas das academias. O número medido é bem mais modesto:{' '}
        <strong>cerca de {KCAL_DIA_POR_KG_MUSCULO} kcal por quilo por dia</strong>,
        contra {n(KCAL_DIA_POR_KG_GORDURA)} kcal do quilo de gordura. Para
        chegar aos 100 do folclore seriam precisos quase{' '}
        {n(KG_PARA_100, 0)} kg de músculo a mais.
      </p>
      <p>
        Parece pouco? É aqui que a conta muda de natureza: essas calorias são{' '}
        <em>permanentes</em>. Ganhar {n(MUSCULO_PADRAO, 0)} kg de músculo soma
        cerca de <strong>{formataKcal(MUSCULO.kcalDia)} kcal por dia</strong> —{' '}
        {formataKcal(MUSCULO.kcalAno)} kcal por ano, sem treino nenhum a mais.
        (Converter isso em quilos de gordura pela regra dos 7.700 kcal
        superestima o resultado, porque o corpo ajusta o gasto conforme
        emagrece.) O modo &ldquo;Músculo ganho&rdquo; da calculadora faz a conta
        para o seu caso.
      </p>
      <p>
        Some o efeito indireto: mais músculo permite treinos mais
        pesados (que gastam mais), melhora a disposição geral e
        sustenta o
        <a href="/emagrecimento/como-acelerar-o-metabolismo/">metabolismo</a>
        que dietas agressivas derrubam. É o
        juro composto do <a
        href="/musculacao/hipertrofia-como-funciona/">investimento em
        massa muscular</a>.
      </p>

      <h2>Onde a musculação ganha o jogo do emagrecimento</h2>
      <p>
        Se a régua fosse só "calorias por sessão", a corrida venceria
        — como mostra o comparativo <a
        href="/emagrecimento/musculacao-ou-cardio-para-emagrecer/">musculação
        ou cardio</a>. Mas o emagrecimento que importa é o que
        <em>preserva músculo enquanto perde gordura</em> — e nisso a
        musculação é insubstituível: ela é o sinal que diz ao corpo em
        déficit "o músculo fica, queime o resto".
      </p>
      <p>
        Quem emagrece só de dieta e cardio perde massa magra junto,
        derruba o gasto de repouso e aterrissa no corpo "menor, porém
        igual"; quem emagrece treinando força troca de composição
        corporal — o objetivo real por trás do número da balança, como
        explica o artigo sobre <a
        href="/emagrecimento/como-preservar-massa-muscular-emagrecendo/">preservação
        de massa magra</a>.
      </p>

      <h2>A estratégia prática: papéis separados</h2>
      <ul>
        <li>
          <strong>Musculação (2 a 4x/semana):</strong> construir e preservar
          músculo, com descansos adequados e progressão — sem transformar
          tudo em circuito para "suar mais".
        </li>
        <li>
          <strong>Cardio e passos diários:</strong> ampliar o gasto. A conta
          surpreende: para {PESO_PADRAO} kg, meia hora de caminhada moderada
          todo dia soma cerca de {formataKcal(CAMINHADA_SEMANA)} kcal na semana,
          mais que {SESSOES_PADRAO} treinos de uma hora de musculação variada
          ({formataKcal(SEMANA.kcalSemana)} kcal). Dá para refazer com o seu
          peso na <a href="/calorias/caminhada/">calculadora de calorias da
          caminhada</a>.
        </li>
        <li>
          <strong>Déficit calórico na alimentação:</strong> o motor do
          processo. Treino não compensa dieta — e comer de volta as
          "calorias do treino" que o relógio inventou é o jeito clássico de
          estagnar.
        </li>
