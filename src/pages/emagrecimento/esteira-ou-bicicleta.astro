---
/**
 * Esteira ou bicicleta para emagrecer — o recorte.
 *
 * O vizinho `/guias/pedalar-como-treino/` trata do que a bike faz pela perna
 * e de como ela convive com a força. Este fica na comparação de MÁQUINA PARA
 * EMAGRECER: quanto cada uma gasta, por que a esteira ganha no mesmo esforço
 * e por que a decisão acaba em outro lugar. (Regra registrada na pauta em
 * 20/09/2026: se os dois se aproximarem, sai o mais novo.)
 *
 * Nenhum número de gasto foi escrito à mão: a tabela sai dos motores das
 * calculadoras de caminhada e de bicicleta, pelo Compêndio de Atividades.
 * Fontes das comparações, conferidas em 28/09/2026: Zeni, Hoffman e Clifford
 * (JAMA, 1996) e Prieto-González e Yagin (Frontiers, 2024).
 */
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import CtaMontinho from '../../components/CtaMontinho.astro';
import Sidebar from '../../components/Sidebar.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import InstagramFollow from '../../components/InstagramFollow.astro';
import AutorMontinho from '../../components/AutorMontinho.astro';
import ContextualCta from '../../components/ContextualCta.astro';
import FerramentaInline from '../../components/FerramentaInline.astro';
import { breadcrumbSchema, articleSchema, faqSchema, personMontinhoSchema } from '../../lib/schema';
import { formatDateLong } from '../../lib/slug';
import { site } from '../../data/site';
import { metCaminhada, kcalPorMinuto, arredondaKcal } from '../../lib/calorias/caminhada';
import { metErgometrica } from '../../lib/calorias/bicicleta';

/* ── A tabela sai dos motores das calculadoras, não da mão ── */
const PESO = 70;
const MIN = 30;
const kcal = (met: number) => arredondaKcal(kcalPorMinuto(met, PESO) * MIN);
const met1 = (m: number) => m.toLocaleString('pt-BR', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const LINHAS = [
  { maquina: 'Esteira', ajuste: 'caminhada a 5 km/h, plano', met: metCaminhada(5, 0) },
  { maquina: 'Esteira', ajuste: 'caminhada a 6 km/h, plano', met: metCaminhada(6, 0) },
  { maquina: 'Esteira', ajuste: 'caminhada a 5 km/h, 5% de inclinação', met: metCaminhada(5, 5) },
  { maquina: 'Esteira', ajuste: 'caminhada a 5 km/h, 10% de inclinação', met: metCaminhada(5, 10) },
  { maquina: 'Bicicleta', ajuste: '60 W, leve', met: metErgometrica(60) },
  { maquina: 'Bicicleta', ajuste: '100 W, moderado', met: metErgometrica(100) },
  { maquina: 'Bicicleta', ajuste: '150 W, forte', met: metErgometrica(150) },
].map((l) => ({ ...l, kcal: kcal(l.met) }));
const PLANO_RAPIDO = LINHAS[1];
const INCLINADA_10 = LINHAS[3];
const BIKE_100 = LINHAS[5];

const relacionados = [
  {
    url: '/guias/pedalar-como-treino/',
    titulo: 'Pedalar como treino: o que a bike faz pela perna',
    descricao: 'Se a bicicleta ganhou, o que ela entrega além de gasto — e o que não entrega.',
    tipo: 'Guias',
  },
  {
    url: '/emagrecimento/quantos-passos-por-dia/',
    titulo: 'Quantos passos por dia para emagrecer?',
    descricao: 'O gasto que vem de fora da esteira pesa mais do que parece.',
    tipo: 'Emagrecimento',
  },
  {
    url: '/emagrecimento/musculacao-ou-cardio-para-emagrecer/',
    titulo: 'Musculação ou cardio para emagrecer?',
    descricao: 'A pergunta anterior a esta: onde o cardio entra no plano.',
    tipo: 'Emagrecimento',
  },
  {
    url: '/emagrecimento/como-comecar-a-treinar-acima-do-peso/',
    titulo: 'Como começar a treinar acima do peso',
    descricao: 'Quando o impacto é o que decide a máquina.',
    tipo: 'Emagrecimento',
  },
];

const path = '/emagrecimento/esteira-ou-bicicleta';
const atualizadoEm = '2026-09-28';
const crumbs = [
  { nome: 'Início', url: '/' },
  { nome: 'Emagrecimento', url: '/emagrecimento/' },
  { nome: 'Esteira ou bicicleta', url: path },
];

const faqs = [
  {
    pergunta: 'O que gasta mais calorias: esteira ou bicicleta?',
    resposta: `Depende do ajuste, não da máquina. Pela tabela de referência, ${MIN} minutos de caminhada plana a 6 km/h gastam perto de ${PLANO_RAPIDO.kcal} kcal para ${PESO} kg, e ${MIN} minutos de bicicleta a 100 W, perto de ${BIKE_100.kcal}. Quando pesquisadores compararam as máquinas no mesmo esforço percebido, porém, a esteira gastou mais — o corpo inteiro trabalha, e você carrega o próprio peso.`,
  },
  {
    pergunta: 'Bicicleta ergométrica emagrece?',
    resposta:
      'Emagrece nas mesmas condições de qualquer exercício: quando o gasto da semana, somado à alimentação, fica acima do que você come. A bicicleta ajuda a aumentar esse gasto e tem a vantagem de não ter impacto. O que decide é a regularidade — a máquina que você usa três vezes por semana rende mais do que a que você abandona.',
  },
  {
    pergunta: 'Esteira ou bicicleta para quem tem dor no joelho?',
    resposta:
      'A bicicleta costuma ser mais confortável para quem sente dor ao caminhar, porque o peso do corpo fica apoiado no selim e não há impacto. Mas dor no joelho tem causas diferentes, e algumas pioram com o pedal. Antes de escolher a máquina, a dor precisa de avaliação de médico ou fisioterapeuta.',
  },
  {
    pergunta: 'Caminhar na esteira inclinada gasta mais?',
    resposta: `Bastante. Pela mesma tabela, ${MIN} minutos a 5 km/h com 10% de inclinação gastam perto de ${INCLINADA_10.kcal} kcal para ${PESO} kg — mais do que a mesma velocidade no plano e mais do que a bicicleta a 100 W. A inclinação é o jeito de aumentar o gasto da caminhada sem precisar correr.`,
  },
  {
    pergunta: 'Quanto tempo de esteira ou bicicleta para emagrecer?',
    resposta:
      'Não existe um tempo que emagrece por si só. As recomendações de atividade física para adultos falam em 150 a 300 minutos por semana de atividade moderada para a saúde, e o emagrecimento depende do conjunto — exercício, alimentação e o movimento do resto do dia. Trinta minutos que você repete cinco vezes por semana valem mais do que uma hora que acontece uma vez.',
  },
];

/* 53 caracteres. */
const title = 'Esteira ou bicicleta para emagrecer: qual gasta mais?';
/* 129 caracteres. */
const description =
  'Esteira ou bicicleta ergométrica: qual gasta mais no mesmo esforço, o que muda nas articulações e qual é a melhor para emagrecer.';

const schema = [
  breadcrumbSchema(crumbs),
  articleSchema({ titulo: title, descricao: description, url: new URL(path, site.dominio).href, atualizadoEm }),
  faqSchema(faqs),
  personMontinhoSchema(),
];
---

<Base title={title} description={description} path={path} ogType="article" schema={schema}>
  <Breadcrumbs crumbs={crumbs} />
  <div class="container guide-layout">
    <article class="article-page">
    <p class="eyebrow">Emagrecimento</p>
    <h1>Esteira ou bicicleta para emagrecer?</h1>
    <p class="updated">Atualizado em {formatDateLong(atualizadoEm)}</p>

    <p class="lead">
      A resposta curta é que a esteira gasta mais — mas só quando as duas são
      comparadas do jeito certo. Comparadas do jeito que a maioria compara,
      pelo número do painel, a bicicleta pode sair na frente.
    </p>

    <p class="lead">
      E nenhuma das duas decide o emagrecimento sozinha. O que decide é outra
      conta, que aparece no fim.
    </p>

    <div class="prose">
      <h2>Pelo ajuste da máquina, depende</h2>
      <p>
        A tabela abaixo mostra quanto cada ajuste gasta em {MIN} minutos para
        uma pessoa de {PESO} kg, pelos valores de referência do Compêndio de
        Atividades Físicas — os mesmos que as calculadoras do portal usam.
      </p>

      <div class="tabela-rolavel">
        <table>
          <caption>{MIN} minutos, {PESO} kg</caption>
          <thead>
            <tr><th scope="col">Máquina</th><th scope="col">Ajuste</th><th scope="col">METs</th><th scope="col">Gasto</th></tr>
          </thead>
          <tbody>
            {LINHAS.map((l) => (
              <tr>
                <th scope="row">{l.maquina}</th>
                <td>{l.ajuste}</td>
                <td>{met1(l.met)}</td>
                <td>≈ {l.kcal} kcal</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p>
        Repare no que a tabela diz: <strong>nenhuma das duas "gasta mais" por si
        só.</strong> A caminhada plana, mesmo em ritmo rápido, fica abaixo da
        bicicleta a 100 W. A caminhada com 10% de inclinação passa dela. Com o
        seu peso, o seu ritmo e a sua inclinação, a{' '}
        <a href="/calorias/caminhada/">calculadora de caminhada</a> faz a conta
        da esteira; para correr, a{' '}
        <a href="/calorias/corrida/">de corrida</a>.
      </p>

      <FerramentaInline
        id="bicicleta"
        texto="Na bicicleta, o número que importa é a potência em watts, não a velocidade do painel — que em ergométrica não quer dizer nada fora dela. A calculadora usa os watts, ou o esforço percebido quando o painel não mostra, e dá o gasto com o seu peso."
        acao="Calcular o gasto da minha bicicleta ergométrica"
      />

      <h2>Pelo esforço, a esteira ganha</h2>
      <p>
        A comparação que interessa não é "5 km/h contra 100 W" — é quanto cada
        máquina gasta quando você se esforça o mesmo tanto. Foi o que dois
        estudos fizeram, com quase trinta anos de distância entre eles.
      </p>

      <p>
        Em 1996, pesquisadores pediram que voluntários se exercitassem em seis
        máquinas diferentes em três níveis de esforço percebido, de "leve" a
        "difícil". Em todos os níveis, a esteira gastou mais energia que as
        outras — incluindo a bicicleta ergométrica.
      </p>

      <p>
        Em 2024, um estudo com trinta homens ativos repetiu a pergunta com sete
        máquinas, num esforço forte. A esteira ficou de novo em primeiro, com o
        maior gasto, o maior consumo de oxigênio e a maior frequência cardíaca.
        A bicicleta vertical ficou entre as últimas, e a horizontal, com
        encosto, em último.
      </p>

      <p>
        O motivo é mecânico. Na esteira, você carrega o próprio peso e o corpo
        inteiro trabalha. Na bicicleta, o selim segura o peso e o trabalho se
        concentra nas pernas — tanto que, em quem não está acostumado a pedalar,
        a coxa costuma cansar antes do fôlego.
      </p>

      <h2>Onde a bicicleta ganha</h2>
      <p>
        <strong>No impacto.</strong> Com o peso apoiado no selim, a bicicleta não
        tem o impacto da caminhada ou da corrida. Para quem está começando acima
        do peso, ou sente desconforto ao caminhar, isso pode ser o que permite
        treinar com regularidade. Dor articular, porém, não se resolve trocando
        de máquina: precisa de avaliação de médico ou fisioterapeuta.
      </p>

      <p>
        <strong>No controle da intensidade.</strong> Na bicicleta, subir ou
        descer a carga é imediato e não muda o risco de tropeçar. Para
        intervalados, é a máquina mais simples.
      </p>

      <p>
        <strong>Na convivência com a musculação.</strong> Esse é assunto do guia
        de <a href="/guias/pedalar-como-treino/">pedalar como treino</a>, que
        trata do que a bike faz pela perna e de como encaixá-la na semana de
        força.
      </p>

      <h2>A conta que decide o emagrecimento</h2>
      <p>
        Mesmo quando a esteira gasta mais por minuto, a diferença numa sessão é
        de dezenas de calorias. A diferença entre fazer o cardio três vezes por
        semana e não fazer é de centenas — e a diferença do movimento do resto do
        dia, fora da academia, pode ser ainda maior, como mostra o guia de{' '}
        <a href="/emagrecimento/quantos-passos-por-dia/">quantos passos por
        dia</a>.
      </p>

      <p>
        Por isso a melhor máquina para emagrecer é a que você usa. Se a esteira
        te entedia e a bicicleta, não, a bicicleta gasta mais — porque acontece.
        Se a bicicleta incomoda e a esteira inclinada funciona para você, é ela.
        E nenhuma das duas substitui o treino de força, que é o que protege o
        músculo enquanto o peso cai.
      </p>

      <h2>Onde um acompanhamento ajuda</h2>
      <p>
        A escolha da máquina é a parte fácil. A difícil é montar a semana em que
        cardio, força e o resto da vida cabem juntos, e ajustar quando o peso
        para de cair. É esse o trabalho de quem acompanha você.
      </p>

      <h2>Referências</h2>
      <ul class="fontes">
        <li>
          <a href="https://jamanetwork.com/journals/jama/article-abstract/402029" target="_blank" rel="noopener noreferrer">Zeni AI, Hoffman MD, Clifford PS. Energy expenditure with indoor exercise machines. JAMA, 275(18):1424-1427, 1996</a>
        </li>
        <li>
          <a href="https://pubmed.ncbi.nlm.nih.gov/38390229/" target="_blank" rel="noopener noreferrer">Prieto-González P, Yagin FH. Energy expenditure, oxygen consumption, and heart rate while exercising on seven different indoor cardio machines at maximum and self-selected submaximal intensity. Frontiers in Sports and Active Living, 2024</a>
        </li>
        <li>
          <a href="https://pacompendium.com/bicycling/" target="_blank" rel="noopener noreferrer">Herrmann SD, Willis EA, Ainsworth BE, et al. 2024 Adult Compendium of Physical Activities. Journal of Sport and Health Science, 2024</a>
        </li>
      </ul>
    </div>

    <Faq faqs={faqs} titulo="Perguntas frequentes sobre esteira e bicicleta" />

    <ContextualCta path={path} assunto={title} />
    <InstagramFollow tema="emagrecimento" />
    <AutorMontinho />

    <RelatedArticles itens={relacionados} />
    </article>

    <Sidebar />
  </div>

  <section class="section-sm">
    <div class="container">
      <CtaMontinho variante="destaque" />
    </div>
  </section>
</Base>

<style>
  .guide-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-6);
    padding-block: var(--sp-7);
  }
  @media (min-width: 980px) {
    .guide-layout {
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: var(--sp-7);
    }
  }
  .article-page {
    min-width: 0;
    max-width: 760px;
  }
  .updated {
    color: var(--muted);
    font-size: var(--step--1);
    margin-top: var(--sp-2);
  }
  .lead {
    margin-top: var(--sp-4);
    font-size: var(--step-1);
    color: var(--ink-soft);
    line-height: 1.55;
  }
  .article-page .prose {
    margin-top: var(--sp-5);
  }
  .tabela-rolavel {
    overflow-x: auto;
    margin: var(--sp-4) 0;
  }
  .tabela-rolavel table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
  }
  .tabela-rolavel caption {
    caption-side: top;
    text-align: left;
    color: var(--muted);
    padding-bottom: 0.5rem;
  }
  .tabela-rolavel th,
  .tabela-rolavel td {
    text-align: left;
    padding: 0.55rem 0.8rem 0.55rem 0;
    border-bottom: 1px solid var(--line);
    font-variant-numeric: tabular-nums;
  }
  .tabela-rolavel td:last-child {
    white-space: nowrap;
  }
  .tabela-rolavel thead th {
    color: var(--muted);
    font-weight: 600;
    background: transparent;
  }
  .fontes {
    font-size: var(--step--1);
    color: var(--ink-soft);
    line-height: 1.6;
  }
  .fontes li {
    margin-bottom: 0.6rem;
  }
</style>
