/**
 * Fome emocional — o que é, como perceber, se é compulsão e como
 * controlar. Dona também de "comer por ansiedade" (mesma intenção, outra
 * porta de entrada).
 *
 * Prints do Google de 27/10/2026 ("fome emocional" e "comer por
 * ansiedade") e AnswerThePublic das duas buscas em
 * docs/pesquisas/2026-10-27-fome-emocional/; leitura em
 * docs/fome-emocional.md.
 *
 * Fontes conferidas em 27/10/2026 (resumos no Europe PMC). Fora, por falta
 * de fonte aberta: a tabela "fome física × emocional" que circula em blogs
 * (o texto usa as perguntas que os estudos sustentam), o Guia Alimentar
 * (PDF inacessível aqui), o status do remédio da compulsão na ANVISA.
 */
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import CtaMontinho from '../../components/CtaMontinho.astro';
import Sidebar from '../../components/Sidebar.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import InstagramFollow from '../../components/InstagramFollow.astro';
