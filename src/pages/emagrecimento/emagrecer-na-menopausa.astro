---
/**
 * Emagrecer na menopausa — o recorte.
 *
 * `/musculacao/musculacao-na-menopausa/` é dona do treino de força da fase.
 * Este artigo é dono do que os prints de 22/10/2026 mostraram: é possível?
 * é normal emagrecer? é mais difícil, por quê? como fazer, com ou sem
 * reposição hormonal? barriga? dieta, remédio, chá, suplemento? 50 anos?
 * exercícios? Prints e decisões em docs/emagrecer-na-menopausa.md.
 *
 * Fontes conferidas em 22/10/2026 (resumos no Europe PMC): Greendale et al.
 * 2019 (SWAN, composição corporal na transição); Lovejoy et al. 2008
 * (gordura visceral e gasto de energia); Pontzer et al. 2021 (gasto ao
 * longo da vida); Irwin et al. 2003 (exercício em pós-menopausa); Donnelly
 * et al. 2009 (ACSM); Verheggen et al. 2016 (gordura visceral).
 */
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import CtaMontinho from '../../components/CtaMontinho.astro';
import Sidebar from '../../components/Sidebar.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import InstagramFollow from '../../components/InstagramFollow.astro';
import AutorMontinho from '../../components/AutorMontinho.astro';
