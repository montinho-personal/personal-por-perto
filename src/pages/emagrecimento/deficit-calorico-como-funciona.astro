---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import CtaMontinho from '../../components/CtaMontinho.astro';
import Sidebar from '../../components/Sidebar.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import InstagramFollow from '../../components/InstagramFollow.astro';
import AutorMontinho from '../../components/AutorMontinho.astro';
import ContextualCta from '../../components/ContextualCta.astro';
import FerramentaInline from '../../components/FerramentaInline.astro';
import VideoYouTube from '../../components/VideoYouTube.astro';
import { breadcrumbSchema, articleSchema, faqSchema, personMontinhoSchema } from '../../lib/schema';
import { formatDateLong } from '../../lib/slug';
import { site } from '../../data/site';
import { rotas } from '../../lib/links';
import { fontesExternas } from '../../data/fontesExternas';

const oms = fontesExternas.oms;
const sbme = fontesExternas.sbme;

const relacionados = [
  {
    url: '/emagrecimento/como-preservar-massa-muscular-emagrecendo/',
    titulo: 'Como preservar massa muscular durante o emagrecimento',
    descricao: 'Depois de entender o déficit calórico, veja como evitar que ele leve embora massa muscular junto com a gordura.',
    tipo: 'Emagrecimento',
  },
  {
    url: '/emagrecimento/plato-de-emagrecimento/',
    titulo: 'Platô de emagrecimento: por que acontece e o que fazer',
    descricao: 'Entenda por que o resultado do déficit calórico costuma estagnar com o tempo e como lidar com isso.',
    tipo: 'Emagrecimento',
  },
  {
    url: '/emagrecimento/como-emagrecer-fazendo-musculacao/',
    titulo: 'Como emagrecer fazendo musculação',
    descricao: 'Veja como o treino de força se encaixa na equação do déficit calórico, além do gasto de calorias.',
    tipo: 'Emagrecimento',
  },
  {
    url: rotas.musculacao,
    titulo: 'Musculação: guias completos',
    descricao: 'O exercício estruturado é uma das variáveis do gasto calórico total — entenda os princípios de treino de força.',
    tipo: 'Musculação',
  },
  {
    url: rotas.montinho,
    titulo: 'Montinho Personal',
    descricao: 'Ajustar treino e déficit calórico à sua rotina, sem exageros, é trabalho de acompanhamento profissional.',
    tipo: 'Guia',
  },
];

const path = '/emagrecimento/deficit-calorico-como-funciona';
const atualizadoEm = '2026-09-11';
const capa = '/capas-conteudo/deficit-calorico-como-funciona.webp';
const capaAlt =
  'Infográfico de balanço de energia (gasto maior que consumo) com fita métrica na cintura, ilustrando o guia sobre como funciona o déficit calórico — Personal por Perto';
const crumbs = [
  { nome: 'Início', url: '/' },
  { nome: 'Emagrecimento', url: '/emagrecimento/' },
  { nome: 'Déficit calórico: como calcular o seu e quanto cortar', url: path },
];

const faqs = [
  {
    pergunta: 'O que é déficit calórico, na prática?',
    resposta:
      'É a situação em que o corpo gasta mais energia (calorias) do que recebe pela alimentação em um período de tempo. Para cobrir essa diferença, o organismo passa a usar reservas de energia armazenadas, principalmente gordura corporal — e é esse mecanismo que sustenta a perda de peso.',
  },
  {
    pergunta: 'Qual o número certo de calorias para o meu déficit?',
    resposta:
      'A estimativa se faz em três passos: calcular a taxa metabólica basal pela equação de Mifflin-St Jeor — (10 × peso em kg) + (6,25 × altura em cm) − (5 × idade) + 5 para homens ou − 161 para mulheres —, multiplicar pelo fator de atividade (cerca de 1,2 sedentário, 1,375 leve, 1,55 moderado, 1,725 intenso) e cortar de 10% a 25% desse total. O que essa conta não captura é a composição corporal, porque ela usa só o peso, nem quanto você se mexe fora do treino. Por isso o número é ponto de partida a ser ajustado pelo que a balança e a fita métrica mostrarem nas semanas seguintes, com acompanhamento de nutricionista para o ajuste alimentar.',
  },
  {
    pergunta: 'Déficit calórico agressivo emagrece mais rápido, então é melhor?',
    resposta:
      'Nem sempre. Déficits muito agressivos tendem a ser mais difíceis de sustentar por tempo suficiente e aumentam o risco de perda de massa muscular junto com a gordura. Um déficit mais moderado, mantido de forma consistente, costuma trazer resultados mais sólidos e sustentáveis do que um corte drástico e de curta duração.',
  },
  {
    pergunta: 'O que é NEAT e por que ele importa para o déficit calórico?',
    resposta:
      'NEAT (Non-Exercise Activity Thermogenesis) é o gasto calórico de tudo o que você faz no dia a dia fora do treino estruturado — caminhar, subir escada, ficar em pé, tarefas domésticas, até se mexer mais ou menos sem perceber. Pesquisas mostram que o NEAT pode representar uma fatia considerável do gasto calórico total e variar bastante entre pessoas de peso parecido, o que o torna uma peça relevante (e muitas vezes esquecida) da equação do déficit.',
  },
  {
    pergunta: 'Só treinar, sem ajustar a alimentação, é suficiente para gerar déficit calórico?',
    resposta:
      'Raramente. O exercício aumenta o gasto calórico, mas costuma ser mais fácil consumir de volta em alimentação a energia gasta em um treino do que muita gente imagina. Para a maioria das pessoas, o déficit calórico sustentável depende de ajustar também o lado da ingestão alimentar — o que reforça a importância de olhar para dieta e treino juntos, com orientação profissional.',
  },
];

const title = 'Déficit calórico: como calcular o seu e quanto cortar';
const description =
  'Déficit calórico: como calcular o seu pela fórmula de Mifflin-St Jeor, o fator de atividade, quanto cortar — e por que o número é ponto de partida, não meta.';

const schema = [
  breadcrumbSchema(crumbs),
  articleSchema({ titulo: title, descricao: description, url: new URL(path, site.dominio).href, imagem: new URL(capa, site.dominio).href, atualizadoEm }),
  faqSchema(faqs),
  personMontinhoSchema(),
];
---

<Base title={title} description={description} path={path} ogType="article" image={capa} schema={schema}>
  <Breadcrumbs crumbs={crumbs} />
  <div class="container guide-layout">
    <article class="article-page">
    <p class="eyebrow">Emagrecimento</p>
    <h1>Déficit calórico: como calcular o seu e quanto cortar</h1>
    <p class="updated">Atualizado em {formatDateLong(atualizadoEm)}</p>

    <figure style="margin: 0 0 var(--sp-5)">
      <img
        src={capa}
        alt={capaAlt}
        width="1200"
        height="675"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        style="width: 100%; height: auto; border-radius: var(--radius-lg); box-shadow: var(--shadow-lg)"
      />
    </figure>

    <p class="lead">
      Déficit calórico é o princípio fisiológico por trás de todo processo de
      emagrecimento: gastar mais energia do que se consome, para que o corpo
      busque a diferença em suas reservas. É um conceito simples de entender,
      mas que costuma ser mal aplicado — seja por tentar acertar um número
      "mágico" sem avaliação individual, seja por cortar calorias de forma
      agressiva demais.
    </p>

    <p class="lead">
      A conta que a maioria das calculadoras faz tem três passos: estimar o
      gasto em repouso pela equação de Mifflin-St Jeor, multiplicar por um
      fator de atividade e cortar de 10% a 25% do resultado. Abaixo, cada
      passo com exemplo — e, logo em seguida, as três razões pelas quais esse
      número é um ponto de partida a ajustar, não uma meta a perseguir.
    </p>

    <div class="prose">
      <h2>O que é balanço energético</h2>
      <p>
        O corpo funciona, de forma simplificada, como uma equação de
        energia: de um lado entram as calorias consumidas pela
        alimentação; do outro saem as calorias gastas para manter
        funções básicas (respirar, fazer o coração bater, digerir), se
        mover ao longo do dia e praticar exercício.
      </p>

      <p>
        Quando a energia que entra é menor do que a que sai, o corpo
        está em déficit calórico e tende a usar reservas armazenadas —
        principalmente gordura corporal — para cobrir essa diferença.
        Quando entra mais do que sai, o corpo tende a armazenar o
        excedente.
      </p>

      <p>
        Esse equilíbrio (ou desequilíbrio) entre entrada e saída de
        energia é a base fisiológica de por que alguém emagrece,
        mantém o peso ou ganha peso ao longo do tempo.
      </p>

      <h2>Como a conta é feita, na prática</h2>
      <p>
        A conta tem três passos, e vale conhecê-los mesmo sabendo que o
        resultado é uma estimativa. Entender de onde sai o número é o que
        permite desconfiar dele na hora certa.
      </p>

      <p>
        <strong>1. A taxa metabólica basal.</strong> É o que o corpo gasta
        parado, só para funcionar. A equação mais usada hoje é a de
        Mifflin-St Jeor, adotada como referência para adultos pela Academy
        of Nutrition and Dietetics desde 2005 por errar menos que as
        anteriores:
      </p>

      <div class="callout">
        <strong>TMB</strong> = (10 × peso em kg) + (6,25 × altura em cm)
        − (5 × idade em anos) + <strong>5</strong> para homens ou
        <strong>−161</strong> para mulheres.
        <br /><br />
        Uma mulher de 70 kg, 1,65 m e 35 anos: (10 × 70) + (6,25 × 165)
        − (5 × 35) − 161 = <strong>1.395 kcal/dia</strong> em repouso.
      </div>

      <p>
        <strong>2. O fator de atividade.</strong> A TMB é multiplicada por
        um número que representa o quanto a pessoa se mexe: em torno de
        1,2 para quem é sedentário, 1,375 para atividade leve (1 a 3 dias
        de treino por semana), 1,55 para moderada (3 a 5 dias) e 1,725
        para intensa (6 a 7 dias). O resultado é o gasto energético total.
        No exemplo acima, com treino três vezes por semana: 1.395 × 1,375
        ≈ <strong>1.918 kcal/dia</strong>.
      </p>

      <p>
        <strong>3. O corte.</strong> Sobre esse total se aplica o déficit.
        A referência mais comum é de 10% a 25% do gasto, ou os clássicos
        500 kcal por dia — que, pela regra tradicional de 3.500 kcal por
        meio quilo de gordura, projetam cerca de 0,5 kg por semana. No
        exemplo, algo entre 1.440 e 1.730 kcal por dia.
      </p>

      <h2>Por que esse número é uma estimativa, e não uma sentença</h2>
      <p>
        Agora a parte que as calculadoras não mostram. A equação usa o
        peso total e ignora a composição corporal: duas pessoas de 80 kg,
        uma com 20% e outra com 35% de gordura, recebem o mesmo resultado
        — e gastam diferente, porque músculo e gordura não consomem
        energia na mesma proporção. Em quadros de obesidade, a fórmula
        tende a superestimar, e o cálculo costuma ser refeito com peso
        ajustado.
      </p>

      <p>
        O fator de atividade é ainda mais grosseiro: ele resume num único
        multiplicador tudo o que a pessoa faz fora do treino, que é
        justamente a parte mais variável do gasto — o NEAT, detalhado mais
        abaixo.
      </p>

      <p>
        E a regra dos 3.500 kcal tem um defeito conhecido: ela supõe que o
        gasto continua o mesmo enquanto o peso cai, e não continua. Um
        corpo mais leve gasta menos para se manter e menos para se mover,
        então a projeção linear sempre promete mais do que a balança
        entrega depois de algumas semanas. Não é falha de disciplina — é
        aritmética, e é uma das causas do
        <a href="/emagrecimento/plato-de-emagrecimento/">platô de
        emagrecimento</a>.
      </p>

      <p>
        Daí o uso correto da conta: ela serve como ponto de partida a ser
        ajustado pelo que acontece de verdade nas semanas seguintes — não
        como número a ser perseguido. E o ajuste fino da alimentação é
        trabalho de nutricionista, não de personal trainer. Diretrizes de
        organizações como a <a href={oms.url} target="_blank"
        rel="noopener">{oms.nome}</a> reforçam que estratégias de controle
        de peso funcionam melhor quando combinam orientação alimentar
        individualizada com atividade física regular, e não um número de
        calorias isolado.
      </p>

      <FerramentaInline
        id="constancia"
        texto="A conta acima é a parte fácil: o que decide o resultado é conseguir sustentar o corte por semanas, e é aí que a maioria das tentativas termina. O diagnóstico mapeia onde a sua constância costuma quebrar — o fim de semana, a semana cheia de trabalho, o mês em que o treino some — antes de você escolher o tamanho do déficit."
        acao="Descobrir onde a minha constância costuma quebrar"
      />

      <h2>Déficit moderado x déficit agressivo</h2>
      <p>
        Nem todo déficit calórico é igual. Um déficit moderado — mais
        conservador em relação ao gasto total — tende a ser mais fácil
        de sustentar por semanas ou meses, o que na prática costuma
        pesar mais no resultado final do que a velocidade de perda de
        peso em uma semana isolada.
      </p>

      <p>
        Já um déficit muito agressivo, além de ser mais difícil de
        manter por tempo suficiente (o que favorece o efeito sanfona),
        tende a aumentar o risco de o corpo "buscar" energia também em
        massa muscular, e não só em gordura — um tema que detalhamos
        no guia sobre <a
        href="/emagrecimento/como-preservar-massa-muscular-emagrecendo/">como
        preservar massa muscular durante o emagrecimento</a>.
      </p>

      <p>
        Isso não significa que déficits maiores sejam sempre errados
        em qualquer contexto, mas sim que o tamanho ideal do déficit é
        uma decisão que deve ser calibrada com acompanhamento
        profissional, e não escolhida pelo maior corte possível.
      </p>

      <VideoYouTube
        id="nrT-Fan_Nbg"
        titulo="Como evitar o efeito sanfona — Montinho Personal"
        legenda="No vídeo: o Montinho Personal sobre o ciclo que o déficit agressivo costuma iniciar — perder rápido, não sustentar, reganhar e recomeçar."
        short
      />

      <h2>O papel do NEAT (gasto de atividades do dia a dia)</h2>
      <p>
        Uma parte do lado "gasto" da equação que costuma passar
        despercebida é o NEAT — sigla para Non-Exercise Activity
        Thermogenesis, ou seja, o gasto calórico de tudo que não é
        treino estruturado nem funções básicas do corpo: caminhar,
        subir escada, ficar em pé em vez de sentado, fazer tarefas
        domésticas, se mexer mais ao longo do dia.
      </p>

      <p>
        Pesquisas sobre o tema mostram que o NEAT pode representar uma
        fatia considerável do gasto calórico total e variar bastante
        entre pessoas de peso e rotina parecidos — o que ajuda a
        explicar por que duas pessoas com hábitos de treino
        semelhantes podem ter resultados diferentes no déficit
        calórico. Aumentar a movimentação natural do dia a dia é, para
        muita gente, uma alavanca tão relevante quanto o treino
        estruturado.
      </p>

      <h2>Exercício estruturado: uma peça da equação, não a equação inteira</h2>
      <p>
        O treino — seja musculação, cardio ou uma combinação dos dois
        — contribui para o lado do gasto calórico e traz benefícios
        que vão além do déficit em si, como preservar massa muscular e
        melhorar condicionamento. Mas, isoladamente, o exercício
        raramente é suficiente para gerar um déficit calórico
        consistente: é comum subestimar quanto se gasta em um treino
        e, sem perceber, compensar essa energia na alimentação.
      </p>

      <p>
        Por isso "só treinar", sem olhar também para o lado da
        ingestão alimentar, tende a não ser suficiente para a maioria
        das pessoas que busca emagrecer — o exercício funciona melhor
        como parte de uma estratégia que inclui ajuste alimentar, não
        como substituto dele.
      </p>
      <div class="callout">
        <strong>Resumindo:</strong> déficit calórico é o princípio de gastar
        mais energia do que se consome, mas o tamanho ideal desse déficit,
        como distribuí-lo na alimentação e como equilibrar NEAT, exercício
        estruturado e ingestão alimentar depende de fatores individuais.
        Ajustar essas variáveis ao seu caso — treino com um
        <a href={rotas.comoEscolher}>personal trainer qualificado</a> e
        alimentação com um nutricionista — segue princípios reconhecidos por
        entidades como a
        <a href={sbme.url} target="_blank" rel="noopener">{sbme.nome}</a>.
      </div>
    </div>

    <VideoYouTube
      id="gKl5Qwiu2yU"
      titulo="Leandro Twin: o melhor modelo de dieta para quem treina musculação"
      legenda="No vídeo: Leandro Twin apresenta o modelo de dieta que sustenta o déficit de quem treina."
    />

    <Faq faqs={faqs} />

    <ContextualCta path={path} assunto={title} />
    <InstagramFollow tema="geral" />
    <AutorMontinho />

    <RelatedArticles itens={relacionados} />
    </article>

    <Sidebar />
  </div>

  <section class="section-sm">
    <div class="container">
      <CtaMontinho variante="destaque" />
    </div>
  </section>
</Base>

<style>
  .guide-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-6);
    padding-block: var(--sp-7);
  }
  @media (min-width: 980px) {
    .guide-layout {
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: var(--sp-7);
    }
  }
  .article-page {
    min-width: 0;
    max-width: 760px;
  }
  .updated {
    color: var(--muted);
    font-size: var(--step--1);
    margin-top: var(--sp-2);
  }
  .lead {
    margin-top: var(--sp-4);
    font-size: var(--step-1);
    color: var(--ink-soft);
    line-height: 1.55;
  }
  .article-page .prose {
    margin-top: var(--sp-5);
  }
</style>
