---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { breadcrumbSchema, itemListSchema } from '../../lib/schema';
import { site } from '../../data/site';
import { rotas } from '../../lib/links';

const path = '/humor-fitness';
const crumbs = [
  { nome: 'Início', url: '/' },
  { nome: 'Humor fitness', url: path },
];

const artigos = [
  {
    url: '/humor-fitness/perfis-de-memes-fitness',
    titulo: 'Perfis de memes fitness para seguir no Instagram',
    desc: 'A curadoria dos perfis que transformam leg day, dieta e frango com batata-doce em piada — do Rindo do Shape à Marombeira Cansada.',
    tag: 'Perfis',
  },
  {
    url: '/humor-fitness/memes-de-academia',
    titulo: 'Memes de academia: os melhores para mandar no grupo de treino',
    desc: 'Leg day, dor do dia seguinte, segunda-feira internacional do peito: o guia dos memes clássicos da academia e por que todo mundo se identifica.',
    tag: 'Memes',
  },
  {
    url: '/humor-fitness/frases-de-academia-engracadas',
    titulo: 'Frases de academia engraçadas para legenda e status',
    desc: 'Mais de 40 frases prontas para legenda de foto, status e grupo do treino — do leg day à dieta por um fio.',
    tag: 'Frases',
  },
  {
    url: '/humor-fitness/memes-de-dieta',
    titulo: 'Memes de dieta: rindo para não chorar no cutting',
    desc: 'O começo eterno na segunda, o "só um pedacinho" e a balança mentirosa — os memes de dieta e o que revelam de verdade.',
    tag: 'Dieta',
  },
  {
    url: '/humor-fitness/meme-de-leg-day',
    titulo: 'Meme de leg day: por que o treino de perna rende tanta piada',
    desc: 'A escada do dia seguinte, o "never skip leg day" e a ciência que explica o treino mais temido (e zoado) da semana.',
    tag: 'Leg day',
  },
];

const title = 'Humor fitness: memes de academia e a cultura de rir do próprio shape';
const description =
  'O lado leve da vida na academia: memes de treino, perfis de humor fitness no Instagram e as piadas que todo marombeiro reconhece.';

const schema = [
  breadcrumbSchema(crumbs),
  itemListSchema('Conteúdos de humor fitness', artigos.map((a) => a.titulo), new URL(path, site.dominio).href),
];
---

<Base title={title} description={description} path={path} schema={schema}>
  <Breadcrumbs crumbs={crumbs} />
  <header class="section-sm tint">
    <div class="container">
      <p class="eyebrow">Cultura fitness</p>
      <h1>Humor fitness</h1>
      <p class="lead" style="max-width: 60ch">
        Treinar é coisa séria — mas rir do processo faz parte. Aqui fica o lado
        leve do portal: memes, perfis de humor e as piadas que unem quem vive a
        rotina da academia.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="grid grid-2">
        {
          artigos.map((a) => (
            <a class="card card-hover guide" href={a.url}>
              <span class="pill">{a.tag}</span>
              <h2>{a.titulo}</h2>
              <p>{a.desc}</p>
              <span class="guide-link">Ler artigo →</span>
            </a>
          ))
        }
      </div>
      <p class="muted small" style="margin-top: var(--sp-6)">
        Depois de rir, o treino continua: veja os conteúdos sérios de
        <a href={rotas.musculacao}>musculação</a> e
        <a href={rotas.emagrecimento}>emagrecimento</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .guide {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--ink);
  }
  .guide:hover {
    text-decoration: none;
  }
  .guide h2 {
    font-size: var(--step-2);
  }
  .guide p {
    color: var(--ink-soft);
    flex: 1;
  }
  .guide-link {
    font-weight: 700;
    color: var(--brand-600);
  }
  .small {
    font-size: var(--step--1);
  }
</style>
