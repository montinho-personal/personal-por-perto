    .cb-proximo-nota { margin-top: var(--sp-3); font-size: var(--step--1); color: var(--muted); }

    .cb-conteudo { margin-top: var(--sp-7); }
    .cb-ressalva {
      border-left: 3px solid var(--line);
      padding-left: var(--sp-4);
      color: var(--ink-soft);
      font-size: var(--step--1);
    }
    .tabela-rolavel { overflow-x: auto; margin: var(--sp-4) 0; }
    .tabela-rolavel:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
    .tabela-rolavel table { width: 100%; border-collapse: collapse; font-size: var(--step--1); }
    .tabela-rolavel caption {
      caption-side: top;
      text-align: left;
      color: var(--muted);
      font-size: var(--step--1);
      padding-bottom: 0.5rem;
    }
    .tabela-rolavel th,
    .tabela-rolavel td {
      text-align: left;
      padding: 0.6rem 0.8rem 0.6rem 0;
      border-bottom: 1px solid var(--line);
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }
    /* O global pinta o thead de azul-escuro com texto branco; aqui o desenho
       é o cabeçalho discreto, então o fundo sai junto com a cor. Só trocar a
       cor deixava cinza sobre quase preto — contraste 3,9, abaixo do mínimo. */
    .tabela-rolavel thead th { color: var(--muted); font-weight: 600; background: transparent; }
    .tabela-rolavel tbody th { font-weight: 700; }
    .cb-faixa { display: block; font-weight: 400; color: var(--muted); font-size: 0.85em; white-space: nowrap; }

    .cb-formula {
      padding: var(--sp-4);
      border: 1px solid var(--line);
      border-radius: var(--radius);
