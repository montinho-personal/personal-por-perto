---
/**
 * Quantas calorias o pedal gasta — página e calculadora.
 *
 * O RECORTE, DECLARADO CONTRA AS OUTRAS DUAS DO CLUSTER
 *
 * Caminhada: o gasto responde ao TEMPO. Corrida: responde à DISTÂNCIA, e o
 * ritmo quase não importa por quilômetro. Pedal: responde à VELOCIDADE, e
 * de forma brutal — dobrar de 14 para 28 km/h triplica o gasto por hora,
 * porque a resistência do ar cresce com o quadrado da velocidade e a
 * potência para vencê-la, com o cubo.
 *
 * É a terceira física do cluster, e é a que mais contraria a intuição de
 * quem acha que "meia hora de bike" é uma medida que significa alguma coisa
 * sozinha.
 *
 * DOIS CENÁRIOS, PORQUE SÃO DUAS ESCALAS
 *
 * Na rua o Compêndio mede por velocidade. Na ergométrica, por watts — sem
 * ar para vencer, a velocidade do painel não diz nada sobre o esforço. Usar
 * uma escala no lugar da outra é o erro mais comum das calculadoras
 * genéricas, e ele infla o resultado com facilidade.
 *
 * DO GOOGLE, 06/10/2026 (prints do Renato, busca "quantas calorias gasta
 * andar de bicicleta"): o autocompletar pede 30 minutos, 1 hora, 10
 * minutos e 1, 5, 10 e 30 km; as relacionadas somam 15, 20 e 25 minutos, 15
 * e 20 km, metade delas na ergométrica (15, 25 e 30 minutos, 1 hora e
 * "calculadora de calorias bicicleta ergométrica"); o PAA pergunta 30
 * minutos, 1 hora e se pedalar 30 minutos ou 1 hora por dia emagrece; a IA
 * diz 300 a 700 kcal por hora (leve 300–400, moderado 500–600, intenso 700
 * a 900), que é o que o nosso motor dá para 70 kg a 14, 20 e 28 km/h (294,
 * 563 e 882). Entraram: título e H1 no fraseado da busca, com a
 * ergométrica; as tabelas por tempo e por distância nos três ritmos, com
 * os tempos e distâncias da busca (no motor); uma tabela da ergométrica por
 * tempo e esforço; as perguntas de 1 km (que veio dos prints da caminhada),
 * 10 e 20 km, 30 minutos e 1 hora de ergométrica e 30 minutos por dia. Saiu
 * do FAQ, sem sair da página, a do vento; a de 45 minutos de ergométrica
 * virou a de 30 minutos e a de 1 hora.
 */
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import Sidebar from '../../components/Sidebar.astro';
import AutorMontinho from '../../components/AutorMontinho.astro';
import WhatsAppCta from '../../components/WhatsAppCta.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import { breadcrumbSchema, articleSchema, faqSchema, personMontinhoSchema } from '../../lib/schema';
import { formatDateLong } from '../../lib/slug';
import { site } from '../../data/site';
import {
  EFICIENCIA,
  FAIXAS_RUA,
  FONTES,
  KCAL_POR_KG_GORDURA,
  NIVEIS_ESFORCO,
  NIVEIS_TABELA_ERGO,
  NOTA_ERGOMETRICA_VELOCIDADE,
  NOTA_ESTIMATIVA,
  NOTA_NAO_PRESCRICAO,
  NOTA_SEGURANCA,
  NOTA_SEM_PERDA_LOCALIZADA,
  NOTA_VENTO,
  PESO_BICICLETA,
  PESO_PADRAO,
  RITMOS_TABELA,
  VELOCIDADE_PADRAO,
  arredondaKcal,
  deDistancia,
  deKcalRua,
  deTempoRua,
  formataKm,
  formataTempo,
  formataVelocidade,
  kcalPorKgPorKm,
  metDaSubida,
  metRua,
  nivel,
  simulacaoUmQuilo,
  tabelaDistanciaPorRitmo,
  tabelaErgoPorTempo,
  tabelaErgometrica,
  tabelaPorPeso,
  tabelaPorVelocidade,
  tabelaTempoPorRitmo,
} from '../../lib/calorias/bicicleta';
import { kcalPorKgPorKm as corridaPorKm } from '../../lib/calorias/corrida';
import { deDistancia as caminhadaDistancia, ritmo as ritmoCaminhada } from '../../lib/calorias/caminhada';

const path = '/calorias/bicicleta';
const atualizadoEm = '2026-10-06';

const crumbs = [
  { nome: 'Início', url: '/' },
  { nome: 'Calorias por atividade', url: '/calorias/' },
  { nome: 'Bicicleta', url: path },
];

/* ── Exemplos resolvidos no servidor, pelo mesmo motor da calculadora ── */
const V = VELOCIDADE_PADRAO;
const EX_60 = deTempoRua(60, PESO_PADRAO, V);
const EX_30 = deTempoRua(30, PESO_PADRAO, V);
const EX_10KM = deDistancia(10, PESO_PADRAO, V);
const EX_20KM = deDistancia(20, PESO_PADRAO, V);
const EX_SUBIDA = deTempoRua(60, PESO_PADRAO, V, 5);
const EX_500 = deKcalRua(500, PESO_PADRAO, V);
const UM_QUILO = simulacaoUmQuilo(PESO_PADRAO, V);
const SEMANA = 7;

const TAB_VEL = tabelaPorVelocidade(PESO_PADRAO, 60);
const TAB_PESO = tabelaPorPeso(60, V);
const TAB_TEMPO = tabelaTempoPorRitmo(PESO_PADRAO);
const TAB_DIST = tabelaDistanciaPorRitmo(PESO_PADRAO);
const TAB_ERGO = tabelaErgometrica(PESO_PADRAO, 45);
const TAB_ERGO_TEMPO = tabelaErgoPorTempo(PESO_PADRAO);
const NIVEIS_ERGO = NIVEIS_TABELA_ERGO.map((id) => nivel(id));

/* As linhas das tabelas que respondem às perguntas da busca. */
const linha = (tab: typeof TAB_TEMPO, valor: number) => tab.find((l) => l.valor === valor)!;
const T30 = linha(TAB_TEMPO, 30);
const KM1 = linha(TAB_DIST, 1);
const KM10 = linha(TAB_DIST, 10);
const KM20 = linha(TAB_DIST, 20);
const ERGO30 = linha(TAB_ERGO_TEMPO, 30);
const ERGO60 = linha(TAB_ERGO_TEMPO, 60);
/* "Andar 1 km de bicicleta" veio dos prints da caminhada: a comparação é com ela. */
const CAMINHADA_MOD = ritmoCaminhada('moderado');
const CAMINHADA_1KM = arredondaKcal(caminhadaDistancia(1, PESO_PADRAO, CAMINHADA_MOD.velocidade, 0, CAMINHADA_MOD.cadencia).kcal);
const CORRIDA_1KM = Math.round(corridaPorKm(10) * PESO_PADRAO);
/* Acréscimo real ao dia: é o líquido que entra num déficit. */
const LIQ_30 = arredondaKcal(EX_30.kcalLiquida);
const LIQ_60 = arredondaKcal(EX_60.kcalLiquida);
const LIQ_30_SEMANA = Math.round((EX_30.kcalLiquida * SEMANA) / 100) * 100;
const RITMO_FAIXA = (kcal: number[]) => `${kcal[0]} kcal em ritmo de passeio a ${kcal[2]} kcal num ritmo forte`;

const MET_LENTO = metRua(14);
const MET_RAPIDO = metRua(28);
const RAZAO = MET_RAPIDO / MET_LENTO;
/*
 * O fator depende do ponto de partida. A versão anterior dizia "dobrar a
 * velocidade triplica o gasto" como regra geral; pelo próprio motor, isso
 * só vale para 14→28. Abaixo de uns 20 km/h dobrar quase só dobra — o ar
 * ainda não pesa. Os pares saem do motor para a frase não poder divergir.
 */
const PARES = [
  [10, 20],
  [12, 24],
  [14, 28],
].map(([de, para]) => ({ de, para, fator: metRua(para) / metRua(de) }));
/* Montada aqui, e não em JSX, para a pontuação não ganhar espaços soltos. */
const fatorTxt = (f: number) => f.toLocaleString('pt-BR', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const trechos = PARES.map((p) => `${p.de}→${p.para} km/h multiplica o gasto por ${fatorTxt(p.fator)}`);
const FRASE_PARES = `${trechos.slice(0, -1).join(', ')} e ${trechos[trechos.length - 1]}`;
const CUSTO_14 = kcalPorKgPorKm(14);
const CUSTO_28 = kcalPorKgPorKm(28);
const CUSTO_CORRIDA = corridaPorKm(10);
const n = (v: number, d = 1) => v.toLocaleString('pt-BR', { maximumFractionDigits: d });

/* 59 caracteres. A busca é "quantas calorias gasta andar de bicicleta"; metade das relacionadas é ergométrica. */
const title = 'Quantas Calorias Gasta Andar de Bicicleta? E na Ergométrica';
const description = `Calcule as calorias do pedal por tempo, km ou na ergométrica. 1 hora a ${formataVelocidade(V)} gasta cerca de ${arredondaKcal(EX_60.kcal)} kcal para ${PESO_PADRAO} kg — e a velocidade muda tudo.`;

const faqs = [
  {
    pergunta: '1 hora de bicicleta gasta quantas calorias?',
    resposta: `Depende muito da velocidade, mais do que em qualquer outra atividade do cluster. Para ${PESO_PADRAO} kg: cerca de ${TAB_VEL[0].kcal} kcal em ritmo de passeio (14 km/h), ${arredondaKcal(EX_60.kcal)} kcal a ${formataVelocidade(V)} e cerca de ${TAB_VEL[4].kcal} kcal num ritmo forte de 28 km/h. Dobrar de 14 para 28 km/h triplica o gasto; em velocidades mais baixas, dobrar quase só dobra.`,
  },
  {
    pergunta: '30 minutos de bicicleta queimam quantas calorias?',
    resposta: `Para ${PESO_PADRAO} kg, de ${RITMO_FAIXA(T30.kcal)} (28 km/h). A ${formataVelocidade(V)}, ritmo de treino tranquilo, são cerca de ${arredondaKcal(EX_30.kcal)} kcal e ${formataKm(EX_30.km)}. Como o gasto é proporcional ao tempo, uma hora no mesmo ritmo dá o dobro.`,
  },
  {
    pergunta: 'Quantas calorias gasta andar 1 km de bicicleta?',
    resposta: `Pouco: para ${PESO_PADRAO} kg, de ${KM1.kcal[0]} a ${KM1.kcal[2]} kcal, do passeio ao ritmo forte. Caminhar o mesmo quilômetro gasta cerca de ${CAMINHADA_1KM} kcal e correr, perto de ${CORRIDA_1KM} — das três, a bicicleta é o jeito mais barato de percorrer distância, e é por isso que, no pedal, a conta que interessa é a do tempo, não a do quilômetro.`,
  },
  {
    pergunta: 'Pedalar 10 km ou 20 km gasta quantas calorias?',
    resposta: `Para ${PESO_PADRAO} kg a ${formataVelocidade(V)}: cerca de ${arredondaKcal(EX_10KM.kcal)} kcal em 10 km (${formataTempo(EX_10KM.minutos)}) e ${arredondaKcal(EX_20KM.kcal)} kcal em 20 km (${formataTempo(EX_20KM.minutos)}). Aqui há uma diferença importante em relação à corrida: pedalar os mesmos 20 km mais rápido gasta MAIS — de ${KM20.kcal[0]} kcal no passeio a ${KM20.kcal[2]} kcal num ritmo forte. O ar cobra por isso.`,
  },
  {
    pergunta: 'Quantas calorias gastam 30 minutos de bicicleta ergométrica?',
    resposta: `Para ${PESO_PADRAO} kg, cerca de ${ERGO30.kcal[0]} kcal em carga leve (~${NIVEIS_ERGO[0].watts} W), ${ERGO30.kcal[1]} kcal em carga moderada (~${NIVEIS_ERGO[1].watts} W) e ${ERGO30.kcal[2]} kcal em carga forte (~${NIVEIS_ERGO[2].watts} W), que é o ritmo médio de uma aula de spinning. O que decide é a carga, não a velocidade que aparece no painel.`,
  },
  {
    pergunta: '1 hora de bicicleta ergométrica gasta quantas calorias?',
    resposta: `Para ${PESO_PADRAO} kg, de ${ERGO60.kcal[0]} kcal em carga leve a ${ERGO60.kcal[2]} kcal em carga forte, passando por cerca de ${ERGO60.kcal[1]} kcal na moderada. Se o painel mostra watts, use a calculadora com o número dele; se não mostra, o nível de esforço é uma aproximação honesta, não uma medição.`,
  },
  {
    pergunta: 'Por que a bike da academia mostra um número diferente?',
    resposta: NOTA_ERGOMETRICA_VELOCIDADE,
  },
  {
    pergunta: 'Bicicleta ou corrida: qual gasta mais?',
    resposta: `Por hora, a corrida costuma gastar mais, a menos que o pedal seja bem rápido. Por quilômetro não há disputa: pedalar 1 km custa cerca de ${n(kcalPorKgPorKm(21), 2)} kcal por quilo, contra ${n(CUSTO_CORRIDA, 2)} correndo — menos da metade. A bike compensa com volume: dá para pedalar duas horas sem o desgaste articular de duas horas correndo.`,
  },
  {
    pergunta: 'Pedalar na subida gasta mais calorias?',
    resposta: `Bastante. A ${formataVelocidade(V)}, 5% de subida somam cerca de ${n(metDaSubida(V, 5, PESO_PADRAO))} METs ao pedal no plano — uma hora sobe de ${arredondaKcal(EX_60.kcal)} para ${arredondaKcal(EX_SUBIDA.kcal)} kcal. E aqui o peso da própria bicicleta entra na conta, porque é massa que precisa ser erguida.`,
  },
  {
    pergunta: 'É possível emagrecer pedalando 30 minutos por dia?',
    resposta: `Ajuda, mas não resolve sozinho. Para ${PESO_PADRAO} kg a ${formataVelocidade(V)}, 30 minutos acrescentam cerca de ${LIQ_30} kcal ao dia — perto de ${LIQ_30_SEMANA.toLocaleString('pt-BR')} kcal na semana, se for todo dia. Uma hora por dia dobra a conta (cerca de ${LIQ_60} kcal). É um bom pedaço de um déficit, e o pedal tem duas vantagens próprias: é de baixo impacto, o que permite volume alto sem castigar as articulações, e cabe no deslocamento do dia. Mas o resultado depende do balanço da semana inteira, e o exercício costuma aumentar a fome.`,
  },
  {
    pergunta: 'Pedalar todo dia perde barriga?',
    resposta: `${NOTA_SEM_PERDA_LOCALIZADA} ${NOTA_SEGURANCA}`,
  },
];

const relacionados = [
  {
    url: '/guias/pedalar-como-treino/',
    titulo: 'Pedalar como treino: o que a bike faz pela perna',
    descricao: 'Por que a perna de quem pedala no plano não muda — e a variável que altera isso.',
    tipo: 'Guia',
  },
  {
    url: '/calorias/corrida/',
    titulo: 'Quantas calorias a corrida gasta?',
    descricao: 'A comparação direta: correr 1 km custa mais que o dobro de pedalar 1 km.',
    tipo: 'Calorias',
  },
  {
    url: '/calorias/caminhada/',
    titulo: 'Quantas calorias a caminhada gasta?',
    descricao: 'A terceira conta do cluster, que responde por tempo em vez de velocidade.',
    tipo: 'Calorias',
  },
  {
    url: '/emagrecimento/deficit-calorico-como-funciona/',
    titulo: 'Déficit calórico: como funciona',
    descricao: 'Onde o gasto do pedal entra, e por que ele é a menor peça da conta.',
    tipo: 'Emagrecimento',
  },
];

const schema = [
  breadcrumbSchema(crumbs),
  articleSchema({ titulo: title, descricao: description, url: new URL(path, site.dominio).href, atualizadoEm }),
  faqSchema(faqs),
  personMontinhoSchema(),
];
---

<Base title={title} description={description} path={path} ogType="article" schema={schema}>
  <Breadcrumbs crumbs={crumbs} />

  <header class="cb-hero">
    <div class="container cb-hero-inner">
      <p class="eyebrow">Calorias por atividade</p>
      <h1>Quantas calorias gasta andar de bicicleta?</h1>
      <p class="cb-hero-lead">
        Uma hora de pedal a {formataVelocidade(V)} gasta cerca de{' '}
        <strong>{arredondaKcal(EX_60.kcal)} kcal</strong> para {PESO_PADRAO} kg. Mas a velocidade
        muda isso mais do que em qualquer outra atividade: <strong>de 14 para 28 km/h, o gasto
        triplica</strong>.
      </p>
      <p class="cb-micro">Grátis · sem cadastro · a conta acontece no seu navegador</p>
    </div>
  </header>

  <div class="container cb-layout">
    <article class="cb-main">
      <section id="cb-app" class="cb-app" aria-labelledby="cb-app-h">
        <h2 id="cb-app-h" class="cb-app-h">Calculadora de calorias da bicicleta — rua e ergométrica</h2>

        <div class="cb-modos" role="tablist" aria-label="Onde e como você pedalou">
          <button type="button" class="cb-modo is-ativo" data-modo="tempo" role="tab" aria-selected="true">
            Na rua, por tempo
          </button>
          <button type="button" class="cb-modo" data-modo="distancia" role="tab" aria-selected="false" tabindex="-1">
            Na rua, por distância
          </button>
          <button type="button" class="cb-modo" data-modo="ergometrica" role="tab" aria-selected="false" tabindex="-1">
            Ergométrica
          </button>
          <button type="button" class="cb-modo" data-modo="meta" role="tab" aria-selected="false" tabindex="-1">
            Tenho uma meta
          </button>
        </div>

        <div class="cb-campos">
          <div class="cb-campo">
            <label for="cb-peso">Seu peso (kg)</label>
            <input id="cb-peso" type="text" inputmode="decimal" autocomplete="off" value={PESO_PADRAO} />
          </div>

          <div class="cb-campo cb-campo-modo">
            <label for="cb-minutos">Tempo pedalando (minutos)</label>
            <input id="cb-minutos" type="text" inputmode="numeric" autocomplete="off" value="60" />
            <div class="cb-presets">
              {[15, 20, 30, 45, 60, 90, 120].map((v) => (
                <button type="button" class="cb-preset" data-alvo="tempo" data-valor={String(v)}>
                  {formataTempo(v)}
                </button>
              ))}
            </div>
          </div>

          <div class="cb-campo cb-campo-modo" hidden>
            <label for="cb-km">Distância pedalada (km)</label>
            <input id="cb-km" type="text" inputmode="decimal" autocomplete="off" value="20" />
            <div class="cb-presets">
              {[1, 5, 10, 15, 20, 30, 50].map((v) => (
                <button type="button" class="cb-preset" data-alvo="distancia" data-valor={String(v)}>{v} km</button>
              ))}
            </div>
          </div>

          <div class="cb-campo cb-campo-modo" hidden>
            <label for="cb-minutos-ergo">Tempo na ergométrica (minutos)</label>
            <input id="cb-minutos-ergo" type="text" inputmode="numeric" autocomplete="off" value="45" />
            <div class="cb-presets">
              {[15, 20, 30, 45, 60].map((v) => (
                <button type="button" class="cb-preset" data-alvo="ergometrica" data-valor={String(v)}>
                  {v} min
                </button>
              ))}
            </div>
          </div>

          <div class="cb-campo cb-campo-modo" hidden>
            <label for="cb-meta">Meta de gasto (kcal)</label>
            <input id="cb-meta" type="text" inputmode="numeric" autocomplete="off" value="500" />
            <div class="cb-presets">
              {[200, 300, 500, 800].map((v) => (
                <button type="button" class="cb-preset" data-alvo="meta" data-valor={String(v)}>{v} kcal</button>
              ))}
            </div>
          </div>

          <!-- Cenário RUA: a escala é velocidade. -->
          <div id="cb-bloco-rua">
            <div class="cb-campo">
              <label for="cb-velocidade">
                Velocidade média (km/h) <span class="cb-comparativo" id="cb-comparativo"></span>
              </label>
              <input id="cb-velocidade" type="text" inputmode="decimal" autocomplete="off" value={V} />
              <div class="cb-presets">
                {FAIXAS_RUA.map((f) => (
                  <button type="button" class="cb-preset" data-alvo="velocidade" data-valor={String(f.velocidade)}>
                    {f.velocidade.toLocaleString('pt-BR')} km/h
                  </button>
                ))}
              </div>
            </div>

            <details class="cb-ajustes">
              <summary>
                Pedalei em subida
                <span class="cb-ajustes-estado" id="cb-estado">no plano</span>
              </summary>
              <div class="cb-campo">
                <label for="cb-inclinacao">
                  Inclinação média — <output id="cb-inclinacao-valor" for="cb-inclinacao">0%</output>
                </label>
                <input id="cb-inclinacao" type="range" value="0" min="0" max="15" step="1" />
                <p class="cb-dica">
                  Aqui entra o peso da bicicleta ({PESO_BICICLETA} kg), porque subindo é massa que precisa ser erguida.
                </p>
              </div>
            </details>
          </div>

          <!-- Cenário ERGOMÉTRICA: a escala é potência. -->
          <div id="cb-bloco-ergo" hidden>
            <div class="cb-campo">
              <label for="cb-watts">Potência (watts)</label>
              <input id="cb-watts" type="text" inputmode="numeric" autocomplete="off" value="100" />
              <p class="cb-dica">Se o painel não mostra watts, escolha o esforço abaixo:</p>
              <div class="cb-presets">
                {NIVEIS_ESFORCO.map((nv) => (
                  <button type="button" class="cb-nivel cb-preset" data-nivel={nv.id} aria-pressed="false">
                    {nv.nome}
                  </button>
                ))}
              </div>
            </div>
          </div>
        </div>

        <p id="cb-erro" class="cb-erro" role="status" hidden></p>

        <div id="cb-saida" class="cb-saida" role="status" aria-live="polite">
          <p class="cb-resultado">
            <span class="cb-numero">≈ {arredondaKcal(EX_60.kcal)}</span>
            <span class="cb-unidade">kcal</span>
          </p>
          <p class="cb-frase"></p>

          <dl class="cb-detalhes">
            <div><dt>Tempo</dt><dd class="cb-d-tempo">—</dd></div>
            <div class="cb-linha-km"><dt>Distância</dt><dd class="cb-d-km">—</dd></div>
            <div class="cb-linha-porkm"><dt>Por quilômetro</dt><dd class="cb-d-porkm">—</dd></div>
            <div class="cb-linha-watts" hidden><dt>Potência</dt><dd class="cb-d-watts">—</dd></div>
            <div><dt>Acréscimo real ao dia</dt><dd class="cb-d-liquido">—</dd></div>
            <div><dt>Intensidade</dt><dd><span class="cb-d-met">—</span> METs</dd></div>
          </dl>

          <p class="cb-nota cb-nota-intensidade" hidden></p>
          <p class="cb-nota cb-nota-ergo" hidden></p>
          <p class="cb-nota">{NOTA_ESTIMATIVA}</p>

          <div class="cb-proximo">
            <p class="cb-proximo-lead">
              Esse número responde <em>quanto você gastou</em>. Ele não responde a pergunta que
              decide o resultado: <strong>o que o pedal está fazendo pelo seu corpo além de
              gastar caloria</strong>. Pedalar no plano é carga baixa repetida — ótimo para volume
              e condicionamento, fraco como estímulo de força.
            </p>
            <div class="cb-proximo-acoes">
              <a class="cb-btn cb-btn-primario" href="/personal-trainer/" data-track="calorias:cta-local">
                Encontrar personal na minha cidade
              </a>
              <a
                class="cb-btn cb-btn-secundario cb-whats"
                href="https://wa.me/"
                target="_blank"
                rel="noopener"
                data-track="calorias:cta-whatsapp"
              >
                Falar com o Montinho sobre acompanhamento online
              </a>
            </div>
            <p class="cb-proximo-nota">
              O Personal por Perto é um portal editorial. O diretório de cidades é gratuito; o
              Montinho Personal é o profissional que assina o conteúdo do portal e atende online
              para todo o Brasil.
            </p>
          </div>
        </div>
      </section>

      <div class="prose cb-conteudo">
        <h2>De 14 para 28 km/h, o gasto triplica</h2>
        <p>
          Esta é a diferença central entre pedalar e as outras atividades. Na corrida, o custo de
          cada quilômetro quase não muda com o ritmo. No pedal, a velocidade manda — e manda de
          forma desproporcional: entre 14 e 28 km/h, o gasto por hora vai de{' '}
          <strong>{n(MET_LENTO)} para {n(MET_RAPIDO)} METs</strong>, exatamente{' '}
          <strong>{n(RAZAO, 1)} vezes</strong>.
        </p>
        <p>
          O motivo é a resistência do ar. Ela cresce com o quadrado da velocidade, e a potência
          necessária para vencê-la cresce com o cubo. Acima de uns 20 km/h no plano, o ar passa a
          ser a força dominante — é contra ele que a maior parte do esforço vai.
        </p>
        <p>
          Por isso o &ldquo;triplica&rdquo; tem endereço: vale para 14→28 km/h, não para qualquer
          dobra de velocidade. Pela mesma tabela, {FRASE_PARES}.
          Abaixo de uns 20 km/h dobrar quase só dobra, porque o ar ainda pesa pouco; o salto
          desproporcional aparece quando a velocidade de chegada passa dessa faixa.
        </p>
        <div class="tabela-rolavel">
          <table>
            <caption>Uma hora de pedal por velocidade média, para {PESO_PADRAO} kg, no plano</caption>
            <thead>
              <tr>
                <th scope="col">Ritmo</th><th scope="col">METs</th>
                <th scope="col">1 hora</th><th scope="col">Distância</th><th scope="col">Por km</th>
              </tr>
            </thead>
            <tbody>
              {TAB_VEL.map((l) => (
                <tr>
                  <th scope="row">
                    {l.faixa.velocidade.toLocaleString('pt-BR')} km/h
                    <small class="cb-faixa">{l.faixa.faixa}</small>
                  </th>
                  <td>{n(l.faixa.met)}</td>
                  <td>≈ {l.kcal} kcal</td>
                  <td>{formataKm(l.km)}</td>
                  <td>≈ {Math.round(l.porKm)} kcal</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>
          Repare na última coluna, e compare com a corrida: aqui o custo por quilômetro{' '}
          <strong>sobe</strong> cerca de 50% da faixa mais lenta à mais rápida, de{' '}
          {n(CUSTO_14, 2)} para {n(CUSTO_28, 2)} kcal por quilo por quilômetro. Correndo, esse
          mesmo número fica praticamente parado. São físicas diferentes.
        </p>
        <p class="cb-ressalva">
          Uma ressalva honesta sobre a tabela: as faixas do Compêndio são médias medidas, de
          larguras diferentes, não pontos de uma curva ajustada. A tendência de alta é clara, mas
          entre duas faixas vizinhas o número pode não subir — a de 21 km/h, por exemplo, sai
          ligeiramente abaixo da de 17,5 km/h por quilômetro. A física explica o formato geral, não
          cada degrau.
        </p>

        <h2>O erro da bike de academia</h2>
        <p>
          Se você já comparou o número do painel da ergométrica com o de um aplicativo de pedal na
          rua, provavelmente estranhou. Há um motivo, e ele é físico: <strong>na ergométrica não
          existe ar para vencer</strong>.
        </p>
        <p>
          Isso significa que a velocidade que aparece no visor não diz nada sobre o seu esforço. Dá
          para marcar 30 km/h com a carga no mínimo, pedalando sem resistência nenhuma. O que decide
          o gasto ali é a <strong>carga</strong> — e é por isso que o Compêndio mede bicicleta
          estacionária em watts, não em quilômetros por hora.
        </p>
        <div class="tabela-rolavel">
          <table>
            <caption>45 minutos de bicicleta ergométrica por potência, para {PESO_PADRAO} kg</caption>
            <thead>
              <tr><th scope="col">Potência</th><th scope="col">METs</th><th scope="col">45 min</th></tr>
            </thead>
            <tbody>
              {TAB_ERGO.map((l) => (
                <tr>
                  <th scope="row">{l.faixa.rotulo}</th>
                  <td>{n(l.faixa.met)}</td>
                  <td>≈ {l.kcal} kcal</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>
          Se o seu painel não mostra watts, a calculadora aceita nível de esforço — mas vale saber
          que isso é aproximação declarada, não medição. Aula de spinning costuma ficar na faixa dos
          150 W médios, com picos bem acima.
        </p>
        <div class="tabela-rolavel">
          <table>
            <caption>Bicicleta ergométrica por tempo e esforço, para {PESO_PADRAO} kg</caption>
            <thead>
              <tr>
                <th scope="col">Tempo</th>
                {NIVEIS_ERGO.map((nv) => (
                  <th scope="col">{nv.nome}<small class="cb-faixa">~{nv.watts} W</small></th>
                ))}
              </tr>
            </thead>
            <tbody>
              {TAB_ERGO_TEMPO.map((l) => (
                <tr>
                  <th scope="row">{formataTempo(l.valor)}</th>
                  {l.kcal.map((k) => <td>≈ {k.toLocaleString('pt-BR')} kcal</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h2>Calorias por tempo: 10, 20, 30 minutos, 1 hora</h2>
        <p>
          &ldquo;Meia hora de bicicleta&rdquo; sozinha não diz quanto se gastou — no pedal a
          velocidade muda a resposta mais do que o tempo. Por isso a tabela dá os três ritmos, para{' '}
          {PESO_PADRAO} kg no plano: passeio ({formataVelocidade(RITMOS_TABELA[0].velocidade)}),
          treino tranquilo ({formataVelocidade(RITMOS_TABELA[1].velocidade)}) e grupo rápido
          ({formataVelocidade(RITMOS_TABELA[2].velocidade)}).
        </p>
        <div class="tabela-rolavel">
          <table>
            <caption>Gasto estimado por tempo de pedal na rua, para {PESO_PADRAO} kg, no plano</caption>
            <thead>
              <tr>
                <th scope="col">Tempo</th>
                {RITMOS_TABELA.map((r) => (
                  <th scope="col">{r.nome}<small class="cb-faixa">{formataVelocidade(r.velocidade)}</small></th>
                ))}
              </tr>
            </thead>
            <tbody>
              {TAB_TEMPO.map((l) => (
                <tr>
                  <th scope="row">{formataTempo(l.valor)}</th>
                  {l.kcal.map((k) => <td>≈ {k.toLocaleString('pt-BR')} kcal</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h2>Calorias por distância: 1, 5, 10, 20 km</h2>
        <p>
          Por quilômetro o pedal gasta pouco: para {PESO_PADRAO} kg, de {KM1.kcal[0]} a{' '}
          {KM1.kcal[2]} kcal, contra cerca de {CAMINHADA_1KM} kcal caminhando e {CORRIDA_1KM}{' '}
          correndo. E, ao contrário da corrida, o mesmo trajeto feito mais rápido custa mais — a
          diferença entre as colunas é o ar.
        </p>
        <div class="tabela-rolavel">
          <table>
            <caption>Gasto estimado por distância pedalada na rua, para {PESO_PADRAO} kg, no plano</caption>
            <thead>
              <tr>
                <th scope="col">Distância</th>
                {RITMOS_TABELA.map((r) => (
                  <th scope="col">{r.nome}<small class="cb-faixa">{formataVelocidade(r.velocidade)}</small></th>
                ))}
              </tr>
            </thead>
            <tbody>
              {TAB_DIST.map((l) => (
                <tr>
                  <th scope="row">{l.valor} km</th>
                  {l.kcal.map((k) => <td>≈ {k.toLocaleString('pt-BR')} kcal</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h2>Calorias no pedal por peso corporal</h2>
        <div class="tabela-rolavel">
          <table>
            <caption>Uma hora a {formataVelocidade(V)} por peso corporal</caption>
            <thead>
              <tr><th scope="col">Peso</th><th scope="col">1 hora (bruto)</th><th scope="col">Acréscimo ao dia</th></tr>
            </thead>
            <tbody>
              {TAB_PESO.map((l) => (
                <tr>
                  <th scope="row">{l.peso} kg</th>
                  <td>≈ {l.kcal} kcal</td>
                  <td>≈ {l.kcalLiquida} kcal</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h2>Bicicleta ou corrida: qual gasta mais?</h2>
        <p>
          <strong>Por hora</strong>, a corrida costuma ganhar, a menos que o pedal seja rápido.
          <strong> Por quilômetro</strong>, não há disputa: pedalar 1 km a {formataVelocidade(21)}{' '}
          custa cerca de {n(kcalPorKgPorKm(21), 2)} kcal por quilo, contra {n(CUSTO_CORRIDA, 2)}{' '}
          correndo — menos da metade.
        </p>
        <p>
          Mas a conta que importa não é essa. A bike compensa com <strong>volume</strong>: duas horas
          de pedal são perfeitamente viáveis toda semana, duas horas de corrida cobram um preço
          articular que a maioria não paga por muito tempo. Para quem está acima do peso ou voltando
          de lesão, isso costuma decidir —{' '}
          <a href="/calorias/corrida/">a conta da corrida</a> mostra o outro lado.
        </p>

        <h2>Pedalar na subida</h2>
        <p>
          A {formataVelocidade(V)}, 5% de subida acrescentam cerca de{' '}
          <strong>{n(metDaSubida(V, 5, PESO_PADRAO))} METs</strong> ao pedal no plano: uma hora sai
          de {arredondaKcal(EX_60.kcal)} para {arredondaKcal(EX_SUBIDA.kcal)} kcal.
        </p>
        <p>
          A subida é também o único lugar em que o <strong>peso da bicicleta</strong> entra na conta.
          No plano ele quase não pesa; subindo, é massa que precisa ser erguida junto com você — e é
          por isso que ciclista se importa tanto com o peso do quadro em prova de montanha e quase
          nada em prova plana.
        </p>

        <h2>Quanto pedalar para gastar 500 calorias?</h2>
        <p>
          Para {PESO_PADRAO} kg a {formataVelocidade(V)}, cerca de{' '}
          <strong>{formataKm(EX_500.km)}</strong> — em torno de {formataTempo(EX_500.minutos)}. Em
          ritmo mais forte cai bastante, porque o gasto por hora sobe rápido.
        </p>
        <p>
          E o lembrete de sempre: meta de caloria não é estratégia. O que decide é{' '}
          <a href="/emagrecimento/deficit-calorico-como-funciona/">o déficit da semana inteira</a>.
        </p>

        <h2>Quanto pedalar para perder 1 kg?</h2>
        <p>
          Um quilo de gordura corporal armazena cerca de {KCAL_POR_KG_GORDURA.toLocaleString('pt-BR')} kcal.
          Para {PESO_PADRAO} kg a {formataVelocidade(V)}, isso corresponderia a aproximadamente{' '}
          <strong>{formataKm(UM_QUILO.km)}</strong> de pedal.
        </p>
        <div class="callout">
          <strong>Isso não significa que pedalar essa distância faz perder exatamente 1 kg.</strong>{' '}
          É uma simulação teórica, para dar noção de ordem de grandeza. O corpo não responde em
          linha reta: o gasto cai conforme a pessoa emagrece, e o exercício mexe no apetite.
        </div>

        <h2>O que o pedal faz — e o que ele não faz</h2>
        <p>
          Gasto calórico é só uma parte da história. Pedalar no plano é carga baixa repetida milhares
          de vezes: excelente para condicionamento e para volume de movimento sem impacto, fraco como
          estímulo de força. A perna de quem só pedala no plano costuma não mudar de forma —{' '}
          <a href="/guias/pedalar-como-treino/">pedalar como treino</a> trata disso com calma, e
          explica qual variável muda esse quadro.
        </p>

        <h2>Como calculamos</h2>
        <p>
          O gasto sai da equação de METs, com os valores vindo do Compêndio de Atividades Físicas
          (edição 2024) — que mede o pedal de <strong>duas formas diferentes</strong>, e é por isso
          que esta ferramenta tem dois cenários:
        </p>
        <pre class="cb-formula">kcal/min = MET × 3,5 × peso (kg) ÷ 200

RUA          MET por faixa de velocidade  (4,0 a 12,0)
ERGOMÉTRICA  MET por potência em watts    (5,0 a 13,8)</pre>
        <p>
          Entre duas faixas medidas a calculadora <strong>interpola</strong>, e fora das pontas ela
          segura no valor da ponta — extrapolar para 45 km/h devolveria um número que ninguém mediu.
        </p>
        <p>
          A <strong>subida</strong> não vem do Compêndio: é física direta. A potência para erguer o
          conjunto (você mais a bicicleta) é massa × gravidade × velocidade vertical; essa potência
          mecânica vira gasto metabólico dividida pela eficiência do pedal, que a literatura situa
          perto de {n(EFICIENCIA * 100, 0)}%.
        </p>
        <p>
          Essa escolha tem uma conferência embutida, e ela fecha: os 100 W da ergométrica valem
          6,8 METs no Compêndio, o que para {PESO_PADRAO} kg implica uma eficiência de cerca de 20%
          — dentro da faixa da literatura e perto dos {n(EFICIENCIA * 100, 0)}% usados na conta de
          subida. As duas pontas da ferramenta concordam.
        </p>
        <p>
          Os números são <strong>brutos</strong>: incluem o que você gastaria parado no mesmo tempo.
          O acréscimo real ao dia é menor, e a calculadora mostra os dois.
        </p>
        <p class="cb-revisao">
          Revisado em {formatDateLong(atualizadoEm)} por <a href="/montinho-personal/">Montinho</a>,
          personal trainer. {NOTA_NAO_PRESCRICAO}
        </p>

