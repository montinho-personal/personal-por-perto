---
/**
 * Quantas calorias gasta uma aula de crossfit — página e calculadora.
 *
 * O RECORTE, DECLARADO CONTRA AS OUTRAS CATORZE
 *
 * Duas coisas que nenhuma outra página do cluster tem. A primeira: a
 * régua não é o Compêndio (ele não tem linha de crossfit), é um WOD
 * medido — o Cindy, 9,5 METs. A segunda: o limite do próprio método. Num
 * WOD de 2 minutos (o Isabel), o gasto medido por minuto foi o dobro do
 * que esta calculadora daria. A página diz que, para WOD curto e
 * explosivo, esta conta — e a do relógio — subestima.
 *
 * A AULA NÃO É O WOD
 *
 * O modo principal pede a aula e o WOD separados. Só o WOD roda na
 * intensidade medida; o resto entra como repouso, e a página diz que isso
 * subestima.
 */
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import Sidebar from '../../components/Sidebar.astro';
import AutorMontinho from '../../components/AutorMontinho.astro';
import WhatsAppCta from '../../components/WhatsAppCta.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import { breadcrumbSchema, articleSchema, faqSchema, personMontinhoSchema } from '../../lib/schema';
import { formatDateLong } from '../../lib/slug';
import { site } from '../../data/site';
import {
  AULA_PADRAO,
  ESTUDO_CINDY,
  ESTUDO_ISABEL,
  FONTES,
  MET_WOD,
  NOTA_AULA,
  NOTA_BRUTO,
  NOTA_ESTIMATIVA,
  NOTA_NAO_PRESCRICAO,
  NOTA_REFERENCIA,
  NOTA_SEGURANCA,
  NOTA_SEM_PERDA_LOCALIZADA,
  NOTA_WOD_CURTO,
  PESO_PADRAO,
  SEM_CONFERENCIA,
  WOD_PADRAO,
  deAula,
  deWod,
  formataKcal,
  formataMet,
  formataTempo,
  isabelContraOxigenio,
  minutosDeWodPara,
  reproduzCindy,
  simulacaoUmQuilo,
  tabelaPorPeso,
  tabelaWods,
} from '../../lib/calorias/crossfit';

const path = '/calorias/crossfit';
const atualizadoEm = '2026-09-23';

const crumbs = [
  { nome: 'Início', url: '/' },
  { nome: 'Calorias por atividade', url: '/calorias/' },
  { nome: 'Crossfit', url: path },
];

/* ── Exemplos resolvidos no servidor, pelo mesmo motor da calculadora ── */
const EX_AULA = deAula(AULA_PADRAO, WOD_PADRAO, PESO_PADRAO);
const EX_WOD = deWod(WOD_PADRAO, PESO_PADRAO);
const EX_HORA_WOD = deWod(60, PESO_PADRAO);
const MIN_PARA_MIL = minutosDeWodPara(1000, PESO_PADRAO);
const UM_QUILO = simulacaoUmQuilo(PESO_PADRAO);
const TAB_WODS = tabelaWods(PESO_PADRAO);
const TAB_PESO = tabelaPorPeso();

/* As conferências, calculadas e não escritas à mão. */
const CINDY = reproduzCindy();
const ISABEL = isabelContraOxigenio();

const n = (v: number, d = 1) => v.toLocaleString('pt-BR', { maximumFractionDigits: d });

/* 57 caracteres. */
const title = 'Quantas Calorias Gasta uma Aula de Crossfit? Conta do WOD';
/* 151 caracteres. */
const description =
  'Calcule as calorias do crossfit pelo WOD, não pela aula inteira — e por que num WOD curto e explosivo o relógio e o oxigênio podem ver menos da metade.';

const faqs = [
  {
    pergunta: 'Quantas calorias gasta uma aula de crossfit?',
    resposta: `Depende de quanto da aula é WOD. Numa aula de ${formataTempo(AULA_PADRAO)} com ${WOD_PADRAO} minutos de WOD, cerca de ${formataKcal(EX_AULA.kcal)} kcal para ${PESO_PADRAO} kg — ${formataKcal(EX_AULA.kcalWod)} delas vêm do WOD. O aquecimento e a técnica entram como repouso, o que subestima um pouco: não conferimos medição dessa parte da aula.`,
  },
  {
    pergunta: 'Uma aula de crossfit queima 1.000 calorias?',
    resposta: `Na intensidade de um WOD medido, 1.000 kcal pedem cerca de ${formataTempo(MIN_PARA_MIL)} de WOD para ${PESO_PADRAO} kg — mais do que uma aula de uma hora inteira, e a aula não é toda WOD. Mesmo uma hora inteira nessa intensidade daria ${formataKcal(EX_HORA_WOD.kcal)} kcal.`,
  },
  {
    pergunta: 'Quantas calorias gasta um WOD de 20 minutos?',
    resposta: `Cerca de ${formataKcal(EX_WOD.kcal)} kcal para ${PESO_PADRAO} kg, pela intensidade medida no Cindy (${formataMet(MET_WOD)} METs). No estudo, os 9 praticantes gastaram ${n(ESTUDO_CINDY.kcalTotal)} kcal em média nos 20 minutos.`,
  },
  {
    pergunta: 'O relógio acerta as calorias do crossfit?',
    resposta: `Num WOD curto e explosivo, dificilmente. Relógios estimam pelo batimento, que acompanha o consumo de oxigênio. Num WOD de cerca de 2 minutos medido em estudo, só ${ESTUDO_ISABEL.pctOxidativa}% da energia veio da via que o oxigênio enxerga, e o gasto medido por minuto foi ${n(ISABEL.razao)} vezes o que esta calculadora daria.`,
  },
  {
    pergunta: 'Crossfit emagrece?',
    resposta: `Aumenta o gasto do dia, e aula frequente conta. Mas nenhum exercício emagrece sozinho: quem decide é o balanço entre o que entra e o que sai ao longo de semanas.`,
  },
  {
    pergunta: 'Quanto tempo de crossfit para perder 1 kg de gordura?',
    resposta: `Cerca de ${formataTempo(UM_QUILO.minutosWod)} de WOD na intensidade do Cindy, para ${PESO_PADRAO} kg — sem contar aquecimento e técnica. Mesmo essa conta é otimista, porque usa a regra dos 7.700 kcal por quilo, que superestima a perda ao longo do tempo.`,
  },
];

const relacionados = [
  {
    url: '/emagrecimento/quantas-calorias-queima-a-musculacao/',
    titulo: 'Quantas calorias a musculação queima?',
    descricao: 'A outra metade do treino de força, com o gasto pós-treino no tamanho certo.',
    tipo: 'Calorias',
  },
  {
    url: '/calorias/corda/',
    titulo: 'Quantas calorias pular corda gasta?',
    descricao: 'O double under de todo box, e a conta que desmonta a lenda dos 10 minutos.',
    tipo: 'Calorias',
  },
  {
    url: '/musculacao/treino-de-ombro/',
    titulo: 'Treino de ombro',
    descricao: 'A articulação mais exigida em barra, arranco e desenvolvimento.',
    tipo: 'Musculação',
  },
  {
    url: '/emagrecimento/deficit-calorico-como-funciona/',
    titulo: 'Déficit calórico: como funciona',
    descricao: `Onde as ${formataKcal(EX_AULA.kcal)} kcal de uma aula de crossfit entram na conta.`,
    tipo: 'Emagrecimento',
  },
];

const schema = [
  breadcrumbSchema(crumbs),
  articleSchema({ titulo: title, descricao: description, url: new URL(path, site.dominio).href, atualizadoEm }),
  faqSchema(faqs),
  personMontinhoSchema(),
];
---

<Base title={title} description={description} path={path} ogType="article" schema={schema}>
  <Breadcrumbs crumbs={crumbs} />

  <header class="cx-hero">
    <div class="container cx-hero-inner">
      <p class="eyebrow">Calorias por atividade</p>
      <h1>Quantas calorias gasta uma aula de crossfit?</h1>
      <p class="cx-hero-lead">
        Uma aula de {formataTempo(AULA_PADRAO)} com {WOD_PADRAO} minutos de WOD gasta cerca de{' '}
        <strong>{formataKcal(EX_AULA.kcal)} kcal</strong> para {PESO_PADRAO} kg. O WOD é a parte que
        pesa — e, quando ele é curto e explosivo,{' '}
        <strong>o relógio e esta conta podem ver bem menos do que foi gasto</strong>.
      </p>
      <p class="cx-micro">Grátis · sem cadastro · a conta acontece no seu navegador</p>
    </div>
  </header>

  <div class="container cx-layout">
    <article class="cx-main">
      <section id="cx-app" class="cx-app" aria-labelledby="cx-app-h">
        <h2 id="cx-app-h" class="cx-app-h">Calculadora de calorias do crossfit</h2>

        <div class="cx-campos">
          <div class="cx-campo">
            <label for="cx-peso">Seu peso (kg)</label>
            <input id="cx-peso" type="text" inputmode="decimal" autocomplete="off" value={PESO_PADRAO} />
          </div>

          <div class="cx-modos" role="tablist" aria-label="Como você quer contar">
            <button type="button" class="cx-modo is-ativo" data-modo="aula" role="tab" aria-selected="true">
              Aula
            </button>
            <button type="button" class="cx-modo" data-modo="wod" role="tab" aria-selected="false" tabindex="-1">
              Só o WOD
            </button>
            <button type="button" class="cx-modo" data-modo="meta" role="tab" aria-selected="false" tabindex="-1">
              Tenho uma meta
            </button>
          </div>

          <div class="cx-campo cx-campo-modo">
            <div class="cx-duo">
              <div>
                <label for="cx-aula">Minutos de aula</label>
                <input id="cx-aula" type="text" inputmode="numeric" autocomplete="off" value={AULA_PADRAO} />
              </div>
              <div>
                <label for="cx-wod-aula">Minutos de WOD</label>
                <input id="cx-wod-aula" type="text" inputmode="numeric" autocomplete="off" value={WOD_PADRAO} />
              </div>
            </div>
          </div>

          <div class="cx-campo cx-campo-modo" hidden>
            <label for="cx-wod">Minutos de WOD</label>
            <input id="cx-wod" type="text" inputmode="numeric" autocomplete="off" value={WOD_PADRAO} />
            <div class="cx-presets">
              {[5, 10, 15, 20].map((v) => (
                <button type="button" class="cx-preset" data-alvo="wod" data-valor={String(v)}>
                  {v} min
                </button>
              ))}
            </div>
          </div>

          <div class="cx-campo cx-campo-modo" hidden>
            <label for="cx-meta">Meta de gasto (kcal)</label>
            <input id="cx-meta" type="text" inputmode="numeric" autocomplete="off" value="300" />
            <div class="cx-presets">
              {[200, 300, 500, 1000].map((v) => (
                <button type="button" class="cx-preset" data-alvo="meta" data-valor={String(v)}>
                  {v.toLocaleString('pt-BR')} kcal
                </button>
              ))}
            </div>
          </div>

          <p class="cx-dica">
            Intensidade do WOD: {formataMet(MET_WOD)} METs, medida no Cindy (Kliszczewicz et al., 2014).
          </p>
        </div>

        <p id="cx-erro" class="cx-erro" role="status" hidden></p>

        <div id="cx-saida" class="cx-saida" role="status" aria-live="polite">
          <p class="cx-resultado">
            <span class="cx-numero">≈ {formataKcal(EX_AULA.kcal)}</span>
            <span class="cx-unidade">kcal</span>
          </p>
          <p class="cx-frase"></p>

          <dl class="cx-detalhes">
            <div><dt>Tempo de WOD</dt><dd class="cx-d-wod">—</dd></div>
            <div><dt>Resto da aula</dt><dd class="cx-d-fora">—</dd></div>
            <div><dt>Acréscimo real ao dia</dt><dd class="cx-d-liquido">—</dd></div>
            <div><dt>De onde vem o número</dt><dd>Cindy, {formataMet(MET_WOD)} METs</dd></div>
          </dl>

          <p class="cx-nota cx-nota-curto" hidden></p>
          <p class="cx-nota">{NOTA_ESTIMATIVA}</p>

          <div class="cx-proximo">
            <p class="cx-proximo-lead">
              Esse número responde <em>quanto você gastou</em>. Ele não diz se a sua técnica aguenta o
              cronômetro: arranco, barra e agachamento com fadiga pedem uma base de força e de
              movimento que o WOD, sozinho, não constrói. <strong>Treino de força fora do relógio é o
              que deixa o WOD continuar existindo.</strong>
            </p>
            <div class="cx-proximo-acoes">
              <a class="cx-btn cx-btn-primario" href="/personal-trainer/" data-track="calorias:cta-local">
                Encontrar personal na minha cidade
              </a>
              <a
                class="cx-btn cx-btn-secundario cx-whats"
                href="https://wa.me/"
                target="_blank"
                rel="noopener"
                data-track="calorias:cta-whatsapp"
              >
                Falar com o Montinho sobre acompanhamento online
              </a>
            </div>
            <p class="cx-proximo-nota">
              O Personal por Perto é um portal editorial. O diretório de cidades é gratuito; o
              Montinho Personal é o profissional que assina o conteúdo do portal e atende online
              para todo o Brasil.
            </p>
          </div>
        </div>
      </section>

      <div class="prose cx-conteudo">
        <h2>A aula não é o WOD</h2>
        <p>
          Uma aula de crossfit costuma ter aquecimento, uma parte de técnica ou força e o WOD. É o
          WOD que roda no máximo — e é só ele que a calculadora conta na intensidade medida.
        </p>
        <p class="cx-formula">{`aula de ${formataTempo(AULA_PADRAO)}, ${WOD_PADRAO} min de WOD, ${PESO_PADRAO} kg
  WOD: ${formataMet(MET_WOD)} × 3,5 × ${PESO_PADRAO} ÷ 200 × ${WOD_PADRAO} = ${n(EX_AULA.kcalWod, 0)} kcal
  resto da aula: ${EX_AULA.minutosFora} min como repouso = ${n(EX_AULA.kcalFora, 0)} kcal
  total ≈ ${formataKcal(EX_AULA.kcal)} kcal`}</p>
        <p>{NOTA_AULA}</p>

        <h2>A régua: um WOD medido</h2>
        <p>
          O Compêndio de Atividades Físicas não tem uma linha para crossfit. Por isso a régua desta
          página é uma medição: Kliszczewicz e colegas acompanharam {ESTUDO_CINDY.participantes}{' '}
          praticantes ({ESTUDO_CINDY.homens} homens e {ESTUDO_CINDY.mulheres} mulheres) no Cindy — o
          máximo de rodadas de 5 barras, 10 flexões e 15 agachamentos em 20 minutos.
        </p>
        <p class="cx-formula">{`${n(ESTUDO_CINDY.vo2)} mL de oxigênio por kg por minuto ÷ 3,5 = ${n(CINDY.metDoOxigenio, 2)} METs (o estudo publica ${formataMet(ESTUDO_CINDY.met)})
  ${ESTUDO_CINDY.kcalPorMinuto} kcal por minuto × 20 = ${CINDY.totalDoPorMinuto} kcal (o estudo publica ${n(ESTUDO_CINDY.kcalTotal)})`}</p>
        <p>
          Os números do estudo conversam entre si, e a frequência cardíaca média ficou em{' '}
          {n(ESTUDO_CINDY.fcMedia)} batimentos por minuto. {NOTA_REFERENCIA}
        </p>
        <div class="tabela-rolavel">
          <table>
            <caption>WOD na intensidade do Cindy, {PESO_PADRAO} kg</caption>
            <thead>
              <tr><th scope="col">Duração do WOD</th><th scope="col">Gasto</th></tr>
            </thead>
            <tbody>
              {TAB_WODS.map((l) => (
                <tr>
                  <th scope="row">{l.minutos} min</th>
                  <td>≈ {formataKcal(l.kcal)} kcal</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h2>O limite do oxigênio: o WOD curto e explosivo</h2>
        <p>
          Aqui está o que esta página tem de diferente, inclusive contra ela mesma. Toda conta de
          calorias baseada em oxigênio ou em frequência cardíaca — esta, a do relógio, a do
          aplicativo — enxerga só a energia que vem da via oxidativa. Em esforço longo e contínuo, ela
          responde pela maior parte. Num WOD curto e explosivo, pode não responder.
        </p>
        <p>
          Rios e colegas mediram o Isabel — 30 arrancos, em cerca de {Math.round(ESTUDO_ISABEL.segundos / 60)}{' '}
          minutos — em {ESTUDO_ISABEL.participantes} homens muito treinados. A via oxidativa respondeu
          por {ESTUDO_ISABEL.pctOxidativa}% da energia; a glicolítica, por {ESTUDO_ISABEL.pctGlicolitica}%;
          a dos fosfagênios, por {ESTUDO_ISABEL.pctFosfagenios}%.
        </p>
        <p class="cx-formula">{`${ESTUDO_ISABEL.kJ} kJ = ${n(ISABEL.kcalTotal)} kcal em ${ESTUDO_ISABEL.segundos} s → ${n(ISABEL.kcalPorMinutoMedido)} kcal por minuto, medidos

  esta calculadora (${formataMet(MET_WOD)} METs), para ${n(ESTUDO_ISABEL.pesoMedio)} kg: ${n(ISABEL.kcalPorMinutoPelaConta)} kcal por minuto
  o gasto medido foi ${n(ISABEL.razao)} vezes a conta`}</p>
        <p>
          Por isso a calculadora avisa quando o WOD tem menos de 5 minutos: nesse caso, o número que
          ela devolve deve ser lido como piso, não como o gasto. O relógio, que estima pelo batimento,
          tem o mesmo ponto cego.
        </p>

        <h2>O que não está na calculadora</h2>
        <ul class="cx-sem-conferencia" aria-label="O que não conseguimos conferir">
          {SEM_CONFERENCIA.map((s) => <li>{s}</li>)}
        </ul>
        <p>
          O Compêndio não tem linha de crossfit. A linha mais próxima, de circuito vigoroso com pouco
          descanso, aparece como 7,5 METs e como 8,0 nas fontes que conseguimos consultar; sem
          resolver o conflito, ela ficou fora. E não conferimos medição de uma aula inteira, com
          aquecimento e técnica — por isso essa parte entra como repouso.
        </p>

        <h2>Quanto custa, por peso</h2>
        <div class="tabela-rolavel">
          <table>
            <caption>WOD de 20 minutos e aula de 1 hora com esse WOD</caption>
            <thead>
              <tr><th scope="col">Peso</th><th scope="col">WOD de 20 min</th><th scope="col">Aula de 1 hora</th></tr>
            </thead>
            <tbody>
              {TAB_PESO.map((l) => (
                <tr>
                  <th scope="row">{l.peso} kg</th>
                  <td>≈ {formataKcal(l.wod20)} kcal</td>
                  <td>≈ {formataKcal(l.aula60)} kcal</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>{NOTA_BRUTO}</p>

        <h2>Como esta conta é feita</h2>
        <p>
          A base é a equação de METs: <strong>kcal por minuto = MET × 3,5 × peso em kg ÷ 200</strong>,
          com o MET medido no Cindy aplicado aos minutos de WOD. O resto da aula entra com 1 MET, o
          repouso.
        </p>
        <p>
          Nenhum número desta página foi escrito à mão. Todos saem do mesmo motor que a calculadora
          usa, e os testes conferem as três coisas que seguram a página: que o Cindy fecha por
          dentro, que só o WOD roda na intensidade medida, e que o gasto medido no Isabel passa o que esta calculadora daria.
        </p>
        <p class="cx-revisao">
          Revisado em {formatDateLong(atualizadoEm)} por <a href="/montinho-personal/">Montinho</a>,
          personal trainer. {NOTA_NAO_PRESCRICAO}
        </p>

        <h2>Limitações desta estimativa</h2>
        <p>{NOTA_ESTIMATIVA}</p>
        <p>
          E a limitação de fonte, dita sem rodeio: a régua é um WOD de 9 praticantes, e o estudo do
          Isabel foi feito só com homens muito treinados. Não conferimos medição de WOD com carga
          pesada, de aula inteira nem de iniciantes.
        </p>
        <p>{NOTA_SEGURANCA}</p>
        <p>{NOTA_SEM_PERDA_LOCALIZADA}</p>

        <h2>Referências</h2>
        <ul class="cx-fontes">
          {FONTES.map((f) => (
            <li>
              <a href={f.url} target="_blank" rel="noopener noreferrer">{f.rotulo}</a> — {f.resumo}
            </li>
          ))}
        </ul>
      </div>

      <Faq faqs={faqs} titulo="Perguntas frequentes sobre calorias do crossfit" />

      <WhatsAppCta tema="emagrecimento" />
      <AutorMontinho />
      <RelatedArticles itens={relacionados} />
    </article>

    <Sidebar />
  </div>

  <script>
    import { iniciarCalculadoraCrossfit } from '../../scripts/caloriasCrossfit.client';
    import { tabelasRolaveis } from '../../scripts/tabelasRolaveis';
    iniciarCalculadoraCrossfit();
    tabelasRolaveis();
  </script>
  <style>
    .cx-hero {
      background: linear-gradient(160deg, var(--brand-700), var(--brand-800));
      color: #eceef2;
      padding-block: var(--sp-7);
      border-bottom: 4px solid var(--accent);
    }
    .cx-hero-inner { max-width: 780px; }
    .cx-hero h1 { color: #fff; max-width: 22ch; }
    .cx-hero :global(.eyebrow) { color: #ffb488; }
    .cx-hero-lead {
      margin-top: var(--sp-4);
      font-size: var(--step-1);
      line-height: 1.55;
      color: #d9dde3;
      max-width: 62ch;
    }
    .cx-hero-lead strong { color: #fff; }
    .cx-micro { margin-top: var(--sp-3); font-size: var(--step--1); color: #aab0ba; }

    .cx-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-6);
      padding-block: var(--sp-7);
    }
    @media (min-width: 980px) {
      .cx-layout { grid-template-columns: minmax(0, 1fr) 300px; gap: var(--sp-7); }
    }
    .cx-main { min-width: 0; max-width: 760px; }

    .cx-app {
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      padding: var(--sp-5);
      background: var(--surface);
      box-shadow: var(--shadow-sm);
    }
    .cx-app-h { font-size: var(--step-1); margin-bottom: var(--sp-4); }

    .cx-modos { display: flex; flex-wrap: wrap; gap: var(--sp-2); }
    .cx-modo {
      flex: 1 1 auto;
      min-height: 44px;
      padding: 0.55rem 0.9rem;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: transparent;
      color: var(--ink-soft);
      font: inherit;
      font-size: var(--step--1);
      font-weight: 600;
      cursor: pointer;
    }
    .cx-modo:hover { border-color: var(--brand-600); color: var(--ink); }
    .cx-modo.is-ativo { background: var(--brand-600); border-color: var(--brand-600); color: #fff; }
    .cx-modo:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }

    .cx-campos { display: grid; gap: var(--sp-4); }
    .cx-campo { margin-bottom: 0; }
    .cx-campo label,
    .cx-campo .cx-rotulo {
      display: block;
      font-weight: 700;
      font-size: var(--step--1);
      margin-bottom: 0.4rem;
