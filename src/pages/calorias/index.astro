---
/**
 * Hub do cluster "Calorias por atividade".
 *
 * POR QUE ESTE CLUSTER NÃO MORA EM /ferramentas/
 *
 * `/ferramentas/` é o Meu Mapa do Treino: sete etapas de uma jornada de
 * decisão sobre acompanhamento, com registro tipado em `lib/jornada.ts`,
 * faixa de progresso e um componente de convite preso a esses sete ids.
 * Calculadora de gasto calórico não é etapa dessa jornada — quem chega
 * perguntando "quantas calorias gastei" não está decidindo se contrata
 * personal. Misturar as duas coisas quebraria o modelo da jornada e
 * diluiria as duas propostas.
 *
 * Então o cluster nasce como irmão de /musculacao/ e /emagrecimento/: um
 * cluster editorial com ferramenta dentro, não uma gaveta de widgets.
 *
 * O hub lista só o que existe. Publicar o índice com doze linhas cinzas de
 * "em breve" não ajuda ninguém e ainda promete o que a página não entrega.
 */
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContextualCta from '../../components/ContextualCta.astro';
import { breadcrumbSchema, itemListSchema } from '../../lib/schema';
import { site } from '../../data/site';
import { porCategoria } from '../../data/ferramentas';
import { PESO_PADRAO, arredondaKcal, deTempo, ritmo } from '../../lib/calorias/caminhada';
import { deDistancia, formataFaixa } from '../../lib/calorias/corrida';
import { deTempoRua, arredondaKcal as arredondaBike, VELOCIDADE_PADRAO } from '../../lib/calorias/bicicleta';
import { deTempo as nadoPorTempo, arredondaKcal as arredondaNado } from '../../lib/calorias/natacao';
import { deAndares, formataKcal as formataEscada } from '../../lib/calorias/escada';
import { deTempo as cordaPorTempo, formataKcal as formataCorda } from '../../lib/calorias/corda';
import { deTempo as dancaPorTempo, formataKcal as formataDanca } from '../../lib/calorias/danca';
import { deTempo as yogaPorTempo, formataKcal as formataYoga } from '../../lib/calorias/yoga';
import { dePelada, formataKcal as formataFutebol, formataTempo as tempoFutebol } from '../../lib/calorias/futebol';
import { deRounds as lutaPorRounds, formataKcal as formataLuta } from '../../lib/calorias/lutas';
import { deAula as hidroPorAula, formataKcal as formataHidro } from '../../lib/calorias/hidroginastica';
import { deTempo as tenisPorTempo, formataKcal as formataTenis } from '../../lib/calorias/tenis';
import { deTempo as voleiPorTempo, formataKcal as formataVolei } from '../../lib/calorias/volei';
import { deAula as crossfitPorAula, formataKcal as formataCrossfit } from '../../lib/calorias/crossfit';
import { deProva as hyroxProva, formataKcal as formataHyrox } from '../../lib/calorias/hyrox';
import { deTempo as basquetePorTempo, formataKcal as formataBasquete } from '../../lib/calorias/basquete';
import { deTempo as pingPongPorTempo, formataKcal as formataPingPong } from '../../lib/calorias/pingpong';
import { deSessao as musculacaoSessao, formataKcal as formataMusculacao } from '../../lib/calorias/musculacao';

const path = '/calorias';
const crumbs = [
  { nome: 'Início', url: '/' },
  { nome: 'Calorias por atividade', url: path },
];

const MOD = ritmo('moderado');
const EX_30 = arredondaKcal(deTempo(30, PESO_PADRAO, MOD.velocidade, 0, MOD.cadencia).kcal);
const EX_5KM = formataFaixa(deDistancia(5, PESO_PADRAO, 6));
const EX_BIKE = arredondaBike(deTempoRua(60, PESO_PADRAO, VELOCIDADE_PADRAO).kcal);
const EX_NADO = arredondaNado(nadoPorTempo(60, PESO_PADRAO, 'crawl', 'medio').kcal);
const EX_ESCADA = formataEscada(deAndares(10, PESO_PADRAO).kcalSubida);
const EX_CORDA = formataCorda(cordaPorTempo(10, PESO_PADRAO, 'moderado').kcal);
const EX_DANCA = formataDanca(dancaPorTempo(45, PESO_PADRAO, 'zumba').kcal);
const EX_YOGA = formataYoga(yogaPorTempo(60, PESO_PADRAO, 'hatha').kcal);
const PELADA = dePelada(120, PESO_PADRAO, 'society', 21, 'casual');
const EX_LUTA = formataLuta(lutaPorRounds(6, 3, 1, PESO_PADRAO, 'saco').kcal);
const EX_HIDRO = formataHidro(hidroPorAula(50, PESO_PADRAO, 'medida').kcal);
const EX_TENIS = formataTenis(tenisPorTempo(60, PESO_PADRAO, 'simples').kcalMin);
const EX_VOLEI_PRAIA = formataVolei(voleiPorTempo(60, PESO_PADRAO, 'praia').kcal);
const EX_VOLEI_LAZER = formataVolei(voleiPorTempo(60, PESO_PADRAO, 'recreativo').kcal);
const EX_CROSSFIT = formataCrossfit(crossfitPorAula(60, 20, PESO_PADRAO).kcal);
const HYROX = hyroxProva(90, 6, PESO_PADRAO);
const EX_HYROX = HYROX.ok ? formataHyrox(HYROX.kcal) : '—';
const EX_BASQUETE = formataBasquete(basquetePorTempo(60, PESO_PADRAO, 'jogo').kcalMin);
const EX_PINGPONG = formataPingPong(pingPongPorTempo(60, PESO_PADRAO, 'jogo').kcalMin);
const EX_MUSCULACAO = formataMusculacao(musculacaoSessao(60, PESO_PADRAO, 'variado').kcal);

/*
 * Nome, URL e resumo vêm do catálogo central (src/data/ferramentas.ts):
 * é lá que uma calculadora nova entra. Aqui fica só o exemplo resolvido
 * pelo motor de cada uma — o que este hub tem e a Central não precisa.
 */
const EXEMPLOS: Record<string, string> = {
  caminhada: `30 min moderados ≈ ${EX_30} kcal para ${PESO_PADRAO} kg`,
  corrida: `5 km a 6:00/km ≈ ${EX_5KM} para ${PESO_PADRAO} kg`,
  bicicleta: `1 hora a ${VELOCIDADE_PADRAO} km/h ≈ ${EX_BIKE} kcal para ${PESO_PADRAO} kg`,
  natacao: `1 hora de crawl médio ≈ ${EX_NADO} kcal para ${PESO_PADRAO} kg`,
  escada: `10 andares ≈ ${EX_ESCADA} kcal líquidas para ${PESO_PADRAO} kg`,
  corda: `10 min em ritmo moderado ≈ ${EX_CORDA} kcal para ${PESO_PADRAO} kg`,
  danca: `45 min de Zumba ≈ ${EX_DANCA} kcal para ${PESO_PADRAO} kg`,
  'yoga-e-pilates': `1 hora de hatha ≈ ${EX_YOGA} kcal para ${PESO_PADRAO} kg`,
  futebol: `2 horas de society com 21 pessoas = ${tempoFutebol(PELADA.minutosEmCampo)} em campo ≈ ${formataFutebol(PELADA.kcal)} kcal`,
  lutas: `6 rounds de 3 min no saco ≈ ${EX_LUTA} kcal para ${PESO_PADRAO} kg`,
  hidroginastica: `Uma aula de 50 min ≈ ${EX_HIDRO} kcal para ${PESO_PADRAO} kg`,
  tenis: `1 hora de simples ≈ ${EX_TENIS} kcal para ${PESO_PADRAO} kg`,
  volei: `1 hora: ≈ ${EX_VOLEI_LAZER} kcal no ginásio sem disputa, ≈ ${EX_VOLEI_PRAIA} na areia, para ${PESO_PADRAO} kg`,
  crossfit: `Aula de 1 hora com 20 min de WOD ≈ ${EX_CROSSFIT} kcal para ${PESO_PADRAO} kg`,
  hyrox: `Prova de 1h30 com pace de 6:00 ≈ ${EX_HYROX} kcal para ${PESO_PADRAO} kg`,
  basquete: `1 hora de jogo ≈ ${EX_BASQUETE} kcal para ${PESO_PADRAO} kg`,
  'ping-pong': `1 hora de jogo de lazer ≈ ${EX_PINGPONG} kcal para ${PESO_PADRAO} kg`,
  musculacao: `1 hora de treino variado ≈ ${EX_MUSCULACAO} kcal para ${PESO_PADRAO} kg`,
};

const ferramentas = porCategoria('calorias').map((f) => ({
  url: f.url,
  nome: f.nomeCurto,
  calcula: f.resumo,
  exemplo: EXEMPLOS[f.slug] ?? '',
}));

/* 47 caracteres. */
const title = 'Quantas Calorias Cada Atividade Gasta | Calcule';
/* 150 caracteres. */
const description =
  'Calculadoras de gasto calórico por atividade, feitas uma a uma com os dados que você realmente tem. Metodologia aberta, fontes citadas e sem cadastro.';

const schema = [
  breadcrumbSchema(crumbs),
  itemListSchema(
    'Calculadoras de calorias por atividade',
    ferramentas.map((f) => f.nome),
    new URL(path, site.dominio).href,
    /*
     * As URLs reais de cada ferramenta. Sem elas, o ItemList apontava os
     * itens para âncoras deste hub (/calorias/#futebol…) que não existem na
     * página — o schema descrevia uma lista de links para lugar nenhum.
     */
    ferramentas.map((f) => new URL(f.url, site.dominio).href),
  ),
];
---

<Base title={title} description={description} path={path} schema={schema}>
  <Breadcrumbs crumbs={crumbs} />

  <header class="section-sm tint">
    <div class="container">
      <p class="eyebrow">Ferramentas do portal</p>
      <h1>Quantas calorias cada atividade gasta</h1>
      <p class="lead" style="max-width: 62ch">
        Uma calculadora por atividade, feita com as informações que quem pratica aquela atividade
        realmente tem — e não a mesma caixa de peso e minutos com o nome trocado.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container container-narrow">
      <div class="grid grid-2">
        {
          ferramentas.map((f) => (
            <a class="card card-hover cal-card" href={f.url}>
              <h2>{f.nome}</h2>
              <p>{f.calcula}</p>
              <p class="cal-exemplo">{f.exemplo}</p>
              <span class="cal-link">Calcular →</span>
            </a>
          ))
        }
      </div>

      <div class="cal-nota">
        <h2>Como estas calculadoras são feitas</h2>
        <p>
          Cada atividade ganha a sua, e cada uma pede entradas diferentes porque as pessoas sabem
          coisas diferentes. Quem caminhou sabe o tempo, a distância ou os passos. Quem corre sabe o
          pace. Quem pedala sabe a velocidade média. Uma caixa única de &ldquo;peso + minutos&rdquo;
          obrigaria quase todo mundo a fazer uma conversão de cabeça antes de usar a ferramenta.
        </p>
        <p>
          Três compromissos valem para todas. <strong>A metodologia fica aberta</strong>, com a
          fórmula visível e a fonte de cada número citada. <strong>Onde a conta é imprecisa, a
          página diz</strong> — inclusive quando o valor foi interpolado em vez de medido.
          E <strong>nenhuma delas promete quilo perdido</strong>: gasto calórico é uma estimativa
          educativa, não avaliação metabólica nem prescrição de treino.
        </p>
        <p class="muted">
          O cluster cresce por demanda real, uma atividade por vez.
          Publicar doze páginas rasas de uma vez seria mais rápido e pior.
        </p>
      </div>

      <div class="cal-relacionado">
        <h2>Conteúdos que explicam o resto da conta</h2>
        <ul>
          <li>
            <a href="/emagrecimento/deficit-calorico-como-funciona/">Déficit calórico: como funciona</a>
            — onde o gasto do exercício entra, e por que ele é a menor peça.
          </li>
          <li>
            <a href="/emagrecimento/quantos-passos-por-dia/">Quantos passos por dia para emagrecer</a>
            — de onde veio a meta dos 10 mil.
          </li>
          <li>
            <a href="/emagrecimento/musculacao-ou-cardio-para-emagrecer/">Musculação ou cardio para emagrecer</a>
            — por que &ldquo;qual gasta mais&rdquo; é a pergunta errada.
          </li>
          <li>
            <a href="/ferramentas/">Todas as ferramentas do portal</a> — treino, personal trainer e
            calorias, com busca por dúvida. É outro caminho, para outra pergunta.
          </li>
        </ul>
      </div>

      <ContextualCta path={path} assunto={title} />
    </div>
  </section>
</Base>

<style>
  .cal-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--ink);
  }
  .cal-card:hover { text-decoration: none; }
  .cal-card h2 { font-size: var(--step-2); }
  .cal-card p { color: var(--ink-soft); }
  .cal-exemplo {
    font-size: var(--step--1);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .cal-link { font-weight: 700; color: var(--brand-600); margin-top: auto; }
  .cal-nota { margin-top: var(--sp-7); }
  .cal-nota h2,
  .cal-relacionado h2 { font-size: var(--step-2); margin-bottom: var(--sp-3); }
  .cal-nota p { margin-bottom: var(--sp-3); line-height: 1.6; }
  .cal-relacionado { margin-top: var(--sp-6); }
  .cal-relacionado ul { display: grid; gap: var(--sp-3); }
  .cal-relacionado li { line-height: 1.55; }
</style>
