---
/**
 * Quantas calorias gasta jogar vôlei — página e calculadora.
 *
 * O RECORTE, DECLARADO CONTRA AS OUTRAS TREZE
 *
 * Aqui o que decide é o chão. As quatro linhas do Compêndio vão de 3,0
 * (vôlei de ginásio sem competição — o mesmo da caminhada leve) a 8,0
 * (vôlei de praia, na areia). A página abre com essa comparação.
 *
 * O QUE NÃO TEM
 *
 * Conferência contra medição em jogo. Não conseguimos conferir números de
 * gasto medido em partida de vôlei, e a página diz isso em vez de
 * pendurar a tabela num estudo que não lemos.
 */
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import Sidebar from '../../components/Sidebar.astro';
import AutorMontinho from '../../components/AutorMontinho.astro';
import WhatsAppCta from '../../components/WhatsAppCta.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import { breadcrumbSchema, articleSchema, faqSchema, personMontinhoSchema } from '../../lib/schema';
import { formatDateLong } from '../../lib/slug';
import { site } from '../../data/site';
import {
  FONTES,
  MINUTOS_PADRAO,
  MODALIDADES,
  NOTA_AREIA,
  NOTA_BRUTO,
  NOTA_ESTIMATIVA,
  NOTA_NAO_PRESCRICAO,
  NOTA_SEGURANCA,
  NOTA_SEM_MEDICAO,
  NOTA_SEM_PERDA_LOCALIZADA,
  PESO_PADRAO,
  SEM_CONFERENCIA,
  deTempo,
  formataKcal,
  formataMet,
  formataTempo,
  metCaminhadaLeve,
  metVolei,
  modalidade,
  praiaSobreRecreativo,
  simulacaoUmQuilo,
  tabelaPorPeso,
} from '../../lib/calorias/volei';

const path = '/calorias/volei';
const atualizadoEm = '2026-09-23';

const crumbs = [
  { nome: 'Início', url: '/' },
  { nome: 'Calorias por atividade', url: '/calorias/' },
  { nome: 'Vôlei', url: path },
];

/* ── Exemplos resolvidos no servidor, pelo mesmo motor da calculadora ── */
const EX = Object.fromEntries(MODALIDADES.map((m) => [m.id, deTempo(60, PESO_PADRAO, m.id)]));
const UM_QUILO = simulacaoUmQuilo(PESO_PADRAO, 'geral');
const TAB_PESO = tabelaPorPeso();
const VEZES = praiaSobreRecreativo();

const n = (v: number, d = 1) => v.toLocaleString('pt-BR', { maximumFractionDigits: d });

/* 50 caracteres. */
const title = 'Quantas Calorias Gasta Jogar Vôlei? Quadra e Praia';
/* 155 caracteres. */
const description =
  'Calcule as calorias do vôlei de quadra e de praia. Na tabela, uma hora na areia gasta quase o triplo do vôlei de lazer no ginásio, que empata com caminhar.';

const faqs = [
  {
    pergunta: 'Quantas calorias gasta 1 hora de vôlei?',
    resposta: `Depende muito de onde e de como. Para ${PESO_PADRAO} kg, cerca de ${formataKcal(EX.recreativo.kcal)} kcal numa hora de vôlei de ginásio sem competição, ${formataKcal(EX.geral.kcal)} pela linha geral, ${formataKcal(EX.competitivo.kcal)} em jogo competitivo e ${formataKcal(EX.praia.kcal)} no vôlei de praia.`,
  },
  {
    pergunta: 'Vôlei de praia gasta mais que vôlei de quadra?',
    resposta: `Pela tabela, bem mais: ${formataMet(metVolei('praia'))} METs na areia contra ${formataMet(metVolei('recreativo'))} no ginásio sem competição — ${n(VEZES)} vezes. O Compêndio tem uma linha só para a areia, sem separar o jogo de lazer do jogo valendo, e é ela que a calculadora usa.`,
  },
  {
    pergunta: 'Vôlei recreativo gasta o mesmo que caminhar?',
    resposta: `Na tabela, sim. Vôlei de ginásio sem competição e caminhada leve têm o mesmo valor, ${formataMet(metCaminhadaLeve())} METs: cerca de ${formataKcal(EX.recreativo.kcal)} kcal por hora para ${PESO_PADRAO} kg. O que faz o vôlei gastar mais é competir ou ir para a areia.`,
  },
  {
    pergunta: 'Jogar vôlei emagrece?',
    resposta: `Aumenta o gasto do dia, e uma partida semanal de verdade conta. Mas nenhum exercício emagrece sozinho: quem decide é o balanço entre o que entra e o que sai ao longo de semanas.`,
  },
  {
    pergunta: 'Quanto tempo de vôlei para perder 1 kg de gordura?',
    resposta: `Cerca de ${formataTempo(UM_QUILO.minutos)} de vôlei pela linha geral, para ${PESO_PADRAO} kg. Mesmo essa conta é otimista, porque usa a regra dos 7.700 kcal por quilo, que superestima a perda ao longo do tempo.`,
  },
];

const relacionados = [
  {
    url: '/calorias/caminhada/',
    titulo: 'Quantas calorias a caminhada gasta?',
    descricao: 'A atividade que empata, na tabela, com o vôlei de ginásio sem competição.',
    tipo: 'Calorias',
  },
  {
    url: '/calorias/tenis/',
    titulo: 'Quantas calorias gasta jogar tênis?',
    descricao: 'O outro esporte de rede — e por que lá a pausa entre pontos não se desconta.',
    tipo: 'Calorias',
  },
  {
    url: '/musculacao/treino-de-ombro/',
    titulo: 'Treino de ombro',
    descricao: 'A articulação que trabalha acima da cabeça a cada ataque e bloqueio.',
    tipo: 'Musculação',
  },
  {
    url: '/emagrecimento/deficit-calorico-como-funciona/',
    titulo: 'Déficit calórico: como funciona',
    descricao: `Onde as ${formataKcal(EX.praia.kcal)} kcal de uma hora de vôlei de praia entram na conta.`,
    tipo: 'Emagrecimento',
  },
];

const schema = [
  breadcrumbSchema(crumbs),
  articleSchema({ titulo: title, descricao: description, url: new URL(path, site.dominio).href, atualizadoEm }),
  faqSchema(faqs),
  personMontinhoSchema(),
];
---

<Base title={title} description={description} path={path} ogType="article" schema={schema}>
  <Breadcrumbs crumbs={crumbs} />

  <header class="cv-hero">
    <div class="container cv-hero-inner">
      <p class="eyebrow">Calorias por atividade</p>
      <h1>Quantas calorias gasta jogar vôlei?</h1>
      <p class="cv-hero-lead">
        Uma hora de vôlei de ginásio sem competição gasta cerca de{' '}
        <strong>{formataKcal(EX.recreativo.kcal)} kcal</strong> para {PESO_PADRAO} kg — o mesmo que
        uma caminhada leve. Na areia, a mesma hora vai a{' '}
        <strong>{formataKcal(EX.praia.kcal)} kcal</strong>. No vôlei, o que mais pesa na conta é o
        chão.
      </p>
      <p class="cv-micro">Grátis · sem cadastro · a conta acontece no seu navegador</p>
    </div>
  </header>

  <div class="container cv-layout">
    <article class="cv-main">
      <section id="cv-app" class="cv-app" aria-labelledby="cv-app-h">
        <h2 id="cv-app-h" class="cv-app-h">Calculadora de calorias do vôlei</h2>

        <div class="cv-campos">
          <div class="cv-campo">
            <label for="cv-peso">Seu peso (kg)</label>
            <input id="cv-peso" type="text" inputmode="decimal" autocomplete="off" value={PESO_PADRAO} />
          </div>

          <div class="cv-campo">
            <span class="cv-rotulo">Onde e como você jogou</span>
            <div class="cv-presets cv-presets-sem-rotulo" role="group" aria-label="Modalidade">
              {MODALIDADES.map((m) => (
                <button
                  type="button"
                  class:list={['cv-preset', 'cv-modalidade', m.id === 'geral' && 'is-ativo']}
                  data-modalidade={m.id}
                  aria-pressed={String(m.id === 'geral')}
                >
                  {m.nomeCurto}
                </button>
              ))}
            </div>
            <p class="cv-dica cv-modalidade-slot" id="cv-modalidade-dica">
              {formataMet(modalidade('geral').met)} METs — Compêndio, código {modalidade('geral').codigo}.{' '}
              {modalidade('geral').comoReconhecer}
            </p>
          </div>

          <!-- As abas ficam logo acima dos campos que trocam, como nas lutas. -->
          <div class="cv-modos" role="tablist" aria-label="Como você quer contar">
            <button type="button" class="cv-modo is-ativo" data-modo="tempo" role="tab" aria-selected="true">
              Tempo de jogo
            </button>
            <button type="button" class="cv-modo" data-modo="meta" role="tab" aria-selected="false" tabindex="-1">
              Tenho uma meta
            </button>
          </div>

          <div class="cv-campo cv-campo-modo">
            <label for="cv-minutos">Minutos de jogo</label>
            <input id="cv-minutos" type="text" inputmode="numeric" autocomplete="off" value={MINUTOS_PADRAO} />
            <div class="cv-presets">
              {[30, 60, 90, 120].map((v) => (
                <button type="button" class="cv-preset" data-alvo="tempo" data-valor={String(v)}>
                  {formataTempo(v)}
                </button>
              ))}
            </div>
          </div>

          <div class="cv-campo cv-campo-modo" hidden>
            <label for="cv-meta">Meta de gasto (kcal)</label>
            <input id="cv-meta" type="text" inputmode="numeric" autocomplete="off" value="400" />
            <div class="cv-presets">
              {[200, 400, 600, 800].map((v) => (
                <button type="button" class="cv-preset" data-alvo="meta" data-valor={String(v)}>
                  {v.toLocaleString('pt-BR')} kcal
                </button>
              ))}
            </div>
          </div>
        </div>

        <p id="cv-erro" class="cv-erro" role="status" hidden></p>

        <div id="cv-saida" class="cv-saida" role="status" aria-live="polite">
          <p class="cv-resultado">
            <span class="cv-numero">≈ {formataKcal(EX.geral.kcal)}</span>
            <span class="cv-unidade">kcal</span>
          </p>
          <p class="cv-frase"></p>

          <dl class="cv-detalhes">
            <div><dt>Tempo de jogo</dt><dd class="cv-d-tempo">—</dd></div>
            <div><dt>Acréscimo real ao dia</dt><dd class="cv-d-liquido">—</dd></div>
            <div><dt>Intensidade</dt><dd><span class="cv-d-met">—</span> METs</dd></div>
            <div><dt>De onde vem o número</dt><dd class="cv-d-fonte">—</dd></div>
          </dl>

          <p class="cv-nota cv-nota-areia" hidden></p>
          <p class="cv-nota">{NOTA_ESTIMATIVA}</p>

          <div class="cv-proximo">
            <p class="cv-proximo-lead">
              Esse número responde <em>quanto você gastou</em> no jogo. Ele não diz se o corpo aguenta
              o jogo: salto, aterrissagem e ataque acima da cabeça pedem perna, tronco e ombro que a
              quadra não treina sozinha. <strong>Força durante a semana é o que deixa o vôlei do fim
              de semana continuar existindo.</strong>
            </p>
            <div class="cv-proximo-acoes">
              <a class="cv-btn cv-btn-primario" href="/personal-trainer/" data-track="calorias:cta-local">
                Encontrar personal na minha cidade
              </a>
              <a
                class="cv-btn cv-btn-secundario cv-whats"
                href="https://wa.me/"
                target="_blank"
                rel="noopener"
                data-track="calorias:cta-whatsapp"
              >
                Falar com o Montinho sobre acompanhamento online
              </a>
            </div>
            <p class="cv-proximo-nota">
              O Personal por Perto é um portal editorial. O diretório de cidades é gratuito; o
              Montinho Personal é o profissional que assina o conteúdo do portal e atende online
              para todo o Brasil.
            </p>
          </div>
        </div>
      </section>

      <div class="prose cv-conteudo">
        <h2>No vôlei, o chão decide</h2>
        <p>
          O vôlei tem quatro linhas no Compêndio de Atividades Físicas de 2024, e elas vão de{' '}
          {formataMet(metVolei('recreativo'))} a {formataMet(metVolei('praia'))} METs. Nenhuma outra
          escolha que você faz no jogo mexe tanto na conta quanto sair do ginásio e ir para a areia.
        </p>
        <div class="tabela-rolavel">
          <table>
            <caption>Uma hora de jogo, {PESO_PADRAO} kg</caption>
            <thead>
              <tr><th scope="col">Modalidade</th><th scope="col">METs</th><th scope="col">Código</th><th scope="col">Gasto</th></tr>
            </thead>
            <tbody>
              {MODALIDADES.map((m) => (
                <tr>
                  <th scope="row">{m.nome}</th>
                  <td>{formataMet(m.met)}</td>
                  <td>{m.codigo}</td>
                  <td>≈ {formataKcal(EX[m.id].kcal)} kcal</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>{NOTA_AREIA}</p>

        <h2>O vôlei que empata com caminhar</h2>
        <p>
          A linha mais baixa — vôlei de ginásio sem competição, time de 6 a 9 pessoas — tem o mesmo
          valor que a nossa <a href="/calorias/caminhada/">calculadora de caminhada</a> usa para a
          caminhada leve: {formataMet(metCaminhadaLeve())} METs. Uma hora de um ou de outro dá cerca
          de {formataKcal(EX.recreativo.kcal)} kcal para {PESO_PADRAO} kg.
        </p>
        <p>
          Isso não diminui o jogo: vôlei de lazer tem salto, reflexo e convivência que a caminhada não
          tem. Mas se a ideia é gastar mais, o que muda a conta é competir ({formataMet(metVolei('competitivo'))}{' '}
          METs) ou ir para a areia ({formataMet(metVolei('praia'))}).
        </p>

        <h2>Sem medição em jogo, e por quê</h2>
        <p>{NOTA_SEM_MEDICAO}</p>
        <ul class="cv-sem-conferencia" aria-label="O que não conseguimos conferir">
          {SEM_CONFERENCIA.map((s) => <li>{s}</li>)}
        </ul>

        <h2>Quanto custa, por peso</h2>
        <div class="tabela-rolavel">
          <table>
            <caption>Uma hora de jogo</caption>
            <thead>
              <tr>
                <th scope="col">Peso</th>
                <th scope="col">Quadra, lazer</th>
                <th scope="col">Quadra, competitivo</th>
                <th scope="col">Praia</th>
              </tr>
            </thead>
            <tbody>
              {TAB_PESO.map((l) => (
                <tr>
                  <th scope="row">{l.peso} kg</th>
                  <td>≈ {formataKcal(l.recreativo)} kcal</td>
                  <td>≈ {formataKcal(l.competitivo)} kcal</td>
                  <td>≈ {formataKcal(l.praia)} kcal</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>{NOTA_BRUTO}</p>

        <h2>Como esta conta é feita</h2>
        <p>
          A base é a equação de METs: <strong>kcal por minuto = MET × 3,5 × peso em kg ÷ 200</strong>,
          aplicada ao tempo de jogo. Os METs vêm do Compêndio de Atividades Físicas de 2024, com o
          código na tabela acima.
        </p>
        <p class="cv-formula">{`1 hora de vôlei de praia, ${PESO_PADRAO} kg
  ${formataMet(metVolei('praia'))} × 3,5 × ${PESO_PADRAO} ÷ 200 = ${n(EX.praia.kcal / 60, 2)} kcal por minuto
  ${n(EX.praia.kcal / 60, 2)} × 60 = ${n(EX.praia.kcal, 0)} kcal`}</p>
        <p>
          Nenhum número desta página foi escrito à mão. Todos saem do mesmo motor que a calculadora
          usa — inclusive a comparação com a caminhada, que o teste lê do motor da caminhada em vez
          de repetir o número.
        </p>
        <p class="cv-revisao">
          Revisado em {formatDateLong(atualizadoEm)} por <a href="/montinho-personal/">Montinho</a>,
          personal trainer. {NOTA_NAO_PRESCRICAO}
        </p>

        <h2>Limitações desta estimativa</h2>
        <p>{NOTA_ESTIMATIVA}</p>
        <p>{NOTA_SEGURANCA}</p>
        <p>{NOTA_SEM_PERDA_LOCALIZADA}</p>

        <h2>Referências</h2>
        <ul class="cv-fontes">
          {FONTES.map((f) => (
            <li>
              <a href={f.url} target="_blank" rel="noopener noreferrer">{f.rotulo}</a> — {f.resumo}
            </li>
          ))}
        </ul>
      </div>

      <Faq faqs={faqs} titulo="Perguntas frequentes sobre calorias do vôlei" />

      <WhatsAppCta tema="emagrecimento" />
      <AutorMontinho />
      <RelatedArticles itens={relacionados} />
    </article>

    <Sidebar />
  </div>

  <script>
    import { iniciarCalculadoraVolei } from '../../scripts/caloriasVolei.client';
    import { tabelasRolaveis } from '../../scripts/tabelasRolaveis';
    iniciarCalculadoraVolei();
    tabelasRolaveis();
  </script>
  <style>
    .cv-hero {
      background: linear-gradient(160deg, var(--brand-700), var(--brand-800));
      color: #eceef2;
      padding-block: var(--sp-7);
      border-bottom: 4px solid var(--accent);
    }
    .cv-hero-inner { max-width: 780px; }
    .cv-hero h1 { color: #fff; max-width: 22ch; }
    .cv-hero :global(.eyebrow) { color: #ffb488; }
    .cv-hero-lead {
      margin-top: var(--sp-4);
      font-size: var(--step-1);
      line-height: 1.55;
      color: #d9dde3;
      max-width: 62ch;
    }
    .cv-hero-lead strong { color: #fff; }
    .cv-micro { margin-top: var(--sp-3); font-size: var(--step--1); color: #aab0ba; }

    .cv-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-6);
      padding-block: var(--sp-7);
    }
    @media (min-width: 980px) {
      .cv-layout { grid-template-columns: minmax(0, 1fr) 300px; gap: var(--sp-7); }
    }
    .cv-main { min-width: 0; max-width: 760px; }

    .cv-app {
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      padding: var(--sp-5);
      background: var(--surface);
      box-shadow: var(--shadow-sm);
    }
    .cv-app-h { font-size: var(--step-1); margin-bottom: var(--sp-4); }

    .cv-modos { display: flex; flex-wrap: wrap; gap: var(--sp-2); }
    .cv-modo {
      flex: 1 1 auto;
      min-height: 44px;
      padding: 0.55rem 0.9rem;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: transparent;
      color: var(--ink-soft);
      font: inherit;
      font-size: var(--step--1);
      font-weight: 600;
      cursor: pointer;
    }
    .cv-modo:hover { border-color: var(--brand-600); color: var(--ink); }
    .cv-modo.is-ativo { background: var(--brand-600); border-color: var(--brand-600); color: #fff; }
    .cv-modo:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }

    .cv-campos { display: grid; gap: var(--sp-4); }
    .cv-campo { margin-bottom: 0; }
    .cv-campo label,
    .cv-campo .cv-rotulo {
      display: block;
      font-weight: 700;
      font-size: var(--step--1);
      margin-bottom: 0.4rem;
    }
    .cv-campo input[type='text'] {
      width: 100%;
      min-height: 48px;
      padding: 0.6rem 0.8rem;
      font: inherit;
      font-size: var(--step-1);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--bg);
      color: var(--ink);
    }
    .cv-campo input:focus-visible { outline: 3px solid var(--accent); outline-offset: 1px; }

    .cv-dica { margin-top: 0.5rem; font-size: var(--step--1); color: var(--muted); line-height: 1.5; }
    /* Primeira pintura; o reservaAltura corrige para a largura real. */
    .cv-modalidade-slot { min-height: 3em; line-height: 1.5; }
    .cv-sem-conferencia {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      list-style: none;
      padding: 0;
      margin: var(--sp-4) 0;
    }
    .cv-sem-conferencia li {
      padding: 0.3rem 0.7rem;
      border: 1px dashed var(--line);
      border-radius: 999px;
      font-size: var(--step--1);
      color: var(--muted);
    }

    .cv-presets { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.5rem; }
    .cv-presets-sem-rotulo { margin-top: 0; }
    .cv-preset {
      min-height: 40px;
      padding: 0.35rem 0.7rem;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: transparent;
      color: var(--ink-soft);
      font: inherit;
      font-size: var(--step--1);
      cursor: pointer;
    }
    .cv-preset:hover { border-color: var(--brand-600); color: var(--brand-600); }
    .cv-preset:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
    .cv-modalidade.is-ativo { background: var(--brand-600); border-color: var(--brand-600); color: #fff; }

    .cv-erro {
      margin-top: var(--sp-4);
      padding: 0.7rem 0.9rem;
      border-left: 3px solid #c0392b;
      background: rgba(192, 57, 43, 0.08);
      font-size: var(--step--1);
    }

    .cv-saida { margin-top: var(--sp-5); border-top: 1px solid var(--line); padding-top: var(--sp-5); }
    .cv-resultado { display: flex; align-items: baseline; gap: 0.4rem; flex-wrap: wrap; }
    .cv-numero {
      font-size: clamp(2.2rem, 8vw, 3.2rem);
      font-weight: 800;
      line-height: 1;
      color: var(--brand-600);
      font-variant-numeric: tabular-nums;
    }
    .cv-unidade { font-size: var(--step-1); font-weight: 700; color: var(--ink-soft); }
    .cv-frase { margin-top: var(--sp-3); color: var(--ink-soft); line-height: 1.55; }

    .cv-detalhes {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: var(--sp-3);
      margin-top: var(--sp-4);
      padding: var(--sp-4);
      border-radius: var(--radius);
      background: var(--bg);
    }
    .cv-detalhes dt { font-size: var(--step--1); color: var(--muted); }
    .cv-detalhes dd { margin: 0.15rem 0 0; font-weight: 700; font-variant-numeric: tabular-nums; }

