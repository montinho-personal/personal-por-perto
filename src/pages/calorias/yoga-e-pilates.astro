---
/**
 * Quantas calorias yoga e pilates gastam — página e calculadora.
 *
 * O RECORTE, DECLARADO CONTRA AS OUTRAS SETE
 *
 * As sete anteriores discutem tabela e física: qual MET, qual trabalho
 * mecânico, qual variável decide. Esta discute o INSTRUMENTO — por que o
 * relógio de quem pergunta está errado justamente aqui.
 *
 * Relógio e aplicativo estimam caloria a partir da frequência cardíaca, com
 * equações feitas para exercício em temperatura normal. Quem mediu o Bikram
 * na Colorado State atribui a isso os números inflados de hot yoga.
 *
 * Por isso existe aqui um modo que nenhuma outra calculadora tem: a pessoa
 * informa o número que o relógio mostrou e a ferramenta compara.
 *
 * O QUE ESTÁ MEDIDO, E O QUE É EXPLICAÇÃO
 *
 * Lambert et al. (Houston Methodist) compararam, nos mesmos 16 praticantes,
 * a mesma sequência a 40 °C e a 23 °C: 156 contra 151 kcal, dentro do erro.
 * E a frequência cardíaca média também não diferiu — por isso a página
 * apresenta o mecanismo do relógio como explicação de pesquisador, não como
 * fato medido. A primeira versão não fazia essa distinção; a auditoria de
 * 23/09/2026 corrigiu isso, a autoria da citação e o peso dos participantes.
 *
 * E É A PRIMEIRA PÁGINA EM QUE A RESPOSTA HONESTA É "POUCO"
 *
 * A escada inteira do yoga vai de 2,3 a 4,0 METs. Uma hora de hatha para 70
 * kg dá 184 kcal, e dois quintos disso é o metabolismo de repouso. A página
 * não esconde isso nem pede desculpas: yoga e pilates treinam mobilidade,
 * core e equilíbrio. Caloria não é o produto deles.
 */
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import Sidebar from '../../components/Sidebar.astro';
import AutorMontinho from '../../components/AutorMontinho.astro';
import WhatsAppCta from '../../components/WhatsAppCta.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import { breadcrumbSchema, articleSchema, faqSchema, personMontinhoSchema } from '../../lib/schema';
import { formatDateLong } from '../../lib/slug';
import { site } from '../../data/site';
import {
  ESTILOS,
  ESTUDO_BIKRAM,
  ESTUDO_CALOR,
  FONTES,
  MINUTOS_ESTUDO,
  MINUTOS_PADRAO,
  NOTA_BRUTO,
  NOTA_CALOR_NAO_MUDA,
  NOTA_ESCADA_CURTA,
  NOTA_ESTIMATIVA,
  NOTA_NAO_E_O_PONTO,
  NOTA_NAO_PRESCRICAO,
  NOTA_RELOGIO_CALOR,
  NOTA_SEGURANCA,
  NOTA_SEM_PERDA_LOCALIZADA,
  PESO_ESTUDO,
  PESO_PADRAO,
  RELOGIO_PADRAO,
  amplitudeDaEscada,
  arredondaKcal,
  deKcal,
  deRelogio,
  deTempo,
  efeitoDoCalor,
  estilo,
  formataKcal,
  formataTempo,
  kcalPorMinuto,
  metYoga,
  reproduzCalor,
  reproduzEstudo,
  simulacaoUmQuilo,
  tabelaPorEstilo,
  tabelaPorPeso,
  tabelaPorTempo,
} from '../../lib/calorias/yoga';
import { deTempo as caminhadaTempo, ritmo as ritmoCaminhada } from '../../lib/calorias/caminhada';
import { ESTUDO_ZUMBA } from '../../lib/calorias/danca';
import { metRua } from '../../lib/calorias/bicicleta';

const path = '/calorias/yoga-e-pilates';
const atualizadoEm = '2026-09-23';

const crumbs = [
  { nome: 'Início', url: '/' },
  { nome: 'Calorias por atividade', url: '/calorias/' },
  { nome: 'Yoga e pilates', url: path },
];

/* ── Exemplos resolvidos no servidor, pelo mesmo motor da calculadora ── */
const EX_HATHA = deTempo(60, PESO_PADRAO, 'hatha');
const EX_HOT = deTempo(60, PESO_PADRAO, 'hot');
const EX_PILATES = deTempo(60, PESO_PADRAO, 'pilates');
const EX_VINYASA = deTempo(60, PESO_PADRAO, 'vinyasa');
const EX_POWER = deTempo(60, PESO_PADRAO, 'power');
const EX_GERAL = deTempo(60, PESO_PADRAO, 'geral');
const EX_RELOGIO = deRelogio(RELOGIO_PADRAO, 60, PESO_PADRAO, 'hot');
const UM_QUILO = simulacaoUmQuilo(PESO_PADRAO, 'hatha');

const TAB_ESTILO = tabelaPorEstilo(PESO_PADRAO);
const TAB_PESO = tabelaPorPeso(60, 'hatha');
const TAB_TEMPO = tabelaPorTempo(PESO_PADRAO, 'hatha');

/* A conferência contra a medição direta, calculada e não escrita à mão. */
const ESTUDO = reproduzEstudo();
const CALOR = reproduzCalor();
const EFEITO_CALOR = efeitoDoCalor();
const AMPLITUDE = amplitudeDaEscada();

/* O que a internet publica para vinyasa, e o que isso implicaria. */
const PUBLICADO_VINYASA = 550;
const MET_PUBLICADO = PUBLICADO_VINYASA / ((3.5 * PESO_PADRAO) / 200) / 60;
const INFLACAO_VINYASA = MET_PUBLICADO / metYoga('vinyasa');

/*
 * O número que circula para pilates vem de aula AVANÇADA, calculado para
 * 68 kg — e a página diz isso, em vez de compará-lo com o pilates geral
 * como se fosse a mesma aula. O Compêndio não separa níveis.
 */
const PUBLICADO_PILATES = 492;
const PESO_PUBLICADO_PILATES = 68;
const MET_PILATES_PUBLICADO = PUBLICADO_PILATES / ((3.5 * PESO_PUBLICADO_PILATES) / 200) / 60;

/*
 * A comparação com o pedal sai do motor do pedal. A primeira versão dizia
 * "dobrar a velocidade triplica o gasto"; pelo próprio motor do site,
 * dobrar de 12 para 24 km/h multiplica por 2,5. Escrito à mão, o número
 * estava errado; calculado, não tem como ficar.
 */
const PEDAL_DE = 12;
const PEDAL_PARA = 24;
const FATOR_PEDAL = metRua(PEDAL_PARA) / metRua(PEDAL_DE);

/* Quanto de caminhada moderada custa o mesmo que uma hora de hatha. */
const MOD = ritmoCaminhada('moderado');
const kcalCaminhadaPorMin = caminhadaTempo(60, PESO_PADRAO, MOD.velocidade, 0, MOD.cadencia).kcal / 60;
const MIN_CAMINHADA = EX_HATHA.kcal / kcalCaminhadaPorMin;

/* A fração do total que é só metabolismo de repouso. */
const FRACAO_REPOUSO = (EX_HATHA.kcal - EX_HATHA.kcalLiquida) / EX_HATHA.kcal;

const n = (v: number, d = 1) => v.toLocaleString('pt-BR', { maximumFractionDigits: d });

/* 52 caracteres. */
const title = 'Quantas Calorias Yoga e Pilates Gastam? A Conta Real';
/*
 * 153 caracteres. A versão anterior prometia explicar "por que seu relógio
 * infla o hot yoga" — mais do que a medição sustenta. A promessa agora é o
 * que a página entrega: a comparação com o relógio e o resultado medido.
 */
const description =
  'Calcule as calorias de yoga e pilates por estilo e compare com o número do seu relógio. E o que a medição achou no hot yoga: o calor não aumenta o gasto.';

const faqs = [
  {
    pergunta: 'Uma hora de yoga queima quantas calorias?',
    resposta: `Cerca de ${formataKcal(EX_HATHA.kcal)} kcal para ${PESO_PADRAO} kg em hatha — e dois quintos disso é o metabolismo de repouso, que aconteceria de qualquer forma. Os estilos mais ativos chegam a ${formataKcal(EX_POWER.kcal)} kcal no power yoga. É bem menos do que circula por aí, e a página mostra de onde vem cada número.`,
  },
  {
    pergunta: 'Hot yoga queima mais calorias por causa do calor?',
    resposta: `Não. Um grupo do Houston Methodist comparou nos MESMOS ${ESTUDO_CALOR.participantes} praticantes a mesma sequência de uma hora a 40 °C e a 23 °C: ${ESTUDO_CALOR.kcalSalaQuente} ± ${ESTUDO_CALOR.erroQuente} kcal contra ${ESTUDO_CALOR.kcalSalaNormal} ± ${ESTUDO_CALOR.erroNormal} kcal. São ${n(EFEITO_CALOR * 100, 1)}% de diferença, dentro da margem de erro das duas medições, e o consumo de oxigênio também não mudou. O calor faz suar muito mais, e suar não é gastar.`,
  },
  {
    pergunta: 'Por que meu relógio mostra muito mais calorias na aula de hot yoga?',
    resposta:
      'A explicação mais citada vem de quem mediu o Bikram na Colorado State: relógios estimam caloria pela frequência cardíaca, com equações feitas para exercício em temperatura normal, e no calor a frequência pode subir para dissipar calor sem que o gasto suba. É uma explicação plausível, mas vale ser honesto sobre o limite dela: no estudo do Houston Methodist, que comparou as duas salas nas mesmas pessoas, a frequência média não chegou a diferir. O que está medido, sem discussão, é o gasto — e ele não sobe com o calor. Por isso a calculadora compara o número do seu aparelho com a medição, em vez de tentar adivinhar o erro dele.',
  },
  {
    pergunta: 'Pilates queima quantas calorias em 1 hora?',
    resposta: `Cerca de ${formataKcal(EX_PILATES.kcal)} kcal para ${PESO_PADRAO} kg. O Compêndio mede pilates geral em ${n(metYoga('pilates'))} METs, sem separar solo de aparelho nem nível — e esse valor é o mesmo do hot yoga, o que dá uma boa noção de escala. Circula um número de ${PUBLICADO_PILATES} kcal por hora, calculado para ${PESO_PUBLICADO_PILATES} kg em aula avançada: ele implicaria ${n(MET_PILATES_PUBLICADO)} METs, mais que o dobro do pilates geral. Aula avançada gasta mais que a média, mas como o Compêndio não separa níveis, não há como conferir esse número contra a tabela.`,
  },
  {
    pergunta: 'Qual estilo de yoga gasta mais calorias?',
    resposta: `Power yoga, com ${n(metYoga('power'))} METs — ${formataKcal(EX_POWER.kcal)} kcal por hora para ${PESO_PADRAO} kg. Mas a escada inteira vai de ${n(Math.min(...ESTILOS.map((e) => e.met)))} a ${n(Math.max(...ESTILOS.map((e) => e.met)))} METs, uma amplitude de ${n(AMPLITUDE, 2)} vez. A diferença entre o yoga mais leve e o mais forte é de ${Math.round(EX_POWER.kcal - EX_GERAL.kcal)} kcal por hora — trocar de estilo para gastar mais muda pouco.`,
  },
  {
    pergunta: 'Yoga emagrece?',
    resposta: `Pela via do gasto calórico, pouco: uma hora de hatha equivale a cerca de ${formataTempo(MIN_CAMINHADA)} de caminhada moderada. O que yoga e pilates fazem bem é outra coisa — mobilidade, força de core, equilíbrio — e, se for a atividade que você consegue manter, isso vale mais do que uma mais intensa que você abandona. Só não espere que a conta da caloria explique o benefício.`,
  },
  {
    pergunta: 'Quanto tempo de yoga para perder 1 kg de gordura?',
    resposta: `Cerca de ${formataTempo(UM_QUILO.minutos)} de hatha. O número existe para deixar claro que a ferramenta é a errada para essa pergunta — e não que a prática seja ruim. Emagrecimento se decide no balanço alimentar ao longo de meses; yoga entra na conta por outros motivos.`,
  },
];

const relacionados = [
  {
    url: '/calorias/danca/',
    titulo: 'Quantas calorias a dança gasta?',
    descricao: 'A outra página do cluster em que o número publicado tem pouca relação com medição.',
    tipo: 'Calorias',
  },
  {
    url: '/calorias/caminhada/',
    titulo: 'Quantas calorias a caminhada gasta?',
    descricao: `A comparação de escala: uma hora de hatha equivale a cerca de ${formataTempo(MIN_CAMINHADA)} de caminhada moderada.`,
    tipo: 'Calorias',
  },
  {
    url: '/guias/como-nao-desistir-do-treino/',
    titulo: 'Como não desistir do treino',
    descricao: 'Por que a atividade que você mantém vale mais que a mais intensa.',
    tipo: 'Guia',
  },
  {
    url: '/emagrecimento/deficit-calorico-como-funciona/',
    titulo: 'Déficit calórico: como funciona',
    descricao: `Por que ${formataKcal(EX_HATHA.kcal)} kcal mudam pouco, e o que muda muito.`,
    tipo: 'Emagrecimento',
  },
];

const schema = [
  breadcrumbSchema(crumbs),
  articleSchema({ titulo: title, descricao: description, url: new URL(path, site.dominio).href, atualizadoEm }),
  faqSchema(faqs),
  personMontinhoSchema(),
];
---

<Base title={title} description={description} path={path} ogType="article" schema={schema}>
  <Breadcrumbs crumbs={crumbs} />

  <header class="cy-hero">
    <div class="container cy-hero-inner">
      <p class="eyebrow">Calorias por atividade</p>
      <h1>Quantas calorias yoga e pilates gastam?</h1>
      <p class="cy-hero-lead">
        Uma hora de hatha gasta cerca de <strong>{formataKcal(EX_HATHA.kcal)} kcal</strong> para{' '}
        {PESO_PADRAO} kg — e <strong>dois quintos disso é só estar vivo</strong>. Se o seu relógio
        mostrou muito mais numa aula de hot yoga, veja o que a medição direta encontrou.
      </p>
      <p class="cy-micro">Grátis · sem cadastro · a conta acontece no seu navegador</p>
    </div>
  </header>

  <div class="container cy-layout">
    <article class="cy-main">
      <section id="cy-app" class="cy-app" aria-labelledby="cy-app-h">
        <h2 id="cy-app-h" class="cy-app-h">Calculadora de calorias de yoga e pilates</h2>

        <!--
          Os rótulos são curtos de propósito. "Meu relógio disse…" era o
          rótulo mais largo de todas as oito calculadoras e forçava as três
          abas a ocuparem três linhas no celular, empurrando o resultado para
          1.545px de rolagem — 90px pior que as irmãs. O campo logo abaixo já
          diz por extenso o que se informa aqui.
        -->
        <div class="cy-modos" role="tablist" aria-label="Como você quer contar">
          <button type="button" class="cy-modo is-ativo" data-modo="tempo" role="tab" aria-selected="true">
            Tempo de prática
          </button>
          <button type="button" class="cy-modo" data-modo="relogio" role="tab" aria-selected="false" tabindex="-1">
            Meu relógio
          </button>
          <button type="button" class="cy-modo" data-modo="meta" role="tab" aria-selected="false" tabindex="-1">
            Tenho uma meta
          </button>
        </div>

        <div class="cy-campos">
          <div class="cy-campo">
            <label for="cy-peso">Seu peso (kg)</label>
            <input id="cy-peso" type="text" inputmode="decimal" autocomplete="off" value={PESO_PADRAO} />
          </div>

          <div class="cy-campo">
            <span class="cy-rotulo">Estilo</span>
            <div class="cy-presets" role="group" aria-label="Estilo de prática">
              {ESTILOS.map((e) => (
                <button
                  type="button"
                  class:list={['cy-preset', 'cy-estilo', e.id === 'hatha' && 'is-ativo']}
                  data-estilo={e.id}
                  aria-pressed={String(e.id === 'hatha')}
                >
                  {e.nomeCurto}
                </button>
              ))}
            </div>
            <p class="cy-dica cy-estilo-slot" id="cy-estilo-dica">
              {n(metYoga('hatha'))} METs — Compêndio, código {estilo('hatha').codigo}.{' '}
              {estilo('hatha').comoReconhecer}
            </p>
          </div>

          <div class="cy-campo cy-campo-modo">
            <label for="cy-minutos">Tempo de prática (minutos)</label>
            <input id="cy-minutos" type="text" inputmode="numeric" autocomplete="off" value={MINUTOS_PADRAO} />
            <div class="cy-presets">
              {[30, 45, 60, 75, 90].map((v) => (
                <button type="button" class="cy-preset" data-alvo="tempo" data-valor={String(v)}>
                  {v < 60 ? `${v} min` : v === 60 ? '1h' : `${v} min`}
                </button>
              ))}
            </div>
          </div>

          <div class="cy-campo cy-campo-modo" hidden>
            <label for="cy-minutos-relogio">Duração da aula (minutos)</label>
            <input id="cy-minutos-relogio" type="text" inputmode="numeric" autocomplete="off" value="60" />
            <div class="cy-presets">
              {[45, 60, 75, 90].map((v) => (
                <button type="button" class="cy-preset" data-alvo="relogio" data-valor={String(v)}>{v} min</button>
              ))}
            </div>
          </div>

          <div class="cy-campo cy-campo-modo" hidden>
            <label for="cy-meta">Meta de gasto (kcal)</label>
            <input id="cy-meta" type="text" inputmode="numeric" autocomplete="off" value="200" />
            <div class="cy-presets">
              {[100, 150, 200, 300].map((v) => (
                <button type="button" class="cy-preset" data-alvo="meta" data-valor={String(v)}>{v} kcal</button>
              ))}
            </div>
          </div>

          <!--
            O modo que nenhuma outra calculadora tem: a pessoa chega com o
            número do aparelho, e é esse número que precisa ser confrontado.
          -->
          <div id="cy-bloco-relogio" hidden>
            <div class="cy-campo">
              <label for="cy-relogio">Quanto o seu relógio ou aplicativo marcou (kcal)</label>
              <input id="cy-relogio" type="text" inputmode="numeric" autocomplete="off" value={RELOGIO_PADRAO} />
              <p class="cy-dica">
                A ferramenta compara esse número com a estimativa baseada em medição de consumo de
                oxigênio, e diz o tamanho da diferença. Em prática no calor, ela também mostra o que a
                medição direta encontrou.
              </p>
            </div>
          </div>
        </div>

        <p id="cy-erro" class="cy-erro" role="status" hidden></p>

        <div id="cy-saida" class="cy-saida" role="status" aria-live="polite">
          <p class="cy-resultado">
            <span class="cy-numero">≈ {formataKcal(EX_HATHA.kcal)}</span>
            <span class="cy-unidade">kcal</span>
          </p>
          <p class="cy-frase"></p>

          <dl class="cy-detalhes">
            <div><dt>Tempo de prática</dt><dd class="cy-d-tempo">—</dd></div>
            <div class="cy-linha-relogio" hidden><dt>Seu aparelho marcou</dt><dd class="cy-d-relogio">—</dd></div>
            <div class="cy-linha-diferenca" hidden><dt>Diferença</dt><dd class="cy-d-diferenca">—</dd></div>
            <div><dt>Acréscimo real ao dia</dt><dd class="cy-d-liquido">—</dd></div>
            <div><dt>Intensidade</dt><dd><span class="cy-d-met">—</span> METs</dd></div>
            <div><dt>De onde vem o número</dt><dd class="cy-d-fonte">—</dd></div>
          </dl>

          <p class="cy-nota cy-nota-relogio" hidden></p>
          <p class="cy-nota">{NOTA_ESTIMATIVA}</p>

          <div class="cy-proximo">
            <p class="cy-proximo-lead">
              Esse número é pequeno, e isso não é problema da prática — é a pergunta que está
              errada. <strong>Yoga e pilates não são ferramentas de gasto calórico</strong>: eles
              treinam mobilidade, força de core e equilíbrio. Se o objetivo é déficit calórico, o
              caminho é outro; se é conseguir se mover bem por décadas, o caminho é esse.
            </p>
            <div class="cy-proximo-acoes">
              <a class="cy-btn cy-btn-primario" href="/personal-trainer/" data-track="calorias:cta-local">
                Encontrar personal na minha cidade
              </a>
              <a
                class="cy-btn cy-btn-secundario cy-whats"
                href="https://wa.me/"
                target="_blank"
                rel="noopener"
                data-track="calorias:cta-whatsapp"
              >
                Falar com o Montinho sobre acompanhamento online
              </a>
            </div>
            <p class="cy-proximo-nota">
              O Personal por Perto é um portal editorial. O diretório de cidades é gratuito; o
              Montinho Personal é o profissional que assina o conteúdo do portal e atende online
              para todo o Brasil.
            </p>
          </div>
        </div>
      </section>

      <div class="prose cy-conteudo">
        <h2>Por que o relógio pode inflar o hot yoga</h2>
        <p>{NOTA_RELOGIO_CALOR}</p>
        <p>
          É a primeira página deste nosso conjunto em que o problema não está só na tabela — está
          também no aparelho de quem pergunta. Nas outras sete o erro típico é usar o MET errado;
          aqui é confiar num número que o relógio calculou a partir do pulso, com uma equação que
          não foi validada para aquela condição.
        </p>
        <p class="cy-formula">{`aula de ${formataTempo(60)} de hot yoga, ${PESO_PADRAO} kg

  ${formataKcal(EX_RELOGIO.kcalRelogio)} kcal   ← um exemplo de número de relógio
  ${formataKcal(EX_RELOGIO.kcal)} kcal   ← estimativa pelo Compêndio (3,0 METs)

  o aparelho mostrou ${n(EX_RELOGIO.razaoRelogio, 1)}× mais`}</p>
        <p>
          A calculadora acima tem um modo para isso. Você informa o que o aparelho mostrou, e ela
          devolve a comparação — porque quem chega aqui depois de uma aula de hot yoga chega com um
          número na mão, não com uma dúvida abstrata.
        </p>

        <h2>A medição que fecha o assunto do calor</h2>
        <p>{NOTA_CALOR_NAO_MUDA}</p>
        <div class="tabela-rolavel">
          <table>
            <caption>
              A mesma aula, nos mesmos {ESTUDO_CALOR.participantes} praticantes, em duas temperaturas
            </caption>
            <thead>
              <tr><th scope="col">Condição</th><th scope="col">Gasto medido</th></tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">Sala em temperatura normal</th>
                <td>{ESTUDO_CALOR.kcalSalaNormal} ± {ESTUDO_CALOR.erroNormal} kcal</td>
              </tr>
              <tr>
                <th scope="row">Sala aquecida</th>
                <td>{ESTUDO_CALOR.kcalSalaQuente} ± {ESTUDO_CALOR.erroQuente} kcal</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p>
          São <strong>{n(EFEITO_CALOR * 100, 1)}%</strong> de diferença, e as duas faixas de erro se
          sobrepõem — ou seja, não há diferença que se possa chamar de real. O consumo de oxigênio
          não mudou, e a frequência cardíaca média também não. Este último ponto importa para a
          conversa do relógio: neste estudo, o calor não chegou a acelerar o coração em média.
        </p>
        <p>
          Há uma segunda medição na mesma direção. Na Colorado State, o pesquisador Brian Tracy
          mediu a taxa metabólica numa sessão de Bikram de {ESTUDO_BIKRAM.minutos} minutos: cerca
          de {ESTUDO_BIKRAM.kcalHomens} kcal nos homens e {ESTUDO_BIKRAM.kcalMulheres} nas
          mulheres — menos de {n(ESTUDO_BIKRAM.kcalMulheres / ESTUDO_BIKRAM.minutos, 1)} kcal por
          minuto em noventa minutos de sala quente. É dele a explicação para as estimativas infladas
          que circulavam: equações de frequência cardíaca, feitas para exercício em temperatura
          normal, usadas no calor. Esses números foram divulgados pela universidade em 2014, não
          num artigo revisado por pares — e a página prefere dizer isso a citar um artigo que não
          os contém.
        </p>

        <h2>A conferência: a tabela bate com a medição direta</h2>
        <p>
          Antes de usar a tabela do Compêndio para responder qualquer coisa, vale checar se ela
          concorda com quem mediu gente de verdade. Os {ESTUDO_CALOR.kcalSalaNormal} kcal por sessão
          do Houston Methodist, numa sequência de {MINUTOS_ESTUDO} minutos de posturas mantidas, com
          praticantes de {n(PESO_ESTUDO)} kg em média, implicam:
        </p>
        <p class="cy-formula">{`sala normal
  ${ESTUDO_CALOR.kcalSalaNormal} ÷ (3,5 × ${n(PESO_ESTUDO)} ÷ 200) ÷ ${MINUTOS_ESTUDO} = ${n(ESTUDO.metImplicado, 2)} METs
  a tabela para hatha: ${n(ESTUDO.metDaTabela)} METs    diferença: ${n(ESTUDO.erro * 100, 1)}%

sala quente
  ${ESTUDO_CALOR.kcalSalaQuente} ÷ (3,5 × ${n(PESO_ESTUDO)} ÷ 200) ÷ ${MINUTOS_ESTUDO} = ${n(CALOR.metImplicado, 2)} METs
  a tabela para hot yoga: ${n(CALOR.metDaTabela)} METs    a tabela fica ${n(CALOR.desvio * 100, 0)}% acima`}</p>
        <p>
          Na sala normal, fecha: a medição direta e a tabela chegam ao mesmo lugar, e as duas dizem
          que yoga é atividade de intensidade baixa. Na sala quente, a tabela fica acima do que foi
          medido — o que quer dizer que o número de hot yoga desta calculadora, se erra, erra
          <strong>para mais</strong>. Nenhum dos dois desvios favorece a tese da página.
        </p>
        <p class="cy-ressalva">
          Uma correção que esta seção já recebeu: a primeira versão usava 65 kg como peso dos
          participantes, número que não está no artigo, e a conta parecia fechar do mesmo jeito. O
          peso publicado é {n(PESO_ESTUDO)} kg. Uma conferência que fecha com o dado errado não
          confere nada, e por isso o peso agora vem direto da tabela de participantes.
        </p>

        <h2>Os sete estilos medidos</h2>
        <div class="tabela-rolavel">
          <table>
            <caption>Uma hora de prática, para {PESO_PADRAO} kg</caption>
            <thead>
              <tr>
                <th scope="col">Estilo</th><th scope="col">METs</th>
                <th scope="col">1 hora</th><th scope="col">Código</th>
              </tr>
            </thead>
            <tbody>
              {TAB_ESTILO.map((l) => (
                <tr>
                  <th scope="row">{l.estilo.nome}</th>
                  <td>{n(l.estilo.met)}</td>
                  <td>≈ {formataKcal(l.kcal60)} kcal</td>
                  <td>{l.estilo.codigo}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>{NOTA_ESCADA_CURTA}</p>
        <p>
          Em número: do pé ao topo da escada são{' '}
          <strong>{Math.round(EX_POWER.kcal - EX_GERAL.kcal)} kcal por hora</strong> de diferença —{' '}
          {formataKcal(EX_GERAL.kcal)} no yoga geral contra {formataKcal(EX_POWER.kcal)} no power. É
          uma amplitude de {n(AMPLITUDE, 2)} vez. No pedal, só dobrar a velocidade de {PEDAL_DE} para{' '}
          {PEDAL_PARA} km/h multiplica o gasto por {n(FATOR_PEDAL)}; aqui, trocar de estilo é ajuste
          fino.
        </p>
        <p class="cy-ressalva">
          Note que pilates e hot yoga têm o mesmo valor ({n(metYoga('pilates'))} METs). Não é erro:
          são códigos diferentes do Compêndio que chegaram ao mesmo valor. E serve de referência
          útil de escala — se você já fez as duas coisas, sabe que elas cansam de formas diferentes,
          e ainda assim custam o mesmo em caloria.
        </p>

        <h2>O que a internet publica, e o que isso implicaria</h2>
        <p>
          Para vinyasa, circulam faixas como &ldquo;300 a 600 kcal por hora&rdquo;. Pegue um
          valor perto do topo: <strong>{PUBLICADO_VINYASA} kcal por hora</strong>. Para{' '}
          {PESO_PADRAO} kg, isso implicaria <strong>{n(MET_PUBLICADO)} METs</strong> — perto dos{' '}
          {n(ESTUDO_ZUMBA.met)} METs medidos numa aula de Zumba, que aparecem na nossa{' '}
          <a href="/calorias/danca/">página de dança</a>. O Compêndio dá{' '}
          {n(metYoga('vinyasa'))} METs para vinyasa, que dá {formataKcal(EX_VINYASA.kcal)} kcal por
          hora.
        </p>
        <p>
          São <strong>{n(INFLACAO_VINYASA, 1)} vezes</strong> de diferença. Não é arredondamento:
          é o número de outra atividade.
        </p>

        <h2>Quanto custa, por tempo e por peso</h2>
        <div class="tabela-rolavel">
          <table>
            <caption>Hatha yoga ({n(metYoga('hatha'))} METs) por tempo, para {PESO_PADRAO} kg</caption>
            <thead>
              <tr><th scope="col">Tempo</th><th scope="col">Gasto bruto</th></tr>
            </thead>
            <tbody>
              {TAB_TEMPO.map((l) => (
                <tr>
                  <th scope="row">{formataTempo(l.minutos)}</th>
                  <td>≈ {formataKcal(l.kcal)} kcal</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="tabela-rolavel">
          <table>
            <caption>Uma hora de hatha por peso corporal</caption>
            <thead>
              <tr>
                <th scope="col">Peso</th><th scope="col">Gasto bruto</th>
                <th scope="col">Acréscimo real ao dia</th>
              </tr>
            </thead>
            <tbody>
              {TAB_PESO.map((l) => (
                <tr>
                  <th scope="row">{l.peso} kg</th>
                  <td>≈ {formataKcal(l.kcal)} kcal</td>
                  <td>≈ {formataKcal(l.kcalLiquida)} kcal</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>{NOTA_BRUTO}</p>
        <p>
          Essa segunda coluna merece atenção especial aqui. Em atividade de intensidade alta o
          metabolismo de repouso é detalhe; numa hora de hatha ele é{' '}
          <strong>{n(FRACAO_REPOUSO * 100, 0)}% do total</strong>. Dito de outro jeito: das{' '}
          {formataKcal(EX_HATHA.kcal)} kcal, só {formataKcal(EX_HATHA.kcalLiquida)} são acréscimo de
          verdade ao seu dia.
        </p>

        <h2>Yoga ou caminhada?</h2>
        <p>
          Uma hora de hatha gasta mais ou menos o mesmo que{' '}
          <strong>{formataTempo(MIN_CAMINHADA)} de caminhada moderada</strong> para {PESO_PADRAO} kg.
          Se o critério de escolha for caloria, a caminhada ganha com folga e de graça.
        </p>
        <p>
          Só que caloria é um critério ruim para escolher entre as duas, e é aí que esta página quer
          chegar. Caminhar pouco treina mobilidade de quadril em amplitude, controle de core ou
          equilíbrio sustentado numa perna só. Yoga e pilates treinam essas três coisas, e nenhuma
          delas aparece numa conta de kcal.
        </p>
        <p>{NOTA_NAO_E_O_PONTO}</p>
        <p>{NOTA_SEM_PERDA_LOCALIZADA}</p>

        <h2>Como esta conta é feita</h2>
        <p>
          A base é a equação de METs: <strong>kcal por minuto = MET × 3,5 × peso em kg ÷ 200</strong>.
          Os sete valores vêm do Compêndio de Atividades Físicas de 2024, copiados e não ajustados,
          com o código de cada um visível na tabela — eles ficam no capítulo de exercícios de
          condicionamento, não num capítulo próprio de yoga.
        </p>
        <p class="cy-formula">{`1 hora de hatha, ${PESO_PADRAO} kg
  ${n(metYoga('hatha'))} × 3,5 × ${PESO_PADRAO} ÷ 200 = ${n(EX_HATHA.kcal / 60, 2)} kcal por minuto
  ${n(EX_HATHA.kcal / 60, 2)} × 60 = ${n(EX_HATHA.kcal, 0)} kcal`}</p>
        <p>
          A comparação com o relógio não usa nenhuma equação nossa de frequência cardíaca: ela
          simplesmente confronta o número que você informa com a estimativa por MET. O que a página
          afirma sobre o aparelho vem das duas medições citadas, não de um modelo próprio.
        </p>
        <p>
          Nenhum número desta página foi escrito à mão. Todos saem do mesmo motor que a calculadora
          usa, e o teste confere se a nossa tabela reproduz a medição do Houston Methodist — porque
          uma página que corrige o relógio dos outros precisa provar que a própria régua está certa.
        </p>
        <p class="cy-revisao">
          Revisado em {formatDateLong(atualizadoEm)} por <a href="/montinho-personal/">Montinho</a>,
          personal trainer. {NOTA_NAO_PRESCRICAO}
        </p>

        <h2>Limitações desta estimativa</h2>
        <p>{NOTA_ESTIMATIVA}</p>
        <p>
          Há uma limitação de fonte que vale declarar. Uma das referências que consultamos reporta
          {' '}2,3 METs para o hatha em vez dos {n(metYoga('hatha'))} que usamos, e não foi possível
          resolver a divergência na fonte primária. A diferença é de 8% e não muda nenhuma conclusão
          desta página — mas é o tipo de coisa que preferimos dizer a esconder.
        </p>
        <p>{NOTA_SEGURANCA}</p>

        <h2>Referências</h2>
        <ul class="cy-fontes">
          {FONTES.map((f) => (
            <li>
              <a href={f.url} target="_blank" rel="noopener noreferrer">{f.rotulo}</a> — {f.resumo}
            </li>
          ))}
        </ul>
      </div>

      <Faq faqs={faqs} titulo="Perguntas frequentes sobre calorias de yoga e pilates" />

      <WhatsAppCta tema="emagrecimento" />
      <AutorMontinho />
      <RelatedArticles itens={relacionados} />
    </article>

    <Sidebar />
  </div>

