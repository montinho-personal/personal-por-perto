    .cf-btn:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
    .cf-proximo-nota { margin-top: var(--sp-3); font-size: var(--step--1); color: var(--muted); }

    .cf-conteudo { margin-top: var(--sp-7); }
    .cf-ressalva {
      border-left: 3px solid var(--line);
