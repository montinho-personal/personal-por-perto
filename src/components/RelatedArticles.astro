---
/**
 * Artigos relacionados — escolha semântica (passada pelo pai), nunca aleatória.
 * Cada item tem título, descrição curta (por que ler a seguir) e rótulo do tipo.
 */
export interface RelatedItem {
  url: string;
  titulo: string;
  descricao: string;
  tipo: string;
}
export interface Props {
  itens: RelatedItem[];
  titulo?: string;
}
const { itens, titulo = 'Continue a leitura' } = Astro.props;
---

<section class="related" aria-labelledby="related-h">
  <h2 id="related-h">{titulo}</h2>
  <div class="related-grid">
    {
      itens.map((it) => (
        <a class="related-card card card-hover" href={it.url}>
          <span class="pill pill-neutral">{it.tipo}</span>
          <h3>{it.titulo}</h3>
          <p>{it.descricao}</p>
          <span class="related-link">Ler a seguir →</span>
        </a>
      ))
    }
  </div>
</section>

<style>
  .related {
    margin-top: var(--sp-7);
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--sp-4);
    margin-top: var(--sp-5);
  }
  .related-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--ink);
  }
  .related-card:hover {
    text-decoration: none;
  }
  .related-card h3 {
    font-size: var(--step-1);
  }
  .related-card p {
    font-size: var(--step--1);
    color: var(--ink-soft);
    line-height: 1.55;
    flex: 1;
    margin: 0;
  }
  .related-link {
    font-weight: 700;
    color: var(--accent-600);
    font-size: var(--step--1);
  }
</style>
