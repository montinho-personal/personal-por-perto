---
/**
 * Comparador arrastável de antes e depois (Vitrine de transformações).
 *
 * - A foto "depois" fica inteira embaixo; a "antes", por cima, recortada com
 *   clip-path: inset(0 X% 0 0), onde X = 100 - posição.
 * - Proporção pelo largura/altura do feed (aspect-ratio): nunca estica a foto
 *   e reserva o espaço antes da imagem chegar (zero layout shift).
 * - Sem JavaScript fica parado em 50%. Nada anima sozinho.
 * - Arrasto: Pointer Events + setPointerCapture (vitrine.client.ts), com
 *   touch-action: pan-y para a rolagem vertical continuar no celular.
 * - Teclado e leitor de tela: <input type="range"> transparente por cima,
 *   sem receber o ponteiro (o arrasto é do contêiner), com foco visível
 *   desenhado no puxador.
 */
import type { Transformacao } from '../lib/vitrine';

export interface Props {
  t: Transformacao;
  /** Altura máxima da foto: 70svh no destaque, 55svh nos cards. */
  variante: 'destaque' | 'card';
}

const { t, variante } = Astro.props;
const { largura, altura } = t.fotos;
const altAntes = `Antes: ${t.nome} no início do acompanhamento com o Montinho`;
const altDepois = t.acompanhamento
  ? `Depois: ${t.nome} após ${t.acompanhamento} de acompanhamento (${t.resultado})`
  : `Depois: ${t.nome} após o acompanhamento com o Montinho (${t.resultado})`;
const vh = variante === 'destaque' ? '70svh' : '55svh';
---

<figure class={`cmp-fig cmp-fig--${variante}`}>
  <div
    class="cmp"
    data-cmp
    data-aluno={t.slug}
    style={`--pos: 50%; --ar: ${largura} / ${altura}; --larg-max: calc(${vh} * ${largura} / ${altura});`}
  >
    <img
      class="cmp-img cmp-depois"
      src={t.fotos.depois}
      alt={altDepois}
      width={largura}
      height={altura}
      loading="lazy"
      decoding="async"
      draggable="false"
    />
    <img
      class="cmp-img cmp-antes"
      src={t.fotos.antes}
      alt={altAntes}
      width={largura}
      height={altura}
      loading="lazy"
      decoding="async"
      draggable="false"
    />
    <span class="cmp-tag cmp-tag--antes" aria-hidden="true">Antes</span>
    <span class="cmp-tag cmp-tag--depois" aria-hidden="true">Depois</span>
    <input
      class="cmp-range"
      type="range"
      min="0"
      max="100"
      step="1"
      value="50"
      aria-label={`Comparar antes e depois de ${t.nome}`}
    />
    <span class="cmp-linha" aria-hidden="true"><span class="cmp-puxador"></span></span>
    <span class="cmp-dica" aria-hidden="true">Arraste para comparar</span>
  </div>
  <figcaption class="cmp-legenda">Fotos reais de {t.nome}, sem retoque.</figcaption>
</figure>

<style>
  .cmp-fig {
    margin: 0;
  }
  .cmp {
    position: relative;
    width: min(100%, var(--larg-max));
    aspect-ratio: var(--ar);
    margin-inline: auto;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--bg-tint);
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    cursor: ew-resize;
  }
  .cmp-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }
  .cmp-antes {
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  .cmp-tag {
    position: absolute;
    top: var(--sp-3);
    padding: 0.2em 0.6em;
    border-radius: var(--radius-sm);
    background: rgba(17, 24, 39, 0.72);
    color: #fff;
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    pointer-events: none;
  }
  .cmp-tag--antes {
    left: var(--sp-3);
  }
  .cmp-tag--depois {
    right: var(--sp-3);
  }
  .cmp-linha {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 3px;
    margin-left: -1.5px;
    background: #fff;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.25);
    pointer-events: none;
  }
  .cmp-puxador {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 44px;
    height: 44px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: #fff;
    box-shadow: var(--shadow);
  }
  .cmp-puxador::before,
  .cmp-puxador::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 0;
    height: 0;
    border-block: 6px solid transparent;
    transform: translateY(-50%);
  }
  .cmp-puxador::before {
    left: 9px;
    border-right: 8px solid var(--brand-700);
  }
  .cmp-puxador::after {
    right: 9px;
    border-left: 8px solid var(--brand-700);
  }
  /* O range cobre a foto para o leitor de tela e o teclado, mas não recebe o
     ponteiro: o arrasto é tratado no contêiner, com touch-action: pan-y. */
  .cmp-range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }
  .cmp-range:focus-visible + .cmp-linha .cmp-puxador {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }
  .cmp-dica {
    position: absolute;
    left: 50%;
    bottom: var(--sp-3);
    transform: translateX(-50%);
    padding: 0.25em 0.75em;
    border-radius: 999px;
    background: rgba(17, 24, 39, 0.72);
    color: #fff;
    font-size: var(--step--1);
    white-space: nowrap;
    pointer-events: none;
  }
  .cmp[data-usado] .cmp-dica {
    display: none;
  }
  .cmp-legenda {
    margin-top: var(--sp-2);
    text-align: center;
    font-size: var(--step--1);
    color: var(--muted);
  }
</style>
