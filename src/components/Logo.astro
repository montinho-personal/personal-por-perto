---
export interface Props {
  height?: number;
  light?: boolean;
}
const { height = 30, light = false } = Astro.props;
const mark = light ? '#ffffff' : '#16181d';
const accent = '#f1681d';
const textColor = light ? '#ffffff' : '#16181d';
---

<span class="logo" style={`--h:${height}px`}>
  <svg
    width={height}
    height={height}
    viewBox="0 0 40 40"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    focusable="false"
  >
    <!-- Marcador de localização + figura em movimento (personal + por perto) -->
    <path
      d="M20 2C12.27 2 6 8.27 6 16c0 9.5 14 22 14 22s14-12.5 14-22C34 8.27 27.73 2 20 2z"
      fill={mark}
    />
    <circle cx="20" cy="11.5" r="3" fill={accent} />
    <path
      d="M14.5 23c1.6-1 3-2.6 3.6-4.4.4-1.2 1.7-1.8 2.9-1.3 1 .4 2 .9 3.2.9 1 0 1.9-.2 2.8-.6"
      stroke={accent}
      stroke-width="2.4"
      stroke-linecap="round"
    />
  </svg>
  <span class="logo-text" style={`color:${textColor}`}>
    Personal<strong>por Perto</strong>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .logo-text {
    font-weight: 600;
    font-size: 1.18rem;
    letter-spacing: -0.02em;
    line-height: 1;
    white-space: nowrap;
  }
  .logo-text strong {
    font-weight: 800;
    margin-left: 0.28rem;
  }
</style>
