---
/**
 * CTA contextual — a interface do motor de decisão.
 *
 * O componente não decide nada: pergunta ao motor qual é o próximo passo
 * desta página e renderiza a resposta. Se o motor devolver `null`, nada é
 * renderizado — e essa é uma resposta legítima, não um erro.
 *
 * Renderizado inteiramente no servidor (SSG): zero JS para aparecer, zero
 * flash de CTA errado, zero layout shift. O único script é o de medição,
 * inserido uma vez por página e apenas quando há CTA.
 *
 * Quando a campanha pede a caixa completa de WhatsApp, delega ao componente
 * já existente em vez de duplicar desenho — o portal continua com um único
 * vocabulário visual.
 */
import WhatsAppCta from './WhatsAppCta.astro';
import { getContextualCTA, textoCampanha, type PosicaoCta } from '../lib/ctaEngine';
import { montarMensagemWhatsapp } from '../lib/whatsappMensagem';
import { whatsappUrl } from '../lib/links';

export interface Props {
  /** Caminho da página (o mesmo passado ao Base). */
  path: string;
  cidadeNome?: string;
  uf?: string;
  /** Locução flexionada ("no Rio de Janeiro"). */
  localidade?: string;
  /** Título do conteúdo — usado na mensagem do WhatsApp. */
  assunto?: string;
  /** A página já tem CTA comercial próprio: o motor se cala. */
  temCtaManual?: boolean;
  /**
   * Onde este bloco está no artigo: 'inicio' (20–35%), 'meio' (45–65%),
   * 'fim' (75–90%) ou 'pos' (depois do corpo). Além de ir para o
   * analytics, a posição é regra: o motor recusa CTA comercial no início.
   */
  posicao?: PosicaoCta;
}

const { path, cidadeNome, uf, localidade, assunto, temCtaManual, posicao } = Astro.props;

const decisao = getContextualCTA({
  path,
  cidadeNome,
  uf,
  localidade,
  assunto,
  temCtaManual,
  posicao,
  tituloArtigo: assunto,
});

// Sem decisão = sem CTA. É o comportamento correto em humor, institucional
// e onde a página já resolve a conversão sozinha.
const c = decisao?.campanha;

const titulo = c ? textoCampanha(c.titulo, { cidadeNome, localidade }) : '';
const texto = c ? textoCampanha(c.texto, { cidadeNome, localidade }) : '';

/** Destino: interno, WhatsApp com mensagem contextual, ou site do Montinho. */
function resolverHref(destino: string): string {
  if (destino !== 'whatsapp') return destino;
  return whatsappUrl(
    montarMensagemWhatsapp({
      campanha: c!.id,
      topico: decisao!.classificacao.topico,
      assunto,
      cidadeNome,
      uf,
      localidade,
    }),
  );
}

const href = c ? resolverHref(c.destino) : '';
const externo = href.startsWith('http');

// Só o modo debug expõe a regra; em produção o atributo não é emitido.
const debug = import.meta.env.DEV && decisao
  ? `${decisao.regra} · ${decisao.motivo}`
  : undefined;

const t = decisao?.tracking;
---

{
  c && c.render === 'whatsapp' && (
    <WhatsAppCta tema={c.temaWhats ?? 'geral'} contexto={cidadeNome} localidade={localidade} />
  )
}

{
  c && c.render === 'card' && (
    <aside
      class:list={['ccta', `ccta--${decisao!.variante}`, `ccta--${c.nivel}`]}
      aria-labelledby={`ccta-tit-${c.id}`}
      data-cta={c.id}
      data-cta-variant={decisao!.variante}
      data-cta-type={t!.offer_type}
      data-cta-position={t!.position}
      data-cta-page-type={t!.page_type}
      data-cta-category={t!.cluster}
      data-cta-funnel={t!.funnel_stage}
      data-cta-intent={t!.search_intent}
      data-cta-title={t!.page_title}
      data-cta-text={titulo}
      data-cta-city={t!.city}
      data-cta-debug={debug}
    >
      <p class="ccta-eyebrow">{c.eyebrow}</p>
      <h2 class="ccta-tit" id={`ccta-tit-${c.id}`}>{titulo}</h2>
      <p class="ccta-txt">{texto}</p>

      <div class="ccta-acoes">
        <a
          class="btn btn-primary ccta-btn"
          href={href}
          data-cta-link="primary"
          {...(externo ? { target: '_blank', rel: 'noopener' } : {})}
          {...(externo ? { 'data-wpp': '' } : {})}
        >
          {c.rotulo}
        </a>
        {c.secundario && (
          <a class="ccta-sec" href={c.secundario.destino} data-cta-link="secondary">
            {c.secundario.rotulo}
          </a>
        )}
      </div>

      {c.microcopy && <p class="ccta-micro">{c.microcopy}</p>}

      {c.nivel === 'comercial' && (
        <p class="ccta-disclosure">
          O Montinho Personal é o profissional ligado a este portal — a
          recomendação não é um resultado editorial neutro. Os critérios estão
          em <a href="/como-avaliamos/">Como avaliamos</a>.
        </p>
      )}
    </aside>
  )
}

<style>
  .ccta {
    margin: var(--sp-6) 0;
    border: 1px solid var(--line);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius);
    background: var(--bg-tint);
    padding: var(--sp-5);
  }
  .ccta-eyebrow {
    margin: 0;
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-600);
  }
  .ccta-tit {
    margin: var(--sp-2) 0 0;
    font-size: var(--step-1);
    line-height: 1.25;
    max-width: 40ch;
  }
  .ccta-txt {
    margin: var(--sp-3) 0 0;
    color: var(--ink-soft);
    line-height: 1.6;
    max-width: 62ch;
  }
  .ccta-acoes {
    margin-top: var(--sp-5);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3) var(--sp-5);
  }
  .ccta-btn {
    min-height: 48px;
    /* O bloco costuma ficar dentro de .prose, que sublinha links.
       Um botão sublinhado parece link quebrado. */
    text-decoration: none;
  }
  .ccta-btn:hover {
    text-decoration: none;
  }
  .ccta-sec {
    font-weight: 600;
    font-size: var(--step--1);
    color: var(--brand-600);
    text-decoration: underline;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .ccta-micro {
    margin: var(--sp-3) 0 0;
    font-size: var(--step--1);
    color: var(--muted);
  }
  .ccta-disclosure {
    margin: var(--sp-4) 0 0;
    padding-top: var(--sp-3);
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--muted);
    line-height: 1.5;
  }

  /* -------------------------- Variantes -------------------------- */

  /* Discreta: conteúdo sensível e artigos de execução, onde o CTA deve
     parecer nota de rodapé útil, não oferta. */
  .ccta--subtle {
    background: transparent;
    border-color: var(--line-soft);
    border-left-color: var(--line);
    padding: var(--sp-4) var(--sp-5);
  }
  .ccta--subtle .ccta-tit {
    font-size: var(--step-0);
    font-weight: 700;
  }
  .ccta--subtle .ccta-eyebrow {
    color: var(--muted);
  }
  .ccta--subtle .ccta-btn {
    background: transparent;
    color: var(--brand-700);
    border-color: var(--brand);
    box-shadow: none;
  }
  .ccta--subtle .ccta-btn:hover {
    background: var(--brand-50);
  }

  /* Destaque: páginas de decisão, onde a ferramenta é o próximo passo óbvio. */
  .ccta--featured {
    background: var(--accent-50);
    border-color: #f7d4bd;
    border-left-color: var(--accent);
  }

  /* Local: páginas de cidade e bairro — maior intenção comercial do site. */
  .ccta--local {
    background: linear-gradient(155deg, var(--brand-700), var(--brand-800));
    border: 0;
    border-top: 4px solid var(--accent);
    border-radius: var(--radius-lg);
    padding: var(--sp-6);
    color: #d4d8df;
    box-shadow: var(--shadow-lg);
  }
  .ccta--local .ccta-tit {
    color: #fff;
    font-size: var(--step-2);
  }
  .ccta--local .ccta-txt {
    color: #d4d8df;
  }
  .ccta--local .ccta-eyebrow {
    color: #ffb488;
  }
  .ccta--local .ccta-sec {
    color: #fff;
  }
  .ccta--local .ccta-micro,
  .ccta--local .ccta-disclosure {
    color: #aab0ba;
    border-top-color: rgba(255, 255, 255, 0.15);
  }
  .ccta--local .ccta-disclosure a {
    color: #fff;
  }

  @media (max-width: 560px) {
    .ccta-btn {
      width: 100%;
    }
    .ccta-acoes {
      gap: var(--sp-3);
    }
  }
</style>

<script>
  // Medição do funil de CTA. Carregado uma única vez por página e só quando
  // existe CTA. Sem dependências, sem impacto de renderização: um
  // IntersectionObserver para a visualização e delegação de clique.
  // Só envia dados não sensíveis, e só se o GA foi autorizado nos cookies.
  import { iniciarMedicaoCta } from '../scripts/ctaTracking.client';
  iniciarMedicaoCta();
</script>
