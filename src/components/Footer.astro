---
/**
 * Rodapé global. Estrutura em blocos semânticos (Encontrar Personal,
 * Localidades populares, Conteúdos, Institucional), cada um em <details>
 * nativo: colapsável no mobile (sem JS), sempre expandido no desktop via
 * CSS, e com os links sempre presentes no DOM independentemente do estado
 * visual — nada é ocultado do crawler.
 */
import Logo from './Logo.astro';
import { site } from '../data/site';
import { montinho } from '../data/montinho';
import { cidadesPopularesFooter } from '../data/destaques';
import { formatMonthYear } from '../lib/slug';

const anoAtual = 2026;
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <Logo light={true} />
      <p>
        O Personal por Perto é um portal editorial independente sobre personal
        trainer no Brasil: reúne busca local de profissionais em centenas de
        cidades e guias práticos para ajudar você a decidir com segurança.
      </p>
      <p class="footer-note">
        As recomendações são baseadas em critérios
        próprios e descritos em <a href="/como-avaliamos">Como avaliamos</a>.
      </p>
    </div>

    <details class="footer-acc" open>
      <summary>Encontrar Personal</summary>
      <ul>
        <li><a href="/personal-trainer">Buscar personal por cidade</a></li>
        <li><a href="/montinho-personal">Acompanhamento online (todo o Brasil)</a></li>
      </ul>
    </details>

    <details class="footer-acc" open>
      <summary>Localidades populares</summary>
      <ul>
        {
          cidadesPopularesFooter.map((c) => (
            <li>
              <a href={`/personal-trainer/${c.slug}`}>Personal Trainer {c.prep} {c.nome}</a>
            </li>
          ))
        }
      </ul>
    </details>

    <details class="footer-acc" open>
      <summary>Conteúdos</summary>
      <ul>
        <li><a href="/guias/como-escolher-personal-trainer">Como escolher um personal</a></li>
        <li><a href="/guias/quanto-custa-personal-trainer">Quanto custa um personal</a></li>
        <li><a href="/musculacao/treino-para-iniciantes">Musculação para iniciantes</a></li>
        <li><a href="/musculacao/hipertrofia-como-funciona">Hipertrofia: como funciona</a></li>
        <li><a href="/emagrecimento/como-emagrecer-fazendo-musculacao">Como emagrecer fazendo musculação</a></li>
        <li><a href="/emagrecimento/deficit-calorico-como-funciona">Déficit calórico: como funciona</a></li>
        <li><a href="/musculacao">Todos os conteúdos de musculação</a></li>
        <li><a href="/emagrecimento">Todos os conteúdos de emagrecimento</a></li>
        <li><a href="/mounjaro-e-treino">Mounjaro e treino</a></li>
        <li><a href="/humor-fitness">Humor fitness</a></li>
        <li><a href="/guias">Todos os guias</a></li>
      </ul>
    </details>

    <details class="footer-acc" open>
      <summary>Institucional</summary>
      <ul>
        <li><a href="/sobre">Sobre o Personal por Perto</a></li>
        <li><a href="/como-avaliamos">Como avaliamos</a></li>
        <li><a href="/montinho-personal">Montinho Personal</a></li>
        <li><a href={montinho.instagram.url} target="_blank" rel="noopener" data-ig>Instagram {montinho.instagram.handle}</a></li>
        <li><a href="/privacidade">Política de Privacidade</a></li>
        <li><a href={`mailto:${site.email}`}>Contato</a></li>
      </ul>
    </details>
  </div>

  <div class="container footer-bottom">
    <p>© {anoAtual} {site.nome}. Conteúdo informativo e editorial.</p>
    <p>Atualizado em {formatMonthYear('2026-06-28')}.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--brand-800);
    color: #c7ccd4;
    padding-top: var(--sp-8);
    margin-top: var(--sp-9);
    font-size: var(--step--1);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr 1fr 1fr;
    gap: var(--sp-6);
  }
  @media (max-width: 980px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
  .footer-brand p {
    margin-top: var(--sp-3);
    line-height: 1.6;
    max-width: 38ch;
  }
  .footer-note {
    color: #9aa1ab;
  }

  /* Acordeão dos blocos de navegação — <details> nativo: sem JS, sem
     dependências, links sempre no DOM. Aberto por padrão (zero CLS) em
     qualquer viewport; no desktop, o toggle é desabilitado via CSS para
     manter a aparência de colunas fixas. */
  .footer-acc {
    border: 0;
  }
  .footer-acc summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
    cursor: pointer;
    list-style: none;
    font-size: var(--step-0);
    font-weight: 700;
    color: #fff;
    margin-bottom: var(--sp-3);
    padding-block: 0.25rem;
  }
  .footer-acc summary::-webkit-details-marker {
    display: none;
  }
  .footer-acc summary::after {
    content: '+';
    font-weight: 400;
    font-size: var(--step-1);
    color: #9aa1ab;
    flex-shrink: 0;
  }
  .footer-acc[open] summary::after {
    content: '–';
  }
  .footer-acc ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.55rem;
  }
  .site-footer a {
    color: #c7ccd4;
  }
  .site-footer a:hover {
    color: #fff;
  }
  @media (min-width: 981px) {
    .footer-acc summary {
      cursor: default;
      pointer-events: none;
      margin-bottom: var(--sp-3);
    }
    .footer-acc summary::after {
      display: none;
    }
  }
  @media (max-width: 980px) {
    .footer-acc {
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      padding-block: var(--sp-4);
    }
    .footer-acc summary {
      margin-bottom: 0;
    }
    .footer-acc[open] summary {
      margin-bottom: var(--sp-3);
    }
  }

  .footer-bottom {
    margin-top: var(--sp-7);
    padding-block: var(--sp-4);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: #888f99;
  }
</style>
