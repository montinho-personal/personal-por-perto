---
/**
 * Rodapé global. Estrutura em blocos semânticos (Encontrar Personal,
 * Ferramentas, Localidades populares, Conteúdos, Institucional), cada um em
 * <details> nativo: colapsável no mobile (sem JS), sempre expandido no
 * desktop via CSS, e com os links sempre presentes no DOM independentemente
 * do estado visual — nada é ocultado do crawler.
 *
 * O bloco de Ferramentas sai do registro central (src/data/ferramentas.ts):
 * publicar uma ferramenta nova a coloca no rodapé automaticamente, e as
 * marcadas como indisponíveis nunca viram link quebrado.
 */
import Logo from './Logo.astro';
import { site } from '../data/site';
import { montinho } from '../data/montinho';
import { cidadesPopularesFooter } from '../data/destaques';
import { ferramentasDisponiveis, urlFerramenta } from '../data/ferramentas';
import { cidades } from '../data/cidades';
import { formatMonthYear } from '../lib/slug';
import { emCidade } from '../lib/gramatica';

const anoAtual = 2026;

/**
 * "Atualizado em" derivado do conteúdo, não escrito à mão: é a data de
 * revisão mais recente entre as páginas de cidade. Estava fixa no código e
 * ficou dois meses defasada — uma data de atualização errada em todas as
 * páginas é pior do que não ter data nenhuma.
 */
const ultimaAtualizacao = cidades.reduce(
  (maior, c) => (c.atualizadoEm > maior ? c.atualizadoEm : maior),
  '2026-01-01',
);
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <Logo light={true} />
      <p>
        O Personal por Perto é um portal editorial independente sobre personal
        trainer no Brasil: reúne busca local de profissionais em centenas de
        cidades e guias práticos para ajudar você a decidir com segurança.
      </p>
      <p class="footer-note">
        As recomendações são baseadas em critérios
        próprios e descritos em <a href="/como-avaliamos/">Como avaliamos</a>.
      </p>
    </div>

    <details class="footer-acc" open>
      <summary>Personal Trainer</summary>
      <ul>
        <li><a href="/personal-trainer/">Buscar por cidade</a></li>
        <li><a href="/montinho-personal/">Acompanhamento online</a></li>
        <li><a href="/guias/como-escolher-personal-trainer/">Como escolher um personal</a></li>
        <li><a href="/guias/quanto-custa-personal-trainer/">Quanto custa um personal</a></li>
      </ul>
    </details>

    <details class="footer-acc" open>
      <summary>Meu Mapa do Treino</summary>
      <ul>
        {
          ferramentasDisponiveis.map((f) => (
            <li>
              <a href={urlFerramenta(f.slug)}>{f.nomeCurto}</a>
            </li>
          ))
        }
        <li><a href="/ferramentas/">Todas as ferramentas</a></li>
      </ul>
    </details>

    <details class="footer-acc" open>
      <summary>Conteúdo</summary>
      <ul>
        <li><a href="/musculacao/">Musculação</a></li>
        <li><a href="/emagrecimento/">Emagrecimento</a></li>
        <li><a href="/mounjaro-e-treino/">Mounjaro e treino</a></li>
        <li><a href="/guias/">Guias de contratação</a></li>
        <li><a href="/humor-fitness/">Humor fitness</a></li>
      </ul>
    </details>

    <details class="footer-acc" open>
      <summary>Institucional</summary>
      <ul>
        <li><a href="/sobre/">Sobre o Personal por Perto</a></li>
        <li><a href="/como-avaliamos/">Como avaliamos</a></li>
        <li><a href="/montinho-personal/">Montinho Personal</a></li>
        <li><a href={montinho.instagram.url} target="_blank" rel="noopener" data-ig>Instagram {montinho.instagram.handle}</a></li>
        <li><a href="/privacidade/">Política de Privacidade</a></li>
        <li><a href={`mailto:${site.email}`}>Contato</a></li>
      </ul>
    </details>
  </div>

  <!--
    Cidades em destaque saem das colunas e viram uma faixa própria: são
    oito links de mesma natureza, e empilhados numa coluna deixavam o
    rodapé desequilibrado (11 itens contra 3). Em linha, ocupam menos
    altura e continuam inteiros no DOM para o crawler.
  -->
  <nav class="container footer-cidades" aria-label="Cidades em destaque" data-track="rodape:faixa-cidades">
    <span class="footer-cidades-rot">Cidades em destaque</span>
    <ul>
      {
        cidadesPopularesFooter.map((c) => (
          <li>
            <a href={`/personal-trainer/${c.slug}/`}>{c.nome}</a>
          </li>
        ))
      }
      <li><a class="footer-cidades-todas" href="/personal-trainer/">Ver todas as cidades</a></li>
    </ul>
  </nav>

  <div class="container footer-bottom">
    <p>© {anoAtual} {site.nome}. Conteúdo informativo e editorial.</p>
    <p>Atualizado em {formatMonthYear(ultimaAtualizacao)}.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--brand-800);
    color: #c7ccd4;
    padding-top: var(--sp-8);
    margin-top: var(--sp-9);
    font-size: var(--step--1);
  }
  /* Marca + quatro colunas de navegação, com contagens equilibradas
     (4/4/5/6). A marca fica mais larga porque carrega texto corrido. */
  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr repeat(4, minmax(0, 1fr));
    gap: var(--sp-6) var(--sp-5);
  }
  @media (max-width: 1080px) {
    .footer-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
  .footer-brand p {
    margin-top: var(--sp-3);
    line-height: 1.6;
    max-width: 38ch;
  }
  .footer-note {
    color: #9aa1ab;
  }

  /* Acordeão dos blocos de navegação — <details> nativo: sem JS, sem
     dependências, links sempre no DOM. Aberto por padrão (zero CLS) em
     qualquer viewport; no desktop, o toggle é desabilitado via CSS para
     manter a aparência de colunas fixas. */
  .footer-acc {
    border: 0;
  }
  .footer-acc summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
    cursor: pointer;
    list-style: none;
    font-size: var(--step-0);
    font-weight: 700;
    color: #fff;
    margin-bottom: var(--sp-3);
    padding-block: 0.25rem;
  }
  .footer-acc summary::-webkit-details-marker {
    display: none;
  }
  .footer-acc summary::after {
    content: '+';
    font-weight: 400;
    font-size: var(--step-1);
    color: #9aa1ab;
    flex-shrink: 0;
  }
  .footer-acc[open] summary::after {
    content: '–';
  }
  .footer-acc ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.55rem;
  }
  .site-footer a {
    color: #c7ccd4;
  }
  .site-footer a:hover {
    color: #fff;
  }
  @media (min-width: 981px) {
    .footer-acc summary {
      cursor: default;
      pointer-events: none;
      margin-bottom: var(--sp-3);
    }
    .footer-acc summary::after {
      display: none;
    }
  }
  @media (max-width: 980px) {
    .footer-acc {
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      padding-block: var(--sp-4);
    }
    .footer-acc summary {
      margin-bottom: 0;
    }
    .footer-acc[open] summary {
      margin-bottom: var(--sp-3);
    }
  }

  /* Faixa de cidades: links em linha, separados por ponto médio. */
  .footer-cidades {
    margin-top: var(--sp-7);
    padding-top: var(--sp-5);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-2) var(--sp-4);
  }
  .footer-cidades-rot {
    font-weight: 700;
    color: #fff;
    flex-shrink: 0;
  }
  .footer-cidades ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
  }
  .footer-cidades li {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
  }
  /* Separador decorativo entre os links, exceto depois do último. */
  .footer-cidades li:not(:last-child)::after {
    content: '·';
    color: #5c6470;
  }
  .footer-cidades-todas {
    font-weight: 600;
    white-space: nowrap;
  }

  /* O botão flutuante do WhatsApp é position:fixed no canto inferior
     direito e cobria a linha da direita ("Atualizado em…"). A reserva
     abaixo garante que o texto termine acima dele. */
  .footer-bottom {
    margin-top: var(--sp-5);
    padding-block: var(--sp-4);
    padding-bottom: calc(var(--sp-4) + 4rem);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: #888f99;
  }
  @media (min-width: 761px) {
    .footer-bottom {
      /* No desktop o botão fica só à direita: basta afastar essa coluna. */
      padding-bottom: var(--sp-4);
    }
    .footer-bottom p:last-child {
      margin-right: 12rem;
    }
  }
</style>
