---
import Logo from './Logo.astro';
import { site } from '../data/site';
import { montinho } from '../data/montinho';
import { estados } from '../data/estados';
import { formatMonthYear } from '../lib/slug';

const anoAtual = 2026;
// Amostra nacional fixa no rodapé (uma cidade por região) — não rotaciona.
const principais = [
  { slug: 'sao-paulo-sp', nome: 'São Paulo', prep: 'em' },
  { slug: 'recife-pe', nome: 'Recife', prep: 'em' },
  { slug: 'manaus-am', nome: 'Manaus', prep: 'em' },
  { slug: 'porto-alegre-rs', nome: 'Porto Alegre', prep: 'em' },
  { slug: 'belem-pa', nome: 'Belém', prep: 'em' },
];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <Logo light={true} />
      <p>
        O Personal por Perto é um portal editorial independente sobre personal
        trainer no Brasil: reúne busca local de profissionais em centenas de
        cidades e guias práticos para ajudar você a decidir com segurança.
      </p>
      <p class="footer-note">
        As recomendações são baseadas em critérios
        próprios e descritos em <a href="/como-avaliamos">Como avaliamos</a>.
      </p>
    </div>

    <nav class="footer-col" aria-label="Encontrar personal">
      <h2>Encontrar Personal</h2>
      <ul>
        {
          principais.map((c) => (
            <li>
              <a href={`/personal-trainer/${c.slug}`}>Personal Trainer {c.prep} {c.nome}</a>
            </li>
          ))
        }
        <li><a href="/personal-trainer"><strong>Ver todas as cidades →</strong></a></li>
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Estados e guias">
      <h2>Estados</h2>
      <ul>
        {
          estados.map((e) => (
            <li>
              <a href={`/estado/${e.slug}`}>Personal Trainer no {e.nome}</a>
            </li>
          ))
        }
      </ul>
      <h2 class="mt">Conteúdos</h2>
      <ul>
        <li><a href="/guias/como-escolher-personal-trainer">Como escolher um personal</a></li>
        <li><a href="/guias/quanto-custa-personal-trainer">Quanto custa um personal</a></li>
        <li><a href="/musculacao/treino-para-iniciantes">Musculação para iniciantes</a></li>
        <li><a href="/musculacao/hipertrofia-como-funciona">Hipertrofia: como funciona</a></li>
        <li><a href="/emagrecimento/como-emagrecer-fazendo-musculacao">Como emagrecer fazendo musculação</a></li>
        <li><a href="/emagrecimento/deficit-calorico-como-funciona">Déficit calórico: como funciona</a></li>
        <li><a href="/musculacao">Todos os conteúdos de musculação</a></li>
        <li><a href="/emagrecimento">Todos os conteúdos de emagrecimento</a></li>
        <li><a href="/guias">Todos os guias</a></li>
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Institucional">
      <h2>Institucional</h2>
      <ul>
        <li><a href="/sobre">Sobre o Personal por Perto</a></li>
        <li><a href="/como-avaliamos">Como avaliamos</a></li>
        <li><a href="/montinho-personal">Montinho Personal</a></li>
        <li><a href={montinho.instagram.url} target="_blank" rel="noopener" data-ig>Instagram {montinho.instagram.handle}</a></li>
        <li><a href="/privacidade">Política de Privacidade</a></li>
        <li><a href={`mailto:${site.email}`}>Contato</a></li>
      </ul>
    </nav>
  </div>

  <div class="container footer-bottom">
    <p>© {anoAtual} {site.nome}. Conteúdo informativo e editorial.</p>
    <p>Atualizado em {formatMonthYear('2026-06-28')}.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--brand-800);
    color: #c7ccd4;
    padding-top: var(--sp-8);
    margin-top: var(--sp-9);
    font-size: var(--step--1);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: var(--sp-6);
  }
  @media (max-width: 820px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
  .footer-brand p {
    margin-top: var(--sp-3);
    line-height: 1.6;
    max-width: 38ch;
  }
  .footer-note {
    color: #9aa1ab;
  }
  .footer-col h2 {
    font-size: var(--step-0);
    color: #fff;
    margin-bottom: var(--sp-3);
  }
  .footer-col h2.mt {
    margin-top: var(--sp-5);
  }
  .footer-col ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }
  .site-footer a {
    color: #c7ccd4;
  }
  .site-footer a:hover {
    color: #fff;
  }
  .footer-bottom {
    margin-top: var(--sp-7);
    padding-block: var(--sp-4);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: #888f99;
  }
</style>
