---
/**
 * Bloco editorial "Personal por Perto recomenda".
 *
 * Uma recomendação só é lida como recomendação quando explica a si mesma.
 * Por isso a ordem é sempre: PONTE (por que aqui) -> nome -> motivos ->
 * ressalva de transparência -> um botão. Sem a ponte, o mesmo bloco em mil
 * páginas vira publicidade repetida.
 *
 * A ponte vem do motor, que é quem sabe se existe contexto. Passando
 * `path`, o componente pode devolver NADA — e devolver nada é o
 * comportamento certo em conteúdo informativo puro, que estava recebendo
 * este bloco sem motivo.
 */
import { montinho } from '../data/montinho';
import { cta } from '../data/site';
import { montinhoUrlCidade } from '../lib/links';
import { getRecomendacao } from '../lib/recomendacao';
import { VARIANTES_REC, LETRA_REC, type VarianteRec } from '../data/recomendacaoContextos';

export interface Props {
  /** Nome da cidade para contextualizar a recomendação (opcional). */
  cidade?: string;
  /** Locução locativa já flexionada ("no Rio de Janeiro"); cai em "em {cidade}". */
  localidade?: string;
  /** Variante visual: "destaque" (caixa cheia) ou "inline" (mais discreta). */
  variante?: 'destaque' | 'inline';
  /**
   * Caminho da página. Com ele o bloco passa a ser contextual e a poder se
   * calar; sem ele, mantém o comportamento antigo — as páginas que ainda
   * não foram migradas continuam funcionando.
   */
  path?: string;
}
const { cidade, localidade, variante = 'destaque', path } = Astro.props;

const rec = path ? getRecomendacao({ path, localidade }) : null;
// Com `path`, a ausência de contexto é uma decisão: não renderiza nada.
const suprimir = Boolean(path) && !rec;

/*
 * Sorteio da variante no servidor.
 *
 * O site é estático, então a escolha é feita a partir do próprio caminho —
 * hash simples do path. Não é aleatório por visitante, mas distribui as
 * três pontes pelas páginas de forma estável: a mesma URL mostra sempre a
 * mesma ponte, o que evita conteúdo trocando entre visitas (ruim para
 * cache e para quem volta) e ainda permite comparar as três no GA.
 */
function varianteDoPath(p: string): VarianteRec {
  let h = 0;
  for (let i = 0; i < p.length; i++) h = (h * 31 + p.charCodeAt(i)) >>> 0;
  return VARIANTES_REC[h % VARIANTES_REC.length];
}

const varianteRec = path ? varianteDoPath(path) : 'direta';
const ponte = rec?.pontes[varianteRec] ?? null;

const contexto = cidade
  ? `Entre as opções analisadas para quem treina ${localidade ?? `em ${cidade}`} — sobretudo no formato online —, o portal destaca o trabalho do Montinho Personal.`
  : 'Entre os profissionais analisados, o portal destaca o trabalho do Montinho Personal para quem busca acompanhamento online com foco em emagrecimento.';
---

{!suprimir && (
<aside
  class={`cta-montinho ${variante}`}
  aria-label="Recomendação editorial"
  data-rec={rec?.contexto ?? 'legado'}
  data-rec-variant={varianteRec}
  data-rec-variant-ab={LETRA_REC[varianteRec]}
  data-rec-page-type={rec?.classificacao.tipo ?? ''}
  data-rec-cluster={rec?.classificacao.topico ?? ''}
  data-rec-intent={rec?.intencao ?? ''}
  data-rec-funnel={rec?.classificacao.funil ?? ''}
  data-rec-search-intent={rec?.classificacao.intencaoBusca ?? ''}
  data-rec-position={variante === 'inline' ? 'corpo' : 'pos-artigo'}
  data-rec-destination="/montinho-personal/"
>
  <p class="eyebrow">Personal por Perto recomenda</p>
  {ponte && <p class="cta-ponte">{ponte}</p>}
  <h2>Para quem procura acompanhamento online, o destaque é o Montinho Personal</h2>
  <p class="cta-lead">{contexto}</p>

  <!--
    Diferenciais em lista curta, não em cards com parágrafo.

    Cada motivo era um cartão branco com título em duas linhas e um
    parágrafo de quatro — os quatro juntos deixavam o bloco com 1.754px no
    celular, duas viewports e meia de altura. Um bloco desse tamanho no meio
    de um artigo lê como página de venda embutida, não como recomendação.
    A explicação de cada ponto continua existindo: mora em
    /montinho-personal/, que é exatamente onde o link secundário leva.
  -->
  <ul class="cta-checks">
    {montinho.motivosRecomendacao.map((m) => <li>{m.titulo}</li>)}
  </ul>

  <p class="cta-context">
    {montinho.resumo} A recomendação parte dos critérios descritos em{' '}
    <a href="/como-avaliamos/">Como avaliamos</a> e não substitui a avaliação de cada
    leitor sobre o profissional ideal para o seu caso.
  </p>

  <div class="cta-actions">
    <a
      class="btn btn-primary btn-lg"
      href={montinhoUrlCidade(cidade)}
      target="_blank"
      rel="noopener nofollow"
      data-rec-link="primario"
    >
      {cta.rotuloPrimario}
    </a>
    <a class="btn btn-outline" href="/montinho-personal/" data-rec-link="secundario">
      Entenda a recomendação
    </a>
  </div>
</aside>
)}

<script>
  import { iniciarMedicaoRecomendacao } from '../scripts/recomendacao.client';
  iniciarMedicaoRecomendacao();
</script>

<style>
  /*
   * A ponte vem antes do título e é o que faz o bloco parecer continuação
   * do texto: ela nomeia a situação de quem acabou de ler aquela página.
   */
  .cta-ponte {
    margin: 0 0 var(--sp-2);
    font-size: var(--step-1);
    font-weight: 650;
    line-height: 1.3;
  }

  .cta-checks {
    list-style: none;
    margin: var(--sp-4) 0 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .cta-checks li {
    position: relative;
    padding-left: 1.5rem;
    font-size: var(--step-0);
    line-height: 1.4;
  }
  /* Marca de conferido desenhada em CSS: sem imagem, sem fonte de ícone. */
  .cta-checks li::before {
    content: '';
    position: absolute;
    left: 0.25rem;
    top: 0.42em;
    width: 0.3rem;
    height: 0.6rem;
    border: solid currentColor;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
    opacity: 0.85;
  }

  .cta-montinho {
    border-radius: var(--radius-lg);
    padding: var(--sp-6);
    background: linear-gradient(155deg, var(--brand-700), var(--brand-800));
    color: #f4f5f7;
    box-shadow: var(--shadow-lg);
  }
  .cta-montinho.inline {
    background: var(--brand-50);
    color: var(--ink);
    box-shadow: none;
    border: 1px solid var(--brand-100);
  }
  .cta-montinho .eyebrow {
    color: var(--accent);
  }
  .cta-montinho.inline .eyebrow {
    color: var(--accent-600);
  }
  .cta-montinho h2 {
    color: #fff;
    font-size: var(--step-2);
    max-width: 26ch;
  }
  .cta-montinho.inline h2 {
    color: var(--ink);
  }
  .cta-lead {
    margin-top: var(--sp-3);
    font-size: var(--step-1);
    line-height: 1.55;
    color: #d4d8df;
  }
  .cta-montinho.inline .cta-lead {
    color: var(--ink-soft);
  }
  .cta-reasons {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--sp-4);
    margin-top: var(--sp-5);
  }
  .reason {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius);
    padding: var(--sp-4);
  }
  .cta-montinho.inline .reason {
    background: #fff;
    border-color: var(--brand-100);
  }
  .reason h3 {
    font-size: var(--step-0);
    color: #fff;
    margin-bottom: 0.35rem;
  }
  .cta-montinho.inline .reason h3 {
    color: var(--brand-700);
  }
  .reason p {
    font-size: var(--step--1);
    color: #c2c7d0;
    line-height: 1.55;
  }
  .cta-montinho.inline .reason p {
    color: var(--ink-soft);
  }
  .cta-context {
    margin-top: var(--sp-5);
    font-size: var(--step--1);
    color: #aab0ba;
    line-height: 1.6;
  }
  .cta-montinho.inline .cta-context {
    color: var(--muted);
  }
  .cta-context a {
    color: #fff;
    text-decoration: underline;
  }
  .cta-montinho.inline .cta-context a {
    color: var(--brand-700);
  }
  .cta-actions {
    margin-top: var(--sp-5);
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }
  .cta-montinho .btn-outline {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.5);
  }
  .cta-montinho .btn-outline:hover {
    background: rgba(255, 255, 255, 0.12);
  }
  .cta-montinho.inline .btn-outline {
    color: var(--brand-700);
    border-color: var(--brand);
  }
  .cta-montinho.inline .btn-outline:hover {
    background: #fff;
  }
</style>
