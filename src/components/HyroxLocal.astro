---
/**
 * Página "Hyrox em <cidade>" da região presencial.
 *
 * O texto local (abertura, onde correr, onde treinar força, caminho até a
 * prova e as perguntas da cidade) vem de src/data/hyroxLocal.ts, escrito
 * para cada cidade. Aqui fica só o que é igual por natureza: o formato da
 * prova e como a preparação se organiza. O bloco de ferramenta entra pelo
 * slot "ferramenta", com o id literal na página — é assim que o teste dos
 * blocos lê o id.
 */
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Faq from './Faq.astro';
import Sidebar from './Sidebar.astro';
import RelatedArticles from './RelatedArticles.astro';
import InstagramFollow from './InstagramFollow.astro';
import AutorMontinho from './AutorMontinho.astro';
import ContextualCta from './ContextualCta.astro';
import { breadcrumbSchema, articleSchema, faqSchema, personMontinhoSchema } from '../lib/schema';
import { formatDateLong } from '../lib/slug';
import { site } from '../data/site';
import { whatsappUrl } from '../lib/links';
import { ESTACOES, KM_CORRIDA } from '../lib/calorias/hyrox';
import { HYROX_CIDADES, hyroxCidade } from '../data/hyroxLocal';

interface Props {
  slug: string;
  publicadoEm: string;
  atualizadoEm: string;
}

const { slug, publicadoEm, atualizadoEm } = Astro.props;
const c = hyroxCidade(slug);
const path = `/guias/hyrox-${c.slug}`;
const urlCidade = `/personal-trainer/${c.cidade}/`;
const whatsHyrox = whatsappUrl(
  `Oi, Montinho! Vim pela página de Hyrox ${c.locucao} do Personal por Perto e queria saber sobre o treino para a prova.`,
);

const crumbs = [
  { nome: 'Início', url: '/' },
  { nome: 'Guias', url: '/guias/' },
  { nome: `Hyrox ${c.locucao}`, url: path },
];

const OBOX_URL = 'https://wellhub.com/pt-br/search/partners/obox-jacarei/';
const HYBOX_URL = 'https://wellhub.com/pt-br/search/partners/hybox/';
const textoLocal = [...c.corrida, ...c.estacoes].join(' ');
const citaObox = textoLocal.includes('Obox');
const citaHybox = textoLocal.includes('HYBOX');
const citaCrossfitBarueri = textoLocal.includes('CrossFit Barueri');

const faqs = [
  ...c.faqs,
  {
    pergunta: 'Quais são os 8 exercícios do Hyrox, e em que sequência?',
    resposta: `São ${KM_CORRIDA} corridas de 1 km, cada uma seguida de uma estação de força, sempre nesta ordem: ${ESTACOES.map((e) => `${e.nome.toLowerCase()} (${e.volume})`).join(', ')}. Dá para competir sozinho, em dupla ou em revezamento de quatro.`,
  },
  {
    pergunta: 'Qual a diferença entre CrossFit e Hyrox?',
    resposta:
      'O Hyrox é uma prova com formato fixo: a mesma sequência de corrida e estações em qualquer lugar do mundo, o que permite comparar tempos e treinar para ela. O CrossFit é um método de treino em que os exercícios do dia variam. Quem vem do CrossFit costuma chegar ao Hyrox com a parte de força adiantada, e o que mais pede atenção é a corrida — são 8 km no total.',
  },
  {
    pergunta: 'Dá para treinar Hyrox em casa?',
    resposta:
      'Parte dele. Corrida, burpee broad jump, afundo e exercícios com o peso do corpo cabem em casa ou na rua; wall ball e carregamento pedem pouco equipamento. Trenó, SkiErg e remo precisam de academia que tenha os aparelhos, pelo menos algumas vezes antes da prova.',
  },
  {
    pergunta: 'Precisa de índice ou classificatória para correr o Hyrox?',
    resposta:
      'Não. Segundo o Distrito Anhembi, que recebe a etapa de São Paulo, a prova não tem tempo limite nem classificatória: qualquer pessoa pode se inscrever. As vagas, porém, costumam acabar rápido.',
  },
];

const vizinhas = c.vizinhas.map((v) => HYROX_CIDADES.find((x) => x.slug === v)!).filter(Boolean);

const relacionados = [
  {
    url: '/guias/hyrox-sao-paulo-2026/',
    titulo: 'Hyrox São Paulo 2026',
    descricao: 'Resultado, data, local, horários e divisões da etapa de outubro no Distrito Anhembi.',
    tipo: 'Guias',
  },
  {
    url: '/calorias/hyrox/',
    titulo: 'Quantas calorias gasta uma prova de Hyrox?',
    descricao: 'A conta separa a corrida e as estações pelo seu tempo e pace.',
    tipo: 'Calorias',
  },
  {
    url: urlCidade,
    titulo: `Personal trainer ${c.locucao}`,
    descricao: 'Preços, onde treinar e como funciona o atendimento na cidade.',
    tipo: 'Cidades',
  },
];

const schema = [
  breadcrumbSchema(crumbs),
  articleSchema({ titulo: c.title, descricao: c.description, url: new URL(path, site.dominio).href, publicadoEm, atualizadoEm }),
  faqSchema(faqs),
  personMontinhoSchema(),
];
---

<Base title={c.title} description={c.description} path={path} ogType="article" schema={schema}>
  <Breadcrumbs crumbs={crumbs} />
  <div class="container guide-layout">
    <article class="article-page">
      <p class="eyebrow">Hyrox na região</p>
      <h1>{c.h1}</h1>
      <p class="updated">Atualizado em {formatDateLong(atualizadoEm)}</p>

      <p class="lead">{c.lead}</p>

      <div class="prose">
        <h2>Como é a prova</h2>
        <p>
          O Hyrox alterna corrida e força: são {KM_CORRIDA} corridas de 1 km, e cada uma termina numa
          estação, sempre na mesma ordem. Dá para competir sozinho, em dupla ou em revezamento de
          quatro, e a prova não tem tempo limite nem classificatória. Os pesos de cada categoria e o
          resto do formato estão em <a href="/guias/o-que-e-hyrox/">o que é Hyrox</a>.
        </p>
        <div class="table-wrap">
          <table>
            <caption>As 8 estações, na ordem da prova</caption>
            <thead>
              <tr><th scope="col">#</th><th scope="col">Estação</th><th scope="col">Volume</th></tr>
            </thead>
            <tbody>
              {ESTACOES.map((e, i) => (
                <tr><td>{i + 1}</td><th scope="row">{e.nome}</th><td>{e.volume}</td></tr>
              ))}
            </tbody>
          </table>
        </div>

        <slot name="ferramenta" />

        <h2>Onde treinar a corrida {c.locucao}</h2>
        {c.corrida.map((t) => <p>{t}</p>)}

        <h2>Onde treinar a força e as estações {c.locucao}</h2>
        {c.estacoes.map((t) => <p>{t}</p>)}
        {
          (citaObox || citaHybox || citaCrossfitBarueri) && (
            <p class="small">
              Aulas, horários e planos aceitos mudam: confirme com a academia antes de ir. A lista de
              academias afiliadas oficialmente à Hyrox fica no buscador da própria Hyrox.
            </p>
          )
        }

        <h2>Como organizar a preparação</h2>
        <p>
          Metade da prova é corrida e metade é força, e o que mais pesa é a passagem de uma para a
          outra: correr com a perna cansada do trenó ou dos afundos é diferente de correr descansado.
          Por isso a preparação costuma ter três tipos de treino na semana:
        </p>
        <ul>
          <li><strong>Corrida</strong>, para a base e para o ritmo que você quer manter nos {KM_CORRIDA} km.</li>
          <li><strong>Força</strong>, para empurrar, puxar, carregar e agachar com carga sem perder a técnica.</li>
          <li>
            <strong>Os dois juntos</strong>: blocos de corrida seguidos de uma estação, que ensinam o
            corpo a voltar a correr depois do esforço.
          </li>
        </ul>
        <p>
          Quanto de cada um, e em que ordem, depende de onde você está hoje e de quanto tempo falta para
          a prova. Para quem está começando, costuma render mais construir primeiro a base de corrida e
          de força, separadas, e só depois juntar as duas no mesmo treino. Se você tem alguma dor, lesão ou condição de saúde, converse com o médico ou o
          fisioterapeuta antes de aumentar o volume de treino. Frequência, musculação e o que dá para
          treinar em casa estão no <a href="/guias/treino-hyrox/">artigo de treino de Hyrox</a>.
        </p>

        <h2>{c.nome} até a prova de São Paulo</h2>
        <p>{c.ateAProva}</p>
        <p>
          A prova é paga por inscrição, não por mensalidade: na etapa de outubro de 2026, R$ 649 no
          individual, R$ 599 por atleta na dupla e R$ 399 por integrante no revezamento. Data, horários e
          resultado da última etapa estão no guia do{' '}
          <a href="/guias/hyrox-sao-paulo-2026/">Hyrox São Paulo 2026</a>.
        </p>

        <h2>Personal para o Hyrox {c.locucao}</h2>
        <p>
          O Montinho Personal prepara alunos para o Hyrox e atende presencialmente {c.locucao} e na
          região — em casa, no condomínio ou na academia —, além de acompanhar online quem prefere. O
          treino junta corrida, força para as estações e sessões que combinam as duas coisas, montado na
          semana que você tem e no tempo que falta até a prova.
        </p>
        <p>
          <a class="hx-cta" href={whatsHyrox} target="_blank" rel="noopener" data-track="hyrox:cta-whatsapp">
            Falar com o Montinho sobre treino para o Hyrox
          </a>
        </p>
        <p>
          Preços e formatos de atendimento na cidade estão na página de{' '}
          <a href={urlCidade}>personal trainer {c.locucao}</a>.
        </p>

        {
          vizinhas.length > 0 && (
            <>
              <h2>Hyrox em outras cidades da região</h2>
              <ul>
                {vizinhas.map((v) => (
                  <li><a href={`/guias/hyrox-${v.slug}/`}>Hyrox {v.locucao}</a></li>
                ))}
              </ul>
            </>
          )
        }

        <h2>Fontes</h2>
        <ul class="small">
          <li>
            <a href="https://hyrox.com/event/hyrox-sao-paulo-2/" target="_blank" rel="noopener noreferrer">Página oficial do Hyrox São Paulo</a>
            — data, local e formatos da etapa de 2026.
          </li>
          <li>
            <a href="https://distritoanhembi.com.br/en/events/hyrox-sao-paulo-2026-2/" target="_blank" rel="noopener noreferrer">Distrito Anhembi</a>
            — formato de 8 km de corrida com 8 estações, sem tempo limite e sem classificatória.
          </li>
          {
            citaObox && (
              <li>
                <a href={OBOX_URL} target="_blank" rel="noopener noreferrer">Obox no Wellhub</a> (aulas) e{' '}
                <a href="https://totalpass.com/br/academias/obox-training-club-74058863-93c1-4f40-8383-736778c221c5/" target="_blank" rel="noopener noreferrer">na TotalPass</a>, conferidos em 23/10/2026.
              </li>
            )
          }
          {
            citaCrossfitBarueri && (
              <li>
                <a href="https://wellhub.com/pt-br/search/partners/crossfit-barueri" target="_blank" rel="noopener noreferrer">CrossFit Barueri no Wellhub</a>{' '}
                e <a href="https://totalpass.com/br/academias/crossfit-barueri/" target="_blank" rel="noopener noreferrer">na TotalPass</a>
                — mesmo endereço nas duas, conferido em 23/10/2026.
              </li>
            )
          }
          {
            citaHybox && (
              <li>
                <a href={HYBOX_URL} target="_blank" rel="noopener noreferrer">HYBOX no Wellhub</a> — atividades
                e endereço, conferidos em 23/10/2026.
              </li>
            )
          }
          <li>Parques, corridas, academias e transporte: a página de personal trainer {c.locucao}, com as fontes de cada item.</li>
        </ul>
        <p class="small">Publicado em {formatDateLong(publicadoEm)}.</p>
      </div>

      <Faq faqs={faqs} titulo={`Perguntas frequentes sobre Hyrox ${c.locucao}`} />

      <ContextualCta path={path} assunto={c.title} />
      <InstagramFollow tema="geral" />
      <AutorMontinho />

      <RelatedArticles itens={relacionados} />
    </article>

    <Sidebar />
  </div>
</Base>

<style>
  .hx-cta {
    display: inline-block;
    padding: 0.7rem 1.1rem;
    border-radius: var(--radius);
    background: var(--brand-600);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }
  .hx-cta:hover { background: var(--brand-700); text-decoration: none; }
  .hx-cta:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
</style>
