---
/**
 * Botão flutuante de WhatsApp — presente em todas as páginas (via Base).
 * Leve (zero JS), acessível, abre a conversa direto com mensagem pré-preenchida.
 * No tema da marca (grafite/laranja) — sem verde, conforme a identidade do portal.
 * Desktop: ícone + "Fale comigo". Mobile: só ícone.
 */
import { whatsappUrl } from '../lib/links';

const mensagem =
  'Oi, Montinho! Vim pelo Personal por Perto e quero saber como funciona a sua consultoria.';
const href = whatsappUrl(mensagem);
---

<a
  class="wpp-float"
  href={href}
  target="_blank"
  rel="noopener"
  data-wpp
  aria-label="Falar no WhatsApp com o Montinho Personal"
>
  <span class="wpp-float-ico" aria-hidden="true">
    <svg viewBox="0 0 32 32" width="26" height="26" fill="currentColor"><path d="M16.04 4C9.4 4 4 9.4 4 16.04c0 2.12.55 4.18 1.6 6L4 28l6.13-1.6a12 12 0 0 0 5.9 1.5h.01C22.68 27.9 28 22.5 28 15.86 28 9.4 22.68 4 16.04 4Zm0 21.8h-.01a9.7 9.7 0 0 1-4.95-1.36l-.35-.21-3.64.95.97-3.55-.23-.36a9.74 9.74 0 0 1-1.49-5.18c0-5.37 4.37-9.74 9.75-9.74 2.6 0 5.05 1.02 6.89 2.86a9.68 9.68 0 0 1 2.85 6.89c0 5.37-4.37 9.74-9.74 9.74Zm5.34-7.29c-.29-.15-1.73-.85-2-.95-.27-.1-.46-.15-.66.15-.2.29-.76.95-.93 1.15-.17.2-.34.22-.63.07-.29-.15-1.24-.46-2.36-1.46-.87-.78-1.46-1.74-1.63-2.03-.17-.29-.02-.45.13-.6.13-.13.29-.34.44-.51.15-.17.2-.29.29-.49.1-.2.05-.37-.02-.51-.07-.15-.66-1.59-.9-2.18-.24-.57-.48-.49-.66-.5l-.56-.01c-.2 0-.51.07-.78.37-.27.29-1.02 1-1.02 2.43 0 1.43 1.04 2.81 1.19 3.01.15.2 2.05 3.13 4.97 4.39.69.3 1.23.48 1.65.61.69.22 1.32.19 1.82.12.56-.08 1.73-.71 1.97-1.39.24-.68.24-1.27.17-1.39-.07-.12-.27-.2-.56-.34Z" /></svg>
  </span>
  <span class="wpp-float-txt">Fale comigo</span>
</a>

<style>
  .wpp-float {
    position: fixed;
    right: clamp(0.75rem, 2vw, 1.25rem);
    /* O piso de 0.875rem existe para o respiro entre o botão e a sticky
       bar nunca cair abaixo de 14px: com 0.75rem eles encostavam em telas
       de 320 a 390px, onde 2vw ainda é menor que o mínimo. */
    bottom: clamp(0.875rem, 2vw, 1.25rem);

    /*
     * Sobe por TRANSFORM, não por `bottom`.
     *
     * A barra publica a própria altura em --sticky-h e o botão só reage —
     * nenhum dos dois conhece o outro. Mas a primeira versão disso animava
     * `bottom`, que é propriedade de layout: o navegador registrava um
     * layout-shift a cada quadro da transição, e o CLS da página saía de
     * 0 para 0,0053. `transform` é composto na GPU, não recalcula layout e
     * não conta como deslocamento.
     *
     * O `--lift` existe para o hover somar ao deslocamento em vez de
     * sobrescrevê-lo: duas regras mexendo em `transform` derrubariam uma
     * à outra.
     */
    --lift: 0px;
    transform: translateY(calc(-1 * var(--sticky-h, 0px) + var(--lift)));

    z-index: 90;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem;
    border-radius: 999px;
    background: var(--accent, #f0641e);
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.28);
    /*
     * Uma declaração só, de propósito.
     *
     * A transição de `bottom` estava declarada mais acima no bloco e era
     * sobrescrita por esta — resultado: o botão PULAVA ao subir e ao
     * descer com a sticky bar, em vez de acompanhar o movimento dela. Em
     * CSS a última declaração da mesma propriedade vence, e `transition`
     * é uma propriedade só, não uma lista acumulável.
     *
     * O tempo de `bottom` é o mesmo da barra (260ms), para os dois se
     * moverem juntos em vez de um atrás do outro.
     */
    transition:
      transform 260ms ease-out,
      filter 0.15s ease;
  }
  /*
   * Some enquanto o slide-in está aberto.
   *
   * No mobile o slide-in é uma folha inferior centrada e o botão ficaria
   * por cima dela; no desktop os dois ocupam o mesmo canto. Some por
   * opacidade (e não por display) para voltar deslizando junto com o
   * resto, e `visibility` garante que não fique clicável enquanto
   * invisível.
   */
  :global(html[data-slidein]) .wpp-float {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 200ms ease-out,
      visibility 0s linear 200ms;
  }

  .wpp-float:hover {
    filter: brightness(1.07);
    --lift: -2px;
  }
  .wpp-float-ico {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
  }
  /* Desktop: mostra o texto e vira "pílula". */
  .wpp-float-txt {
    display: none;
    padding-right: 0.4rem;
    font-size: var(--step-0, 1rem);
  }
  @media (min-width: 768px) {
    .wpp-float {
      padding: 0.7rem 0.9rem;
    }
    .wpp-float-txt {
      display: inline;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wpp-float {
      transition: none;
    }
  }
</style>
